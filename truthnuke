local function cleanName(name)
    if type(name) ~= "string" then return nil end
    local key = name:lower():gsub("[_%-]", " "):gsub("%s+", " ")
    key = key:match("^%s*(.-)%s*$")
    if key == "" or orbitTools.GENERIC_NAMES[key] then return nil end
    return key
end

local function meshAssetKey(value)
    local text = tostring(value or "")
    return text:match("rbxassetid://(%d+)")
        or text:match("[?&]id=(%d+)")
        or text:match("^(%d+)$")
end

local function getReplicaNames()
    local replicas = ReplicatedStorage:FindFirstChild("Tool_Replicas")
    local names, meshes, count = {}, {}, 0
    local function addName(name)
        local key = cleanName(name)
        if key and not names[key] then
            names[key] = name
            count += 1
        end
    end
    -- Never let the replica folder's timing/layout prevent item detection.
    for name in pairs(orbitTools.ITEM_CAPS) do addName(name) end
    for _, name in ipairs(orbitTools.KNOWN_ITEM_NAMES) do addName(name) end
    local function add(instance)
        local name = instance.Name
        addName(name)
        local function registerMesh(part)
            local asset
            if part:IsA("MeshPart") or part:IsA("SpecialMesh") then
                asset = meshAssetKey(part.MeshId)
            end
            if not asset then return end
            if meshes[asset] == nil then
                meshes[asset] = name
            elseif meshes[asset] ~= name then
                meshes[asset] = false
            end
        end
        registerMesh(instance)
        for _, child in ipairs(instance:GetDescendants()) do registerMesh(child) end
    end
    if replicas then
        for _, child in ipairs(replicas:GetChildren()) do
            if not child:IsA("Folder") then
                add(child)
            else
                local hasEntries = false
                for _, inner in ipairs(child:GetChildren()) do
                    if inner:IsA("Tool") or inner:IsA("Model") or inner:IsA("Folder") then
                        add(inner)
                        hasEntries = true
                    end
                end
                if not hasEntries then add(child) end
            end
        end
    end
    return names, count, meshes
end

local function partFromItem(item)
    if not (item:IsA("Model") or item:IsA("BasePart") or item:IsA("Folder")
        or item:IsA("Tool")) then return end
    local click
    local prompt, anyPrompt
    -- Modern YBA items can contain TWO prompts: one disabled (distance 0)
    -- and a real enabled prompt (distance 8). Find the usable one explicitly.
    for _, descendant in ipairs(item:GetDescendants()) do
        if descendant:IsA("ClickDetector") and not click then
            click = descendant
        elseif descendant:IsA("ProximityPrompt") then
            anyPrompt = anyPrompt or descendant
            if descendant.Enabled and descendant.MaxActivationDistance > 0 then
                if not prompt or (descendant.KeyboardKeyCode == Enum.KeyCode.E
                    and prompt.KeyboardKeyCode ~= Enum.KeyCode.E) then
                    prompt = descendant
                end
            end
        end
    end
    local activePrompt = prompt
    prompt = activePrompt or anyPrompt
    local part
    if activePrompt then
        local host = activePrompt.Parent
        if host and host:IsA("Attachment") then host = host.Parent end
        if host and host:IsA("BasePart") then part = host end
    end
    if not part and click and click.Parent and click.Parent:IsA("BasePart") then
        part = click.Parent
    end
    if not part and prompt then
        local host = prompt.Parent
        if host and host:IsA("Attachment") then host = host.Parent end
        if host and host:IsA("BasePart") then part = host end
    end
    if not part and item:IsA("BasePart") then part = item end
    if not part then
        if item:IsA("Model") then part = item.PrimaryPart end
        part = part or item:FindFirstChildWhichIsA("BasePart", true)
    end
    if part and part:IsDescendantOf(workspace) then
        return part, click, activePrompt, anyPrompt
    end
end

local function matchReplica(item, replicas, meshLookup)
    local function match(value)
        local key = cleanName(value)
        return key and replicas[key]
    end
    local function readable(value)
        local key = cleanName(value)
        if not key then return nil end
        local name = tostring(value)
        if key == "interact" or key == "collect" or key == "pick up"
            or key == "click" or key == "take" then return nil end
        return name
    end
    -- An enabled interaction prompt is a stronger indicator than a generic
    -- enclosing model name (some item shells are named Human/Model/etc.).
    local interactiveName
    for _, descendant in ipairs(item:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Enabled
            and descendant.MaxActivationDistance > 0 then
            interactiveName = match(descendant.ObjectText)
            if interactiveName then return interactiveName, "active-prompt" end
        end
    end
    local found = match(item.Name)
    if found then return found, "name" end
    for _, field in ipairs({"ItemName", "ToolName", "DisplayName", "Item", "Tool"}) do
        found = match(item:GetAttribute(field))
        if found then return found, "attribute" end
    end
    local checked, meshMatch, ambiguousMesh = 0, nil, false
    local fallbackName, fallbackOrigin
    local function compareMesh(child)
        if not (child:IsA("MeshPart") or child:IsA("SpecialMesh")) then return end
        local id = meshAssetKey(child.MeshId)
        local name = id and meshLookup[id]
        if name then
            if meshMatch and meshMatch ~= name then ambiguousMesh = true end
            meshMatch = name
        end
    end
    compareMesh(item)
    for _, child in ipairs(item:GetDescendants()) do
        checked += 1
        if checked > 180 then break end
        if child:IsA("Tool") or child:IsA("Model") or child:IsA("BasePart") then
            found = match(child.Name)
        elseif child:IsA("ProximityPrompt") then
            found = match(child.ObjectText)
            if child.Enabled and child.MaxActivationDistance > 0 then
                fallbackName = fallbackName or readable(child.ObjectText)
                if fallbackName then fallbackOrigin = "prompt-text" end
            end
        elseif child:IsA("StringValue") then
            local label = child.Name:lower()
            if label == "itemname" or label == "toolname" or label == "displayname" then
                found = match(child.Value)
                if not fallbackName then
                    fallbackName = readable(child.Value)
                    if fallbackName then fallbackOrigin = "string-value" end
                end
            end
        elseif child:IsA("TextLabel") then
            found = match(child.Text)
        end
        if found then return found, "name" end
        compareMesh(child)
    end
    if meshMatch and not ambiguousMesh then return meshMatch, "mesh" end
    -- The folder is an authoritative item-only container. Accept a readable
    -- prompt name there even when Tool_Replicas doesn't contain that item.
    if fallbackName then return fallbackName, fallbackOrigin end
    for _, field in ipairs({"ItemName", "ToolName", "DisplayName"}) do
        local attr = readable(item:GetAttribute(field))
        if attr then return attr, "attribute-fallback" end
    end
    local ownName = readable(item.Name)
    if ownName then return ownName, "item-model" end
    return nil
end

local function itemsFolder()
    local root = workspace:FindFirstChild("Item_Spawns")
        or workspace:FindFirstChild("ItemSpawns")
        or workspace:FindFirstChild("Item Spawns")
    if not root then return nil end
    local items = root:FindFirstChild("Items") or root:FindFirstChild("SpawnedItems")
    if items and (items:IsA("Folder") or items:IsA("Model")) then
        return items
    end
end

-- Some YBA builds group the spawned item models inside extra Folders. The
-- old scanner treated such a category folder as one item and missed its peers.
-- Flatten only clear groups; never enumerate unrelated workspace geometry.
function orbitTools.worldItemCandidates(folder)
    local collected={}
    local function add(child,depth)
        if child:IsA("Folder") and depth<3 then
            local kids=child:GetChildren()
            local key=child.Name:lower():gsub("[^%a]","")
            local grouped=(key=="items" or key=="spawneditems" or key=="spawns"
                or key=="worlditems" or key=="itemspawns")
            if not grouped and #kids>=2 then
                local independent=0
                for _,kid in ipairs(kids) do
                    if kid:IsA("Model") or kid:IsA("Tool") or kid:IsA("Folder") then
                        if kid:FindFirstChildWhichIsA("ProximityPrompt",true)
                            or kid:FindFirstChildWhichIsA("ClickDetector",true) then
                            independent+=1
                        end
                    end
                end
                grouped=independent>=2
            end
            if grouped then
                for _,kid in ipairs(kids) do add(kid,depth+1) end
                return
            end
        end
        collected[#collected+1]=child
    end
    for _,child in ipairs(folder:GetChildren()) do add(child,0) end
    return collected
end

-- Index the item folder once, then handle spawns/despawns as they arrive.
-- A newly created Model can be empty for a few frames, so unresolved entries
-- are retried instead of being permanently cached as not-an-item.
local function ensureTrackedItems()
    local folder = itemsFolder()
    if folder == trackedFolder then
        -- ChildAdded can be missed while the client is busy, especially over
        -- long AFK sessions. Reconciling doesn't alter the world or sell logic.
        if folder and os.clock() - (orbitTools.lastTrackCheckAt or -math.huge) >= 0.85 then
            orbitTools.lastTrackCheckAt = os.clock()
            local existing = orbitTools.worldItemCandidates(folder)
            local drift = #existing ~= #trackedItems
            if not drift then
                for _, child in ipairs(existing) do
                    if not trackedIndex[child] then drift = true; break end
                end
            end
            if drift then
                trackedItems, trackedIndex = {}, {}
                for _, child in ipairs(existing) do
                    trackedItems[#trackedItems + 1] = child
                    trackedIndex[child] = #trackedItems
                end
                spawnSerial += 1
            end
        end
        return folder
    end
    orbitTools.lastTrackCheckAt = os.clock()
    if itemAddedConn then itemAddedConn:Disconnect(); itemAddedConn = nil end
    if itemRemovedConn then itemRemovedConn:Disconnect(); itemRemovedConn = nil end
    if orbitTools.folderAddedConn then orbitTools.folderAddedConn:Disconnect(); orbitTools.folderAddedConn = nil end
    if orbitTools.folderRemovedConn then orbitTools.folderRemovedConn:Disconnect(); orbitTools.folderRemovedConn = nil end
    trackedFolder = folder
    trackedItems, trackedIndex = {}, {}
    itemInfoCache = setmetatable({}, {__mode = "k"})
    unresolvedRetryAt = setmetatable({}, {__mode = "k"})
    orbitTools.itemCacheRefreshedAt = setmetatable({}, {__mode = "k"})
    orbitTools.itemCacheDirty = setmetatable({}, {__mode = "k"})
    spawnSerial += 1
    if not folder then return nil end

    local function trackItem(item)
        if trackedIndex[item] then return end
        trackedItems[#trackedItems + 1] = item
        trackedIndex[item] = #trackedItems
        itemInfoCache[item] = nil
        unresolvedRetryAt[item] = nil
        orbitTools.itemCacheDirty[item] = true
        orbitTools.itemCacheRefreshedAt[item] = nil
        spawnSerial += 1
        orbitTools.lastWorldChangeAt = os.clock()
    end
    local function untrackItem(item)
        local i = trackedIndex[item]
        if not i then return end
        local last = trackedItems[#trackedItems]
        trackedItems[i] = last
        if last ~= item then trackedIndex[last] = i end
        trackedItems[#trackedItems] = nil
        trackedIndex[item] = nil
        itemInfoCache[item] = nil
        unresolvedRetryAt[item] = nil
        orbitTools.itemCacheDirty[item] = nil
        orbitTools.itemCacheRefreshedAt[item] = nil
        skipItems[item] = nil
        spawnSerial += 1
        orbitTools.lastWorldChangeAt = os.clock()
    end
    itemAddedConn = folder.ChildAdded:Connect(function(item)
        trackItem(item)
        orbitTools.lastTrackCheckAt = -math.huge
    end)
    itemRemovedConn = folder.ChildRemoved:Connect(function(item)
        untrackItem(item)
        orbitTools.lastTrackCheckAt = -math.huge
    end)
    -- The game may parent the item shell first, then add its prompt/mesh a few
    -- frames later. ChildAdded on Items does not fire for those additions.
    -- Watch inner replication without initiating an expensive full refresh.
    function orbitTools.onItemTreeChanged(descendant, wasAdded)
        if not (descendant:IsA("ProximityPrompt") or descendant:IsA("BasePart")
            or descendant:IsA("Attachment") or descendant:IsA("StringValue")
            or descendant:IsA("Tool")) then return end
        local current = descendant.Parent
        while current and current ~= folder and not trackedIndex[current] do
            current = current.Parent
        end
        if current and trackedIndex[current] then
            orbitTools.itemCacheDirty[current] = true
            unresolvedRetryAt[current] = nil
            orbitTools.lastWorldChangeAt = os.clock()
            spawnSerial += 1
            -- A new interaction component is a reason to retry, even if a
            -- previous version of this spawn failed several times.
            if wasAdded and descendant:IsA("ProximityPrompt") then
                skipItems[current] = nil
                orbitTools.failedItemAttempts[current] = nil
            end
        end
    end
    orbitTools.folderAddedConn = folder.DescendantAdded:Connect(function(descendant)
        orbitTools.onItemTreeChanged(descendant, true)
        if descendant:IsA("Model") or descendant:IsA("Folder") or descendant:IsA("Tool") then
            orbitTools.lastTrackCheckAt = -math.huge
        end
    end)
    orbitTools.folderRemovedConn = folder.DescendantRemoving:Connect(function(descendant)
        orbitTools.onItemTreeChanged(descendant, false)
        if descendant:IsA("Model") or descendant:IsA("Folder") or descendant:IsA("Tool") then
            orbitTools.lastTrackCheckAt = -math.huge
        end
    end)
    for _, child in ipairs(orbitTools.worldItemCandidates(folder)) do trackItem(child) end
    return folder
end

-- HYBRID SPAWN DISCOVERY -------------------------------------------------
-- Historical YBA used ItemSpawn:OnClientInvoke (a RemoteFunction), with
-- payload fields Replica, CFrame and CD. Recent builds may also use a
-- RemoteEvent. Observe both without replacing the normal game handler.
-- Generic remotes require an explicit spawn action or a recognisable payload.
function orbitTools.recordSpawnLead(source, ...)
    if not alive then return end
    local args=table.pack(...)
    local sourceName=tostring(source.Name):lower()
    local named=(sourceName:find("item",1,true) and sourceName:find("spawn",1,true))~=nil
    local explicit=false
    local itemName,position,recognized=nil,nil,false
    for i=1,math.min(args.n,5) do
        local v=args[i]
        local kind=typeof(v)
        if kind=="string" then
            local cleaned=v:lower():gsub("[^%a]","")
            if cleaned=="itemspawn" or cleaned=="spawnitem" or cleaned=="itemspawned"
                or cleaned=="spawneditem" or cleaned:find("itemspawn",1,true) then
                explicit=true
            elseif named and #v<80 then
                itemName=itemName or v
            end
        elseif kind=="table" then
            local nested=rawget(v,"ItemData") or rawget(v,"Item")
            if type(nested)=="table" then v=nested end
            local cf=rawget(v,"CFrame") or rawget(v,"CFR") or rawget(v,"SpawnCFrame")
                or rawget(v,"SpawnPosition") or rawget(v,"Position")
            if typeof(cf)=="CFrame" then position=cf.Position;recognized=true
            elseif typeof(cf)=="Vector3" then position=cf;recognized=true end
            local replica=rawget(v,"Replica")
            local name=rawget(v,"ItemName") or rawget(v,"ToolName") or rawget(v,"DisplayName")
                or (typeof(replica)=="Instance" and replica.Name or nil)
                or (type(replica)=="table" and rawget(replica,"Name") or nil)
            if type(name)=="string" and #name<=100 then itemName=name end
            if rawget(v,"CD") or rawget(v,"ClickDetector") or rawget(v,"Prompt") then
                recognized=true
            end
        elseif kind=="CFrame" then
            if not position then position=v.Position end
        elseif kind=="Vector3" then
            if not position then position=v end
        end
    end
    -- Ignore incidental coordinates in unrelated game traffic.
    if not named and not explicit and not (recognized and itemName) then return end
    orbitTools.spawnSignalsSeen += 1
    spawnSerial += 1
    orbitTools.lastWorldChangeAt=os.clock()
    -- Certain notifier events carry only the name. They still wake the scanner.
    if not position then
        if os.clock()-orbitTools.lastRemoteSignalNote>6 then
            orbitTools.lastRemoteSignalNote=os.clock()
            print("[Truefarm][Spawn] Notification received from "..source:GetFullName()
                .." (no coordinate; waiting for replicated item)")
        end
        return
    end
    if position.X~=position.X or position.Y~=position.Y or position.Z~=position.Z
        or position.Magnitude>1e7 then return end
    local now=os.clock()
    for _,lead in ipairs(orbitTools.spawnLeads) do
        if (lead.position-position).Magnitude<5 then
            lead.received=now
            lead.name=itemName or lead.name
            -- A fresh notification can revive a previously expired lead.
            if lead.tries>=orbitTools.REMOTE_LEAD_MAX_TRIES then
                lead.tries=0;lead.retryAt=now
            end
            return
        end
    end
    orbitTools.spawnLeads[#orbitTools.spawnLeads+1]={
        position=position,name=itemName or "unknown",received=now,
        source=source.Name,tries=0,retryAt=now,
    }
    if #orbitTools.spawnLeads>24 then table.remove(orbitTools.spawnLeads,1) end
    print(string.format("[Truefarm][Spawn] %s at %.0f, %.0f, %.0f via %s",
        itemName or "item",position.X,position.Y,position.Z,source.Name))
end

function orbitTools.expireSpawnLeads()
    local leads=orbitTools.spawnLeads
    for i=#leads,1,-1 do
        local hint=leads[i]
        if os.clock()-hint.received>orbitTools.REMOTE_LEAD_TTL
            or hint.resolved
            or (hint.tries>=orbitTools.REMOTE_LEAD_MAX_TRIES
                and os.clock()>=hint.retryAt) then
            table.remove(leads,i)
        end
    end
end

function orbitTools.resolveSpawnLead(part)
    if not part or #orbitTools.spawnLeads==0 then return end
    for _,lead in ipairs(orbitTools.spawnLeads) do
        if (lead.position-part.Position).Magnitude<=12 then
            lead.resolved=true
        end
    end
end

function orbitTools.watchSpawnRemote(remote)
    if not alive or not (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then return end
    local lowered=remote.Name:lower()
    local specific=(lowered:find("item",1,true) and (lowered:find("spawn",1,true)
        or lowered:find("notif",1,true))) or lowered=="spawnitem"
    local generic=(remote.Name=="RemoteEvent" or remote.Name=="Event")
    if not specific and not generic then return end
    if remote:IsA("RemoteEvent") then
        if orbitTools.spawnRemoteConnections[remote] then return end
        orbitTools.spawnRemoteConnections[remote]=connect(remote.OnClientEvent,function(...)
            orbitTools.recordSpawnLead(remote,...)
        end)
    elseif specific then
        orbitTools.spawnRemoteFunctions[remote]=true
        orbitTools.tryWrapSpawnCallback(remote)
    end
end

function orbitTools.tryWrapSpawnCallback(remote)
    if not alive or not remote.Parent then return end
    local ok,existing=pcall(function() return remote.OnClientInvoke end)
    if not ok or type(existing)~="function" then return end
    local active=orbitTools.spawnWrappedCallbacks[remote]
    if active and existing==active.wrapper then return end
    -- Important: retain the game's callback, arguments and return values.
    local original=existing
    local wrapper=function(...)
        orbitTools.recordSpawnLead(remote,...)
        return original(...)
    end
    if pcall(function() remote.OnClientInvoke=wrapper end) then
        orbitTools.spawnWrappedCallbacks[remote]={original=original,wrapper=wrapper}
    end
end

function orbitTools.installSpawnWatchers()
    local function attachDescendants(root)
        if not root then return end
        if root:IsA("RemoteEvent") or root:IsA("RemoteFunction") then
            orbitTools.watchSpawnRemote(root)
        end
        for _,obj in ipairs(root:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                orbitTools.watchSpawnRemote(obj)
            end
        end
        connect(root.DescendantAdded,function(obj)
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                orbitTools.watchSpawnRemote(obj)
            end
        end)
    end
    attachDescendants(ReplicatedStorage)
    attachDescendants(game:GetService("ReplicatedFirst"))
    attachDescendants(player)
    attachDescendants(player.Character)
    attachDescendants(workspace:FindFirstChild("Item_Spawns"))
    -- The character might be replaced after a server hop or reset.
    connect(player.CharacterAdded,function(character)
        attachDescendants(character)
    end)
    -- The old ItemSpawn callback can be assigned after this file runs.
    -- Recheck only known spawn RemoteFunctions at low frequency.
    task.spawn(function()
        while alive do
            for remote in pairs(orbitTools.spawnRemoteFunctions) do
                orbitTools.tryWrapSpawnCallback(remote)
            end
            orbitTools.expireSpawnLeads()
            task.wait(1.5)
        end
    end)
end

local function getRoot()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not (root and humanoid and humanoid.Health > 0 and not root.Anchored) then
        return nil
    end
    return root
end


-- Underground support surfaces are LOCAL ONLY. They can provide local physical
-- contact but do NOT exist on the server and are NOT a way around server checks.
-- Smooth voxel terrain may remain visually present even with map hiding on.
-- No new collision groups: Roblox only allows those to be configured on server.
-- Instead, disable local anchored scenery collision and use a small welded foot
-- collider that still collides with our own local support surfaces.
function orbitTools.mapBounds(root)
    local xs, zs = {}, {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and mapPart(obj) then
            local pos = obj.Position
            -- Avoid distant off-map assets and enormous utility primitives.
            if math.abs(pos.X - root.Position.X) < 6000
                and math.abs(pos.Z - root.Position.Z) < 6000
                and obj.Size.X < 1800 and obj.Size.Z < 1800 then
                xs[#xs+1] = pos.X
                zs[#zs+1] = pos.Z
            end
        end
    end
    if #xs < 10 then
        local x, z = root.Position.X, root.Position.Z
        return x, z, 240, 240
    end
    table.sort(xs)
    table.sort(zs)
    local function centralBounds(t)
        local n = #t
        local lo = t[math.max(1, math.floor(n * 0.015))]
        local hi = t[math.min(n, math.ceil(n * 0.985))]
        return lo, hi
    end
    local minX, maxX = centralBounds(xs)
    local minZ, maxZ = centralBounds(zs)
    local centerX = (minX + maxX) / 2
    local centerZ = (minZ + maxZ) / 2
    local halfX = math.clamp((maxX - minX) / 2 + 45, 140, 1300)
    local halfZ = math.clamp((maxZ - minZ) / 2 + 45, 140, 1300)
    return centerX, centerZ, halfX, halfZ
end

function orbitTools.terrainSurfaceY(root)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character}
    params.IgnoreWater = true
    local result = workspace:Raycast(root.Position + Vector3.new(0, 30, 0),
        Vector3.new(0, -350, 0), params)
    return result and result.Position.Y or (root.Position.Y - 3.5)
end

function orbitTools.newSupportPart(parent, name, size, cf)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = cf
    part.Anchored = true
    part.CanCollide = true
    part.CanTouch = false
    part.CanQuery = false
    part.Transparency = 1
    part.CastShadow = false
    part.Locked = true
    part.Parent = parent
    return part
end

function orbitTools.ensureFarmFloor()
    if floorState and (floorState.character ~= player.Character or not floorState.root.Parent) then
        teardownFarmFloor(false)
    end
    if floorState or not underItem or not floorEnabled then return floorState end
    local root = getRoot()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return nil end
    local centerX, centerZ, halfX, halfZ = orbitTools.mapBounds(root)
    local surfaceY = orbitTools.terrainSurfaceY(root)
    local orbitY = surfaceY - 31 -- keep the idle route well below visible map geometry
    local footDrop = humanoid.HipHeight + root.Size.Y * 0.5
    local folder = Instance.new("Folder")
    folder.Name = "TSFarmLocalSupports"
    folder.Parent = workspace
    local tiles = {}
    -- Tile if a level is wider than the practical size of one BasePart.
    local tileWidth = 850
    local totalX = halfX * 2 + 100
    local totalZ = halfZ * 2 + 100
    local countX = math.max(1, math.ceil(totalX / tileWidth))
    local countZ = math.max(1, math.ceil(totalZ / tileWidth))
    local width = totalX / countX
    local depth = totalZ / countZ
    local floorCenterY = orbitY - footDrop - 0.75
    for ix = 1, countX do
        for iz = 1, countZ do
            local x = centerX + (ix - (countX + 1) / 2) * width
            local z = centerZ + (iz - (countZ + 1) / 2) * depth
            tiles[#tiles+1] = orbitTools.newSupportPart(folder, "OrbitFloor",
                Vector3.new(width, 1.5, depth), CFrame.new(x, floorCenterY, z))
        end
    end
    local pad = orbitTools.newSupportPart(folder, "PickupFloor", Vector3.new(22, 1.5, 22),
        CFrame.new(root.Position.X, -10000, root.Position.Z))
    local foot = Instance.new("Part")
    foot.Name = "TSFarmFootCollider"
    foot.Size = Vector3.new(2.0, 0.35, 2.0)
    foot.Transparency = 1
    foot.CanCollide = true
    foot.CanTouch = false
    foot.CanQuery = false
    foot.CastShadow = false
    foot.Massless = true
    foot.CFrame = root.CFrame * CFrame.new(0, -footDrop + foot.Size.Y * 0.5, 0)
    foot.Parent = character
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = foot
    weld.Parent = foot
    -- Terrain inherits BasePart. A local NoCollisionConstraint avoids the
    -- welded foot being caught by voxel mountains (when supported by engine).
    -- The support tiles remain collidable; do not alter collision groups.
    local terrainConstraint
    pcall(function()
        local c = Instance.new("NoCollisionConstraint")
        c.Name = "TSFarmFootVsTerrain"
        c.Part0 = foot
        c.Part1 = workspace.Terrain
        c.Enabled = true
        c.Parent = folder
        terrainConstraint = c
    end)
    local state = {
        folder = folder, pad = pad, tiles = tiles, foot = foot, root = root,
        terrainConstraint = terrainConstraint,
        character = character, savedCFrame = root.CFrame, footDrop = footDrop,
        center = Vector3.new(centerX, orbitY, centerZ),
        radius = math.clamp(math.min(halfX, halfZ) * 0.83, 115, 950),
        oldMapCollision = setmetatable({}, {__mode = "k"}),
        mapAddConnection = nil, mapScanActive = true,
    }
    floorState = state
    local function noclipScenery(part)
        if floorState ~= state or not part:IsA("BasePart") or not mapPart(part) then return end
        if state.oldMapCollision[part] == nil then
            state.oldMapCollision[part] = part.CanCollide
        end
        if part.CanCollide then part.CanCollide = false end
    end
    state.mapAddConnection = workspace.DescendantAdded:Connect(noclipScenery)
    -- Refresh only scenery near the current orbit position. A few map scripts
    -- periodically re-enable CanCollide on their mesh parts.
    local lastNearbyCheck = 0
    state.mapStepConnection = RunService.Heartbeat:Connect(function()
        if floorState ~= state or not state.root.Parent then return end
        local now = os.clock()
        if now - lastNearbyCheck < 0.25 then return end
        lastNearbyCheck = now
        local options = OverlapParams.new()
        options.FilterType = Enum.RaycastFilterType.Exclude
        options.FilterDescendantsInstances = {state.character, state.folder}
        options.MaxParts = 120
        local ok, nearby = pcall(function()
            return workspace:GetPartBoundsInRadius(state.root.Position, 32, options)
        end)
        if ok then
            for _, part in ipairs(nearby) do noclipScenery(part) end
        end
    end)
    -- Batch the one-time pass to avoid an FPS stall.
    task.spawn(function()
        local parts = workspace:GetDescendants()
        for i, obj in ipairs(parts) do
            if floorState ~= state or not state.mapScanActive then return end
            if obj:IsA("BasePart") then noclipScenery(obj) end
            if i % 200 == 0 then task.wait() end
        end
    end)
    return state
end

function orbitTools.placePickupFloor(destination)
    local state = floorState
    if not state or not state.pad.Parent then return end
    -- Top surface sits under the character's foot collider, not inside the root.
    state.pad.CFrame = CFrame.new(destination.X,
        destination.Y - state.footDrop - state.pad.Size.Y * 0.5, destination.Z)
end

teardownFarmFloor = function(restorePosition)
    local state = floorState
    if not state then return end
    floorState = nil
    state.mapScanActive = false
    if state.mapAddConnection then state.mapAddConnection:Disconnect() end
    if state.mapStepConnection then state.mapStepConnection:Disconnect() end
    -- Return above ground BEFORE removing the local support and restoring map collision.
    if restorePosition and player.Character == state.character and state.root.Parent then
        pcall(function()
            state.root.CFrame = state.savedCFrame
            state.root.AssemblyLinearVelocity = Vector3.zero
        end)
    end
    if state.folder and state.folder.Parent then state.folder:Destroy() end
    if state.foot and state.foot.Parent then state.foot:Destroy() end
    for part, wasCollidable in pairs(state.oldMapCollision) do
        if part.Parent then pcall(function() part.CanCollide = wasCollidable end) end
    end
end

-- Keep real character parts non-colliding while allowing only the welded local
-- foot to contact the floor. No modifying global collision-group rules.
local function maintainUndergroundNoclip(character)
    local original = {}
    local parts = {}
    local released = false
    local function addPart(obj)
        if released or not obj:IsA("BasePart") or obj.Name == "TSFarmFootCollider"
            or original[obj] ~= nil then return end
        original[obj] = obj.CanCollide
        parts[#parts + 1] = obj
        if obj.CanCollide then obj.CanCollide = false end
    end
    for _, obj in ipairs(character:GetDescendants()) do addPart(obj) end
    local partAdded = character.DescendantAdded:Connect(addPart)
    local step = RunService.Stepped:Connect(function()
        if released or player.Character ~= character or not character.Parent then return end
        for _, obj in ipairs(parts) do
            if obj.Parent and obj.CanCollide then obj.CanCollide = false end
        end
        local state = floorState
        if state and state.foot and state.foot.Parent and not state.foot.CanCollide then
            state.foot.CanCollide = true
        end
    end)
    return function()
        if released then return end
        released = true
        step:Disconnect()
        partAdded:Disconnect()
        for obj, wasCollidable in pairs(original) do
            if obj.Parent then pcall(function() obj.CanCollide = wasCollidable end) end
        end
    end
end

-- An adjustable, map-scale orbit. Alignment target follows straight chord
-- segments; segment duration is based on studs per second, not fixed 0.90s.
stopIdleOrbit = function(returnToSurface)
    local state = orbitState
    if not state then return end
    orbitState = nil
    if state.tween then pcall(function() state.tween:Cancel() end) end
    if state.pin and state.pin.Parent then state.pin:Destroy() end
    if state.attachment and state.attachment.Parent then state.attachment:Destroy() end
    local root, character = state.root, state.character
    if returnToSurface and not floorState and player.Character == character and root.Parent then
        pcall(function()
            root.CFrame = CFrame.new(state.surface) * root.CFrame.Rotation
            root.AssemblyLinearVelocity = Vector3.zero
        end)
    end
    if state.restoreNoclip then state.restoreNoclip() end
end

local function startIdleOrbit(token)
    if orbitState or not orbitEnabled or not underItem or not autoRunning
        or generation ~= token or hopInProgress or sellingNow
        or orbitTools.pickupBusy or os.clock() < orbitTools.orbitPauseUntil then return end
    local root = getRoot()
    local character = player.Character
    if not root or not character then return end
    local floor = floorEnabled and orbitTools.ensureFarmFloor() or nil
    local center, radius
    if floor then
        center, radius = floor.center, floor.radius
    else
        local x, z, halfX, halfZ = orbitTools.mapBounds(root)
        center = Vector3.new(x, orbitTools.terrainSurfaceY(root) - 31, z)
        radius = math.clamp(math.min(halfX, halfZ) * 0.83, 115, 950)
    end
    local startPoint = center + Vector3.new(radius, 0, 0)
    local originalPosition = root.Position
    local restoreNoclip = maintainUndergroundNoclip(character)
    local att = Instance.new("Attachment")
    att.Name = "TSFarmOrbitAttachment"
    att.Parent = root
    local pin = Instance.new("AlignPosition")
    pin.Name = "TSFarmOrbitHold"
    pin.Mode = Enum.PositionAlignmentMode.OneAttachment
    pin.Attachment0 = att
    pin.ApplyAtCenterOfMass = true
    pin.MaxForce = 1e8
    pin.MaxVelocity = orbitSpeed + 40
    pin.Responsiveness = 110
    pin.Position = startPoint
    pin.Parent = root
    -- Arrive at orbit level immediately; start movement on the support plane.
    pcall(function()
        root.CFrame = CFrame.new(startPoint) * root.CFrame.Rotation
        root.AssemblyLinearVelocity = Vector3.zero
    end)
    local state = {character = character, root = root, center = center,
        surface = floorState and floorState.savedCFrame.Position or originalPosition,
        restoreNoclip = restoreNoclip, attachment = att, pin = pin, tween = nil}
    orbitState = state
    task.spawn(function()
        local segments = 96
        local current = startPoint
        while orbitState == state and alive and autoRunning and generation == token
            and root.Parent and player.Character == character do
            for i = 1, segments do
                if orbitState ~= state or not alive or not autoRunning or generation ~= token then break end
                local angle = i * math.pi * 2 / segments
                local target = center + Vector3.new(math.cos(angle) * radius, 0,
                    math.sin(angle) * radius)
                local distance = (target - current).Magnitude
                local duration = math.clamp(distance / orbitSpeed, 0.08, 3)
                local tween = TweenService:Create(pin,
                    TweenInfo.new(duration, Enum.EasingStyle.Linear), {Position = target})
                state.tween = tween
                tween:Play()
                tween.Completed:Wait()
                current = target
            end
        end
        if orbitState == state then stopIdleOrbit(false) end
    end)
end

-- Same YBA TP Filter that TrueSight uses for Preferred Spawn.
-- Reuses an existing hook instead of stacking another one.
local function enableTrueSightTeleport()
    if not filterState then
        if type(env) ~= "table" then return false, "Executor environment unavailable" end
        local key = "__TrueSightYBAReturnerFilterV1"
        local existing = rawget(env, key)
        if type(existing) == "table" and existing.signature == "TrueSightYBAReturnerFilterV1" then
            filterState = existing
        else
            filterState = {
                signature = "TrueSightYBAReturnerFilterV1",
                installed = false, enabled = false, intercepted = 0, previous = nil
            }
            rawset(env, key, filterState)
        end
    end
    if not filterUsedByTest then
        filterBeforeTest = filterState.enabled == true
        filterUsedByTest = true
    end
    if filterState.installed then
        if type(filterState.previous) ~= "function" then
            return false, "Previous hook missing"
        end
        filterState.enabled = true
        return true
    end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function"
        or type(checkcaller) ~= "function" then
        return false, "Potassium hook functions unavailable"
    end
    local state = filterState
    local function wrappedNamecall(self, ...)
        if state.enabled then
            local ok, executorCaller = pcall(checkcaller)
            if ok and not executorCaller then
                local methodOK, method = pcall(getnamecallmethod)
                if methodOK and (method == "InvokeServer" or method == "FireServer") then
                    if select(1, ...) == "idklolbrah2de" and tostring(self) == "Returner" then
                        state.intercepted = (state.intercepted or 0) + 1
                        return "  ___XP DE KEY"
                    end
                end
            end
        end
        return state.previous(self, ...)
    end
    local callback = wrappedNamecall
    if type(newcclosure) == "function" then
        local ok, converted = pcall(newcclosure, wrappedNamecall)
        if ok and type(converted) == "function" then callback = converted end
    end
    local ok, previous = pcall(hookmetamethod, game, "__namecall", callback)
    if not ok or type(previous) ~= "function" then
        state.enabled = filterBeforeTest == true
        return false, ok and "Couldn't capture original hook" or tostring(previous)
    end
    state.previous = previous
    state.installed = true
    state.enabled = true
    return true
end


-- Keep just our own character underground for the duration of one pickup.
local function holdBelowItem(character, root, part, destination)
    restoreUnderground()
    if floorEnabled then
        orbitTools.ensureFarmFloor()
        orbitTools.placePickupFloor(destination)
    end
    local restoreNoclip = maintainUndergroundNoclip(character)
    local att = Instance.new("Attachment")
    att.Name = "TSFarmHoldAttachment"
    att.Parent = root
    local pin = Instance.new("AlignPosition")
    pin.Name = "TSFarmUndergroundHold"
    pin.Mode = Enum.PositionAlignmentMode.OneAttachment
    pin.Attachment0 = att
    pin.ApplyAtCenterOfMass = true
    pin.MaxForce = 1e8
    pin.MaxVelocity = 200
    pin.Responsiveness = 135
    pin.Position = destination
    pin.Parent = root

    -- Track the current hold target; optional position bob changes this target.
    local active = true
    local holdTarget = destination
    local lastCorrection = 0
    local heartbeat = RunService.Stepped:Connect(function()
        if not alive or not root.Parent or player.Character ~= character then return end
        if (root.Position - holdTarget).Magnitude > 1.8 and os.clock() - lastCorrection >= 0.18 then
            lastCorrection = os.clock()
            pcall(function()
                root.CFrame = CFrame.new(holdTarget) * root.CFrame.Rotation
                root.AssemblyLinearVelocity = Vector3.zero
            end)
        end
    end)
    undergroundRelease = function()
        active = false
        heartbeat:Disconnect()
        if pin.Parent then pin:Destroy() end
        if att.Parent then att:Destroy() end
        -- Surface before restoring collisions, so Stop cannot strand us.
        if not floorState and player.Character == character and root.Parent
            and (root.Position - holdTarget).Magnitude < 12 then
            pcall(function()
                root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3.2, 0)) * root.CFrame.Rotation
                root.AssemblyLinearVelocity = Vector3.zero
            end)
        end
        restoreNoclip()
    end
    -- A local movement target is not evidence of server-side position acceptance.
    return function(nextPosition)
        if not active or not root.Parent or not pin.Parent then return false end
        holdTarget = nextPosition
        pin.Position = nextPosition
        if floorEnabled then orbitTools.placePickupFloor(nextPosition) end
        return true
    end
end

-- Historic UI factory retained for compatibility; the themed LITE GUI uses
-- its own scoped widgets to avoid adding locals to the main Luau chunk.
local function textObject(parent, class, caption, pos, size, background)
    local object = Instance.new(class)
    object.Name = (class == "TextButton" and "Button" or "Label")
    object.Position = pos
    object.Size = size
    object.BackgroundColor3 = background or Color3.fromRGB(53, 48, 68)
    object.BackgroundTransparency = class == "TextLabel" and 1 or 0
    object.BorderSizePixel = 0
    object.Font = Enum.Font.GothamMedium
    object.Text = caption
    object.TextSize = 13
    object.TextColor3 = Color3.fromRGB(235, 233, 242)
    object.TextWrapped = true
    object.Parent = parent
    if class == "TextButton" then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 7)
        corner.Parent = object
    end
    return object
end

