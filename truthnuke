-- Hide only static map geometry, never items, characters, prompts or VFX.
-- This is local transparency, not deleting the map. Everything is restored on Stop.
local mapHidden = false
local mapGeneration = 0
local mapAddedConnection
local mapOriginal = {}
local terrainVisualOriginal
local terrainVisualChanged = false
-- Treat mesh mountains and map decorations inside folders named Terrain as
-- scenery. Only the actual voxel Terrain INSTANCE gets separate handling.
-- This predicate is shared by map transparency, map bounds and local noclip.
local function mapPart(part)
    if not part:IsA("BasePart") or part:IsA("Terrain") then return false end
    if player.Character and part:IsDescendantOf(player.Character) then return false end
    local parent = part
    local namedScenery = false
    while parent and parent ~= workspace do
        if parent:IsA("Tool") or parent:IsA("Accessory") or parent:IsA("Humanoid") then return false end
        if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then return false end
        local name = parent.Name
        if name == "TSFarmLocalSupports" or name == "Living" or name == "IgnoreInstances" or name == "Item_Spawns"
            or name == "ItemSpawns" or name == "Item Spawns"
            or name == "Camera" or name == "Effects"
            or name == "NPCs" or name == "Tool_Replicas" then
            return false
        end
        local lower = name:lower()
        if lower:find("terrain", 1, true) or lower:find("mountain", 1, true)
            or lower:find("hill", 1, true) or lower:find("scenery", 1, true)
            or lower:find("landscape", 1, true) or lower:find("decor", 1, true)
            or lower:find("map", 1, true) then
            namedScenery = true
        end
        parent = parent.Parent
    end
    -- A few decorative meshes in some maps are unanchored. Do not treat all
    -- moving parts as terrain: require a scenery parent/name for those.
    if not part.Anchored and not namedScenery then return false end
    if part:FindFirstChildWhichIsA("ProximityPrompt", true)
        or part:FindFirstChildWhichIsA("ClickDetector", true) then return false end
    return true
end
local function hideMapPart(part)
    if not mapHidden or mapOriginal[part] ~= nil or not mapPart(part) then return end
    local success, original = pcall(function() return part.LocalTransparencyModifier end)
    if not success then return end
    mapOriginal[part] = original
    pcall(function() part.LocalTransparencyModifier = 1 end)
end
local function restoreMap()
    mapGeneration += 1
    mapHidden = false
    if mapAddedConnection then
        mapAddedConnection:Disconnect()
        mapAddedConnection = nil
    end
    for part, original in pairs(mapOriginal) do
        if part.Parent then
            pcall(function() part.LocalTransparencyModifier = original end)
        end
        mapOriginal[part] = nil
    end
    if terrainVisualChanged then
        pcall(function() workspace.Terrain.LocalTransparencyModifier = terrainVisualOriginal end)
        terrainVisualChanged = false
        terrainVisualOriginal = nil
    end
end
local function hideMapForFarm()
    if mapHidden then return end
    mapGeneration += 1
    local thisGeneration = mapGeneration
    mapHidden = true
    -- Terrain is a separate BasePart subclass. Try the reversible visual
    -- modifier, but do not clear terrain voxels or assume it hides smooth land.
    pcall(function()
        local t = workspace.Terrain
        terrainVisualOriginal = t.LocalTransparencyModifier
        t.LocalTransparencyModifier = 1
        terrainVisualChanged = true
    end)
    mapAddedConnection = workspace.DescendantAdded:Connect(hideMapPart)
    task.spawn(function()
        -- Spread the one-time map pass across frames to avoid a big FPS spike.
        local all = workspace:GetDescendants()
        for i, instance in ipairs(all) do
            if not alive or not mapHidden or mapGeneration ~= thisGeneration then return end
            if instance:IsA("BasePart") then hideMapPart(instance) end
            if i % 250 == 0 then task.wait() end
        end
    end)
end

local function cleanup()
    if not alive then return end
    alive = false
    if orbitTools.session.farmStart then
        orbitTools.session.elapsed += math.max(0,os.clock()-orbitTools.session.farmStart)
        orbitTools.session.farmStart=nil
    end
    autoRunning = false
    hopInProgress = false
    generation += 1
    stopHoldingE()
    if stopIdleOrbit then stopIdleOrbit(true) end
    restoreUnderground()
    if teardownFarmFloor then teardownFarmFloor(true) end
    restoreMap()
    if itemAddedConn then itemAddedConn:Disconnect(); itemAddedConn = nil end
    if itemRemovedConn then itemRemovedConn:Disconnect(); itemRemovedConn = nil end
    if orbitTools.folderAddedConn then orbitTools.folderAddedConn:Disconnect(); orbitTools.folderAddedConn = nil end
    if orbitTools.folderRemovedConn then orbitTools.folderRemovedConn:Disconnect(); orbitTools.folderRemovedConn = nil end
    -- Restore the filter's previous enabled state, if this test changed it.
    if filterUsedByTest and filterState and filterBeforeTest ~= nil then
        filterState.enabled = filterBeforeTest
    end
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    -- Restore original RemoteFunction handlers only when our wrapper is still
    -- installed. Never overwrite another script's newer callback.
    for remote,wrapped in pairs(orbitTools.spawnWrappedCallbacks) do
        pcall(function()
            if remote.Parent and remote.OnClientInvoke == wrapped.wrapper then
                remote.OnClientInvoke = wrapped.original
            end
        end)
    end
    destroyMark()
    if orbitTools.view and orbitTools.view.hudGui then
        pcall(function() orbitTools.view.hudGui:Destroy() end)
        orbitTools.view.hudGui = nil
    end
    if ui then ui:Destroy(); ui = nil end
    if env.__TS_FarmTestCleanup == cleanup then
        env.__TS_FarmTestCleanup = nil
    end
end
env.__TS_FarmTestCleanup = cleanup

