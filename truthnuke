-- Direct Prompt-only item engine. This matches the working v22 interaction mode.
-- A prompt is accepted only if enabled and attached to a live world item.
function orbitTools.pickInteraction(entry)
    local prompt = entry.prompt
    local api = (type(env) == "table" and rawget(env, "fireproximityprompt")) or fireproximityprompt
    if not prompt or not prompt:IsDescendantOf(workspace)
        or not prompt.Enabled or prompt.MaxActivationDistance <= 0 then
        return nil, "No enabled, usable ProximityPrompt on this item"
    end
    if type(api) ~= "function" then
        return nil, "Executor does not expose fireproximityprompt"
    end
    return "Direct", prompt, api
end

function orbitTools.saveFarmLog()
    if type(writefile) ~= "function" then return end
    pcall(writefile, "Truefarm_LITE_v14_Log.txt", table.concat(logs, "\n"))
end

-- Inventory must increase to count a confirmed acquisition. World-model removal
-- by itself is not proof: it may be a despawn or another player's interaction.
function orbitTools.waitForPickupResult(entry, beforeCounts, token)
    local name = capName(entry.name)
    local deadline = os.clock() + math.max(1.6, timing().confirm + 1.1)
    local disappeared = false
    while stillRunning(token) and os.clock() < deadline do
        if not entry.item:IsDescendantOf(workspace) then disappeared = true end
        local counts = updateInventory(true)
        -- Prefer the identified item; fall back to any actual Tool increase if
        -- the world item's name was still replicating or did not match.
        if name ~= orbitTools.UNKNOWN_LABEL and (counts[name] or 0) > (beforeCounts[name] or 0) then
            local delta = counts[name] - (beforeCounts[name] or 0)
            return true, "Inventory +" .. tostring(delta), name, delta
        end
        for toolName, quantity in pairs(counts) do
            if quantity > (beforeCounts[toolName] or 0) then
                local delta = quantity - (beforeCounts[toolName] or 0)
                return true, "Inventory +" .. tostring(delta), toolName, delta
            end
        end
        task.wait(0.06)
    end
    return false, disappeared and "Disappeared without inventory confirmation" or "No inventory increase"
end

local function doPickup(entry, token)
    if not stillRunning(token) then return false end
    local character = player.Character
    local root = getRoot()
    if not character or not root or not entry.item.Parent or not entry.part.Parent then
        return false, "Character/item unavailable"
    end
    local method, prompt, api = orbitTools.pickInteraction(entry)
    if not method then
        return false, tostring(prompt)
    end
    local interactionPart = prompt.Parent
    if interactionPart and interactionPart:IsA("Attachment") then
        interactionPart = interactionPart.Parent
    end
    if not (interactionPart and interactionPart:IsA("BasePart")) then
        interactionPart = entry.part
    end
    if not interactionPart or not interactionPart:IsDescendantOf(workspace) then
        return false, "Prompt host part missing"
    end
    local allowed, reason = enableTrueSightTeleport()
    if not allowed then
        log("Teleport filter error: " .. tostring(reason))
        return false, "Teleport unavailable: " .. tostring(reason)
    end
    if orbitTools.setActivity then orbitTools.setActivity("Travelling · " .. entry.name) end
    local fromDist = (root.Position-interactionPart.Position).Magnitude
    -- Never enlarge an interaction's true radius locally.
    local range = prompt.MaxActivationDistance
    local depth = math.clamp(math.max(2.5,range - 0.8), 2.5, 5.4) -- lower, still inside observed prompt radius
    local destination = interactionPart.Position + Vector3.new(0, underItem and -depth or 3, 0)
    local moveHoldTarget
    if underItem then
        moveHoldTarget = holdBelowItem(character, root, interactionPart, destination)
    end
    local ok, err = pcall(function()
        root.CFrame = CFrame.new(destination) * root.CFrame.Rotation
        root.AssemblyLinearVelocity = Vector3.zero
    end)
    if not ok then return false, "Teleport error: " .. tostring(err) end
    log(string.format("Teleport to %s, %.0f studs (%s)", entry.name, fromDist, method))
    -- Approach speed: reduce the wait BEFORE attempting a pickup only.
    -- Preserve a modest ping-aware floor rather than firing instantly after teleport.
    local approachDelay = math.max(orbitTools.approachWait, timing().settle * 0.55)
    if not pause(approachDelay, token) then return false end
    if player.Character ~= character or not entry.item.Parent or not prompt.Parent then
        return false, "Target changed during teleport"
    end
    if positionBobEnabled and underItem then
        if not bobAndSettle(root, entry, destination, moveHoldTarget, token) then
            return false, "Position settling failed"
        end
    end
    local distance = (root.Position-interactionPart.Position).Magnitude
    if range > 0 and distance > range + 0.3 then
        return false, string.format("Prompt range %.1f > %.1f; local teleport did not hold", distance, range)
    end
    local before = updateInventory(true)
    if entry.name ~= orbitTools.UNKNOWN_LABEL and atItemCap(entry.name) then
        return false, "Stack is full: " .. entry.name
    end
    if orbitTools.setActivity then orbitTools.setActivity("Collecting · " .. entry.name) end
    pickupAttempts += 1
    updateStats()
    -- Same signature as the working TrueSight v22 Direct Prompt mode.
    local fired, promptErr = pcall(api, prompt, prompt.HoldDuration)
    if not fired then return false, "Direct prompt activation failed: " .. tostring(promptErr) end
    log(string.format("Direct prompt attempted on %s (original hold %.2fs)",
        entry.name, prompt.HoldDuration))
    local acquired, result, actualName, actualQuantity = orbitTools.waitForPickupResult(entry, before, token)
    if acquired then
        confirmedPickups += 1
        sessionPickups += 1
        local name = capName(actualName or entry.name)
        local quantity = actualQuantity or 1
        orbitTools.session.collected[name] = (orbitTools.session.collected[name] or 0) + quantity
        if orbitTools.rememberItemIcon then orbitTools.rememberItemIcon(name) end
        orbitTools.hudDirty = true
        if orbitTools.setActivity then orbitTools.setActivity("Collected · " .. name) end
        log("CONFIRMED " .. entry.name .. ": " .. result)
    else
        log("UNCONFIRMED " .. entry.name .. ": " .. result)
    end
    updateStats()
    orbitTools.saveFarmLog()
    return acquired, result
end

-- AUTO HOP: go when there are no eligible pickups, not only when the map is empty.
-- A server can contain capped, cooled-down, disabled or unstreamed item shells.
-- Those should not permanently prevent an otherwise idle farm from hopping.
function orbitTools.requestServerPage(url)
    local call = (type(env)=="table" and (rawget(env,"request") or rawget(env,"http_request")
        or rawget(env,"httprequest")))
        or (type(request)=="function" and request)
        or (type(http_request)=="function" and http_request)
    if type(call)~="function" and type(syn)=="table" then call=syn.request end
    if type(call)~="function" and type(http)=="table" then call=http.request end
    local why="No compatible HTTP request API"
    if type(call)=="function" then
        local ok,response=pcall(call,{Url=url,Method="GET",Headers={Accept="application/json"}})
        if ok and type(response)=="table" then
            local status=tonumber(response.StatusCode or response.statusCode or response.Status or response.status)
            local body=response.Body or response.body
            if (not status or status>=200 and status<300) and type(body)=="string" and #body>0 then
                return body,nil
            end
            why="server-list HTTP "..tostring(status or "unknown").." ("..tostring(type(body)).." body)"
        elseif ok and type(response)=="string" and #response>0 then
            return response,nil
        else
            why="HTTP request failed: "..tostring(response)
        end
    end
    local ok,body=pcall(function() return game:HttpGet(url) end)
    if ok and type(body)=="string" and #body>0 then return body,nil end
    return nil,why.."; HttpGet: "..tostring(body)
end

local function listPublicServers()
    local cursor=nil
    local candidates={}
    local checked=0
    local failure=nil
    for page=1,3 do
        local url=string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true", game.PlaceId)
        if cursor then url=url.."&cursor="..HttpService:UrlEncode(cursor) end
        local body,reason=orbitTools.requestServerPage(url)
        if not body then failure=reason;break end
        local ok,data=pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or type(data)~="table" or type(data.data)~="table" then
            failure="invalid server list JSON";break
        end
        for _,server in ipairs(data.data) do
            checked+=1
            if type(server.id)=="string" and server.id~=game.JobId
                and not hopVisited[server.id]
                and type(server.playing)=="number" and type(server.maxPlayers)=="number"
                and server.playing < server.maxPlayers then
                candidates[#candidates+1]=server.id
            end
        end
        cursor=type(data.nextPageCursor)=="string" and data.nextPageCursor~="" and data.nextPageCursor or nil
        if #candidates>=8 or not cursor then break end
    end
    if #candidates>0 then
        return candidates[math.random(1,#candidates)],nil,checked
    end
    return nil,failure or ("No unvisited public server found (checked "..checked..")"),checked
end

local function queueResume()
    local queue=(type(env)=="table" and (rawget(env,"queue_on_teleport") or rawget(env,"queueonteleport")))
        or (type(queue_on_teleport)=="function" and queue_on_teleport)
        or (type(queueonteleport)=="function" and queueonteleport)
    if type(queue)~="function" then return false,"No executor queue_on_teleport API" end
    local exists=(type(env)=="table" and rawget(env,"isfile")) or isfile
    if type(exists)~="function" then return false,"No executor isfile API" end
    local okFound,found=pcall(exists,HOP_FILE)
    if not okFound or not found then
        return false,"Save "..HOP_FILE.." in your executor workspace for auto-resume"
    end
    local queued=string.format(
        "while not game:IsLoaded() or not game:GetService('Players').LocalPlayer do task.wait(0.12) end; task.wait(0.4); if type(isfile)=='function' and isfile(%q) then local ok,src=pcall(readfile,%q); if ok and type(src)=='string' then local f=loadstring(src); if f then f() end end end",
        HOP_FILE,HOP_FILE)
    local ok,result=pcall(queue,queued)
    return ok,ok and nil or tostring(result)
end

local function attemptHop(token)
    if not stillRunning(token) or hopInProgress or not autoHop then return end
    -- The configured hop delay controls idle time, not a retry flood after HTTP errors.
    if os.clock()-hopLastTry < math.max(5,math.min(15,hopAfterSeconds)) then return end
    hopLastTry=os.clock()
    log(string.format("Auto Hop: %ds without eligible pickups; searching for a destination (world=%d, ready=%d, hints=%d)",
        hopAfterSeconds,orbitTools.scanStats.raw or 0,orbitTools.scanStats.available or 0,#orbitTools.spawnLeads))
    if orbitTools.setActivity then orbitTools.setActivity("Server hopping · finding destination") end
    local serverId,reason,checked=listPublicServers()
    if not stillRunning(token) or not autoHop then return end
    -- The public server API is sometimes unavailable to the executor. When that
    -- happens a regular same-place teleport requests fresh matchmaking, but
    -- Roblox can assign the player to the same instance; don't claim otherwise.
    if not serverId then
        log("Auto Hop: "..tostring(reason).."; trying Roblox matchmaking fallback")
    else
        log("Auto Hop: selected an unvisited public server (checked "..tostring(checked)..")")
    end
    hopInProgress=true
    if orbitTools.setActivity then orbitTools.setActivity("Server hopping · connecting") end
    if orbitTools.webhook then orbitTools.webhook("Server hop","Leaving server; session continues.") end
    stopIdleOrbit(true)
    stopHoldingE()
    restoreUnderground()
    if teardownFarmFloor then teardownFarmFloor(true) end
    destroyMark()
    local visited={game.JobId}
    if serverId then visited[#visited+1]=serverId end
    for id in pairs(hopVisited) do
        if #visited>=15 then break end
        visited[#visited+1]=id
    end
    local queued,queueReason=queueResume()
    if not queued then
        log("Auto Hop: script will not restart automatically: "..tostring(queueReason))
    end
    pcall(function()
        TeleportService:SetTeleportSetting("TruefarmLITEResumeV11",{
            resume=true,autoHop=autoHop,underItem=underItem,
            positionBobEnabled=positionBobEnabled,orbitEnabled=orbitEnabled,
            floorEnabled=floorEnabled,orbitSpeed=orbitSpeed,
            approachWait=orbitTools.approachWait,itemScanInterval=orbitTools.ITEM_SCAN_INTERVAL,
            modeName=modeName,visited=visited,autoSell=autoSell,
            hopAfterSeconds=hopAfterSeconds,
            autoTurnCandy=orbitTools.AUTO_TURN_CANDY,
            autoBuyLucky=orbitTools.AUTO_BUY_LUCKY,
            candyThreshold=orbitTools.CANDY_THRESHOLD,
            interItemDelay=interItemDelay,
            legacySellEnabled=orbitTools.legacySellEnabled,
            autoRejoin=orbitTools.AUTO_REJOIN,
            hudVisible=orbitTools.HUD_VISIBLE,hudX=orbitTools.hudX,hudY=orbitTools.hudY,
            webhookEnabled=orbitTools.WEBHOOK_ON,webhookUrl=orbitTools.WEBHOOK_URL,
            webhookInterval=orbitTools.WEBHOOK_INTERVAL,
            session=orbitTools.sessionSnapshot and orbitTools.sessionSnapshot(true) or nil,
        })
    end)
    if orbitTools.prepareTeleportHUD then orbitTools.prepareTeleportHUD() end
    local ok,errTeleport=pcall(function()
        if serverId then
            TeleportService:TeleportToPlaceInstance(game.PlaceId,serverId,player)
        else
            TeleportService:Teleport(game.PlaceId,player)
        end
    end)
    if not ok then
        hopInProgress=false
        pcall(function() TeleportService:SetTeleportSetting("TruefarmLITEResumeV11",nil) end)
        if orbitTools.clearTeleportHUD then orbitTools.clearTeleportHUD() end
        if orbitTools.setActivity then orbitTools.setActivity("Searching · hop failed") end
        log("Auto Hop teleport failed: "..tostring(errTeleport))
    else
        -- The request may return without the player leaving. Allow a retry.
        task.delay(12,function()
            if alive and hopInProgress and stillRunning(token) then
                hopInProgress=false
                emptySince=os.clock()-hopAfterSeconds
                if orbitTools.clearTeleportHUD then orbitTools.clearTeleportHUD() end
                if orbitTools.setActivity then orbitTools.setActivity("Searching · teleport stalled") end
                log("Auto Hop: teleport didn't complete in 12s; retrying")
            end
        end)
    end
end

connect(TeleportService.TeleportInitFailed,function(who,result,message)
    if who~=player or not hopInProgress then return end
    hopInProgress=false
    emptySince=os.clock()-hopAfterSeconds
    pcall(function() TeleportService:SetTeleportSetting("TruefarmLITEResumeV11",nil) end)
    if orbitTools.clearTeleportHUD then orbitTools.clearTeleportHUD() end
    if orbitTools.setActivity then orbitTools.setActivity("Searching · hop failed") end
    log("Auto Hop initialization failed: "..tostring(result).." / "..tostring(message))
end)

-- v22 merchant seller (register-safe). Combines the historical NukeVsCity single-request
-- fallback with modern YBA dialogue, without changing the tested pickup engine.
-- Every path requires an actual inventory reduction before reporting a sale.
-- Older EndDialogue calls may no longer work in current YBA.
orbitTools.manualSellRequest = false
orbitTools.legacySellEnabled = false -- Outdated NukeVsCity request: opt-in only.
orbitTools.SELL_FAILURE_BACKOFF = 120

function orbitTools.sellVisibleButton(button)
    if not button.Parent or not button.Visible then return false end
    local ancestor = button.Parent
    while ancestor and ancestor ~= player.PlayerGui do
        if ancestor:IsA("GuiObject") and not ancestor.Visible then return false end
        if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return false end
        ancestor = ancestor.Parent
    end
    return ancestor == player.PlayerGui
end

function orbitTools.sellerGui()
    local pg = player:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    local gui = pg:FindFirstChild("DialogueGui")
    if gui then return gui end
    for _, child in ipairs(pg:GetChildren()) do
        if child.Name:lower():find("dialog", 1, true) then return child end
    end
    return nil
end

function orbitTools.buttonText(btn)
    local text = (btn:IsA("TextButton") and tostring(btn.Text or "")) or ""
    if text ~= "" then return text end
    for _, child in ipairs(btn:GetDescendants()) do
        if child:IsA("TextLabel") and child.Text ~= "" then return child.Text end
    end
    return text
end

function orbitTools.sellDialogueButtons()
    local gui = orbitTools.sellerGui()
    if not gui then return {} end
    local buttons = {}
    for _, obj in ipairs(gui:GetDescendants()) do
        -- YBA dialogue may use ImageButtons, not only TextButtons.
        if obj:IsA("GuiButton") and orbitTools.sellVisibleButton(obj) then
            local text = orbitTools.buttonText(obj)
            local name = obj.Name:lower()
            if name:find("option", 1, true) or text ~= "" then
                buttons[#buttons + 1] = {button=obj, text=text:lower(), name=name}
            end
        end
    end
    return buttons
end

function orbitTools.sellButtonSignature(buttons)
    local names = {}
    for _, entry in ipairs(buttons) do
        names[#names + 1] = entry.name .. ":" .. entry.text
    end
    table.sort(names)
    return table.concat(names, "|")
end

function orbitTools.triggerSellButton(button, token)
    if not stillRunning(token) or not button or not button.Parent then return false, "Button missing" end
    -- Directly firing a registered GUI callback avoids unreliable mouse coordinates.
    local signal = button.MouseButton1Click
    local fire = (type(env) == "table" and rawget(env, "firesignal")) or firesignal
    if type(fire) == "function" then
        local ok = pcall(fire, signal)
        if ok then return true, "firesignal" end
    end
    local gc = (type(env) == "table" and rawget(env, "getconnections")) or getconnections
    if type(gc) == "function" then
        local ok, items = pcall(gc, signal)
        if ok and type(items) == "table" then
            local fired = false
            for _, conn in ipairs(items) do
                local fn
                pcall(function()
                    if conn.Enabled ~= false and type(conn.Function) == "function" then fn = conn.Function end
                end)
                if fn and pcall(fn) then fired = true end
            end
            if fired then return true, "getconnections" end
        end
    end
    local ok, vim = pcall(game.GetService, game, "VirtualInputManager")
    if not ok or not vim then return false, "No GUI click API" end
    local position = button.AbsolutePosition + button.AbsoluteSize / 2
    local clicked = pcall(function()
        vim:SendMouseButtonEvent(position.X, position.Y, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(position.X, position.Y, 0, false, game, 0)
    end)
    return clicked, clicked and "mouse" or "VIM click failed"
end

function orbitTools.sellerChooseOption(buttons, step)
    local chosen, best = nil, -999
    for _, entry in ipairs(buttons) do
        local t, n = entry.text, entry.name
        local score = -200
        if t:find("leave",1,true) or t:find("cancel",1,true) or
           t:find("buy",1,true) or t:find("decline",1,true) or
           t:find("nevermind",1,true) or t:find("no thanks",1,true) then
            score = -900
        elseif t:find("sell all",1,true) or t:find("sell everything",1,true) then
            score = 250
        elseif t:find("all",1,true) or t:find("everything",1,true) then
            score = 190
        elseif t:find("sell",1,true) then
            score = 150
        elseif t:find("confirm",1,true) or t:find("deal",1,true) or t == "yes" then
            score = 130
        elseif step == 1 and (t:find("talk",1,true) or t:find("continue",1,true)) then
            score = 90
        end
        -- Modern YBA dialogue uses Option1 -> Option1 -> Option6. Only use
        -- namings when the button text provides no safer intent signal.
        if n == (step >= 3 and "option6" or "option1") and score < 0 then
            score = 55
        end
        if score > best then best, chosen = score, entry end
    end
    return best >= 0 and chosen or nil
end

function orbitTools.sellerCloseDialogue(token)
    for _, entry in ipairs(orbitTools.sellDialogueButtons()) do
        if entry.text:find("leave",1,true) or entry.text:find("cancel",1,true) or
           entry.text:find("goodbye",1,true) then
            orbitTools.triggerSellButton(entry.button, token)
            break
        end
    end
end

function orbitTools.sellerMerchantPrompt()
    -- Contemporary YBA appears to store Merchant's dialogue prompt under
    -- ReplicatedStorage.Dialogue.Merchant on some versions.
    local dialogue = ReplicatedStorage:FindFirstChild("Dialogue")
    if dialogue then
        local merchant = dialogue:FindFirstChild("Merchant", true)
        if merchant then
            local prompt = merchant:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then return prompt, "ReplicatedStorage.Dialogue" end
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local labels = tostring(obj.ObjectText or "") .. " " .. tostring(obj.ActionText or "")
            local p, depth = obj.Parent, 0
            while p and p ~= workspace and depth < 7 do
                labels ..= " " .. p.Name
                p, depth = p.Parent, depth + 1
            end
            labels = labels:lower()
            if labels:find("merchant",1,true) or labels:find("shiftplox",1,true) then
                return obj, "Workspace"
            end
        end
    end
    return nil, "not found"
end

function orbitTools.sellerInventory(name)
    return updateInventory(true)[capName(name)] or 0
end

function orbitTools.sellerWaitForInventoryDrop(name, before, seconds, token)
    local deadline = os.clock() + seconds
    while stillRunning(token) and os.clock() < deadline do
        if orbitTools.sellerInventory(name) < before then return true end
        task.wait(0.09)
    end
    return orbitTools.sellerInventory(name) < before
end

function orbitTools.sellerEquip(name, token)
    local char = player.Character
    local human = char and char:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not char or not human then return false, "No humanoid" end
    local item = (backpack and backpack:FindFirstChild(name)) or char:FindFirstChild(name)
    if not item or not item:IsA("Tool") then return false, "No tool: " .. name end
    if item.Parent ~= char then
        local ok = pcall(function() human:EquipTool(item) end)
        if not ok then return false, "Equip rejected" end
    end
    local deadline = os.clock() + 0.8
    while stillRunning(token) and item.Parent ~= char and os.clock() < deadline do
        task.wait(0.04)
    end
    if item.Parent ~= char then return false, "Tool not equipped" end
    return true
end

function orbitTools.sellerLegacyRemote(name, before, token)
    local char = player.Character
    local remote = char and char:FindFirstChild("RemoteEvent")
    if not remote or not remote:IsA("RemoteEvent") then return false, "Legacy RemoteEvent missing" end
    -- Historical NukeVsCity: EndDialogue Merchant / Dialogue5 / Option1.
    -- ONE attempt, then only continue if the inventory does not change.
    local ok, err = pcall(function()
        remote:FireServer("EndDialogue", {NPC="Merchant", Dialogue="Dialogue5", Option="Option1"})
    end)
    if not ok then return false, "Legacy request failed: " .. tostring(err) end
    if orbitTools.sellerWaitForInventoryDrop(name, before, 0.75, token) then return true, "Legacy Merchant confirmed" end
    return false, "Legacy route made no inventory change"
end

function orbitTools.sellerOpenPrompt(prompt, location, token)
    if not prompt or not prompt.Parent then return false, "Merchant prompt missing" end
    local api = (type(env) == "table" and rawget(env, "fireproximityprompt")) or fireproximityprompt
    if type(api) == "function" then
        local ok, err = pcall(api, prompt)
        if ok then return true, "Direct prompt from " .. location end
        log("Merchant direct prompt failed: " .. tostring(err))
    end
    if not prompt:IsDescendantOf(workspace) then
        return false, "Merchant prompt stored outside Workspace; requires fireproximityprompt"
    end
    local part = prompt:FindFirstAncestorWhichIsA("BasePart")
    if not part then return false, "Merchant prompt has no physical part" end
    local root = getRoot()
    if not root then return false, "Character unavailable" end
    local filterOK, reason = enableTrueSightTeleport()
    if not filterOK then return false, "TP unavailable: " .. tostring(reason) end
    stopHoldingE()
    restoreUnderground()
    teardownFarmFloor(true)
    local destination = part.Position + Vector3.new(0, 2.5, 0)
    local moved = pcall(function()
        root.CFrame = CFrame.new(destination) * root.CFrame.Rotation
        root.AssemblyLinearVelocity = Vector3.zero
    end)
    if not moved or not pause(0.35, token) then return false, "Merchant movement failed" end
    if (root.Position-part.Position).Magnitude > prompt.MaxActivationDistance + 0.3 then
        return false, "Merchant out of range"
    end
    if prompt.KeyboardKeyCode ~= Enum.KeyCode.E then return false, "Merchant key isn't E" end
    local press, release = getInput()
    if not press or not release then return false, "E input unavailable" end
    releaseE = release
    local okPress = pcall(press)
    if not okPress then stopHoldingE(); return false, "E press failed" end
    pause(math.max(0.22, prompt.HoldDuration + 0.12), token)
    stopHoldingE()
    return stillRunning(token), "Normal E prompt"
end

function orbitTools.sellerDriveModernDialogue(name, before, token)
    local prevSignature = ""
    local sameStage = 0
    for step = 1, 7 do
        if orbitTools.sellerInventory(name) < before then return true, "Modern dialogue confirmed" end
        local buttons, sig
        local deadline = os.clock() + (step == 1 and 2.8 or 2.0)
        while stillRunning(token) and os.clock() < deadline do
            buttons = orbitTools.sellDialogueButtons()
            sig = orbitTools.sellButtonSignature(buttons)
            if #buttons > 0 and (sig ~= prevSignature or step == 1) then break end
            if orbitTools.sellerInventory(name) < before then return true, "Inventory changed during dialogue" end
            task.wait(0.07)
        end
        if not buttons or #buttons == 0 then return false, "Dialogue buttons not visible at step " .. step end
        if sig == prevSignature then
            sameStage += 1
            if sameStage >= 2 then return false, "Dialogue did not advance at step " .. step end
        else
            sameStage = 0
        end
        local chosen = orbitTools.sellerChooseOption(buttons, step)
        if not chosen then
            local names = {}
            for i, entry in ipairs(buttons) do
                if i > 7 then break end
                names[#names + 1] = entry.name .. ":" .. entry.text
            end
            return false, "Unknown dialogue choices: " .. table.concat(names, " | ")
        end
        log(string.format("Merchant step %d: %s (%s)", step, chosen.name, chosen.text))
        prevSignature = sig
        local ok, method = orbitTools.triggerSellButton(chosen.button, token)
        if not ok then return false, "Dialogue click failed: " .. tostring(method) end
        if not pause(0.20, token) then return false, "Sale cancelled" end
        if orbitTools.sellerInventory(name) < before then return true, "Modern Merchant confirmed" end
    end
    return false, "Modern dialogue made no inventory change"
end

function orbitTools.saleCandidate()
    if sellingNow then return nil end
    local inventory = updateInventory(true) -- always inspect current backpack+equipped Tools
    local bestName, bestCount, bestCap, bestFraction = nil, 0, 0, -1
    local fullStacks = {}
    for name in pairs(orbitTools.AUTO_SELLABLE) do
        local count = inventory[name] or 0
        local limit = itemCap(name)
        if limit and count > 0 then
            local fraction = count / limit
            if fraction > bestFraction then
                bestName, bestCount, bestCap, bestFraction = name, count, limit, fraction
            end
            if count >= limit and os.clock() >= (sellCooldowns[name] or 0) then
                fullStacks[#fullStacks + 1] = name
            end
        end
    end
    table.sort(fullStacks)
    if bestName then
        orbitTools.lastFullStackStatus = string.format("Closest stack: %s  %d/%d%s | 2x=%s",
            bestName, bestCount, bestCap, bestCount >= bestCap and " FULL" or "",
            capCheckFinished and tostring(capMultiplier) or "checking")
    else
        orbitTools.lastFullStackStatus = "No common sellable stacks found"
    end
    if uiRefs.sellStatus and autoSell and not sellingNow then
        uiRefs.sellStatus.Text = orbitTools.lastFullStackStatus ..
            (capCheckFinished and ("\nReady to sell: " .. tostring(#fullStacks)) or "\nChecking Inventory gamepass...")
    end
    if orbitTools.manualSellRequest then
        orbitTools.manualSellRequest = false
        -- Manual selling intentionally does not require a full stack.
        local chosen, highest = nil, -1
        for name in pairs(orbitTools.AUTO_SELLABLE) do
            local count = inventory[name] or 0
            if count > highest then highest, chosen = count, name end
        end
        if chosen and highest > 0 then return chosen, true end
        log("Sell now: no sellable items in inventory")
    end
    if not autoSell or not capCheckFinished then return nil end
    return fullStacks[1], false
end

function orbitTools.sellCappedItem(name, token, manual)
    if not stillRunning(token) or (not manual and not autoSell) then return false end
    sellingNow = true
    if orbitTools.setActivity then orbitTools.setActivity("Selling · " .. name) end
    sellCooldowns[name] = os.clock() + orbitTools.SELL_FAILURE_BACKOFF
    local function finish(ok, message)
        if stillRunning(token) then orbitTools.sellerCloseDialogue(token) end
        -- Restore the user's ordinary inventory state before normal farming resumes.
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then pcall(function() humanoid:UnequipTools() end) end
        stopHoldingE()
        sellingNow = false
        lastSellError = message or ""
        if uiRefs.sellStatus then uiRefs.sellStatus.Text = message or "" end
        if message then log(message) end
        updateInventory(true)
        if ok then
            if orbitTools.webhook then orbitTools.webhook("Sale confirmed", tostring(message)) end
            if orbitTools.setActivity then orbitTools.setActivity("Sale complete · " .. name) end
            sellCooldowns[name] = os.clock() + 2
            -- Seller confirmed an inventory reduction. Re-evaluate pickup
            -- eligibility and prompt identity on the next pass; keep the
            -- Merchant interaction implementation itself unchanged.
            itemInfoCache = setmetatable({}, {__mode = "k"})
            unresolvedRetryAt = setmetatable({}, {__mode = "k"})
            cachedReplicas = nil
            orbitTools.lastEmptyRefreshAt = -math.huge
        end
        return ok
    end
    local before = orbitTools.sellerInventory(name)
    if before == 0 then return finish(false, "Sell skipped: missing " .. name) end
    if not manual and not atItemCap(name) then
        return finish(false, "Sell skipped: " .. name .. " isn't at its cap")
    end
    local equipped, reason = orbitTools.sellerEquip(name, token)
    if not equipped then return finish(false, "Sell failed: " .. tostring(reason)) end
    log(string.format("Merchant sale starting: %s x%d (%s)", name, before, manual and "manual" or "capped"))
    -- Prefer the current Merchant dialogue. Older NukeVsCity network requests
    -- are incompatible with some builds and are OFF by default.
    local prompt, location = orbitTools.sellerMerchantPrompt()
    local reason = "Merchant ProximityPrompt not found"
    if prompt then
        log("Merchant prompt discovered in " .. tostring(location))
        local opened, method = orbitTools.sellerOpenPrompt(prompt, location, token)
        if opened then
            log("Merchant opening: " .. tostring(method))
            local success, details = orbitTools.sellerDriveModernDialogue(name, before, token)
            if success or orbitTools.sellerWaitForInventoryDrop(name, before, 0.70, token) then
                return finish(true, "Sold " .. math.max(0,before-orbitTools.sellerInventory(name)) .. "x " .. name .. " via Merchant dialogue")
            end
            reason = "Modern Merchant unconfirmed: " .. tostring(details)
        else
            reason = "Merchant open failed: " .. tostring(method)
        end
    end
    log(reason)
    if orbitTools.legacySellEnabled and stillRunning(token) then
        -- Explicitly enabled historical path; exactly one request per sale.
        local legacyOK, legacyReason = orbitTools.sellerLegacyRemote(name, before, token)
        if legacyOK then
            return finish(true, "Sold " .. math.max(0,before-orbitTools.sellerInventory(name)) .. "x " .. name .. " via legacy Merchant")
        end
        reason ..= "; legacy: " .. tostring(legacyReason)
    end
    return finish(false, "Sale unconfirmed for " .. name .. ": " .. reason)
end

-- =====================
-- Halloween + Lucky shop automation (serialized in farm worker)
-- =====================
function orbitTools.candyTotals()
    local snapshot = updateInventory(true)
    local total = 0
    local isAnyFull = false
    for _, name in ipairs(orbitTools.CANDY_NAMES) do
        local count = snapshot[name] or 0
        total += count
        if count >= (itemCap(name) or 45) then isAnyFull = true end
    end
    return total, isAnyFull
end

function orbitTools.farmMoney()
    local stats = player:FindFirstChild("PlayerStats")
    local money = stats and stats:FindFirstChild("Money")
    if money and (money:IsA("IntValue") or money:IsA("NumberValue")) then
        return tonumber(money.Value)
    end
    return nil
end

-- Halloween trades are driven by the farm worker, never by a competing
-- background teleport loop. A transaction owns movement until restoration.
function orbitTools.updateEventStatus()
    if not uiRefs.eventStatus then return end
    local total = orbitTools.candyTotals()
    local lucky = itemCount("Lucky Arrow")
    local money = orbitTools.farmMoney()
    local state
    if orbitTools.candyRetryBlocked then
        state = "Candy exchange unresolved - auto retry disabled for this session"
    elseif orbitTools.AUTO_TURN_CANDY then
        state = total >= orbitTools.CANDY_THRESHOLD and "Candy threshold met - exchange queued"
            or string.format("Waiting for candy threshold: %d more needed", orbitTools.CANDY_THRESHOLD - total)
    else
        state = "Candy Auto Turn-In OFF"
    end
    uiRefs.eventStatus.Text = string.format(
        "Candy %d / %d | Lucky %d / %s | Money %s\n%s\n%s",
        total, orbitTools.CANDY_THRESHOLD, lucky,
        tostring(itemCap("Lucky Arrow") or "?"),
        money and ("$" .. tostring(math.floor(money))) or "unavailable",
        state, orbitTools.eventLastResult)
end

function orbitTools.eventCandidate()
    if sellingNow or orbitTools.eventBusy then return nil end
    if orbitTools.manualCandyRequest then
        orbitTools.manualCandyRequest = false
        if orbitTools.candyRetryBlocked then
            log("Candy test blocked: an earlier trade outcome is unresolved")
        elseif orbitTools.candyTotals() > 0 then
            return "candy"
        else
            log("Candy test skipped: no event candy in Backpack or equipped Tools")
        end
    end
    if os.clock() < orbitTools.nextEventCheck then return nil end
    orbitTools.nextEventCheck = os.clock() + 1.2
    local total, anyFull = orbitTools.candyTotals()
    if orbitTools.AUTO_TURN_CANDY and not orbitTools.candyRetryBlocked and total > 0
        and (total >= orbitTools.CANDY_THRESHOLD or anyFull) then
        return "candy"
    end
    if orbitTools.AUTO_BUY_LUCKY and not orbitTools.luckyRetryBlocked and capCheckFinished then
        local money = orbitTools.farmMoney()
        if money and money >= orbitTools.LUCKY_PRICE and
            itemCount("Lucky Arrow") < (itemCap("Lucky Arrow") or 10) then
            return "lucky"
        end
    end
    return nil
end

-- YBA's Halloween dialogue puts Option2 under a GuiObject; the clickable
-- descendant may be an ImageButton with no useful Name or direct Text.
-- Verify the exact candy text and the companion Option3 before sending clicks.
function orbitTools.jackDialogueOption()
    local gui = orbitTools.sellerGui()
    if not gui or (gui:IsA("ScreenGui") and not gui.Enabled) then return nil end
    local choice, pointsOption = nil, false
    local seen = {}
    for _, node in ipairs(gui:GetDescendants()) do
        if node:IsA("GuiObject") and (node.Name == "Option2" or node.Name == "Option3")
            and orbitTools.sellVisibleButton(node) then
            local parts = {}
            if node:IsA("TextButton") and node.Text ~= "" then
                parts[#parts + 1] = node.Text
            end
            for _, child in ipairs(node:GetDescendants()) do
                if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.Text ~= "" then
                    parts[#parts + 1] = child.Text
                end
            end
            local label = string.lower(table.concat(parts, " "))
            seen[#seen + 1] = node.Name .. ":" .. label:sub(1, 90)
            if node.Name == "Option2" and label:find("candy", 1, true)
                and label:find("turn", 1, true) then
                local button = node:IsA("GuiButton") and node
                    or node:FindFirstChildWhichIsA("GuiButton", true)
                if button and orbitTools.sellVisibleButton(button) then choice = button end
            end
            if node.Name == "Option3" and label:find("point", 1, true) then
                pointsOption = true
            end
        end
    end
    orbitTools.jackLastOptions = #seen > 0 and table.concat(seen, " | ") or "No visible Option2/Option3"
    -- The exact labelled Option2 is enough; Option3 may render later, or the
    -- client may use a different layout. Never click by index alone.
    return choice
end

-- Several streamed Jack/Halloween prompt replicas can coexist in one server.
-- They are NOT an error: rank verified NPC prompts by usable range, action and
-- distance, then test the actual Jack Option2 before sending any candy choice.
function orbitTools.findJackWorldPrompt()
    local dialogueRoot = workspace:FindFirstChild("Dialogues")
    if not dialogueRoot then
        return nil, "Workspace.Dialogues unavailable (possibly not streamed)", {}
    end
    local candidates = {}
    local root = getRoot()
    for _, child in ipairs(dialogueRoot:GetDescendants()) do
        if child:IsA("ProximityPrompt") and child.Enabled
            and child.MaxActivationDistance > 0 then
            local ancestor, matched = child.Parent, false
            while ancestor and ancestor ~= dialogueRoot do
                local name = ancestor.Name:lower()
                if name == "jack, the cauldron specter" or name == "halloween event" then
                    matched = true
                    break
                end
                ancestor = ancestor.Parent
            end
            if matched then
                local host = child:FindFirstAncestorWhichIsA("BasePart")
                if host and host:IsDescendantOf(workspace) then
                    local text = (tostring(child.ObjectText) .. " " .. tostring(child.ActionText)):lower()
                    local distance = root and (root.Position-host.Position).Magnitude or 0
                    local score = (text:find("jack",1,true) and 50 or 0)
                        + (text:find("talk",1,true) and 25 or 0)
                        + math.min(20,child.MaxActivationDistance)
                        - math.min(50,distance/150)
                    candidates[#candidates+1] = {prompt=child,host=host,score=score}
                end
            end
        end
    end
    table.sort(candidates,function(a,b) return a.score>b.score end)
    if #candidates==0 then return nil,"No enabled Jack prompt with a valid host",{} end
    local prompts={}
    for _, entry in ipairs(candidates) do prompts[#prompts+1]=entry.prompt end
    return prompts[1],"Found "..tostring(#prompts).." verified Jack prompt(s)",prompts
end

function orbitTools.openJackDialogue(token)
    local gui=orbitTools.sellerGui()
    if gui and gui:IsA("ScreenGui") and gui.Enabled then
        local exact=orbitTools.jackDialogueOption()
        if exact then return true,exact end
        return false,"Another NPC dialogue is open; cannot interact with Jack"
    end
    local prompt,promptReason,choices=orbitTools.findJackWorldPrompt()
    if #choices>0 then
        log("Jack discovery: "..tostring(promptReason).."; verifying actual candy option")
        local api=(type(env)=="table" and rawget(env,"fireproximityprompt")) or fireproximityprompt
        if type(api)~="function" then return false,"Executor has no fireproximityprompt" end
        local root=getRoot()
        if not root then return false,"Character root unavailable for Jack" end
        local allow,reason=enableTrueSightTeleport()
        if not allow then return false,"Jack movement unavailable: "..tostring(reason) end
        -- No arbitrary NPC interaction: only physically parented, explicitly
        -- named Jack/Halloween prompts make it into 'choices'.
        for i, candidate in ipairs(choices) do
            if not stillRunning(token) then return false,"Jack exchange interrupted" end
            local host=candidate:FindFirstAncestorWhichIsA("BasePart")
            if host and candidate.Parent and candidate.Enabled and host:IsDescendantOf(workspace) then
                local reach=math.max(1,tonumber(candidate.MaxActivationDistance) or 8)
                local destination=host.Position+Vector3.new(0,math.min(2,reach*0.35),0)
                local moved,moveErr=pcall(function()
                    root.CFrame=CFrame.new(destination)*root.CFrame.Rotation
                    root.AssemblyLinearVelocity=Vector3.zero
                end)
                if moved and pause(0.24,token) and (root.Position-host.Position).Magnitude<=reach+0.3 then
                    log(string.format("Jack candidate %d/%d: %s | %s (range %.1f)",
                        i,#choices,tostring(candidate.ObjectText),tostring(candidate.ActionText),reach))
                    local fired,err=pcall(api,candidate)
                    if fired then
                        local deadline=os.clock()+1.5
                        while stillRunning(token) and os.clock()<deadline do
                            local option=orbitTools.jackDialogueOption()
                            if option then
                                log("Verified Jack candy dialogue via live prompt #"..tostring(i))
                                return true,option
                            end
                            task.wait(0.10)
                        end
                        local openedGui=orbitTools.sellerGui()
                        if openedGui and openedGui:IsA("ScreenGui") and openedGui.Enabled then
                            return false,"Jack prompt opened an unexpected dialogue: "..tostring(orbitTools.jackLastOptions)
                        end
                    else
                        log("Jack candidate failed: "..tostring(err))
                    end
                elseif not moved then
                    log("Jack approach failed: "..tostring(moveErr))
                end
            end
        end
        log("Jack: no verified candy option through live prompts; trying exact definition")
    end
    local definition
    for _,folderName in ipairs({"NewDialogue","Dialogue"}) do
        local folder=ReplicatedStorage:FindFirstChild(folderName)
        if folder then
            definition=folder:FindFirstChild("Jack, The Cauldron Specter")
                or folder:FindFirstChild("Halloween Event")
            if definition then break end
        end
    end
    local character=player.Character
    local remote=character and character:FindFirstChild("RemoteEvent")
    if not definition or not remote then
        return false,"Jack unavailable: "..tostring(promptReason or "prompt failed")
            .."; exact dialogue definition or RemoteEvent missing"
    end
    log("Jack: requesting exact "..tostring(definition.Name).." dialogue")
    local ok,err=pcall(function() remote:FireServer("PromptTriggered",definition) end)
    if not ok then return false,"Jack definition request failed: "..tostring(err) end
    local deadline=os.clock()+4.5
    while stillRunning(token) and os.clock()<deadline do
        local option=orbitTools.jackDialogueOption()
        if option then return true,option end
        task.wait(0.10)
    end
    return false,"Jack candy Option2 not found; candidates="..tostring(#choices)
        .."; "..tostring(orbitTools.jackLastOptions)
end

function orbitTools.jackClickOnce(button,token)
    if not stillRunning(token) or not button or not button.Parent then return false,"Jack button missing" end
    local signal=button.MouseButton1Click
    local api=(type(env)=="table" and rawget(env,"getconnections")) or getconnections
    if type(api)=="function" then
        local ok,connections=pcall(api,signal)
        if ok and type(connections)=="table" then
            for _,conn in ipairs(connections) do
                local enabled,fire,fn=true,nil,nil
                pcall(function() enabled=conn.Enabled~=false end)
                pcall(function() fire=conn.Fire end)
                pcall(function() fn=conn.Function end)
                if enabled then
                    if type(fire)=="function" then
                        local dispatched=pcall(function() conn:Fire() end)
                        if dispatched then return true,"Jack bound connection" end
                    end
                    if type(fn)=="function" and pcall(fn) then return true,"Jack connection function" end
                end
            end
        end
    end
    local fireSignal=(type(env)=="table" and rawget(env,"firesignal")) or firesignal
    if type(fireSignal)=="function" then
        if pcall(fireSignal,signal) then return true,"Jack signal" end
    end
    -- If the executor lacks callback APIs, use the existing visible UI route.
    -- Do not click through the large full-screen HUD.
    local hidden=uiRefs.hudRoot and uiRefs.hudRoot.Visible
    if hidden then uiRefs.hudRoot.Visible=false end
    local ok,reason=orbitTools.triggerSellButton(button,token)
    if hidden and uiRefs.hudRoot then uiRefs.hudRoot.Visible=true end
    return ok,reason
end

function orbitTools.turnInCandy(token)
    local before, _ = orbitTools.candyTotals()
    if before <= 0 then return false, "No candy to turn in" end
    local opened, option = orbitTools.openJackDialogue(token)
    if not opened then return false, tostring(option) end
    log("Jack: verified Option2 'I want to turn in my candy.'; submitting once")
    local didClick, route = orbitTools.jackClickOnce(option, token)
    if not didClick then return false, "Jack option click failed: " .. tostring(route) end
    -- Confirmation comes from the inventory, NOT from a locally-fired button.
    local deadline = os.clock() + 7
    while stillRunning(token) and os.clock() < deadline do
        local count = orbitTools.candyTotals()
        if count < before then
            orbitTools.sellerCloseDialogue(token)
            return true, "Candy turned in: " .. tostring(before - count)
        end
        task.wait(0.15)
    end
    orbitTools.candyRetryBlocked = true
    return false, "Jack option submitted but candy did not decrease; retry blocked for this session"
end

function orbitTools.buyLucky(token)
    local moneyBefore = orbitTools.farmMoney()
    if not moneyBefore or moneyBefore < orbitTools.LUCKY_PRICE then
        return false, "Insufficient money or currency unavailable"
    end
    local before = orbitTools.sellerInventory("Lucky Arrow")
    if before >= (itemCap("Lucky Arrow") or 10) then return false, "Lucky stack full" end
    local char = player.Character
    local remote = char and char:FindFirstChild("RemoteEvent")
    if not remote or not remote:IsA("RemoteEvent") then return false, "Shop RemoteEvent missing" end
    local ok = pcall(function()
        remote:FireServer("PurchaseShopItem", {ItemName = "1x Lucky Arrow"})
    end)
    if not ok then return false, "Shop purchase request failed" end
    local deadline = os.clock() + 3
    while stillRunning(token) and os.clock() < deadline do
        local count = orbitTools.sellerInventory("Lucky Arrow")
        local moneyAfter = orbitTools.farmMoney()
        if count > before then
            orbitTools.session.luckyBought += count - before
            orbitTools.hudDirty = true
            if orbitTools.webhook then orbitTools.webhook("Lucky Arrow purchased", "Confirmed " .. tostring(count-before) .. " new Lucky Arrow(s).") end
            return true, "Bought Lucky Arrow: " .. tostring(before) .. " -> " .. tostring(count)
        end
        if moneyAfter and moneyAfter < moneyBefore and count == before then
            -- Money changed but inventory may not have replicated; don't repeat.
            orbitTools.luckyRetryBlocked = true
            return false, "Money decreased without confirmed Lucky Arrow: retry blocked"
        end
        task.wait(0.12)
    end
    orbitTools.luckyRetryBlocked = true
    return false, "Lucky purchase unverified: retry blocked until script reload"
end

function orbitTools.performEvent(operation, token)
    if not stillRunning(token) or orbitTools.eventBusy then return end
    orbitTools.eventBusy = true
    if orbitTools.setActivity then
        orbitTools.setActivity(operation == "candy" and "Turning in candy · Jack" or "Buying Lucky Arrow")
    end
    orbitTools.nextEventCheck = os.clock() + 7
    local isCandy = operation == "candy"
    local root, savedCFrame, character
    if isCandy then
        -- Jack's dialogue must be interactable even with our full-screen HUD enabled.
        orbitTools.jackHUDWasVisible=uiRefs.hudRoot and uiRefs.hudRoot.Visible or false
        if uiRefs.hudRoot then uiRefs.hudRoot.Visible=false end
        root, character = getRoot(), player.Character
        -- Return to a safe surface position, not the temporary orbit location
        -- under the map. The under-floor support is rebuilt after the trade.
        savedCFrame = floorState and floorState.savedCFrame or (root and root.CFrame)
        stopHoldingE()
        restoreUnderground()
        teardownFarmFloor(true)
    end
    local ok, success, message
    if isCandy then
        ok, success, message = pcall(orbitTools.turnInCandy, token)
    else
        ok, success, message = pcall(orbitTools.buyLucky, token)
    end
    if not ok then
        success, message = false, tostring(success)
        if isCandy then orbitTools.candyRetryBlocked = true
        else orbitTools.luckyRetryBlocked = true end
    end
    if isCandy then
        if uiRefs.hudRoot and orbitTools.jackHUDWasVisible then
            uiRefs.hudRoot.Visible=true
        end
        orbitTools.jackHUDWasVisible=false
        -- Never leave the player stranded beside Jack, even on a failure.
        -- Dialogue cleanup only clicks a visible exit; never submits a trade.
        pcall(orbitTools.sellerCloseDialogue, token)
        if root and root.Parent and savedCFrame and player.Character == character then
            pcall(function()
                root.CFrame = savedCFrame
                root.AssemblyLinearVelocity = Vector3.zero
            end)
        end
        if stillRunning(token) and underItem and floorEnabled then
            pcall(orbitTools.ensureFarmFloor)
        end
    end
    orbitTools.eventLastResult = (success and "Success: " or "Failed: ") .. tostring(message)
    if success and isCandy and orbitTools.webhook then
        orbitTools.webhook("Candy exchange", tostring(message))
    end
    if orbitTools.setActivity then
        orbitTools.setActivity(success and "Transaction complete" or "Transaction failed · see Events")
    end
    log("Events: " .. orbitTools.eventLastResult)
    orbitTools.eventBusy = false
    orbitTools.updateEventStatus()
end

local function runFarm(token)
    if orbitTools.setActivity then orbitTools.setActivity("Searching · scanning item spawns") end
    log("Farm started | Direct Prompt-only | Auto Ping ON | Hide map automatic")
    local noItemsReported = false
    while stillRunning(token) do
        if hopInProgress then
            if not pause(1.0, token) then break end
        elseif not getRoot() then
            if not pause(0.7, token) then break end
        else
            local sale, manual = orbitTools.saleCandidate()
            local eventOperation = (not sale or orbitTools.manualCandyRequest) and orbitTools.eventCandidate() or nil
            if eventOperation then
                orbitTools.orbitEligibleSince = nil
                orbitTools.orbitPauseUntil = os.clock() + 0.8
                stopIdleOrbit(true)
                orbitTools.performEvent(eventOperation, token)
                if not pause(0.30, token) then break end
            elseif sale then
                orbitTools.orbitEligibleSince = nil
                orbitTools.orbitPauseUntil = os.clock() + 0.8
                stopIdleOrbit(true)
                local ok, err = pcall(orbitTools.sellCappedItem, sale, token, manual)
                if not ok then
                    sellingNow = false
                    stopHoldingE()
                    local char = player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then pcall(function() hum:UnequipTools() end) end
                    sellCooldowns[sale] = os.clock() + orbitTools.SELL_FAILURE_BACKOFF
                    log("Merchant error: " .. tostring(err))
                end
                if not pause(0.25, token) then break end
            else
            local observedSerial = spawnSerial
            local entry, total = getAvailableItems()
            -- If the folder has objects but none are collectable, an old
            -- cached name/part/prompt can mask newly replicated contents.
            -- Do a bounded full refresh, then use the refreshed result.
            if not entry and orbitTools.scanStats.raw > 0
                and orbitTools.scanStats.capped + orbitTools.scanStats.cooldown < orbitTools.scanStats.raw
                and os.clock() - (orbitTools.lastEmptyRefreshAt or -math.huge) >= 2.5 then
                orbitTools.lastEmptyRefreshAt = os.clock()
                cachedReplicas, cachedCount, cachedMeshes = getReplicaNames()
                itemInfoCache = setmetatable({}, {__mode = "k"})
                unresolvedRetryAt = setmetatable({}, {__mode = "k"})
                entry, total = getAvailableItems()
            end
            foundCount = total
            updateStats()
            if entry then
                noItemsReported = false
                emptySince = nil
                orbitTools.orbitEligibleSince = nil
                orbitTools.pickupBusy = true
                orbitTools.orbitPauseUntil = os.clock() + 1.0
                stopIdleOrbit(true)
                -- Brief cooldown prevents immediate re-targeting; confirmed pickups
                -- are removed when the model disappears. Failures are backed off.
                skipItems[entry.item] = os.clock() + 2
                setMarker(entry)
                local ok, acquired, result = pcall(doPickup, entry, token)
                stopHoldingE()
                            restoreUnderground()
                            if not ok then
                    log("Pickup error: " .. tostring(acquired))
                    acquired = false
                end
                if acquired then
                    orbitTools.failedItemAttempts[entry.item] = nil
                    skipItems[entry.item] = os.clock() + 20
                else
                    local failures = (orbitTools.failedItemAttempts[entry.item] or 0) + 1
                    orbitTools.failedItemAttempts[entry.item] = failures
                    skipItems[entry.item] = os.clock() + math.min(30, 3 * failures)
                    if failures >= 3 then
                        -- A failure may be temporary (streaming, remote distance,
                        -- prompt late-loading). Back off, but never blacklist
                        -- a physically present item for the whole server session.
                        skipItems[entry.item] = os.clock() + 18
                        orbitTools.failedItemAttempts[entry.item] = 0
                        log("Item cooling down for 18s after 3 failed pickups")
                    end
                end
                destroyMark()
                -- A failed or confirmed pickup still gets the full post-attempt
                -- window before idle movement can resume.
                local continueLoop = pause(timing().between, token)
                orbitTools.orbitPauseUntil = os.clock() + 0.45
                orbitTools.pickupBusy = false
                if not continueLoop then break end
            else
                -- A trusted spawn signal with coordinates may arrive BEFORE
                -- Workspace.Item_Spawns.Items replicates the item. Briefly move
                -- near it, rescan, then use the ordinary Direct Prompt path.
                -- Measure the time with NO ELIGIBLE pickup, independently of
                -- physical item shells and stale remote spawn hints. A remote
                -- hint is only a short-lived reason to wait for replication.
                emptySince = emptySince or os.clock()
                orbitTools.visitSpawnLead(token)
                if orbitTools.setActivity then orbitTools.setActivity("Searching · waiting for items") end
                local scan = orbitTools.scanStats
                -- A real spawn/replication change gets a brief grace period.
                -- Only unresolved models justify waiting; full/cooling stacks
                -- must not prevent the idle orbit from restarting.
                local unresolved = (scan.noPrompt or 0) + (scan.noInteract or 0)
                    + (scan.noName or 0)
                local waitingToReplicate = unresolved > 0
                    and os.clock() - orbitTools.lastWorldChangeAt < orbitTools.REPLICATION_GRACE
                -- IMPORTANT: Do not extend orbitPauseUntil while it is active!
                -- At 0.07s scans, extending it by 0.20s each scan made its
                -- expiry impossible and stranded the character after pickup.
                -- Likewise promptReady includes capped/cooling items: if the
                -- scanner returned no entry, there is no *eligible* target.
                if waitingToReplicate or orbitTools.pickupBusy
                    or os.clock() < orbitTools.orbitPauseUntil then
                    orbitTools.orbitEligibleSince = nil
                    if waitingToReplicate and orbitState then stopIdleOrbit(false) end
                else
                    orbitTools.orbitEligibleSince = orbitTools.orbitEligibleSince or os.clock()
                    if os.clock() - orbitTools.orbitEligibleSince >= orbitTools.ORBIT_GRACE then
                        if not orbitState then
                            startIdleOrbit(token)
                            if orbitState then log("Idle orbit resumed after pickup/scan") end
                        end
                    end
                end
                if orbitState and orbitTools.setActivity then
                    orbitTools.setActivity("Orbiting · watching for item spawns")
                end
                local digest = string.format("world=%d named=%d prompts=%d noPrompt=%d disabled=%d capped=%d cooling=%d unnamed=%d unfinished=%d %s",
                    orbitTools.scanStats.raw, orbitTools.scanStats.identified, orbitTools.scanStats.promptReady or 0, orbitTools.scanStats.noPrompt or 0, orbitTools.scanStats.disabled,
                    orbitTools.scanStats.capped, orbitTools.scanStats.cooldown, orbitTools.scanStats.noName, orbitTools.scanStats.noInteract,
                    orbitTools.scanStats.error or "")
                if not noItemsReported or digest ~= orbitTools.lastEmptyDigest
                    or os.clock() - (orbitTools.lastEmptyLogAt or -math.huge) >= 15 then
                    log("No READY items: " .. digest)
                    orbitTools.lastEmptyDigest = digest
                    orbitTools.lastEmptyLogAt = os.clock()
                    noItemsReported = true
                end
                -- Skip hopping only during the first few seconds of a fresh
                -- spawn signal. Old/cooling/full models and old hints must not
                -- veto a hop indefinitely.
                orbitTools.expireSpawnLeads()
                local hasFreshLead=false
                for _,lead in ipairs(orbitTools.spawnLeads) do
                    if not lead.resolved and os.clock()-lead.received<3.5 then
                        hasFreshLead=true;break
                    end
                end
                local idleAge=emptySince and (os.clock()-emptySince) or 0
                if autoHop and not hopInProgress then
                    local timeLeft=math.max(0,math.ceil(hopAfterSeconds-idleAge))
                    if timeLeft>0 then
                        if orbitTools.setActivity then
                            orbitTools.setActivity("No pickup ready · hop in "..timeLeft.."s")
                        end
                    elseif hasFreshLead then
                        if orbitTools.setActivity then
                            orbitTools.setActivity("Spawn signalled · waiting briefly before hop")
                        end
                    else
                        attemptHop(token)
                    end
                end
                if not waitForItems(timing().idle, token, observedSerial) then break end
            end
            end -- seller or pickup
        end
    end
    if generation == token then
        autoRunning = false
        if orbitTools.session.farmStart then
            orbitTools.session.elapsed += math.max(0, os.clock() - orbitTools.session.farmStart)
            orbitTools.session.farmStart = nil
        end
        orbitTools.pickupBusy = false
        orbitTools.orbitEligibleSince = nil
        stopIdleOrbit(true)
        stopHoldingE()
            restoreUnderground()
            teardownFarmFloor(true)
        restoreMap()
        destroyMark()
        if filterUsedByTest and filterState and filterBeforeTest ~= nil then
            filterState.enabled = filterBeforeTest
            filterUsedByTest = false
        end
        log("Truefarm LITE stopped")
    end
    updateStats()
end

local function stopFarm()
    orbitTools.manualSellRequest = false
    if orbitTools.session.farmStart then
        orbitTools.session.elapsed += math.max(0, os.clock() - orbitTools.session.farmStart)
        orbitTools.session.farmStart = nil
    end
    if orbitTools.setActivity then orbitTools.setActivity("Idle · farming stopped") end
    if not autoRunning then return end
    autoRunning = false
    generation += 1
    orbitTools.pickupBusy = false
    orbitTools.orbitEligibleSince = nil
    stopIdleOrbit(true)
    stopHoldingE()
    restoreUnderground()
    teardownFarmFloor(true)
    restoreMap()
    destroyMark()
    if filterUsedByTest and filterState and filterBeforeTest ~= nil then
        filterState.enabled = filterBeforeTest
        filterUsedByTest = false
    end
    orbitTools.saveFarmLog()
    log("Stopped. Inputs released.")
end
local function startFarm()
    orbitTools.manualSellRequest = false
    if autoRunning then return end
    if not getRoot() then log("Character not ready") return end
    if not ensureTrackedItems() then log("No map item folder found") return end
    if not cachedReplicas then
        cachedReplicas, cachedCount, cachedMeshes = getReplicaNames()
    end
    -- Known names and prompt labels work even if Tool_Replicas is unavailable.
    if not capCheckStarted then
        capCheckStarted = true
        task.spawn(function()
            local ok, owned = pcall(function()
                return MarketplaceService:UserOwnsGamePassAsync(player.UserId, 14597778)
            end)
            if ok and owned then
                capMultiplier = 2
                log("2x inventory gamepass detected")
            elseif not ok then
                -- Unknown ownership must not silently assume ordinary stack limits.
                log("Inventory gamepass check failed; Auto Sell disabled until cap is verified")
                capCheckFinished = false
                return
            end
            capCheckFinished = true
            log("Auto Sell inventory-cap check ready (x" .. capMultiplier .. ")")
        end)
    end
    emptySince = nil
    hopInProgress = false
    orbitTools.pickupBusy = false
    orbitTools.orbitPauseUntil = 0
    orbitTools.orbitEligibleSince = nil
    skipItems = setmetatable({}, {__mode = "k"})
    orbitTools.failedItemAttempts = setmetatable({}, {__mode = "k"})
    sessionStarted = os.clock()
    sessionPickups = 0
    if not orbitTools.session.farmStart then orbitTools.session.farmStart = os.clock() end
    orbitTools.session.lastMoney = orbitTools.farmMoney and orbitTools.farmMoney() or nil
    autoRunning = true
    generation += 1
    if underItem and floorEnabled then orbitTools.ensureFarmFloor() end
    hideMapForFarm()
    updateStats()
    local token = generation
    task.spawn(function() runFarm(token) end)
end

