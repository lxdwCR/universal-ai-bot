end
local function log(message)
    if not alive then return end
    local line = string.format("[TRUEFARM LITE %.1fs] %s", os.clock() - start, message)
    table.insert(logs, line)
    if #logs > 160 then table.remove(logs, 1) end
    print(line)
    uiRefs.status.Text = message
    if uiRefs.logPreview then
        local tail = {}
        for i = math.max(1,#logs-7), #logs do tail[#tail+1] = logs[i] end
        uiRefs.logPreview.Text = table.concat(tail, "\n")
    end
    updateStats()
    -- Keep a rolling record even if the game disconnects immediately afterwards.
    if type(writefile) == "function" and os.clock() - orbitTools.lastLogSave >= 0.75 then
        orbitTools.lastLogSave = os.clock()
        pcall(writefile, "Truefarm_LITE_v14_Log.txt", table.concat(logs, "\n"))
    end
end
-- Read ping and smooth out brief spikes.
local function samplePing(force)
    local now = os.clock()
    if not force and now - pingLastSample < 1.5 then return smoothedPing end
    pingLastSample = now
    local ok, oneWay = pcall(function() return player:GetNetworkPing() end)
    if ok and type(oneWay) == "number" and oneWay >= 0 and oneWay < 3 then
        local ms = math.clamp(oneWay * 1000, 20, 1800)
        smoothedPing = smoothedPing and (smoothedPing * 0.72 + ms * 0.28) or ms
    end
    return smoothedPing
end

local function timing()
    local base = modes[modeName]
    local ms = samplePing(false)
    if not ms then
        return {between = interItemDelay, settle = tpSettle,
            confirm = base.confirm, padding = base.padding,
            minHold = base.minHold, idle = orbitTools.ITEM_SCAN_INTERVAL}
    end
    -- Avoid reacting too strongly to a single network spike.
    local scale
    if ms < 80 then scale = 0.92
    elseif ms < 140 then scale = 1.0
    elseif ms < 220 then scale = 1.3
    elseif ms < 350 then scale = 1.75
    else scale = 2.4 end
    return {
        between = math.clamp(interItemDelay * scale, 0.12, 1.8),
        settle = math.clamp(tpSettle * scale, 0.10, 1.2),
        confirm = math.clamp(base.confirm * scale, 0.18, 1.2),
        padding = math.clamp(base.padding * scale, 0.04, 0.6),
        minHold = math.clamp(base.minHold * scale, 0.09, 0.5),
        idle = orbitTools.ITEM_SCAN_INTERVAL,
    }
end

local function refreshPingLabel()
    local ms = samplePing(false)
    local t = timing()
    local shown = ms and string.format("%.0f ms", ms) or "unavailable"
    uiRefs.pingLabel.Text = string.format("AUTO PING  ·  %s", shown)
end

local function stillRunning(token)
    return alive and autoRunning and generation == token
end
local function pause(seconds, token)
    local stopAt = os.clock() + seconds
    while stillRunning(token) and os.clock() < stopAt do
        task.wait(math.min(0.08, math.max(0.015, stopAt - os.clock())))
    end
    return stillRunning(token)
end
-- If a spawn notification arrived before the model replicated, briefly
-- visit its exact server-provided position to encourage nearby streaming.
-- Never attempt Direct Prompt until the real model/prompt appears.
function orbitTools.visitSpawnLead(token)
    orbitTools.expireSpawnLeads()
    local lead
    local now=os.clock()
    for _,candidate in ipairs(orbitTools.spawnLeads) do
        if not candidate.resolved and candidate.tries<orbitTools.REMOTE_LEAD_MAX_TRIES
            and candidate.retryAt<=now then
            if not lead or candidate.received>lead.received then lead=candidate end
        end
    end
    if not lead then return false end
    local root=getRoot()
    if not root then return false end
    lead.tries+=1
    lead.retryAt=now+math.min(9,2*lead.tries+1)
    orbitTools.pickupBusy=true
    orbitTools.orbitEligibleSince=nil
    orbitTools.orbitPauseUntil=now+2
    stopIdleOrbit(true)
    local allowed,reason=enableTrueSightTeleport()
    if not allowed then
        log("Spawn lead: cannot travel: "..tostring(reason))
        orbitTools.pickupBusy=false
        return true
    end
    if orbitTools.setActivity then orbitTools.setActivity("Checking spawn · "..lead.name) end
    -- Keep the character below the reported spawn, but don't assume the item
    -- is collectible until its prompt is genuinely present on the client.
    local depth=underItem and -4.0 or 2.5
    local ok=pcall(function()
        root.CFrame=CFrame.new(lead.position+Vector3.new(0,depth,0))*root.CFrame.Rotation
        root.AssemblyLinearVelocity=Vector3.zero
    end)
    if ok then
        log(string.format("Checking remote spawn %s (try %d/%d)",
            lead.name,lead.tries,orbitTools.REMOTE_LEAD_MAX_TRIES))
        pause(0.55,token)
    end
    orbitTools.orbitPauseUntil=os.clock()+0.5
    orbitTools.pickupBusy=false
    return true
end

-- Smooth vertical movement beneath an item, followed by a local-position settle check.
-- Client observation CANNOT prove the server validated this position.
local function bobAndSettle(root, entry, center, setTarget, token)
    if not setTarget then return true end
    -- Compact single bob: travel-position settling, not pickup activation timing.
    local oscillationSeconds = 0.24
    local amplitude = 0.32
    local cycles = 1
    local started = os.clock()
    while stillRunning(token) and os.clock() - started < oscillationSeconds do
        if not entry.item:IsDescendantOf(workspace) or not root.Parent then return false end
        local elapsed = math.min(oscillationSeconds, os.clock() - started)
        local height = amplitude * math.sin((elapsed / oscillationSeconds) * cycles * math.pi * 2)
        if not setTarget(center + Vector3.new(0, height, 0)) then return false end
        if not pause(0.03, token) then return false end
    end
    if not stillRunning(token) or not setTarget(center) then return false end

    -- Require a short locally stable target; permit additional time on slow frames.
    local stableAt
    local deadline = os.clock() + 1.0
    while stillRunning(token) and os.clock() < deadline do
        if not entry.item:IsDescendantOf(workspace) or not root.Parent then return false end
        if (root.Position - center).Magnitude <= 0.9 then
            stableAt = stableAt or os.clock()
            if os.clock() - stableAt >= 0.10 then break end
        else
            stableAt = nil
        end
        if not pause(0.04, token) then return false end
    end
    if not stableAt or os.clock() - stableAt < 0.10 then
        log("Position bob: local position didn't settle; pickup skipped")
        return false
    end
    -- Extra wait after local settling. This is not a server-validation signal.
    local extraWait = 0.05
    log(string.format("Position bob complete; settling %.2fs before Direct Prompt (local check only)", extraWait))
    if not pause(extraWait, token) then return false end
    return entry.item:IsDescendantOf(workspace) and root.Parent ~= nil
end

local function getInput()
    local press = type(env) == "table" and rawget(env, "keypress") or nil
    local release = type(env) == "table" and rawget(env, "keyrelease") or nil
    press = press or keypress
    release = release or keyrelease
    if type(press) == "function" and type(release) == "function" then
        return function() press(0x45) end, function() release(0x45) end, "keypress"
    end
    local ok, vim = pcall(function() return game:GetService("VirtualInputManager") end)
    if ok and vim then
        return function() vim:SendKeyEvent(true, Enum.KeyCode.E, false, game) end,
            function() vim:SendKeyEvent(false, Enum.KeyCode.E, false, game) end,
            "VirtualInputManager"
    end
    return nil
end

local function matchingPrompt(entry)
    local prompt = entry.prompt
    if not (prompt and prompt.Parent and prompt:IsDescendantOf(workspace)
        and prompt.Enabled and prompt.KeyboardKeyCode == Enum.KeyCode.E) then
        return nil
    end
    return prompt
end

local function getAvailableItems()
    local folder = ensureTrackedItems()
    local root = getRoot()
    orbitTools.scanStats = {raw = 0, identified = 0, usable = 0, available = 0, promptReady = 0, noPrompt = 0,
        noName = 0, noInteract = 0, disabled = 0, capped = 0, cooldown = 0}
    orbitTools.lastScanSamples = {}
    if not folder then
        orbitTools.scanStats.error = "Workspace.Item_Spawns.Items not found"
        return nil, 0
    end
    if not root then
        orbitTools.scanStats.raw = #trackedItems
        orbitTools.scanStats.error = "Character root not available (dead, anchored or not loaded)"
        return nil, 0
    end
    if not cachedReplicas then
        cachedReplicas, cachedCount, cachedMeshes = getReplicaNames()
    end
    local closest, shortest = nil, math.huge
    local total, now = 0, os.clock()
    for _, item in ipairs(trackedItems) do
        if item:IsDescendantOf(folder) then
            orbitTools.scanStats.raw += 1
            local info = itemInfoCache[item]
            if info == nil or orbitTools.itemCacheDirty[item]
                or (now - (orbitTools.itemCacheRefreshedAt[item] or -math.huge) >=
                    (info and info.prompt and orbitTools.NAMED_CACHE_TTL or orbitTools.PENDING_CACHE_TTL))
                or (info == false and now >= (unresolvedRetryAt[item] or 0))
                or (type(info) == "table" and (
                    not info.part or not info.part.Parent or (info.part ~= item and not info.part:IsDescendantOf(item))
                    or (info.click and not info.click:IsDescendantOf(item))
                    or (info.prompt and (not info.prompt:IsDescendantOf(item)
                        or not info.prompt.Enabled or info.prompt.MaxActivationDistance <= 0))
                )) then
                -- Resolve geometry and interaction FIRST. Unknown item labels
                -- must not erase a real, enabled world-item prompt.
                local part, click, prompt = partFromItem(item)
                local name, matchedBy = matchReplica(item, cachedReplicas, cachedMeshes)
                if not name and prompt and part then
                    name = orbitTools.UNKNOWN_LABEL
                    matchedBy = "unidentified-active-prompt"
                end
                info = part and name and {
                    part = part, click = click, prompt = prompt,
                    name = name, matchedBy = matchedBy,
                } or false
                itemInfoCache[item] = info
                orbitTools.itemCacheDirty[item] = nil
                orbitTools.itemCacheRefreshedAt[item] = now
                if not info then unresolvedRetryAt[item] = now + orbitTools.PENDING_CACHE_TTL end
            end
            if info and info.name then
                orbitTools.scanStats.identified += 1
                local partOkay = info.part and info.part.Parent
                    and (info.part == item or info.part:IsDescendantOf(item))
                if partOkay then
                    orbitTools.resolveSpawnLead(info.part)
                    orbitTools.scanStats.usable += 1
                    -- Only enabled item prompts can be targeted in Direct Prompt mode.
                    -- An item with a ClickDetector but no active prompt is NOT ready.
                    local promptAPI = (type(env) == "table" and rawget(env, "fireproximityprompt")) or fireproximityprompt
                    local canPrompt = info.prompt and info.prompt.Parent
                        and info.prompt.Enabled and info.prompt.MaxActivationDistance > 0
                        and info.prompt:IsDescendantOf(workspace)
                    if canPrompt then orbitTools.scanStats.promptReady += 1 end
                    local methodOkay = canPrompt and type(promptAPI) == "function"
                    if not canPrompt then orbitTools.scanStats.noPrompt += 1 end
                    if not methodOkay then
                        orbitTools.scanStats.disabled += 1
                    elseif atItemCap(info.name) then
                        orbitTools.scanStats.capped += 1
                    elseif skipItems[item] ~= nil and now < skipItems[item] then
                        orbitTools.scanStats.cooldown += 1
                    else
                        total += 1
                        orbitTools.scanStats.available += 1
                        local distance = (info.part.Position - root.Position).Magnitude
                        if distance < shortest then
                            shortest = distance
                            closest = {item = item, part = info.part, click = info.click,
                                prompt = info.prompt, name = info.name, matchedBy = info.matchedBy}
                        end
                    end
                else
                    orbitTools.scanStats.noInteract += 1
                end
            else
                -- Distinguish empty/replicating models from unidentified pickups.
                local part, click, prompt, anyPrompt = partFromItem(item)
                if (click or prompt or anyPrompt) and part then
                    orbitTools.scanStats.noName += 1
                else
                    orbitTools.scanStats.noInteract += 1
                end
            end
            if #orbitTools.lastScanSamples < 5 then
                local label = info and info.name or item.Name
                local prompt = info and info.prompt
                orbitTools.lastScanSamples[#orbitTools.lastScanSamples + 1] = string.format("%s [%s] %s",
                    tostring(label), tostring(item.ClassName),
                    prompt and ("Prompt enabled=" .. tostring(prompt.Enabled)
                        .. " range=" .. tostring(prompt.MaxActivationDistance)) or "no enabled item prompt")
            end
        end
    end
    return closest, total
end

-- Wake immediately when the item folder changes instead of sleeping the
-- entire idle interval; still cap polling to avoid needless CPU load.
local function waitForItems(seconds, token, serial)
    -- ChildAdded/ChildRemoved increment spawnSerial; wake within ~20ms on a spawn.
    local deadline = os.clock() + math.min(seconds, orbitTools.ITEM_SCAN_INTERVAL)
    while stillRunning(token) and os.clock() < deadline do
        if spawnSerial ~= serial then return true end
        task.wait(math.min(0.02, math.max(0.008, deadline - os.clock())))
    end
    return stillRunning(token)
end

