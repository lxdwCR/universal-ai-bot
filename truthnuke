function orbitTools.prepareTeleportHUD()
    if not orbitTools.HUD_VISIBLE or not uiRefs.hudGui then return end
    orbitTools.setActivity("Server hopping · loading destination")
    orbitTools.tickSession()
    if uiRefs.hudRoot then uiRefs.hudRoot.Visible=true end
    if uiRefs.hudMini then uiRefs.hudMini.Visible=false end
    -- The Roblox engine carries the GUI tree, but its scripts cannot execute
    -- during loading. Static counters/status stay rendered.
    local ok,err=pcall(function() TeleportService:SetTeleportGui(uiRefs.hudGui) end)
    if not ok then warn("[Truefarm LITE] Custom teleport HUD unavailable: "..tostring(err)) end
end
