local inventorySnapshot = {}
local inventorySnapshotAt = -math.huge
local function updateInventory(force)
    if not force and os.clock() - inventorySnapshotAt < 0.65 then return inventorySnapshot end
    local counts = {}
    local function scan(container)
        if not container then return end
        for _, part in ipairs(container:GetChildren()) do
            if part:IsA("Tool") then
                local n = capName(part.Name)
                counts[n] = (counts[n] or 0) + 1
            end
        end
    end
    scan(player:FindFirstChildOfClass("Backpack"))
    scan(player.Character)
    inventorySnapshot = counts
    inventorySnapshotAt = os.clock()
    return counts
end
local function itemCount(name)
    return updateInventory(false)[capName(name)] or 0
end
local function itemCap(name)
    local cap = orbitTools.ITEM_CAPS[capName(name)]
    return cap and cap * capMultiplier or nil
end
local function atItemCap(name)
    local cap = itemCap(name)
    return cap ~= nil and itemCount(name) >= cap
end
