-- =======================================
-- LITE SESSION HUD + TELEPORT SCREEN
-- HUD and webhook logic live on orbitTools: avoid main-chunk register overflow.
-- A teleport ScreenGui is static while Roblox changes servers; execution resumes
-- when queue_on_teleport executes again in the next server.
-- =======================================
function orbitTools.sessionSnapshot(forHop)
    local data=orbitTools.session
    local elapsed=data.elapsed+(data.farmStart and math.max(0,os.clock()-data.farmStart) or 0)
    local items,icons={},{}
    for n,v in pairs(data.collected) do items[n]=v end
    for n,v in pairs(data.icons) do icons[n]=v end
    return {moneyEarned=data.moneyEarned,luckyBought=data.luckyBought,
        collected=items,icons=icons,elapsed=elapsed,startedAt=data.startedAt,
        hops=data.hops+(forHop and 1 or 0),rejoinAttempts=data.rejoinAttempts or 0}
end
function orbitTools.setActivity(message)
    if not alive then return end
    if orbitTools.session.status==message then return end
    orbitTools.session.status=message
    if uiRefs.hudStatus then uiRefs.hudStatus.Text=message end
    orbitTools.hudDirty=true
end
function orbitTools.rememberItemIcon(name)
    if orbitTools.session.icons[name] then return end
    for _,container in ipairs({player:FindFirstChildOfClass("Backpack"),player.Character}) do
        if container then
            for _,obj in ipairs(container:GetChildren()) do
                if obj:IsA("Tool") and capName(obj.Name)==name and type(obj.TextureId)=="string"
                    and obj.TextureId~="" then
                    orbitTools.session.icons[name]=obj.TextureId
                    return
                end
            end
        end
    end
    local replicas=ReplicatedStorage:FindFirstChild("Tool_Replicas")
    if replicas then
        local replica=replicas:FindFirstChild(name,true)
        if replica and replica:IsA("Tool") and replica.TextureId~="" then
            orbitTools.session.icons[name]=replica.TextureId
        end
    end
end
function orbitTools.fmtDuration(value)
    local t=math.floor(math.max(0,value))
    return string.format("%02d:%02d:%02d",math.floor(t/3600),math.floor(t/60)%60,t%60)
end
function orbitTools.webhook(title,description,force)
    if not force and not orbitTools.WEBHOOK_ON then return end
    local url=orbitTools.WEBHOOK_URL
    if type(url)~="string" or not url:match("^https://[^%s]+$") then return end
    -- Avoid posting private data: no player name, account ID, server ID, or location.
    local now=os.clock()
    if not force and now-orbitTools.lastWebhookAt<12 then return end
    orbitTools.lastWebhookAt=now
    task.spawn(function()
        local requestFn=(type(env)=="table" and (rawget(env,"request") or rawget(env,"http_request")))
            or (type(request)=="function" and request)
            or (type(http_request)=="function" and http_request)
        local synEnv=(type(env)=="table" and rawget(env,"syn")) or nil
        if type(requestFn)~="function" and type(synEnv)=="table" then
            requestFn=synEnv.request
        end
        if type(requestFn)~="function" then
            if uiRefs.webhookStatus then uiRefs.webhookStatus.Text="HTTP request API unavailable" end
            return
        end
        local snap=orbitTools.sessionSnapshot(false)
        local payload={username="Truefarm LITE",embeds={{
            title=tostring(title):sub(1,120),
            description=tostring(description):sub(1,350),
            color=9689078,
            fields={
                {name="Session earnings",value="$"..tostring(math.floor(snap.moneyEarned)),inline=true},
                {name="Lucky Arrows bought",value=tostring(snap.luckyBought),inline=true},
                {name="Farming time",value=orbitTools.fmtDuration(snap.elapsed),inline=true}
            }
        }}}
        local ok,answer=pcall(requestFn,{Url=url,Method="POST",
            Headers={["Content-Type"]="application/json"},Body=HttpService:JSONEncode(payload)})
        local status=ok and type(answer)=="table" and (answer.StatusCode or answer.Status)
        if uiRefs.webhookStatus then
            uiRefs.webhookStatus.Text=not ok and "Webhook request failed"
                or (status==204 or status==200) and "Webhook sent successfully"
                or "Webhook response: "..tostring(status or "unknown")
        end
    end)
end
function orbitTools.tickSession()
    if not alive then return end
    local now=os.clock()
    if now-orbitTools.lastHudTick<0.85 then return end
    orbitTools.lastHudTick=now
    if autoRunning and orbitTools.WEBHOOK_ON and now-(orbitTools.lastPeriodicWebhook or now)>=orbitTools.WEBHOOK_INTERVAL then
        orbitTools.lastPeriodicWebhook=now
        orbitTools.webhook("Farm session update","Session running: "..orbitTools.session.status)
    end
    local funds=orbitTools.farmMoney and orbitTools.farmMoney() or nil
    if type(funds)=="number" then
        local previous=orbitTools.session.lastMoney
        if autoRunning and type(previous)=="number" and funds>previous then
            orbitTools.session.moneyEarned+=funds-previous
            orbitTools.hudDirty=true
        end
        orbitTools.session.lastMoney=funds
    end
    if not uiRefs.hudRoot or not uiRefs.hudRoot.Parent then return end
    local snap=orbitTools.sessionSnapshot(false)
    uiRefs.hudMoney.Text="$"..tostring(math.floor(snap.moneyEarned))
    uiRefs.hudLucky.Text=tostring(snap.luckyBought)
    uiRefs.hudTime.Text=orbitTools.fmtDuration(snap.elapsed)
    uiRefs.hudStatus.Text=orbitTools.session.status
    if not orbitTools.hudDirty then return end
    orbitTools.hudDirty=false
    for _,obj in ipairs(uiRefs.hudList:GetChildren()) do
        if obj:IsA("GuiObject") then obj:Destroy() end
    end
    local sorted={}
    for name,count in pairs(snap.collected) do
        if count>0 then sorted[#sorted+1]={name=name,count=count} end
    end
    table.sort(sorted,function(a,b)
        if a.count==b.count then return a.name<b.name end
        return a.count>b.count
    end)
    local y=0
    for idx,info in ipairs(sorted) do
