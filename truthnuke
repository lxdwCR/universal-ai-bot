    uiRefs.statsDetail.Text = string.format("%.1f pickups/min  •  Attempts: %d", perMinute, pickupAttempts)
    uiRefs.scanHint.Text = string.format("Prompts: %d  |  No prompt: %d  |  Capped: %d",
        orbitTools.scanStats.promptReady or 0, orbitTools.scanStats.noPrompt or 0, orbitTools.scanStats.capped or 0)
    uiRefs.startBtn.Text = autoRunning and "●  FARM RUNNING" or "▶  START FARM"
    uiRefs.runPill.Text = autoRunning and "●  RUNNING" or "●  IDLE"
