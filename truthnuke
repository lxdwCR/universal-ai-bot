do
    local dragging, dragStart, panelStart, touchInput = false, nil, nil, nil
    local function isPointer(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end
    connect(uiRefs.dragBar.InputBegan, function(input)
        if isPointer(input) then
            dragging = true
            dragStart = input.Position
            panelStart = uiRefs.panel.Position
            touchInput = input.UserInputType == Enum.UserInputType.Touch and input or nil
        end
    end)
    connect(UIS.InputChanged, function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input ~= touchInput then return end
        local delta = input.Position - dragStart
        local scaleObj = uiRefs.panel:FindFirstChildWhichIsA("UIScale")
        local factor = scaleObj and scaleObj.Scale or 1
        uiRefs.panel.Position = UDim2.new(panelStart.X.Scale, panelStart.X.Offset + delta.X / factor,
            panelStart.Y.Scale, panelStart.Y.Offset + delta.Y / factor)
    end)
    connect(UIS.InputEnded, function(input)
        if isPointer(input) and (not touchInput or touchInput == input) then
            dragging = false
            touchInput = nil
        end
    end)
end

