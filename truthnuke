-- Best-effort reconnect: neither GUI observation nor teleporting is guaranteed
-- once Roblox has already terminated the client's Lua execution context.
-- Do not repeatedly reconnect to a moderation, security, or ban rejection.
function orbitTools.handleDisconnect(message)
    if not alive or not orbitTools.AUTO_REJOIN or orbitTools.rejoinPending then return end
    local code=tostring(message or ""):lower()
    if code:find("banned") or code:find("moderation") or code:find("restricted")
        or code:find("security") or code:find("suspended") then
        log("Disconnect reported; no automatic retry for moderation/security kicks")
        return
    end
    if code=="" then return end
    if (orbitTools.session.rejoinAttempts or 0)>=2 then
        log("Automatic rejoin paused after two disconnections this session")
        return
    end
    orbitTools.session.rejoinAttempts=(orbitTools.session.rejoinAttempts or 0)+1
    orbitTools.rejoinPending=true
    if orbitTools.setActivity then orbitTools.setActivity("Disconnected · attempting reconnection") end
    task.delay(2,function()
        if not alive then return end
        if orbitTools.prepareTeleportHUD then orbitTools.prepareTeleportHUD() end
        local queued=queueResume()
        if queued then
            pcall(function()
                TeleportService:SetTeleportSetting("TruefarmLITEResumeV11",{
                    resume=true,autoHop=autoHop,autoSell=autoSell,
                    underItem=underItem,positionBobEnabled=positionBobEnabled,
                    orbitEnabled=orbitEnabled,floorEnabled=floorEnabled,
                    orbitSpeed=orbitSpeed,modeName=modeName,
                    approachWait=orbitTools.approachWait,
                    itemScanInterval=orbitTools.ITEM_SCAN_INTERVAL,
                    interItemDelay=interItemDelay,hopAfterSeconds=hopAfterSeconds,
                    legacySellEnabled=orbitTools.legacySellEnabled,
                    autoTurnCandy=orbitTools.AUTO_TURN_CANDY,
                    autoBuyLucky=orbitTools.AUTO_BUY_LUCKY,
                    candyThreshold=orbitTools.CANDY_THRESHOLD,
                    autoRejoin=orbitTools.AUTO_REJOIN,hudVisible=orbitTools.HUD_VISIBLE,
                    hudX=orbitTools.hudX,hudY=orbitTools.hudY,
                    webhookEnabled=orbitTools.WEBHOOK_ON,webhookUrl=orbitTools.WEBHOOK_URL,
                    webhookInterval=orbitTools.WEBHOOK_INTERVAL,
                    session=orbitTools.sessionSnapshot(false)})
            end)
        end
        local success=pcall(function() TeleportService:Teleport(game.PlaceId,player) end)
        if not success then
            orbitTools.rejoinPending=false
            if orbitTools.clearTeleportHUD then orbitTools.clearTeleportHUD() end
        end
    end)
end
do
    -- Not all clients allow scripts to subscribe to the protected GuiService event.
    pcall(function()
        connect(game:GetService("GuiService").ErrorMessageChanged,orbitTools.handleDisconnect)
    end)
    -- Some executors can observe the Roblox disconnection dialog in CoreGui.
    pcall(function()
        local core=game:GetService("CoreGui")
        local watched=setmetatable({},{__mode="k"})
        local function watchPrompt(node)
            if node.Name~="ErrorPrompt" or not node:IsA("GuiObject") or watched[node] then return end
            watched[node]=true
            local function check()
                if not node.Parent or not node.Visible or not orbitTools.AUTO_REJOIN then return end
                task.delay(0.35,function()
                    if not node.Parent or not node.Visible then return end
                    local parts={}
                    for _,desc in ipairs(node:GetDescendants()) do
                        if desc:IsA("TextLabel") and desc.Text~="" then parts[#parts+1]=desc.Text end
                    end
                    orbitTools.handleDisconnect(#parts>0 and table.concat(parts," ") or "Connection interrupted")
                end)
            end
            connect(node:GetPropertyChangedSignal("Visible"),check)
            check()
        end
        for _,node in ipairs(core:GetDescendants()) do watchPrompt(node) end
        connect(core.DescendantAdded,watchPrompt)
    end)
end
