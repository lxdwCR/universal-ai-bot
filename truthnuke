        nameText.Text=info.name
        nameText.Parent=entry
        local number=Instance.new("TextLabel")
        number.BackgroundTransparency=1
        number.Position=UDim2.new(1,-70,0,10)
        number.Size=UDim2.fromOffset(58,38)
        number.Text="×"..tostring(info.count)
        number.Font=Enum.Font.GothamBold
        number.TextSize=16
        number.TextColor3=Color3.fromRGB(117,222,190)
        number.TextXAlignment=Enum.TextXAlignment.Right
        number.Parent=entry
        y+=1
    end
    uiRefs.hudList.CanvasSize=UDim2.fromOffset(0,math.max(24,math.ceil(y/2)*69+22))
    uiRefs.hudEmpty.Visible=#sorted==0
