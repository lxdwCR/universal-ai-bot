-- Unload
------------------------------------------------------------------
local function cleanup()
    -- save the current state first, then stop auto-saving while modules switch off
    if saveConfig then saveConfig() end
    configLoading = true
    for i = #modules, 1, -1 do
        local m = modules[i]
        if m.enabled then pcall(m.set, false) end
    end
    for _, c in ipairs(connections) do c:Disconnect() end
    table.clear(connections)
    pcall(function() RunService:UnbindFromRenderStep("TrueSightFOV") end)

    removeHat()
    removeTrail()
    removeWings()
    removeAura()
    verity.remove()
    unhookJump()
    removeGhost()
    correction:Destroy()
    blur:Destroy()
    if bloomCreated then
        bloom:Destroy()
    elseif bloomOriginal and bloom.Parent then
        bloom.Enabled = bloomOriginal.Enabled
        bloom.Intensity = bloomOriginal.Intensity
        bloom.Size = bloomOriginal.Size
        bloom.Threshold = bloomOriginal.Threshold
    end
    if raysCreated then
        rays:Destroy()
    elseif raysOriginal and rays.Parent then
        rays.Enabled = raysOriginal.Enabled
        rays.Intensity = raysOriginal.Intensity
        rays.Spread = raysOriginal.Spread
    end
    fxGui:Destroy()
    gui:Destroy()
end

