-- Update chams only when needed to avoid FPS drops.
ghostRenderSettings.applyVisuals = function()
    local mode = ghostRenderSettings.materialName
    local materialMode = (mode ~= "Highlight")
    local material = materialMode and (Enum.Material[mode] or Enum.Material.SmoothPlastic)
        or Enum.Material.SmoothPlastic
    local visible = (ghostAvatar.style ~= 2)
    local transparency = ghostRenderSettings.fillTransparency
    for _, pair in ipairs(ghostAvatar.parts) do
        local obj = pair.ghost
        local source = pair.source
        if obj and obj.Parent then
            local isRoot = obj.Name == "HumanoidRootPart"
            local sourceHidden = (not source or not source.Parent or source.Transparency >= 0.99)
            obj.Transparency = (not visible or isRoot or sourceHidden) and 1
                or (materialMode and transparency or 0.90)
            obj.Material = material
        end
    end
    local highlight = ghostAvatar.highlight
    if highlight and highlight.Parent then
        highlight.FillTransparency = materialMode and 1 or transparency
        highlight.OutlineTransparency = ghostRenderSettings.outlineTransparency
        highlight.Enabled = visible
    end
end

