        end
        local preview = state.layoutRefs.StandPreview
        if preview and preview.Parent then
            local panelRight = 18 + 6 * width + 40
            local freeRight = viewport.X - 18
            local freeWidth = math.max(72, freeRight - panelRight)
            local previewWidth = math.max(220, math.min(286, freeWidth - 16))
            local previewHeight = math.max(220, math.min(356, viewport.Y - 100))
            preview.AnchorPoint = Vector2.new(0, 0)
            preview.Size = UDim2.fromOffset(math.min(previewWidth, viewport.X - 16), previewHeight)
            preview.Position = UDim2.fromOffset(panelRight + (freeWidth - previewWidth) / 2, math.max(28, viewport.Y - previewHeight - 18))
        end
        clampAll()
    end

    table.insert(connections, UserInputService.InputBegan:Connect(function(input)
        if not state.dropdownPopup then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local popup = state.dropdownPopup
        if not popup or not popup.Parent then closeDropdown(); return end
        local pos = input.Position
        local pp, ps = popup.AbsolutePosition, popup.AbsoluteSize
        local inPopup = pos.X >= pp.X and pos.X <= pp.X + ps.X and pos.Y >= pp.Y and pos.Y <= pp.Y + ps.Y
        local owner = state.dropdownOwner
        local inOwner = owner and owner.Parent and pos.X >= owner.AbsolutePosition.X and pos.X <= owner.AbsolutePosition.X + owner.AbsoluteSize.X
            and pos.Y >= owner.AbsolutePosition.Y and pos.Y <= owner.AbsolutePosition.Y + owner.AbsoluteSize.Y
        if not inPopup and not inOwner then closeDropdown() end
    end))

    table.insert(connections, RunService.RenderStepped:Connect(function()
        for i = #state.grips, 1, -1 do
            local entry = state.grips[i]
            local target, grip = entry.target, entry.grip
