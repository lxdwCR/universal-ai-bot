                end
                local layoutData = {content = content, host = host, columns = columns, modules = cardModules, wide = nil}
                table.insert(activeColumns, layoutData)
            end
        end
    end
    local function arrangeColumns(data)
        if not data.content or not data.content.Parent then return end
        local wide = data.content.AbsoluteSize.X >= 735
        if data.wide == wide then return end
        data.wide = wide
        data.columns[1].Size = wide and UDim2.new(0.5, -11, 0, 0) or UDim2.new(1, 0, 0, 0)
        data.columns[2].Size = UDim2.new(0.5, -11, 0, 0)
        data.columns[2].Visible = wide
        local halfway = math.ceil(#data.modules / 2)
        for i, module in ipairs(data.modules) do
            local column = wide and ((i <= halfway) and 1 or 2) or 1
            module.holder.LayoutOrder = wide and ((column == 1) and i or (i - halfway)) or i
            module.holder.Parent = data.columns[column]
        end
    end
    for _, data in ipairs(activeColumns) do
        arrangeColumns(data)
        data.content:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            arrangeColumns(data)
        end)
    end
end

