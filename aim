                    maxH = math.max(kind == "preview" and 220 or 250, ((cam() and cam().ViewportSize.Y) or 720) - 16),
                }
            end
        end)
        return grip
    end

    local function clampObject(object)
        if not object or not object.Parent then return end
        local viewport = (cam() and cam().ViewportSize) or Vector2.new(1280, 720)
        local size = object.AbsoluteSize
        local screenX = math.clamp(object.AbsolutePosition.X, 8, math.max(8, viewport.X - size.X - 8))
        local screenY = math.clamp(object.AbsolutePosition.Y, 28, math.max(28, viewport.Y - size.Y - 8))
        -- Position is relative to the parent's origin, not the screen. Subtract the parent's absolute
        -- position before writing the clamped coordinates.
        local parentOrigin = Vector2.new(0, 0)
        local parentSize = viewport
        if object.Parent:IsA("GuiObject") then
            parentOrigin = object.Parent.AbsolutePosition
            parentSize = object.Parent.AbsoluteSize
        end
        local scaleX = object.Position.X.Scale
        local scaleY = object.Position.Y.Scale
        object.Position = UDim2.new(
            scaleX, screenX - parentOrigin.X + object.AnchorPoint.X * size.X - scaleX * parentSize.X,
            scaleY, screenY - parentOrigin.Y + object.AnchorPoint.Y * size.Y - scaleY * parentSize.Y
        )
    end

    local function clampAll()
        local viewport = (cam() and cam().ViewportSize) or Vector2.new(1280, 720)
        for _, panel in pairs(panelRegistry) do
            if panel and panel.Parent and not panel:GetAttribute("TrueSightNavPage") then
                panel.Size = UDim2.fromOffset(math.min(panel.Size.X.Offset, viewport.X - 16), math.min(panel.Size.Y.Offset, viewport.Y - 24))
                clampObject(panel)
            end
        end
        if state.layoutRefs.StandPreview and state.layoutRefs.StandPreview.Parent then
            local preview = state.layoutRefs.StandPreview
            preview.Size = UDim2.fromOffset(math.min(preview.Size.X.Offset, viewport.X - 16), math.min(preview.Size.Y.Offset, viewport.Y - 16))
            clampObject(preview)
        end
    end

    local function resetLayout()
        local viewport = (cam() and cam().ViewportSize) or Vector2.new(1280, 720)
        local width = responsivePanelWidth(viewport.X)
        local height = math.max(220, math.min(690, viewport.Y - 92))
        for title, panel in pairs(panelRegistry) do
            if not panel:GetAttribute("TrueSightNavPage") then
                local col = panelColumns[title] or 1
                panel.AnchorPoint = Vector2.new(0, 0)
                panel.Size = UDim2.fromOffset(width, height)
                panel.Position = UDim2.fromOffset(18 + (col - 1) * (width + 8), 72)
            end
        end
        local preview = state.layoutRefs.StandPreview
        if preview and preview.Parent then
            local panelRight = 18 + 6 * width + 40
            local freeRight = viewport.X - 18
            local freeWidth = math.max(72, freeRight - panelRight)
            local previewWidth = math.max(220, math.min(286, freeWidth - 16))
            local previewHeight = math.max(220, math.min(356, viewport.Y - 100))
            preview.AnchorPoint = Vector2.new(0, 0)
            preview.Size = UDim2.fromOffset(math.min(previewWidth, viewport.X - 16), previewHeight)
            preview.Position = UDim2.fromOffset(panelRight + (freeWidth - previewWidth) / 2, math.max(28, viewport.Y - previewHeight - 18))
        end
        clampAll()
    end

    table.insert(connections, UserInputService.InputBegan:Connect(function(input)
        if not state.dropdownPopup then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local popup = state.dropdownPopup
        if not popup or not popup.Parent then closeDropdown(); return end
        local pos = input.Position
        local pp, ps = popup.AbsolutePosition, popup.AbsoluteSize
        local inPopup = pos.X >= pp.X and pos.X <= pp.X + ps.X and pos.Y >= pp.Y and pos.Y <= pp.Y + ps.Y
        local owner = state.dropdownOwner
        local inOwner = owner and owner.Parent and pos.X >= owner.AbsolutePosition.X and pos.X <= owner.AbsolutePosition.X + owner.AbsoluteSize.X
            and pos.Y >= owner.AbsolutePosition.Y and pos.Y <= owner.AbsolutePosition.Y + owner.AbsoluteSize.Y
        if not inPopup and not inOwner then closeDropdown() end
    end))

    table.insert(connections, RunService.RenderStepped:Connect(function()
        for i = #state.grips, 1, -1 do
            local entry = state.grips[i]
            local target, grip = entry.target, entry.grip
            if not target or not target.Parent or not grip or not grip.Parent then
                table.remove(state.grips, i)
            else
                local pos, size = target.AbsolutePosition, target.AbsoluteSize
                grip.Position = UDim2.fromOffset(pos.X + size.X - 20, pos.Y + size.Y - 20)
                grip.Visible = (not target:GetAttribute("TrueSightNavPage"))
                    and target.Visible and target:IsDescendantOf(gui)
                    and (not target:IsDescendantOf(clickGui) or clickGui.Visible)
            end
        end
    end))

    local camera = cam()
    if camera then
        table.insert(connections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            task.defer(clampAll)
            closeDropdown()
        end))
    end

    return {
        layoutRefs = state.layoutRefs,
        addResizeGrip = addResizeGrip,
        openDropdown = openDropdown,
        closeDropdown = closeDropdown,
        clampObject = clampObject,
        clampAll = clampAll,
        resetLayout = resetLayout,
        resizeState = state,
    }
end)()

