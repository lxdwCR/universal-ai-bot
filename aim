    local function updateRemoteSkins()
        if not showModule.enabled then return end
        local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local nearest = {}
        if localRoot then
            for userId, entry in pairs(activeEntries) do
                local other = Players:GetPlayerByUserId(userId)
                if other and other ~= player then
                    local morph = findMorphFor(other)
                    local anchor = morph and (morph:FindFirstChild("HumanoidRootPart", true) or morph.PrimaryPart)
                    if anchor and anchor:IsA("BasePart") then
                        local isSpoh = entry.avatarId == SPOH_SYNC_AVATAR_ID
                        local matches = modules._isStarPlatinumStand
                        if not isSpoh or (type(matches) == "function" and matches(other, morph)) then
                            local distance = (localRoot.Position - anchor.Position).Magnitude
                            if distance < 225 then
                                table.insert(nearest, {entry=entry, player=other, morph=morph, dist=distance})
                            end
                        end
                    end
                end
            end
        end
        table.sort(nearest, function(a,b) return a.dist < b.dist end)
        local selected = {}
        for i=1, math.min(#nearest, MAX_REMOTE) do
            local item = nearest[i]
            selected[item.entry] = true
            if item.entry.skin and item.entry.morph ~= item.morph then
                cleanupEntry(item.entry)
            end
            if not item.entry.skin and not item.entry.building
                and (os.clock() - (item.entry.lastAttempt or 0) > 8) then
                buildEntry(item.entry, item.player, item.morph)
            end
        end
        for _, entry in pairs(activeEntries) do
            if not selected[entry] and entry.skin then cleanupEntry(entry) end
        end
    end
