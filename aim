    ------------------------------------------------------------------
    -- Neon Halo: one thin, continuous-looking open ring made from Beam segments.
    -- This avoids the thick, dotted double-ring that obscured the centre in-game.
    ------------------------------------------------------------------
    local haloParts = {}
    local haloSegmentRecords = {}
    local haloHead
    local haloSize = 2.35
    local haloRingSegments = 72
    local haloRingWidth = 0.055
    local function removeHalo()
        for _, obj in ipairs(haloParts) do if obj and obj.Parent then obj:Destroy() end end
        table.clear(haloParts)
        table.clear(haloSegmentRecords)
        haloHead = nil
    end
    local function updateHaloGeometry()
        if not haloHead or not haloHead.Parent then return end
        local radius = haloSize * 0.68
        local y = haloHead.Size.Y * 0.64
        for _, rec in ipairs(haloSegmentRecords) do
            rec.attachment.Position = Vector3.new(math.cos(rec.angle) * radius, y, math.sin(rec.angle) * radius)
        end
    end
    local function addHalo(character)
        removeHalo()
        character = character or player.Character
        local head = character and character:FindFirstChild("Head")
        if not head then return end
        haloHead = head
        local attachments = {}
        local radius = haloSize * 0.68
        local y = head.Size.Y * 0.64
        for index = 1, haloRingSegments do
            local angle = (index - 1) * (math.pi * 2 / haloRingSegments)
            local attachment = Instance.new("Attachment")
            attachment.Name = "TrueSightHaloPoint"
            attachment.Position = Vector3.new(math.cos(angle) * radius, y, math.sin(angle) * radius)
            attachment.Parent = head
            table.insert(attachments, attachment)
            table.insert(haloParts, attachment)
            table.insert(haloSegmentRecords, {attachment = attachment, angle = angle})
        end
        for index = 1, haloRingSegments do
            local nextIndex = (index % haloRingSegments) + 1
            local beam = Instance.new("Beam")
            beam.Name = "TrueSightHaloSegment"
            beam.Attachment0 = attachments[index]
            beam.Attachment1 = attachments[nextIndex]
            beam.Width0 = haloRingWidth
            beam.Width1 = haloRingWidth
            beam.FaceCamera = true
            beam.LightEmission = 1
            beam.LightInfluence = 0
            beam.Color = ColorSequence.new(accent)
            beam.Transparency = NumberSequence.new(0.06)
            beam.Segments = 1
            beam.Parent = head
            table.insert(haloParts, 1, beam)
        end
        updateHaloGeometry()
    end
    onAccent(function(c)
        for _, obj in ipairs(haloParts) do
            if obj and obj.Parent and obj:IsA("Beam") then obj.Color = ColorSequence.new(c) end
        end
    end)
    local haloMod = addModule(visualPanel, "Neon Halo", function(on)
        if on then addHalo(player.Character) else removeHalo() end
    end)
    haloMod.slider("Diameter", 1.4, 3.4, haloSize, 0.1, function(v)
        haloSize = v
        updateHaloGeometry()
    end)
    visualModules.halo = haloMod
    visualModules.addHalo = addHalo
    visualModules.removeHalo = removeHalo
    ------------------------------------------------------------------
    -- Black Flash: chance roll on nearby opponent damage shortly after our attack animation.
    -- It reads VFX/audio source groups discovered during the shared startup scan.
    ------------------------------------------------------------------
    local function disconnectBlackFlashAnimation()
        if blackFlashAnimationConnection then
            if type(blackFlashAnimationConnection) == "table" then
                for _, conn in ipairs(blackFlashAnimationConnection) do
                    pcall(function() conn:Disconnect() end)
                end
            else
                pcall(function() blackFlashAnimationConnection:Disconnect() end)
            end
            blackFlashAnimationConnection = nil
        end
    end
    local function cleanupBlackFlashObjects()
        for _, obj in ipairs(blackFlashActiveObjects) do
            if obj and obj.Parent then pcall(function() obj:Destroy() end) end
        end
        local state = blackFlashActiveObjects._state or {recentAttackAt = 0, durationFactor = 1.6}
        table.clear(blackFlashActiveObjects)
        state.recentAttackAt = 0
        blackFlashActiveObjects._state = state
    end
    local function retainBlackFlashObject(obj, lifetime)
        table.insert(blackFlashActiveObjects, obj)
        if lifetime then Debris:AddItem(obj, lifetime) end
        return obj
    end
    local function blackFlashAnchor(character)
        return character and (character:FindFirstChild("HumanoidRootPart")
            or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
            or character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
            or character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm"))
    end
    local function blackFlashAttackerCharacter()
        -- YBA commonly mirrors player avatars inside workspace.Living. Prefer that
        -- live rig when it has a root, since it can be closer to the combat position
        -- than Player.Character during a respawn/Stand transition.
        local living = workspace:FindFirstChild("Living")
        local liveCharacter = living and living:FindFirstChild(player.Name)
        if liveCharacter and (liveCharacter:FindFirstChild("HumanoidRootPart")
            or liveCharacter:FindFirstChild("UpperTorso") or liveCharacter:FindFirstChild("Torso")) then
            return liveCharacter
        end
        return player.Character
    end
    local function blackFlashImpactCFrame(targetCharacter, anchor)
        local targetRoot = targetCharacter and (targetCharacter:FindFirstChild("HumanoidRootPart")
            or targetCharacter:FindFirstChild("UpperTorso") or targetCharacter:FindFirstChild("Torso"))
        local ownCharacter = blackFlashAttackerCharacter()
        local ownRoot = ownCharacter and (ownCharacter:FindFirstChild("HumanoidRootPart")
            or ownCharacter:FindFirstChild("UpperTorso") or ownCharacter:FindFirstChild("Torso"))
        if targetRoot and ownRoot and targetCharacter ~= ownCharacter then
            local toAttacker = ownRoot.Position - targetRoot.Position
            local flat = Vector3.new(toAttacker.X, 0, toAttacker.Z)
            if flat.Magnitude > 0.05 then
                -- Put the impact between the two characters and turn it toward the
                -- attacker, independent of which direction the victim is facing.
                -- Keep the burst close to the target's front/upper torso rather than
                -- offsetting it more than a stud from the actual hit position.
                local position = targetRoot.Position + flat.Unit * math.min(0.38, flat.Magnitude * 0.10)
                    + Vector3.new(0, math.clamp(targetRoot.Size.Y * 0.12, 0.18, 0.38), 0)
                return CFrame.lookAt(position, ownRoot.Position + Vector3.new(0, 0.35, 0))
            end
        end
        local base = targetRoot or anchor
        return base.CFrame * CFrame.new(0, 0.8, -0.45)
    end
    local function makeBlackFlashAttachment(anchor, worldCFrame)
        local attachment = Instance.new("Attachment")
        attachment.Name = "TrueSightBlackFlashAttachment"
        attachment.CFrame = anchor.CFrame:ToObjectSpace(worldCFrame)
        attachment.Parent = anchor
        return attachment
    end
    local function cloneBlackFlashSource(character) 
        local anchor = blackFlashAnchor(character)
        if not anchor then
            if blackFlashStatus then blackFlashStatus.Text = "No hand/root part found on the target character." end
            return false
        end
        local impactCFrame = blackFlashImpactCFrame(character, anchor)
        if #blackFlashAssets == 0 then
            if blackFlashStatus then blackFlashStatus.Text = "No named Black Flash assets were found during startup discovery." end
            return false
        end
        -- Dropdown index 1 means Auto-detect (first discovered group); named options
        -- start at index 2 and map to the corresponding discovered group minus one.
        local selectedIndex = tonumber(blackFlashSelectedIndex) or 1
        local sourceIndex = selectedIndex <= 1 and 1 or (selectedIndex - 1)
        sourceIndex = math.clamp(sourceIndex, 1, #blackFlashAssets)
        local record = blackFlashAssets[sourceIndex]
        if not record or not record.source or not record.source.Parent then
            if blackFlashStatus then blackFlashStatus.Text = "Selected Black Flash asset is no longer available. Restart TrueSight to refresh assets." end
            return false
        end
        -- Build one composite from the selected source plus whichever companion
        -- capability is missing. YBA often stores Black Flash VFX and audio in separate
        -- folders, so selecting either one should still play BOTH when both are available.
        local selectedClone = cloneArchivable(record.source)
        if not selectedClone then
            if blackFlashStatus then blackFlashStatus.Text = "Could not clone " .. tostring(record.label) end
            return false
        end
        local composite = Instance.new("Folder")
        composite.Name = "TrueSightBlackFlashComposite"

        -- Black Flash folders in ReplicatedStorage may contain large PointLights /
        -- SurfaceLights used by the original in-game scene. Reusing them locally can
        -- tint the whole arena red for several seconds. Keep the particles and audio,
        -- but remove scene-lighting objects from every cloned source.
        local function stripBlackFlashSceneLights(root)
            if not root then return end
            local items = {root}
            for _, desc in ipairs(root:GetDescendants()) do
                table.insert(items, desc)
            end
            for _, obj in ipairs(items) do
                if obj and obj.Parent and (obj:IsA("PointLight") or obj:IsA("SpotLight")
                    or obj:IsA("SurfaceLight") or obj:IsA("BloomEffect")
                    or obj:IsA("ColorCorrectionEffect") or obj:IsA("BlurEffect")
                    or obj:IsA("SunRaysEffect")) then
                    pcall(function() obj:Destroy() end)
                end
            end
        end
        stripBlackFlashSceneLights(selectedClone)
        selectedClone.Parent = composite

        local function inspectCapabilities(root)
            local hasSound, hasVisual = false, false
            local function inspectOne(obj)
                if obj:IsA("Sound") and obj.SoundId ~= "" then hasSound = true end
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                    or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                    hasVisual = true
                end
            end
            inspectOne(root)
            for _, obj in ipairs(root:GetDescendants()) do inspectOne(obj) end
            return hasSound, hasVisual
        end
        local hasSound, hasVisual = inspectCapabilities(composite)
        local companionVisual, companionSound
        for _, candidate in ipairs(blackFlashAssets) do
            if candidate.source and candidate.source.Parent and candidate.source ~= record.source then
                local candidateSound, candidateVisual = inspectCapabilities(candidate.source)
                if not hasVisual and not companionVisual and candidateVisual then companionVisual = candidate end
                if not hasSound and not companionSound and candidateSound then companionSound = candidate end
                if (hasVisual or companionVisual) and (hasSound or companionSound) then break end
            end
        end
        if not hasVisual and companionVisual then
            local extra = cloneArchivable(companionVisual.source)
            if extra then
                stripBlackFlashSceneLights(extra)
                extra.Parent = composite
                hasVisual = select(2, inspectCapabilities(extra))
            end
        end
        -- Recheck after adding the visual companion, since that group may contain sound too.
        hasSound = select(1, inspectCapabilities(composite))
        if not hasSound and companionSound then
            local extra = cloneArchivable(companionSound.source)
            if extra then
                stripBlackFlashSceneLights(extra)
                extra.Parent = composite
                hasSound = select(1, inspectCapabilities(extra))
            end
        end
        local clone = composite

        -- Remove executable logic but retain particles, geometry, attachments and sound.
        stripBlackFlashSceneLights(clone)
        for _, obj in ipairs(clone:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                pcall(function() obj:Destroy() end)
            end
        end

        if clone:IsA("Sound") then
            local soundAttachment = makeBlackFlashAttachment(anchor, impactCFrame)
            clone.Volume = blackFlashVolume
            clone.Looped = false
            clone.Parent = soundAttachment
            pcall(function() clone.TimePosition = 0 end)
            clone:Play()
            retainBlackFlashObject(soundAttachment, math.max(3, clone.TimeLength + 0.5))
            retainBlackFlashObject(clone, math.max(3, clone.TimeLength + 0.5))
        elseif clone:IsA("ParticleEmitter") then
            local attachment = makeBlackFlashAttachment(anchor, impactCFrame)
            retainBlackFlashObject(attachment, 3 * (blackFlashActiveObjects._state.durationFactor or 1.6))
            clone.Rate = 0
            clone.Enabled = true
            pcall(function()
                local durationScale = blackFlashActiveObjects._state.durationFactor or 1.6
                local life = clone.Lifetime
                clone.Lifetime = NumberRange.new(life.Min * durationScale, life.Max * durationScale)
                local sizeScale = blackFlashActiveObjects._state.effectScale or 0.58
                local keys = clone.Size.Keypoints
                local scaled = table.create(#keys)
                for i, keypoint in ipairs(keys) do
                    scaled[i] = NumberSequenceKeypoint.new(keypoint.Time, keypoint.Value * sizeScale, keypoint.Envelope * sizeScale)
                end
                clone.Size = NumberSequence.new(scaled)
            end)
            clone.Parent = attachment
            pcall(function() clone:Emit(blackFlashParticleCount) end)
            retainBlackFlashObject(clone, 2.8 * (blackFlashActiveObjects._state.durationFactor or 1.6))
        elseif clone:IsA("Trail") or clone:IsA("Beam") then
            -- Trail/Beam templates need two valid attachments. If source is a single
            -- asset leaf without both, it cannot render on its own; report it safely.
            local a0, a1 = clone.Attachment0, clone.Attachment1
            if not a0 or not a1 then
                clone:Destroy()
                if blackFlashStatus then blackFlashStatus.Text = "The selected Trail/Beam needs its parent effect group; select the enclosing Black Flash folder." end
                return false
            end
            local attachA = makeBlackFlashAttachment(anchor, impactCFrame * CFrame.new(-0.45, 0, 0))
            local attachB = makeBlackFlashAttachment(anchor, impactCFrame * CFrame.new(0.45, 0, 0))
            clone.Attachment0, clone.Attachment1 = attachA, attachB
            clone.Enabled = true
            pcall(function()
                if clone:IsA("Trail") then
                    clone.Lifetime = clone.Lifetime * (blackFlashActiveObjects._state.durationFactor or 1.6)
                end
            end)
            clone.Parent = anchor
            local trailHold = 1.8 * (blackFlashActiveObjects._state.durationFactor or 1.6)
            retainBlackFlashObject(attachA, trailHold); retainBlackFlashObject(attachB, trailHold); retainBlackFlashObject(clone, trailHold)
        else
            local wrapper
            local sourceIsModel = clone:IsA("Model")
            if sourceIsModel then
                wrapper = clone
            elseif clone:IsA("Folder") then
                wrapper = Instance.new("Model")
                wrapper.Name = "TrueSightBlackFlashFX"
                for _, child in ipairs(clone:GetChildren()) do child.Parent = wrapper end
                clone:Destroy()
            elseif clone:IsA("BasePart") then
                wrapper = Instance.new("Model")
                wrapper.Name = "TrueSightBlackFlashFX"
                clone.Parent = wrapper
            else
                -- Unknown container types still get useful local VFX by mounting
                -- descendant ParticleEmitters and Sounds to an attachment/hand.
                wrapper = Instance.new("Model")
                wrapper.Name = "TrueSightBlackFlashFX"
                clone.Parent = wrapper
            end

            local parts = {}
            for _, obj in ipairs(wrapper:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj.Anchored = true
                    obj.CanCollide = false
                    obj.CanTouch = false
                    obj.CanQuery = false
                    obj.CastShadow = false
                    -- Many stored Black Flash templates include bright placeholder shards.
                    -- Keep them invisible and use the template's real emitters for the burst.
                    obj.Transparency = 1
                    table.insert(parts, obj)
                end
            end
            if #parts > 0 then
                wrapper.Parent = workspace
                pcall(function()
                    -- Scale oversized source geometry before aligning its actual bounds.
                    wrapper:ScaleTo(blackFlashActiveObjects._state.effectScale or 0.58)
                end)
                pcall(function()
                    -- Stored effect models sometimes have a pivot far from their visible geometry.
                    -- Align their bounds to the impact point rather than trusting that pivot.
                    local boundsCFrame = wrapper:GetBoundingBox()
                    local currentPivot = wrapper:GetPivot()
                    local worldTransform = impactCFrame * boundsCFrame:Inverse()
                    wrapper:PivotTo(worldTransform * currentPivot)
                end)
                -- Start audio first; then emit the burst in the same event callback to
                -- minimise the perceived gap between the Black Flash sound and VFX.
                for _, obj in ipairs(wrapper:GetDescendants()) do
                    if obj:IsA("Sound") then
                        obj.Volume = blackFlashVolume
                        obj.Looped = false
                        -- Standalone Sound objects parented under Model/Folder containers
                        -- may not get reliable spatial playback; attach them to the hit anchor.
                        if not obj.Parent or not (obj.Parent:IsA("BasePart") or obj.Parent:IsA("Attachment")) then
                            local soundAttachment = makeBlackFlashAttachment(anchor, impactCFrame)
                            obj.Parent = soundAttachment
                            retainBlackFlashObject(soundAttachment, math.max(3, obj.TimeLength + 0.5))
                        end
                        -- Startup discovery preloads source sounds; don't wait on Loaded here,
                        -- because waiting at hit-time makes audio lag behind the VFX burst.
                        pcall(function() obj.TimePosition = 0 end)
                        pcall(function() obj:Play() end)
                        retainBlackFlashObject(obj, math.max(4, obj.TimeLength + 1))
                    end
                end
                local fallbackEmitterAttachment
                for _, obj in ipairs(wrapper:GetDescendants()) do
                    if obj:IsA("ParticleEmitter") then
                        obj.Enabled = true
                        local parent = obj.Parent
                        -- Root-level emitters stored directly under a Model/Folder do not
                        -- have a valid emission point. Mount those at the computed impact.
                        if not parent or (not parent:IsA("Attachment") and not parent:IsA("BasePart")) then
                            if not fallbackEmitterAttachment then
                                fallbackEmitterAttachment = makeBlackFlashAttachment(anchor, impactCFrame)
                                retainBlackFlashObject(fallbackEmitterAttachment, 3.8 * (blackFlashActiveObjects._state.durationFactor or 1.6))
                            end
                            obj.Parent = fallbackEmitterAttachment
                            parent = fallbackEmitterAttachment
                        end
                        obj.Rate = 0
                        pcall(function()
                            local durationScale = blackFlashActiveObjects._state.durationFactor or 1.6
                            local life = obj.Lifetime
                            obj.Lifetime = NumberRange.new(life.Min * durationScale, life.Max * durationScale)
                            local sizeScale = blackFlashActiveObjects._state.effectScale or 0.58
                            local keys = obj.Size.Keypoints
                            local scaled = table.create(#keys)
                            for i, keypoint in ipairs(keys) do
                                scaled[i] = NumberSequenceKeypoint.new(keypoint.Time, keypoint.Value * sizeScale, keypoint.Envelope * sizeScale)
                            end
                            obj.Size = NumberSequence.new(scaled)
                            obj:Emit(blackFlashParticleCount)
                        end)
                    end
                end
                retainBlackFlashObject(wrapper, 4 * (blackFlashActiveObjects._state.durationFactor or 1.6))
            else
                local attachment = makeBlackFlashAttachment(anchor, impactCFrame)
                retainBlackFlashObject(attachment, 4 * (blackFlashActiveObjects._state.durationFactor or 1.6))
                local descendants = wrapper:GetDescendants()
                -- Reparent/play sounds before particle emission for tighter sync.
                for _, obj in ipairs(descendants) do
                    if obj:IsA("Sound") then
                        obj.Volume = blackFlashVolume
                        obj.Looped = false
                        local soundAttachment = makeBlackFlashAttachment(anchor, impactCFrame)
                        obj.Parent = soundAttachment
                        retainBlackFlashObject(soundAttachment, math.max(3, obj.TimeLength + 0.5))
                        -- Startup discovery preloads source sounds; don't wait on Loaded here,
                        -- because waiting at hit-time makes audio lag behind the VFX burst.
                        pcall(function() obj.TimePosition = 0 end)
                        pcall(function() obj:Play() end)
                        retainBlackFlashObject(obj, math.max(4, obj.TimeLength + 1))
                    end
                end
                for _, obj in ipairs(descendants) do
                    if obj:IsA("ParticleEmitter") then
                        obj.Rate = 0
                        obj.Enabled = true
                        pcall(function()
                            local durationScale = blackFlashActiveObjects._state.durationFactor or 1.6
                            local life = obj.Lifetime
                            obj.Lifetime = NumberRange.new(life.Min * durationScale, life.Max * durationScale)
                            local sizeScale = blackFlashActiveObjects._state.effectScale or 0.58
                            local keys = obj.Size.Keypoints
                            local scaled = table.create(#keys)
                            for i, keypoint in ipairs(keys) do
                                scaled[i] = NumberSequenceKeypoint.new(keypoint.Time, keypoint.Value * sizeScale, keypoint.Envelope * sizeScale)
                            end
                            obj.Size = NumberSequence.new(scaled)
                        end)
                        obj.Parent = attachment
                        pcall(function() obj:Emit(blackFlashParticleCount) end)
                        retainBlackFlashObject(obj, 3.8 * (blackFlashActiveObjects._state.durationFactor or 1.6))
                    end
                end
                wrapper:Destroy()
            end
        end
        if blackFlashStatus then blackFlashStatus.Text = "Played local Black Flash FX at impact: " .. tostring(record.path) end
        return true
    end
    local function attachBlackFlashCharacter(character)
        disconnectBlackFlashAnimation()
        character = character or player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not character or not humanoid then return end
        blackFlashAnimationConnection = {}
        local function recordAttackTrack(track)
            if not blackFlashMod or not blackFlashMod.enabled or not track then return end
            -- Animation tracks are a backup signal only. Require Action priority here;
            -- mouse/skill-key input handles attack timing when YBA doesn't expose tracks.
            -- Ordinary walking/idle animations must not make unrelated damage count.
            local priority = track.Priority
            if not priority or priority.Value < Enum.AnimationPriority.Action.Value then return end
            blackFlashActiveObjects._state.recentAttackAt = os.clock()
        end
        local function hookAnimationSignal(signal)
            table.insert(blackFlashAnimationConnection, signal:Connect(recordAttackTrack))
        end
        local seenAnimators = {}
        local function hookAnimator(obj)
            if obj and obj:IsA("Animator") and not seenAnimators[obj] then
                seenAnimators[obj] = true
                hookAnimationSignal(obj.AnimationPlayed)
            end
        end
        hookAnimationSignal(humanoid.AnimationPlayed)
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("Animator") then hookAnimator(obj) end
        end
        table.insert(blackFlashAnimationConnection, character.DescendantAdded:Connect(function(obj)
            if obj:IsA("Animator") then hookAnimator(obj) end
        end))
        -- YBA can play Stand attack tracks on a model under workspace.Living rather
        -- than on the player's Humanoid. Watch that local player's live rig too.
        local living = workspace:FindFirstChild("Living")
        local liveCharacter = living and living:FindFirstChild(player.Name)
        if liveCharacter and liveCharacter ~= character then
            for _, obj in ipairs(liveCharacter:GetDescendants()) do
                if obj:IsA("Animator") then hookAnimator(obj) end
            end
            table.insert(blackFlashAnimationConnection, liveCharacter.DescendantAdded:Connect(function(obj)
                if obj:IsA("Animator") then hookAnimator(obj) end
            end))
        end
    end
    local function stopBlackFlash()
        disconnectBlackFlashAnimation()
        if blackFlashRespawnConnection then
            if type(blackFlashRespawnConnection) == "table" then
                for _, conn in ipairs(blackFlashRespawnConnection) do
                    pcall(function() conn:Disconnect() end)
                end
            else
                pcall(function() blackFlashRespawnConnection:Disconnect() end)
            end
            blackFlashRespawnConnection = nil
        end
        blackFlashActiveObjects._state.recentAttackAt = 0
        cleanupBlackFlashObjects()
    end
    blackFlashMod = addModule(visualPanel, "Black Flash VFX + Sound", function(on)
        stopBlackFlash()
        if not on then return end
        blackFlashRespawnConnection = {}
        local function keepConnection(connection)
            table.insert(blackFlashRespawnConnection, connection)
            return connection
        end
        keepConnection(player.CharacterAdded:Connect(function(character)
            task.delay(0.45, function()
                if blackFlashMod and blackFlashMod.enabled then attachBlackFlashCharacter(character) end
            end)
        end))
        -- Input timestamps are a fallback for YBA combat/Stand moves whose tracks
        -- are not exposed through the local Humanoid's AnimationPlayed signal.
        -- The effect still only fires when another player's health actually drops.
        keepConnection(UserInputService.InputBegan:Connect(function(input)
            if not blackFlashMod or not blackFlashMod.enabled then return end
            if UserInputService:GetFocusedTextBox() then return end
            local isAttackInput = input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local key = input.KeyCode
                -- Include common YBA moves and hotbar inputs (1-9), plus Q for games that bind it.
                isAttackInput = key == Enum.KeyCode.Q or key == Enum.KeyCode.E or key == Enum.KeyCode.R
                    or key == Enum.KeyCode.T or key == Enum.KeyCode.Y or key == Enum.KeyCode.F
                    or key == Enum.KeyCode.G or key == Enum.KeyCode.H or key == Enum.KeyCode.Z
                    or key == Enum.KeyCode.X or key == Enum.KeyCode.C or key == Enum.KeyCode.V
                    or key == Enum.KeyCode.B or key == Enum.KeyCode.One or key == Enum.KeyCode.Two
                    or key == Enum.KeyCode.Three or key == Enum.KeyCode.Four or key == Enum.KeyCode.Five
                    or key == Enum.KeyCode.Six or key == Enum.KeyCode.Seven or key == Enum.KeyCode.Eight
                    or key == Enum.KeyCode.Nine
            end
            if isAttackInput then
                -- Some YBA combat inputs are marked processed. The effect still requires
                -- actual nearby opponent health loss inside the short attack window.
                blackFlashActiveObjects._state.recentAttackAt = os.clock()
                if blackFlashStatus then
                    blackFlashStatus.Text = "Attack input detected — waiting for nearby target health to drop."
                end
            end
        end))
        local watchedTargetModels = {}
        local playerTargetWatchers = {}
        -- HealthChanged signals are not consistently exposed on every YBA live rig.
        -- Share one handler between the signal and a low-rate polling fallback.
        local processedDamage = setmetatable({}, {__mode = "k"})
        local function handleBlackFlashDamage(character, humanoid, oldHealth, newHealth)
            if newHealth >= oldHealth - 0.05 then return end
            if not blackFlashMod or not blackFlashMod.enabled then return end
            local now = os.clock()
            local seen = processedDamage[humanoid]
            if seen and math.abs((seen.health or -999) - newHealth) < 0.001
                and now - (seen.at or 0) < 0.65 then
                return -- same health drop was reported by both signal and polling fallback
            end
            processedDamage[humanoid] = {health = newHealth, at = now}

            local lastAttack = blackFlashActiveObjects._state and blackFlashActiveObjects._state.recentAttackAt or 0
            if now - lastAttack > 5.0 then
                if blackFlashStatus then blackFlashStatus.Text = "Damage detected, but no attack input/animation was recorded in the last 5 seconds. Try clicking/using the move again." end
                return
            end
            if now - blackFlashLastTrigger < blackFlashCooldown then return end

            local attackerCharacter = blackFlashAttackerCharacter()
            local attackerRoot = attackerCharacter and (attackerCharacter:FindFirstChild("HumanoidRootPart")
                or attackerCharacter:FindFirstChild("UpperTorso") or attackerCharacter:FindFirstChild("Torso"))
            local targetRoot = character and (character:FindFirstChild("HumanoidRootPart")
                or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"))
            if not attackerRoot or not targetRoot then
                if blackFlashStatus then blackFlashStatus.Text = "Damage detected, but a character root part was missing." end
                return
            end
            local distance = (attackerRoot.Position - targetRoot.Position).Magnitude
            if distance > 22 then
                if blackFlashStatus then blackFlashStatus.Text = string.format("Damage detected %.1f studs away (limit 22).", distance) end
                return
            end
            if math.random(1, 100) > blackFlashChance then
                if blackFlashStatus then blackFlashStatus.Text = "Hit detected; chance roll did not trigger Black Flash." end
                return
            end

            blackFlashLastTrigger = now
            local ok, result = pcall(cloneBlackFlashSource, character)
            if not ok or result == false then
                local err = ok and "No compatible Black Flash source could be played." or tostring(result)
                if blackFlashStatus then blackFlashStatus.Text = "Black Flash playback failed: " .. err end
                warn("[TrueSight] Black Flash FX failed: " .. err)
            elseif blackFlashStatus then
                blackFlashStatus.Text = "Hit confirmed — Black Flash triggered."
            end
        end

        local function watchTargetModel(targetPlayer, character)
            if targetPlayer == player or not character or watchedTargetModels[character] then return end
            local record = {player = targetPlayer, connection = nil}
            watchedTargetModels[character] = record
            task.spawn(function()
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                    or character:WaitForChild("Humanoid", 5)
                if not humanoid or not humanoid:IsA("Humanoid") or not character.Parent
                    or watchedTargetModels[character] ~= record then return end
                local previousHealth = humanoid.Health
                record.connection = humanoid.HealthChanged:Connect(function(newHealth)
                    local oldHealth = previousHealth
                    previousHealth = newHealth
                    handleBlackFlashDamage(character, humanoid, oldHealth, newHealth)
                end)
                keepConnection(record.connection)
            end)
        end
        local function clearWatchedModelsForPlayer(targetPlayer)
            for character, record in pairs(watchedTargetModels) do
                if record.player == targetPlayer then
                    if record.connection then pcall(function() record.connection:Disconnect() end) end
                    watchedTargetModels[character] = nil
                end
            end
        end
        local function watchTargetForms(targetPlayer, character)
            if targetPlayer == player then return end
            watchTargetModel(targetPlayer, character)
            task.delay(0.3, function()
                if not blackFlashMod or not blackFlashMod.enabled then return end
                local living = workspace:FindFirstChild("Living")
                local liveCharacter = living and living:FindFirstChild(targetPlayer.Name)
                if liveCharacter and liveCharacter ~= character then watchTargetModel(targetPlayer, liveCharacter) end
            end)
        end
        local function watchTargetPlayer(targetPlayer)
            if targetPlayer == player or playerTargetWatchers[targetPlayer] then return end
            playerTargetWatchers[targetPlayer] = true
            if targetPlayer.Character then
                watchTargetForms(targetPlayer, targetPlayer.Character)
            else
                task.delay(0.35, function()
                    if not blackFlashMod or not blackFlashMod.enabled then return end
                    local living = workspace:FindFirstChild("Living")
                    local liveCharacter = living and living:FindFirstChild(targetPlayer.Name)
                    if liveCharacter then watchTargetModel(targetPlayer, liveCharacter) end
                end)
            end
            keepConnection(targetPlayer.CharacterAdded:Connect(function(character)
                clearWatchedModelsForPlayer(targetPlayer)
                watchTargetForms(targetPlayer, character)
            end))
        end
        local function bindLivingFolder(living)
            if not living or not living:IsA("Folder") and not living:IsA("Model") then return end
            for _, liveCharacter in ipairs(living:GetChildren()) do
                local targetPlayer = Players:FindFirstChild(liveCharacter.Name)
                if targetPlayer and targetPlayer ~= player then watchTargetModel(targetPlayer, liveCharacter) end
            end
            keepConnection(living.ChildAdded:Connect(function(liveCharacter)
                local targetPlayer = Players:FindFirstChild(liveCharacter.Name)
                if targetPlayer and targetPlayer ~= player then watchTargetModel(targetPlayer, liveCharacter) end
                if liveCharacter.Name == player.Name then
                    task.defer(function()
                        if blackFlashMod and blackFlashMod.enabled then attachBlackFlashCharacter(player.Character) end
                    end)
                end
            end))
        end
        -- Poll both normal Player.Character rigs and workspace.Living mirrors at 8 Hz.
        -- Some YBA builds replicate the visible health change only on one of these forms.
        local healthPollAccumulator = 0
        local healthPollLast = setmetatable({}, {__mode = "k"})
        keepConnection(RunService.Heartbeat:Connect(function(dt)
            if not blackFlashMod or not blackFlashMod.enabled then return end
            healthPollAccumulator += dt
            if healthPollAccumulator < 0.125 then return end
            healthPollAccumulator = 0
            local candidates = {}
            local living = workspace:FindFirstChild("Living")
            if living then
                for _, character in ipairs(living:GetChildren()) do
                    -- Some YBA live models don't exactly match a Player.Name. Watch
                    -- every non-local humanoid under Living and let distance + attack
                    -- timing reject unrelated damage.
                    if character ~= player.Character and character.Name ~= player.Name
                        and character:FindFirstChildOfClass("Humanoid") then
                        candidates[character] = true
                    end
                end
            end
            for _, targetPlayer in ipairs(Players:GetPlayers()) do
                if targetPlayer ~= player and targetPlayer.Character then
                    candidates[targetPlayer.Character] = targetPlayer
                end
            end
            for character in pairs(candidates) do
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    local currentHealth = humanoid.Health
                    local oldHealth = healthPollLast[humanoid]
                    if oldHealth == nil then
                        healthPollLast[humanoid] = currentHealth
                    else
                        if currentHealth < oldHealth - 0.05 then
                            handleBlackFlashDamage(character, humanoid, oldHealth, currentHealth)
                        end
                        healthPollLast[humanoid] = currentHealth
                    end
                end
            end
        end))

        attachBlackFlashCharacter(player.Character)
        for _, targetPlayer in ipairs(Players:GetPlayers()) do watchTargetPlayer(targetPlayer) end
        keepConnection(Players.PlayerAdded:Connect(watchTargetPlayer))
        local currentLiving = workspace:FindFirstChild("Living")
        if currentLiving then
            bindLivingFolder(currentLiving)
        else
            keepConnection(workspace.ChildAdded:Connect(function(child)
                if child.Name == "Living" then bindLivingFolder(child) end
            end))
        end
        if blackFlashStatus then
            blackFlashStatus.Text = #blackFlashAssets > 0
                and "Enabled: watches player + Living health. Chance defaults to 100% for testing; lower it after confirming triggers."
                or "Enabled, but no named Black Flash assets were found at startup."
        end
    end)
    blackFlashCycle = blackFlashMod.cycle("FX Source", blackFlashNames, 1, function(i)
        blackFlashSelectedIndex = i
    end)
    blackFlashMod.slider("Trigger Chance (%)", 0, 100, blackFlashChance, 1, function(v) blackFlashChance = v end)
    blackFlashMod.slider("Sound Volume", 0, 2, blackFlashVolume, 0.1, function(v) blackFlashVolume = v end)
    blackFlashMod.slider("Cooldown (seconds)", 0.2, 5, blackFlashCooldown, 0.1, function(v) blackFlashCooldown = v end)
    blackFlashMod.slider("VFX Duration", 1, 2.5, blackFlashActiveObjects._state.durationFactor, 0.1, function(v)
        blackFlashActiveObjects._state.durationFactor = v
    end)
    blackFlashMod.slider("Effect Scale", 0.25, 1.0, blackFlashActiveObjects._state.effectScale, 0.05, function(v)
        blackFlashActiveObjects._state.effectScale = v
    end)
    local blackFlashSettings = blackFlashCycle.button.Parent
    local blackFlashTestButton = addAction({frame = blackFlashSettings, n = 59, panel = blackFlashSettings}, "Test Black Flash FX (self)", function()
        local ok, err = pcall(cloneBlackFlashSource, player.Character)
        if not ok and blackFlashStatus then blackFlashStatus.Text = "Test failed: " .. tostring(err) end
    end)
    if blackFlashTestButton then blackFlashTestButton.LayoutOrder = 59 end
    blackFlashStatus = Instance.new("TextLabel")
    blackFlashStatus.LayoutOrder = 60
    blackFlashStatus.Size = UDim2.new(1, 0, 0, 42)
    blackFlashStatus.BackgroundTransparency = 1
    blackFlashStatus.Font = FONT
    blackFlashStatus.TextSize = 10
    blackFlashStatus.TextWrapped = true
    blackFlashStatus.TextXAlignment = Enum.TextXAlignment.Left
    blackFlashStatus.TextColor3 = DIM
    blackFlashStatus.Text = "Black Flash assets are discovered automatically at startup."
    blackFlashStatus.Parent = blackFlashSettings
    visualModules.blackFlash = blackFlashMod
    visualModules.stopBlackFlash = stopBlackFlash

    ------------------------------------------------------------------
    -- Orbiting orbs: one capped-rate update loop for three local lights.
    ------------------------------------------------------------------
    local orbParts, orbConnection = {}, nil
    local orbSpeed, orbRadius = 1.6, 1.8
    local orbCharacter
    local function removeOrbs()
        if orbConnection then orbConnection:Disconnect(); orbConnection = nil end
        for _, obj in ipairs(orbParts) do if obj and obj.Parent then obj:Destroy() end end
        table.clear(orbParts)
        orbCharacter = nil
    end
    local function addOrbs(character)
        removeOrbs()
        character = character or player.Character
        if not character then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        orbCharacter = character
        for i = 1, 3 do
            local orb = Instance.new("Part")
            orb.Name = "TrueSightOrbitingOrb"
            orb.Shape = Enum.PartType.Ball
            orb.Size = Vector3.new(0.22, 0.22, 0.22)
            orb.Material = Enum.Material.Neon
            orb.Color = accent
            orb.CanCollide = false
            orb.CanTouch = false
            orb.CanQuery = false
            orb.CastShadow = false
            orb.Anchored = true
            orb.Parent = workspace
            table.insert(orbParts, orb)
        end
        local lastUpdate = 0
        local t = 0
        orbConnection = RunService.Heartbeat:Connect(function(dt)
            if not orbCharacter or player.Character ~= orbCharacter or not root.Parent then return end
            t += math.min(dt, 0.08) * orbSpeed
            lastUpdate += dt
            if lastUpdate < 1 / 30 then return end
            lastUpdate = 0
            for i, orb in ipairs(orbParts) do
                if orb.Parent then
                    local angle = t + (i - 1) * (math.pi * 2 / #orbParts)
                    local pos = root.Position + Vector3.new(math.cos(angle) * orbRadius, 0.7 + math.sin(t * 1.2 + i) * 0.45, math.sin(angle) * orbRadius)
                    orb.CFrame = CFrame.new(pos)
                end
            end
        end)
    end
    onAccent(function(c) for _, obj in ipairs(orbParts) do if obj and obj.Parent then obj.Color = c end end end)
    local orbsMod = addModule(visualPanel, "Orbiting Orbs", function(on)
        if on then addOrbs(player.Character) else removeOrbs() end
    end)
    orbsMod.slider("Orbit Speed", 0.2, 4, orbSpeed, 0.1, function(v) orbSpeed = v end)
    orbsMod.slider("Orbit Radius", 1, 3.5, orbRadius, 0.1, function(v) orbRadius = v end)
    visualModules.orbs = orbsMod
    visualModules.addOrbs = addOrbs
    visualModules.removeOrbs = removeOrbs

    ------------------------------------------------------------------
    -- Footstep sparks: throttled emission while walking on the ground.
    ------------------------------------------------------------------
    local footstepConnection
    local function stopFootstepSparks()
        if footstepConnection then footstepConnection:Disconnect(); footstepConnection = nil end
    end
    local function startFootstepSparks(character)
        stopFootstepSparks()
        character = character or player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        local elapsed = 0
        local emitted = 0
        footstepConnection = RunService.Heartbeat:Connect(function(dt)
            elapsed += dt
            if elapsed < 0.22 then return end
            elapsed = 0
            if player.Character ~= character or not root.Parent then return end
            if hum.MoveDirection.Magnitude < 0.12 or hum.FloorMaterial == Enum.Material.Air then return end
            emitted += 1
            local side = (emitted % 2 == 0) and 0.55 or -0.55
            local spark = Instance.new("Part")
            spark.Name = "TrueSightFootstepSpark"
            spark.Shape = Enum.PartType.Ball
            spark.Size = Vector3.new(0.13, 0.13, 0.13)
            spark.Material = Enum.Material.Neon
            spark.Color = accent
            spark.Anchored = true
            spark.CanCollide = false
            spark.CanTouch = false
            spark.CanQuery = false
            spark.CastShadow = false
            spark.CFrame = CFrame.new(root.Position + root.CFrame.RightVector * side + Vector3.new(0, -2.35, 0))
            spark.Parent = workspace
            TweenService:Create(spark, TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = Vector3.new(0.02, 0.02, 0.02), Transparency = 1,
                CFrame = spark.CFrame + Vector3.new(0, 0.35, 0),
            }):Play()
            Debris:AddItem(spark, 0.48)
        end)
    end
    local footstepMod = addModule(visualPanel, "Footstep Sparks", function(on)
        if on then startFootstepSparks(player.Character) else stopFootstepSparks() end
    end)
    visualModules.footsteps = footstepMod
    visualModules.startFootstepSparks = startFootstepSparks
    visualModules.stopFootstepSparks = stopFootstepSparks

