        if keyUiState.binding or keyUiState.bindingModule or keyUiState.capture then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard or UserInputService:GetFocusedTextBox() then return end
        if os.clock() - lastKeyAt > 2.3 then progress = 0 end
        lastKeyAt = os.clock()
        local expected = sequence[progress + 1]
        progress = (input.KeyCode == expected) and progress + 1 or (input.KeyCode == sequence[1] and 1 or 0)
