    task.defer(function()
        if not modules._unloaded and refreshSpawnList then refreshSpawnList() end
    end)
    table.insert(connections, player.CharacterAdded:Connect(function(character)
        task.defer(function()
            if not modules._unloaded then scheduleRespawn(character) end
        end)
    end))
    modules._cleanupSpawnMarker = function()
        spawnState.spawnToken += 1
        spawnState.testToken += 1
        -- Delete any leftover waypoint from an earlier version if still present.
        if gui then
            local old = gui:FindFirstChild("TrueSightPreferredSpawnWaypoint", true)
            if old then old:Destroy() end
        end
        local oldPart = workspace:FindFirstChild("TrueSightLocalSpawnWaypoint")
        if oldPart then oldPart:Destroy() end
    end
    -- A re-executed older version might have left an orphaned waypoint visible.
    local oldWaypoint = gui:FindFirstChild("TrueSightPreferredSpawnWaypoint", true)
    if oldWaypoint then oldWaypoint:Destroy() end
    local oldAnchor = workspace:FindFirstChild("TrueSightLocalSpawnWaypoint")
    if oldAnchor then oldAnchor:Destroy() end
end, function(e) return tostring(e) end)
if not qosOK then
    warn("[TrueSight] Optional QoL/spawn setup failed (menu will still load): " .. tostring(qosError))
end
