            pcall(function() humanoid.EvaluateStateMachine = false end)
            root.Transparency = 1
            root.LocalTransparencyModifier = 1
            root.Anchored = true
            local torsoRelative = root.CFrame:ToObjectSpace(torso.CFrame)
            local destination = standTorso.CFrame * torsoRelative:Inverse()
            local pivotOffset = root.CFrame:ToObjectSpace(skin:GetPivot())
            skin:PivotTo(destination * pivotOffset)
