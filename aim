                        table.insert(entry.connections, source.Stopped:Connect(function()
                            entry.tracks[source] = nil
                            pcall(function() targetTrack:Stop(0.1); targetTrack:Destroy() end)
                        end))
                    end
                end
                table.insert(entry.connections, sourceAnimator.AnimationPlayed:Connect(playCopy))
