                    end
                end
            end
            spawnCache = {found = found, npcs = npcs,
                center = #found > 0 and sum / #found or Vector3.new(0,0,0)}
        end
        local found, npcs, center = spawnCache.found, spawnCache.npcs, spawnCache.center
        table.sort(found, function(a,b)
            if math.abs(a.Position.X - b.Position.X) > 1 then return a.Position.X < b.Position.X end
            if math.abs(a.Position.Z - b.Position.Z) > 1 then return a.Position.Z < b.Position.Z end
            return a:GetFullName() < b:GetFullName()
        end)
        locationTitle.Text = #found == 0 and "NO SPAWN LOCATIONS FOUND"
            or string.format("LOCATIONS  •  %d", #found)
        local selectedPad = nil
        for i, pad in ipairs(found) do
            local key = spawnKey(pad)
