-- Cycle widget: click to step through options
local function addCycle(parent, label, options, start, onChange, key)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 24)
    styleButton(b)
    b.BackgroundColor3 = SUB
    b.TextSize = 12
    local idx = start
    local function refresh()
        b.Text = "      " .. label .. ":  " .. options[idx]
    end
    refresh()
    b.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        refresh()
        onChange(idx)
        requestSave()
    end)
    if key then
        registerConfig(key, function() return idx end, function(i)
            if type(i) == "number" and options[i] then
                idx = i
                refresh()
                onChange(i)
