    character:WaitForChild("Head")
    character:WaitForChild("HumanoidRootPart")
    if enabled["China Hat"] then addHat(character) end
    if enabled["Player Trails"] then addTrail(character) end
end))

-- Restore everything and remove the client
local function cleanup()
    for _, fn in ipairs(resetFns) do
        pcall(fn)
    end
    if fogConn then fogConn:Disconnect() fogConn = nil end
    for _, c in ipairs(connections) do
        c:Disconnect()
    end
    table.clear(connections)

    removeHat()
    removeTrail()
    camera.FieldOfView = oldFOV
    Lighting.Brightness = oldLighting.Brightness
    Lighting.ClockTime = oldLighting.ClockTime
    Lighting.Ambient = oldLighting.Ambient
    Lighting.OutdoorAmbient = oldLighting.OutdoorAmbient
    Lighting.GlobalShadows = oldLighting.GlobalShadows
    Lighting.FogStart = oldLighting.FogStart
    Lighting.FogEnd = oldLighting.FogEnd
    correction:Destroy()
    blur:Destroy()
    gui:Destroy()
end

button("Unload Client", cleanup)

