-- Config saving (needs an executor with writefile / readfile)
------------------------------------------------------------------
;(function()
local CONFIG_PATH = canFolder and "TrueSight/config.json" or "TrueSightConfig.json"
local currentProfile = "default"

local function normalizeProfileName(value)
    local safe = string.gsub(tostring(value or ""), "[^%w_-]", "")
    return string.sub(safe, 1, 24)
end

local function profilePath(profile)
    if profile == "default" then return CONFIG_PATH end
    if canFolder then return "TrueSight/" .. profile .. ".json" end
    return "TrueSight_" .. profile .. ".json"
end

local function readConfig(profileName)
    local profile = normalizeProfileName(profileName or currentProfile)
    if profile == "" then return nil end
    local path = profilePath(profile)
    if profile == "default" and canFile and not isfile(path) then
        local legacyPath = canFolder and "VisualClient/config.json" or "VisualClientConfig.json"
        if isfile(legacyPath) then path = legacyPath end
    end
    if not canFile or not isfile(path) then return nil end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if ok and type(data) == "table" then return data end
    return nil
end

saveConfig = function(profileName)
    if not canFile then return false end
    local profile = normalizeProfileName(profileName or currentProfile)
    if profile == "" then return false end
    currentProfile = profile
    local path = profilePath(profile)

    local data = {
        version = 1,
        accent = accentIndex,
        menuKey = keyUiState.menuKey.Name,
        modules = {},
        values = {},
        panels = {},
    }
    for _, m in ipairs(modules) do
        data.modules[m.name] = m.enabled
    end
    for key, e in pairs(configEntries) do
        local ok, v = pcall(e.get)
        if ok then data.values[key] = v end
    end
    for title, panel in pairs(panelRegistry) do
        data.panels[title] = {
            x = panel.Position.X.Offset,
            y = panel.Position.Y.Offset,
        }
    end

    local ok = pcall(function()
        if canFolder and not isfolder("TrueSight") then
            makefolder("TrueSight")
        end
        writefile(path, HttpService:JSONEncode(data))
    end)
    return ok
end

local function applyConfig(data)
    configLoading = true

    if type(data.accent) == "number" and presets[data.accent] then
        setAccentIndex(data.accent)
    end

    -- settings first, so modules switch on with their saved values
    if type(data.values) == "table" then
        for key, v in pairs(data.values) do
            local e = configEntries[key]
            if e then pcall(e.set, v) end
        end
    end

    if type(data.menuKey) == "string" then
        local ok, kc = pcall(function() return Enum.KeyCode[data.menuKey] end)
        if ok and kc then
            keyUiState.menuKey = kc
            keyUiState.updateKeyUi()
        end
    end

    if type(data.panels) == "table" then
        for title, pos in pairs(data.panels) do
            local panel = panelRegistry[title]
            if panel and type(pos) == "table"
                and type(pos.x) == "number" and type(pos.y) == "number" then
                panel.Position = UDim2.fromOffset(pos.x, pos.y)
            end
        end
    end

    if type(data.modules) == "table" then
        for _, m in ipairs(modules) do
            local want = data.modules[m.name]
            if want == nil and m.name == "Desync Box" then
                want = data.modules["Own Position Estimate"]
                if want == nil then want = data.modules["Desync Tracker"] end
            end
            if type(want) == "boolean" then m.set(want) end
        end
    end

    configLoading = false
end

