    local hum = character:WaitForChild("Humanoid", 5)
    character:WaitForChild("Head", 5)
    character:WaitForChild("HumanoidRootPart", 5)
    if hum then
        character:WaitForChild(
            hum.RigType == Enum.HumanoidRigType.R15 and "UpperTorso" or "Torso", 5)
    end
    if hatMod.enabled then addHat(character) end
    if trailMod.enabled then addTrail(character) end
    if wingMod.enabled then addWings(character) end
end))

