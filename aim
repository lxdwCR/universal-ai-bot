                    or not entry.standTorso.Parent then
                    cleanupEntry(entry)
                else
                    local sr, st = entry.standRoot, entry.standTorso
                    local expected = (sr.CFrame * entry.torsoOffset).Position
                    local deviation = (st.Position - expected).Magnitude
                    if entry.detached then
                        if deviation < 1.35 then entry.detached = false end
                    elseif deviation > 3.25 then
                        entry.detached = true
                    end
                    -- Correct the weld angle if the skin faces backward.
                    local localTorso = root.CFrame:ToObjectSpace(entry.torso.CFrame)
                    local desired = st.CFrame * localTorso:Inverse()
                    if entry.detached then
                        if entry.weld then entry.weld:Destroy(); entry.weld = nil end
                        root.Anchored = true
                        root.CFrame = desired
