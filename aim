    local function removeHalo()
        for _, obj in ipairs(haloParts) do if obj and obj.Parent then obj:Destroy() end end
        table.clear(haloParts)
        table.clear(haloSegmentRecords)
        haloHead = nil
    end
    local function updateHaloGeometry()
        if not haloHead or not haloHead.Parent then return end
        local radius = haloSize * 0.68
        local y = haloHead.Size.Y * 0.64
        for _, rec in ipairs(haloSegmentRecords) do
            rec.attachment.Position = Vector3.new(math.cos(rec.angle) * radius, y, math.sin(rec.angle) * radius)
        end
    end
    local function addHalo(character)
        removeHalo()
        character = character or player.Character
        local head = character and character:FindFirstChild("Head")
        if not head then return end
        haloHead = head
        local attachments = {}
        local radius = haloSize * 0.68
        local y = head.Size.Y * 0.64
        for index = 1, haloRingSegments do
            local angle = (index - 1) * (math.pi * 2 / haloRingSegments)
            local attachment = Instance.new("Attachment")
            attachment.Name = "TrueSightHaloPoint"
            attachment.Position = Vector3.new(math.cos(angle) * radius, y, math.sin(angle) * radius)
            attachment.Parent = head
            table.insert(attachments, attachment)
            table.insert(haloParts, attachment)
            table.insert(haloSegmentRecords, {attachment = attachment, angle = angle})
        end
        for index = 1, haloRingSegments do
            local nextIndex = (index % haloRingSegments) + 1
            local beam = Instance.new("Beam")
            beam.Name = "TrueSightHaloSegment"
            beam.Attachment0 = attachments[index]
            beam.Attachment1 = attachments[nextIndex]
            beam.Width0 = haloRingWidth
            beam.Width1 = haloRingWidth
            beam.FaceCamera = true
            beam.LightEmission = 1
            beam.LightInfluence = 0
            beam.Color = ColorSequence.new(accent)
            beam.Transparency = NumberSequence.new(0.06)
            beam.Segments = 1
            beam.Parent = head
            table.insert(haloParts, 1, beam)
        end
