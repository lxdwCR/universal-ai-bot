stunTimerMod = addModule(hudPanel, "YBA Stun Timer", function(on)
    if stunTimerConn then stunTimerConn:Disconnect() stunTimerConn = nil end
    updateStunDisplay()
    stunStartedAt = nil
    predictedStunDuration = nil
    if on then
        local elapsed = 0
        stunTimerConn = RunService.Heartbeat:Connect(function(dt)
            elapsed += dt
            if elapsed < 0.08 then return end
            elapsed = 0
            local stunned = isLocallyStunned()
            local explicitRemaining, signalDuration = getStunTimingSignals()
            local now = os.clock()
            if stunned then
                if not stunStartedAt then
                    stunStartedAt = now
                    -- If the game exposes a total duration, use it; otherwise use the last observed duration (2s
                    -- until we learn one).
                    predictedStunDuration = math.clamp(signalDuration or learnedStunDuration, 0.25, 15)
                end
                local left
                if explicitRemaining and explicitRemaining > 0 then
                    left = explicitRemaining
                    setStunTimerText(string.format("STUN: %.1fs LEFT", left), BAD)
                else
                    left = math.max(0, predictedStunDuration - (now - stunStartedAt))
                    if left > 0 then
                        setStunTimerText(string.format("STUN: ~%.1fs LEFT", left), BAD)
                    else
                        -- Detection is still active after our estimate expired. Never imply the stun ended until the
                        -- detected flag clears.
                        setStunTimerText("STUN: ~0.0s LEFT", BAD)
                    end
                end
                updateStunDisplay()
            else
                if stunStartedAt then
                    local observed = now - stunStartedAt
                    if observed >= 0.2 and observed <= 12 then
                        -- Learn a smoothed fallback duration for later stuns.
                        learnedStunDuration = math.clamp(learnedStunDuration * 0.55 + observed * 0.45, 0.25, 12)
                    end
                end
                stunStartedAt = nil
                predictedStunDuration = nil
                setStunTimerText("STUN: not detected", TEXT)
                updateStunDisplay()
            end
        end)
    end
end)
