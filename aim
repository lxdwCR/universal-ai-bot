    uiInteraction.addResizeGrip(panel, "panel")
    return state
end

-- Resolve both the usual {frame = Frame, n = number} wrapper and a raw Frame. Some
-- executor/build combinations produced a nil panel argument during UI setup; fall back to an
-- existing utility panel rather than aborting the entire script.
local function resolvePanelState(panel)
    if type(panel) == "table" and panel.frame then
        return panel
    end
    if typeof(panel) == "Instance" then
        return panelStatesByFrame[panel]
    end

    local preferred = panelRegistry["Client"] or panelRegistry["Config"]
    if preferred and panelStatesByFrame[preferred] then
        warn("[TrueSight] UI helper received a nil panel; using " .. preferred.Name .. " panel as fallback")
        return panelStatesByFrame[preferred]
    end
    for _, frame in pairs(panelRegistry) do
        local state = panelStatesByFrame[frame]
        if state then
            warn("[TrueSight] UI helper received a nil panel; using " .. frame.Name .. " panel as fallback")
            return state
        end
    end
    return nil
end

local function nextOrder(panel)
    local state = resolvePanelState(panel)
    if not state then
        fallbackOrder += 1
        warn("[TrueSight] Could not resolve panel for LayoutOrder; using fallback order " .. tostring(fallbackOrder))
        return 100000 + fallbackOrder
    end
    state.n = (tonumber(state.n) or 0) + 1
    return state.n
end

