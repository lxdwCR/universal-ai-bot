        list.Size = UDim2.new(1, -16, 1, -87)
        list.AutomaticCanvasSize = Enum.AutomaticSize.Y
        list.ScrollBarThickness = 3
        list.Parent = rail
        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 5)
        layout.Parent = list
        local pages = {"Quick", "Visual", "Prediction", "Render", "World", "HUD", "Performance", "Keybinds", "Spawns", "Backgrounds", "Client", "Config"}
        local buttons = {}
        local function selectPage(selected)
            clickGui:SetAttribute("TrueSightActivePage", selected)
            for name,p in pairs(panelRegistry) do
                if p and p.Parent then p.Visible = (name == selected) end
            end
            for name,b in pairs(buttons) do
                b.BackgroundColor3 = name == selected and Color3.fromRGB(30, 61, 57) or Color3.fromRGB(18, 23, 33)
                b.TextColor3 = name == selected and TEXT or DIM
            end
        end
        for i,name in ipairs(pages) do
            local p = panelRegistry[name]
            if p and p.Parent then
                p.Parent = frame
                p:SetAttribute("TrueSightNavPage", true)
                p.Position = UDim2.fromOffset(170, 8)
                p.Size = UDim2.fromOffset(w-178, h-16)
                p.ZIndex = 3
                p.Visible = false
                local btn = Instance.new("TextButton")
                btn.LayoutOrder = i
                btn.Size = UDim2.new(1, 0, 0, 36)
                btn.BackgroundColor3 = Color3.fromRGB(18, 23, 33)
                btn.BorderSizePixel = 0
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Text = "    " .. name
                btn.Font = FONTB
                btn.TextSize = 12
                btn.TextColor3 = DIM
                btn.Parent = list
                corner(btn, 6)
                buttons[name] = btn
                btn.MouseButton1Click:Connect(function() selectPage(name) end)
            end
        end
        clickGui:SetAttribute("TrueSightMenuRehaul", true)
        clickGui:GetAttributeChangedSignal("TrueSightRequestPage"):Connect(function()
            local target = clickGui:GetAttribute("TrueSightRequestPage")
            if buttons[target] then selectPage(target) end
        end)
        selectPage(buttons.Visual and "Visual" or (buttons.Client and "Client" or "Config"))
        hint.Visible = false
    end)
end
end -- menu rehaul scope

-- Auto-load after the UI and module callbacks have finished initializing. The dedicated
-- snapshot is authoritative when present; the selected profile file is the fallback if the
-- snapshot cannot be decoded.
if canFile then
    task.defer(function()
        -- Allow the GUI, module rows and setting registration to finish first.
        task.wait(0.8)
        if modules._unloaded then return end

        -- A saved marker takes precedence over the cached snapshot. Only use the snapshot when it
        -- belongs to the selected profile, or when there is no marker and the snapshot is the only
        -- saved startup selection.
        local startupProfile, selectedStamp, selectionSource = getAutoLoadSelection()
        local snapshot, snapshotProfile, snapshotStamp = readStartupSnapshot()
        local data = nil
        local loadedFromSnapshot = false

        -- If the snapshot is the newest surviving selection, it is the chosen config itself. Otherwise
        -- prefer the selected profile file, falling back to a matching snapshot only if that profile
        -- file is unavailable.
        if selectionSource == "snapshot" and snapshot and snapshotProfile == startupProfile then
            data = snapshot
            loadedFromSnapshot = true
        else
            data = readConfig(startupProfile)
            if not data and snapshot and snapshotProfile == startupProfile then
                data = snapshot
                loadedFromSnapshot = true
            end
        end

        if data then
            currentProfile = startupProfile
            if profileInput then profileInput.Text = startupProfile end

            local applyOk = applyConfig(data)
            -- A few visual modules depend on Character/PlayerGui finishing their startup. Retry twice after
            -- short settling windows.
            task.wait(0.35)
            if modules._unloaded then return end
            local secondApplyOk = applyConfig(data)
            task.wait(0.5)
            if modules._unloaded then return end
            local thirdApplyOk = applyConfig(data)

            if modules._refreshFavouriteUI then pcall(modules._refreshFavouriteUI) end
            if modules._refreshKeybindManager then pcall(modules._refreshKeybindManager) end
            if applyOk and secondApplyOk and thirdApplyOk then
                notifyConfig("Config auto-loaded: " .. startupProfile .. (loadedFromSnapshot and " (snapshot)" or ""), false)
                print("[TrueSight] Startup config applied: " .. startupProfile
                    .. " (source=" .. tostring(loadedFromSnapshot and "snapshot" or "profile file")
                    .. ", selection=" .. tostring(selectionSource) .. ", timestamp=" .. tostring(selectedStamp) .. ")")
            else
                notifyConfig("Config found but application failed; see console", true)
                warn("[TrueSight] Startup config application failed for profile: " .. startupProfile)
            end
        else
            notifyConfig("Auto-load profile not found: " .. startupProfile, true)
            warn("[TrueSight] Could not read auto-load profile: " .. startupProfile)
        end
    end)
end
end)()

