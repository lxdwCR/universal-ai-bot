    local function blackFlashAnchor(character)
        return character and (character:FindFirstChild("HumanoidRootPart")
            or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
            or character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
            or character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm"))
    end
    local function blackFlashAttackerCharacter()
        -- YBA commonly mirrors player avatars inside workspace.Living. Prefer that live rig when it has
        -- a root, since it can be closer to the combat position than Player.Character during a
        -- respawn/Stand transition.
        local living = workspace:FindFirstChild("Living")
        local liveCharacter = living and living:FindFirstChild(player.Name)
        if liveCharacter and (liveCharacter:FindFirstChild("HumanoidRootPart")
            or liveCharacter:FindFirstChild("UpperTorso") or liveCharacter:FindFirstChild("Torso")) then
            return liveCharacter
        end
        return player.Character
    end
    local function blackFlashImpactCFrame(targetCharacter, anchor)
        local targetRoot = targetCharacter and (targetCharacter:FindFirstChild("HumanoidRootPart")
            or targetCharacter:FindFirstChild("UpperTorso") or targetCharacter:FindFirstChild("Torso"))
        local ownCharacter = blackFlashAttackerCharacter()
        local ownRoot = ownCharacter and (ownCharacter:FindFirstChild("HumanoidRootPart")
            or ownCharacter:FindFirstChild("UpperTorso") or ownCharacter:FindFirstChild("Torso"))
        if targetRoot and ownRoot and targetCharacter ~= ownCharacter then
            local toAttacker = ownRoot.Position - targetRoot.Position
            local flat = Vector3.new(toAttacker.X, 0, toAttacker.Z)
            if flat.Magnitude > 0.05 then
                -- Place the hit effect close to the target, facing the attacker.
                local position = targetRoot.Position + flat.Unit * math.min(0.38, flat.Magnitude * 0.10)
                    + Vector3.new(0, math.clamp(targetRoot.Size.Y * 0.12, 0.18, 0.38), 0)
                return CFrame.lookAt(position, ownRoot.Position + Vector3.new(0, 0.35, 0))
            end
        end
        local base = targetRoot or anchor
        return base.CFrame * CFrame.new(0, 0.8, -0.45)
    end
    local function makeBlackFlashAttachment(anchor, worldCFrame)
        local attachment = Instance.new("Attachment")
        attachment.Name = "TrueSightBlackFlashAttachment"
        attachment.CFrame = anchor.CFrame:ToObjectSpace(worldCFrame)
        attachment.Parent = anchor
        return attachment
    end
    local function cloneBlackFlashSource(character) 
        local anchor = blackFlashAnchor(character)
        if not anchor then
            if blackFlashStatus then blackFlashStatus.Text = "No hand/root part found on the target character." end
            return false
        end
        local impactCFrame = blackFlashImpactCFrame(character, anchor)
        if #blackFlashAssets == 0 then
            if blackFlashStatus then blackFlashStatus.Text = "No named Black Flash assets were found during startup discovery." end
            return false
        end
        -- Dropdown index 1 means Auto-detect (first discovered group); named options start at index 2
        -- and map to the corresponding discovered group minus one.
        local selectedIndex = tonumber(blackFlashSelectedIndex) or 1
        local sourceIndex = selectedIndex <= 1 and 1 or (selectedIndex - 1)
        sourceIndex = math.clamp(sourceIndex, 1, #blackFlashAssets)
        local record = blackFlashAssets[sourceIndex]
        if not record or not record.source or not record.source.Parent then
            if blackFlashStatus then blackFlashStatus.Text = "Selected Black Flash asset is no longer available. Restart TrueSight to refresh assets." end
            return false
        end
        -- Build one composite from the selected source plus whichever companion capability is missing.
        -- YBA often stores Black Flash VFX and audio in separate folders, so selecting either one
        -- should still play BOTH when both are available.
        local selectedClone = cloneArchivable(record.source)
        if not selectedClone then
            if blackFlashStatus then blackFlashStatus.Text = "Could not clone " .. tostring(record.label) end
            return false
        end
        local composite = Instance.new("Folder")
        composite.Name = "TrueSightBlackFlashComposite"

        -- Strip large scene lights from cloned Black Flash effects.
        local function stripBlackFlashSceneLights(root)
            if not root then return end
            local items = {root}
            for _, desc in ipairs(root:GetDescendants()) do
                table.insert(items, desc)
            end
            for _, obj in ipairs(items) do
                if obj and obj.Parent and (obj:IsA("PointLight") or obj:IsA("SpotLight")
                    or obj:IsA("SurfaceLight") or obj:IsA("BloomEffect")
                    or obj:IsA("ColorCorrectionEffect") or obj:IsA("BlurEffect")
                    or obj:IsA("SunRaysEffect")) then
                    pcall(function() obj:Destroy() end)
                end
            end
        end
        stripBlackFlashSceneLights(selectedClone)
        selectedClone.Parent = composite

        local function inspectCapabilities(root)
            local hasSound, hasVisual = false, false
            local function inspectOne(obj)
                if obj:IsA("Sound") and obj.SoundId ~= "" then hasSound = true end
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                    or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                    hasVisual = true
                end
            end
            inspectOne(root)
            for _, obj in ipairs(root:GetDescendants()) do inspectOne(obj) end
            return hasSound, hasVisual
        end
        local hasSound, hasVisual = inspectCapabilities(composite)
        local companionVisual, companionSound
        for _, candidate in ipairs(blackFlashAssets) do
            if candidate.source and candidate.source.Parent and candidate.source ~= record.source then
                local candidateSound, candidateVisual = inspectCapabilities(candidate.source)
                if not hasVisual and not companionVisual and candidateVisual then companionVisual = candidate end
                if not hasSound and not companionSound and candidateSound then companionSound = candidate end
                if (hasVisual or companionVisual) and (hasSound or companionSound) then break end
            end
        end
        if not hasVisual and companionVisual then
            local extra = cloneArchivable(companionVisual.source)
            if extra then
                stripBlackFlashSceneLights(extra)
                extra.Parent = composite
                hasVisual = select(2, inspectCapabilities(extra))
            end
        end
        -- Recheck after adding the visual companion, since that group may contain sound too.
        hasSound = select(1, inspectCapabilities(composite))
        if not hasSound and companionSound then
            local extra = cloneArchivable(companionSound.source)
            if extra then
                stripBlackFlashSceneLights(extra)
                extra.Parent = composite
                hasSound = select(1, inspectCapabilities(extra))
            end
        end
        local clone = composite

        -- Remove executable logic but retain particles, geometry, attachments and sound.
        stripBlackFlashSceneLights(clone)
        for _, obj in ipairs(clone:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                pcall(function() obj:Destroy() end)
            end
        end
        -- Tint only the local clones, never ReplicatedStorage's original assets.
        recolourBlackFlashClone(clone)

        if clone:IsA("Sound") then
            local soundAttachment = makeBlackFlashAttachment(anchor, impactCFrame)
            clone.Volume = blackFlashVolume
            clone.Looped = false
            clone.Parent = soundAttachment
            pcall(function() clone.TimePosition = 0 end)
            clone:Play()
            retainBlackFlashObject(soundAttachment, math.max(3, clone.TimeLength + 0.5))
            retainBlackFlashObject(clone, math.max(3, clone.TimeLength + 0.5))
        elseif clone:IsA("ParticleEmitter") then
            local attachment = makeBlackFlashAttachment(anchor, impactCFrame)
            retainBlackFlashObject(attachment, 3 * (blackFlashActiveObjects._state.durationFactor or 1.6))
            clone.Rate = 0
            clone.Enabled = true
            pcall(function()
                local durationScale = blackFlashActiveObjects._state.durationFactor or 1.6
                local life = clone.Lifetime
                clone.Lifetime = NumberRange.new(life.Min * durationScale, life.Max * durationScale)
                local sizeScale = blackFlashActiveObjects._state.effectScale or 0.58
                local keys = clone.Size.Keypoints
                local scaled = table.create(#keys)
                for i, keypoint in ipairs(keys) do
                    scaled[i] = NumberSequenceKeypoint.new(keypoint.Time, keypoint.Value * sizeScale, keypoint.Envelope * sizeScale)
                end
                clone.Size = NumberSequence.new(scaled)
            end)
            clone.Parent = attachment
            pcall(function() clone:Emit(blackFlashParticleCount) end)
            retainBlackFlashObject(clone, 2.8 * (blackFlashActiveObjects._state.durationFactor or 1.6))
        elseif clone:IsA("Trail") or clone:IsA("Beam") then
            -- Trail/Beam templates need two valid attachments. If source is a single asset leaf without
            -- both, it cannot render on its own; report it safely.
            local a0, a1 = clone.Attachment0, clone.Attachment1
            if not a0 or not a1 then
                clone:Destroy()
                if blackFlashStatus then blackFlashStatus.Text = "The selected Trail/Beam needs its parent effect group; select the enclosing Black Flash folder." end
                return false
            end
            local attachA = makeBlackFlashAttachment(anchor, impactCFrame * CFrame.new(-0.45, 0, 0))
            local attachB = makeBlackFlashAttachment(anchor, impactCFrame * CFrame.new(0.45, 0, 0))
            clone.Attachment0, clone.Attachment1 = attachA, attachB
            clone.Enabled = true
            pcall(function()
                if clone:IsA("Trail") then
                    clone.Lifetime = clone.Lifetime * (blackFlashActiveObjects._state.durationFactor or 1.6)
                end
            end)
            clone.Parent = anchor
            local trailHold = 1.8 * (blackFlashActiveObjects._state.durationFactor or 1.6)
            retainBlackFlashObject(attachA, trailHold); retainBlackFlashObject(attachB, trailHold); retainBlackFlashObject(clone, trailHold)
        else
            local wrapper
            local sourceIsModel = clone:IsA("Model")
            if sourceIsModel then
                wrapper = clone
            elseif clone:IsA("Folder") then
                wrapper = Instance.new("Model")
                wrapper.Name = "TrueSightBlackFlashFX"
                for _, child in ipairs(clone:GetChildren()) do child.Parent = wrapper end
                clone:Destroy()
            elseif clone:IsA("BasePart") then
                wrapper = Instance.new("Model")
                wrapper.Name = "TrueSightBlackFlashFX"
                clone.Parent = wrapper
            else
                -- Unknown container types still get useful local VFX by mounting descendant ParticleEmitters
                -- and Sounds to an attachment/hand.
                wrapper = Instance.new("Model")
                wrapper.Name = "TrueSightBlackFlashFX"
                clone.Parent = wrapper
            end

            local parts = {}
            for _, obj in ipairs(wrapper:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj.Anchored = true
                    obj.CanCollide = false
                    obj.CanTouch = false
                    obj.CanQuery = false
                    obj.CastShadow = false
                    -- Many stored Black Flash templates include bright placeholder shards. Keep them invisible and
                    -- use the template's real emitters for the burst.
                    obj.Transparency = 1
                    table.insert(parts, obj)
                end
            end
            if #parts > 0 then
                wrapper.Parent = workspace
                pcall(function()
                    -- Scale oversized source geometry before aligning its actual bounds.
                    wrapper:ScaleTo(blackFlashActiveObjects._state.effectScale or 0.58)
                end)
                pcall(function()
                    -- Stored effect models sometimes have a pivot far from their visible geometry. Align their
                    -- bounds to the impact point rather than trusting that pivot.
                    local boundsCFrame = wrapper:GetBoundingBox()
                    local currentPivot = wrapper:GetPivot()
                    local worldTransform = impactCFrame * boundsCFrame:Inverse()
                    wrapper:PivotTo(worldTransform * currentPivot)
                end)
                -- Start audio first; then emit the burst in the same event callback to minimise the perceived
                -- gap between the Black Flash sound and VFX.
                for _, obj in ipairs(wrapper:GetDescendants()) do
                    if obj:IsA("Sound") then
                        obj.Volume = blackFlashVolume
                        obj.Looped = false
                        -- Standalone Sound objects parented under Model/Folder containers may not get reliable spatial
                        -- playback; attach them to the hit anchor.
                        if not obj.Parent or not (obj.Parent:IsA("BasePart") or obj.Parent:IsA("Attachment")) then
                            local soundAttachment = makeBlackFlashAttachment(anchor, impactCFrame)
                            obj.Parent = soundAttachment
                            retainBlackFlashObject(soundAttachment, math.max(3, obj.TimeLength + 0.5))
                        end
                        -- Startup discovery preloads source sounds; don't wait on Loaded here, because waiting at
                        -- hit-time makes audio lag behind the VFX burst.
                        pcall(function() obj.TimePosition = 0 end)
                        pcall(function() obj:Play() end)
                        retainBlackFlashObject(obj, math.max(4, obj.TimeLength + 1))
                    end
                end
                local fallbackEmitterAttachment
                for _, obj in ipairs(wrapper:GetDescendants()) do
                    if obj:IsA("ParticleEmitter") then
                        obj.Enabled = true
                        local parent = obj.Parent
                        -- Root-level emitters stored directly under a Model/Folder do not have a valid emission point.
                        -- Mount those at the computed impact.
                        if not parent or (not parent:IsA("Attachment") and not parent:IsA("BasePart")) then
                            if not fallbackEmitterAttachment then
                                fallbackEmitterAttachment = makeBlackFlashAttachment(anchor, impactCFrame)
                                retainBlackFlashObject(fallbackEmitterAttachment, 3.8 * (blackFlashActiveObjects._state.durationFactor or 1.6))
                            end
                            obj.Parent = fallbackEmitterAttachment
                            parent = fallbackEmitterAttachment
                        end
                        obj.Rate = 0
                        pcall(function()
                            local durationScale = blackFlashActiveObjects._state.durationFactor or 1.6
                            local life = obj.Lifetime
                            obj.Lifetime = NumberRange.new(life.Min * durationScale, life.Max * durationScale)
                            local sizeScale = blackFlashActiveObjects._state.effectScale or 0.58
                            local keys = obj.Size.Keypoints
                            local scaled = table.create(#keys)
                            for i, keypoint in ipairs(keys) do
                                scaled[i] = NumberSequenceKeypoint.new(keypoint.Time, keypoint.Value * sizeScale, keypoint.Envelope * sizeScale)
                            end
                            obj.Size = NumberSequence.new(scaled)
                            obj:Emit(blackFlashParticleCount)
                        end)
                    end
                end
                retainBlackFlashObject(wrapper, 4 * (blackFlashActiveObjects._state.durationFactor or 1.6))
            else
                local attachment = makeBlackFlashAttachment(anchor, impactCFrame)
                retainBlackFlashObject(attachment, 4 * (blackFlashActiveObjects._state.durationFactor or 1.6))
                local descendants = wrapper:GetDescendants()
                -- Reparent/play sounds before particle emission for tighter sync.
                for _, obj in ipairs(descendants) do
                    if obj:IsA("Sound") then
                        obj.Volume = blackFlashVolume
                        obj.Looped = false
                        local soundAttachment = makeBlackFlashAttachment(anchor, impactCFrame)
                        obj.Parent = soundAttachment
                        retainBlackFlashObject(soundAttachment, math.max(3, obj.TimeLength + 0.5))
                        -- Startup discovery preloads source sounds; don't wait on Loaded here, because waiting at
                        -- hit-time makes audio lag behind the VFX burst.
                        pcall(function() obj.TimePosition = 0 end)
                        pcall(function() obj:Play() end)
                        retainBlackFlashObject(obj, math.max(4, obj.TimeLength + 1))
                    end
                end
                for _, obj in ipairs(descendants) do
                    if obj:IsA("ParticleEmitter") then
                        obj.Rate = 0
                        obj.Enabled = true
                        pcall(function()
                            local durationScale = blackFlashActiveObjects._state.durationFactor or 1.6
                            local life = obj.Lifetime
                            obj.Lifetime = NumberRange.new(life.Min * durationScale, life.Max * durationScale)
                            local sizeScale = blackFlashActiveObjects._state.effectScale or 0.58
                            local keys = obj.Size.Keypoints
                            local scaled = table.create(#keys)
                            for i, keypoint in ipairs(keys) do
                                scaled[i] = NumberSequenceKeypoint.new(keypoint.Time, keypoint.Value * sizeScale, keypoint.Envelope * sizeScale)
                            end
                            obj.Size = NumberSequence.new(scaled)
                        end)
                        obj.Parent = attachment
                        pcall(function() obj:Emit(blackFlashParticleCount) end)
                        retainBlackFlashObject(obj, 3.8 * (blackFlashActiveObjects._state.durationFactor or 1.6))
                    end
                end
                wrapper:Destroy()
            end
        end
        if blackFlashStatus then blackFlashStatus.Text = "Played local Black Flash FX at impact: " .. tostring(record.path) end
        return true
    end
    local function attachBlackFlashCharacter(character)
        disconnectBlackFlashAnimation()
        character = character or player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not character or not humanoid then return end
        blackFlashAnimationConnection = {}
        local function recordAttackTrack(track)
            if not blackFlashMod or not blackFlashMod.enabled or not track then return end
            -- Animation tracks are a backup signal only. Require Action priority here; mouse/skill-key
            -- input handles attack timing when YBA doesn't expose tracks. Ordinary walking/idle animations
            -- must not make unrelated damage count.
            local priority = track.Priority
            if not priority or priority.Value < Enum.AnimationPriority.Action.Value then return end
            blackFlashActiveObjects._state.recentAttackAt = os.clock()
        end
        local function hookAnimationSignal(signal)
            table.insert(blackFlashAnimationConnection, signal:Connect(recordAttackTrack))
        end
        local seenAnimators = {}
        local function hookAnimator(obj)
            if obj and obj:IsA("Animator") and not seenAnimators[obj] then
                seenAnimators[obj] = true
                hookAnimationSignal(obj.AnimationPlayed)
            end
        end
        hookAnimationSignal(humanoid.AnimationPlayed)
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("Animator") then hookAnimator(obj) end
        end
        table.insert(blackFlashAnimationConnection, character.DescendantAdded:Connect(function(obj)
            if obj:IsA("Animator") then hookAnimator(obj) end
        end))
        -- YBA can play Stand attack tracks on a model under workspace.Living rather than on the
        -- player's Humanoid. Watch that local player's live rig too.
        local living = workspace:FindFirstChild("Living")
        local liveCharacter = living and living:FindFirstChild(player.Name)
        if liveCharacter and liveCharacter ~= character then
            for _, obj in ipairs(liveCharacter:GetDescendants()) do
                if obj:IsA("Animator") then hookAnimator(obj) end
            end
            table.insert(blackFlashAnimationConnection, liveCharacter.DescendantAdded:Connect(function(obj)
                if obj:IsA("Animator") then hookAnimator(obj) end
            end))
        end
    end
    local function stopBlackFlash()
        disconnectBlackFlashAnimation()
        if blackFlashRespawnConnection then
            if type(blackFlashRespawnConnection) == "table" then
                for _, conn in ipairs(blackFlashRespawnConnection) do
                    pcall(function() conn:Disconnect() end)
                end
            else
                pcall(function() blackFlashRespawnConnection:Disconnect() end)
            end
            blackFlashRespawnConnection = nil
        end
        blackFlashActiveObjects._state.recentAttackAt = 0
        cleanupBlackFlashObjects()
    end
    blackFlashMod = addModule(visualPanel, "Black Flash VFX + Sound", function(on)
        stopBlackFlash()
        if not on then return end
        blackFlashRespawnConnection = {}
        local function keepConnection(connection)
            table.insert(blackFlashRespawnConnection, connection)
            return connection
        end
        keepConnection(player.CharacterAdded:Connect(function(character)
            task.delay(0.45, function()
                if blackFlashMod and blackFlashMod.enabled then attachBlackFlashCharacter(character) end
            end)
        end))
        -- Input timestamps are a fallback for YBA combat/Stand moves whose tracks are not exposed
        -- through the local Humanoid's AnimationPlayed signal. The effect still only fires when another
        -- player's health actually drops.
        keepConnection(UserInputService.InputBegan:Connect(function(input)
            if not blackFlashMod or not blackFlashMod.enabled then return end
            if UserInputService:GetFocusedTextBox() then return end
            local isAttackInput = input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local key = input.KeyCode
                -- Include common YBA moves and hotbar inputs (1-9), plus Q for games that bind it.
                isAttackInput = key == Enum.KeyCode.Q or key == Enum.KeyCode.E or key == Enum.KeyCode.R
