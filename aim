    "king crimson requiem", "gold experience requiem", "the world over heaven"
}

local function lowerName(v)
    return string.lower(tostring(v or ""))
end

local function nameLooksLikeStand(name)
    local n = lowerName(name)
    if string.find(n, "stand", 1, true) then return true end
    for _, standName in ipairs(knownStandNames) do
        if string.find(n, standName, 1, true) then return true end
    end
    return false
end

local function isAuraNamed(inst)
    local cur = inst
    for _ = 1, 7 do
        if not cur or cur == game then break end
        local n = lowerName(cur.Name)
        if string.find(n, "aura", 1, true)
            or string.find(n, "ambient", 1, true)
            or string.find(n, "idle", 1, true)
            or string.find(n, "glow", 1, true)
            or string.find(n, "energy", 1, true)
            or string.find(n, "standfx", 1, true) then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function isTrueSightEffect(inst)
    local cur = inst
    while cur and cur ~= game do
        local n = tostring(cur.Name)
        if string.find(n, "TrueSight", 1, true)
            or string.find(n, "LocalAura", 1, true)
            or string.find(n, "LocalJumpCircle", 1, true) then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function isEffectCandidate(inst)
    local class = inst.ClassName
    if class ~= "ParticleEmitter" and class ~= "Trail" and class ~= "Beam"
        and class ~= "Fire" and class ~= "Smoke" and class ~= "Sparkles"
        and class ~= "PointLight" and class ~= "SpotLight" and class ~= "SurfaceLight"
        and class ~= "Highlight" then
        return false
    end
    local auraNamed = isAuraNamed(inst)
    if class == "ParticleEmitter" then
        return (inst.Enabled and inst.Rate > 0) or auraNamed
    elseif class == "Trail" or class == "Beam" then
        return inst.Enabled and auraNamed
    elseif class == "Fire" or class == "Smoke" or class == "Sparkles" then
        return (inst.Enabled ~= false) and auraNamed
    elseif class == "PointLight" or class == "SpotLight" or class == "SurfaceLight" then
        return inst.Enabled and auraNamed
    elseif class == "Highlight" then
        return inst.Enabled and auraNamed
    end
    return false
end

local function findSourceRoot(effect)
    local cur = effect.Parent
    local auraFallback
    while cur and cur ~= game do
        local name = lowerName(cur.Name)
        if not auraFallback and string.find(name, "aura", 1, true)
            and (cur:IsA("Folder") or cur:IsA("Model") or cur:IsA("BasePart") or cur:IsA("Attachment")) then
            auraFallback = cur
        end
        if cur:IsA("Model") and nameLooksLikeStand(cur.Name) then
            return cur
        end
        cur = cur.Parent
    end
    return auraFallback
end

local function getNearestPart(inst, stopAt)
    local cur = inst
    while cur and cur ~= stopAt do
        if cur:IsA("BasePart") then return cur end
        cur = cur.Parent
    end
    if stopAt and stopAt:IsA("BasePart") then return stopAt end
    return nil
end

local function getAttachmentSnapshot(att, sourceRoot)
    if not att or not att:IsA("Attachment") then return nil end
    local part = getNearestPart(att.Parent, sourceRoot)
    return {
        source = att,
        partName = part and part.Name or "HumanoidRootPart",
        cframe = att.CFrame,
        name = att.Name,
    }
end

local function captureEffect(effect, sourceRoot)
    local parent = effect.Parent
    local parentAttachment = parent and parent:IsA("Attachment") and parent or nil
    local part = getNearestPart(parentAttachment and parentAttachment.Parent or parent, sourceRoot)
    local record = {
        className = effect.ClassName,
        name = effect.Name,
        template = effect:Clone(),
        partName = part and part.Name or "HumanoidRootPart",
        parentAttachment = parentAttachment and getAttachmentSnapshot(parentAttachment, sourceRoot) or nil,
        enabled = true,
    }
    if effect:IsA("ParticleEmitter") then
        record.baseRate = effect.Rate
        record.enabled = effect.Enabled
    elseif effect:IsA("Trail") or effect:IsA("Beam") then
        record.attachment0 = getAttachmentSnapshot(effect.Attachment0, sourceRoot)
        record.attachment1 = getAttachmentSnapshot(effect.Attachment1, sourceRoot)
    elseif effect:IsA("PointLight") or effect:IsA("SpotLight") or effect:IsA("SurfaceLight") then
        record.baseBrightness = effect.Brightness
    end
    return record
end

local function removeStandAura()
    for _, obj in ipairs(standAuraObjects) do
        if obj and obj.Parent then pcall(function() obj:Destroy() end) end
    end
    table.clear(standAuraObjects)
    table.clear(standAuraRecords)
end

local function findTargetPart(character, partName)
    local part = partName and character:FindFirstChild(partName, true)
    if part and part:IsA("BasePart") then return part end
    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
end

local function addStandAura(character)
    removeStandAura()
    if not character then return end
    local source = standAuraSources[standAuraIndex]
    if not source or type(source.effects) ~= "table" or #source.effects == 0 then
        if standAuraScanStatus then
            standAuraScanStatus.Text = "No loaded aura source is available yet. Restart TrueSight after the Stand assets load."
        end
        return
    end

    local attachmentMap = {}
    local function ensureTargetAttachment(snapshot)
        if not snapshot then return nil end
        if attachmentMap[snapshot.source] then return attachmentMap[snapshot.source] end
        local part = findTargetPart(character, snapshot.partName)
        if not part then return nil end
        local att = Instance.new("Attachment")
        att.Name = "TrueSightAuraAttachment_" .. tostring(snapshot.name or "FX")
        att.CFrame = snapshot.cframe or CFrame.new()
        att.Parent = part
        attachmentMap[snapshot.source] = att
        table.insert(standAuraObjects, att)
        return att
    end

    for _, record in ipairs(source.effects) do
        local ok, clone = pcall(function() return record.template:Clone() end)
        if ok and clone then
            clone.Name = "TrueSightAuraFX_" .. tostring(record.name)
            local parent = findTargetPart(character, record.partName)
            if clone:IsA("ParticleEmitter") then
                if record.parentAttachment then
                    parent = ensureTargetAttachment(record.parentAttachment) or parent
                end
                if parent then
                    clone.Rate = (record.baseRate and record.baseRate > 0 and record.baseRate or 8) * standAuraIntensity
                    clone.Enabled = true
                    clone.Parent = parent
                    table.insert(standAuraObjects, clone)
                    table.insert(standAuraRecords, {obj = clone, baseRate = record.baseRate and record.baseRate > 0 and record.baseRate or 8, kind = "rate"})
                else
                    clone:Destroy()
                end
            elseif clone:IsA("Trail") or clone:IsA("Beam") then
                local a0 = ensureTargetAttachment(record.attachment0)
                local a1 = ensureTargetAttachment(record.attachment1)
                if parent and a0 and a1 then
                    clone.Attachment0 = a0
                    clone.Attachment1 = a1
                    clone.Enabled = true
                    clone.Parent = parent
                    table.insert(standAuraObjects, clone)
                else
                    clone:Destroy()
                end
            elseif clone:IsA("Fire") or clone:IsA("Smoke") or clone:IsA("Sparkles") then
                if parent then
                    clone.Enabled = true
                    clone.Parent = parent
                    table.insert(standAuraObjects, clone)
                else
                    clone:Destroy()
                end
            elseif clone:IsA("PointLight") or clone:IsA("SpotLight") or clone:IsA("SurfaceLight") then
                if parent then
                    clone.Brightness = (record.baseBrightness or clone.Brightness) * standAuraIntensity
                    clone.Enabled = true
                    clone.Parent = parent
                    table.insert(standAuraObjects, clone)
                    table.insert(standAuraRecords, {obj = clone, baseBrightness = record.baseBrightness or clone.Brightness, kind = "brightness"})
                else
                    clone:Destroy()
                end
            elseif clone:IsA("Highlight") then
                clone.Adornee = character
                clone.Parent = character
                table.insert(standAuraObjects, clone)
            else
                clone:Destroy()
            end
        end
    end

    if standAuraScanStatus then
        standAuraScanStatus.Text = "Applied " .. tostring(#standAuraRecords) .. " rate-controlled effect(s) from " .. tostring(source.label) .. "."
    end
end

local function updateStandAuraIntensity()
    for _, rec in ipairs(standAuraRecords) do
        if rec.obj and rec.obj.Parent then
            if rec.kind == "rate" then
                rec.obj.Rate = rec.baseRate * standAuraIntensity
            elseif rec.kind == "brightness" then
                rec.obj.Brightness = rec.baseBrightness * standAuraIntensity
            end
        end
    end
end

local function isSupportedStandFx(inst)
    return inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
        or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles")
        or inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight")
        or inst:IsA("Highlight")
end

local function hasAuraPath(inst, stopAt)
    local cur = inst
    while cur and cur ~= stopAt do
        local n = lowerName(cur.Name)
        if string.find(n, "aura", 1, true)
            or string.find(n, "ambient", 1, true)
            or string.find(n, "idle", 1, true)
            or string.find(n, "glow", 1, true)
            or string.find(n, "energy", 1, true)
            or string.find(n, "standfx", 1, true) then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function isCurrentlyEnabledFx(inst)
    local ok, enabled = pcall(function()
        if inst:IsA("ParticleEmitter") then return inst.Enabled and inst.Rate > 0 end
        if inst:IsA("Trail") or inst:IsA("Beam") then return inst.Enabled end
        if inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then return inst.Enabled end
        if inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then return inst.Enabled end
        if inst:IsA("Highlight") then return inst.Enabled end
        return false
    end)
    return ok and enabled == true
end

local function scanStandAuraSources()
    removeStandAura()
    table.clear(standAuraSources)
    table.clear(standAuraNames)

    local standsFolder = ReplicatedStorage:FindFirstChild("Stands")
    local foundFromFolder = false

    -- List the actual stand assets from ReplicatedStorage.Stands.
    if standsFolder then
        for _, sourceRoot in ipairs(standsFolder:GetChildren()) do
            local descendants = {}
            local ok, result = pcall(function() return sourceRoot:GetDescendants() end)
            if ok and type(result) == "table" then descendants = result end

            local auraMatches, enabledFallback, allVisualFallback = {}, {}, {}
            for scanIndex, inst in ipairs(descendants) do
                if scanIndex % 350 == 0 then task.wait() end
                if isSupportedStandFx(inst) and not isTrueSightEffect(inst) then
                    table.insert(allVisualFallback, inst)
                    if hasAuraPath(inst, sourceRoot) or isAuraNamed(inst) then
                        table.insert(auraMatches, inst)
                    end
                    if isCurrentlyEnabledFx(inst) then
                        table.insert(enabledFallback, inst)
                    end
                end
            end

            -- Prefer named auras, then fall back to other stored effects.
            local chosen = #auraMatches > 0 and auraMatches
                or (#enabledFallback > 0 and enabledFallback or allVisualFallback)
            if #chosen > 0 then
                local group = {
                    root = sourceRoot,
                    label = tostring(sourceRoot.Name),
                    effects = {},
                    seen = {},
                    origin = "ReplicatedStorage.Stands",
                }
                for _, inst in ipairs(chosen) do
                    if not group.seen[inst] then
                        local captured, record = pcall(captureEffect, inst, sourceRoot)
                        if captured and record then
                            table.insert(group.effects, record)
                            group.seen[inst] = true
                        end
                    end
                end
                if #group.effects > 0 then
                    group.displayName = group.label .. " [" .. tostring(#group.effects) .. " FX]"
                    table.insert(standAuraSources, group)
                    foundFromFolder = true
                end
            end
        end
    end

    -- Fall back to live effects if some skins aren't stored with the stands.
    if not foundFromFolder then
        local groups = {}
        local descendants = {}
        local ok, scanResult = pcall(function() return game:GetDescendants() end)
        if ok and type(scanResult) == "table" then descendants = scanResult end
        for scanIndex, inst in ipairs(descendants) do
            if scanIndex % 500 == 0 then task.wait() end
            if isEffectCandidate(inst) and not isTrueSightEffect(inst) then
                local root = findSourceRoot(inst)
                if root and root ~= player.Character then
                    local group = groups[root]
                    if not group then
                        local rootName = tostring(root.Name)
                        local label = rootName
                        if string.lower(rootName) == "stand" and root.Parent then
                            label = tostring(root.Parent.Name) .. " / Stand"
                        end
                        group = {root = root, label = label, effects = {}, seen = {}, origin = "Loaded game FX"}
                        groups[root] = group
                    end
                    if not group.seen[inst] then
                        local captured, record = pcall(captureEffect, inst, root)
                        if captured and record then
                            table.insert(group.effects, record)
                            group.seen[inst] = true
                        end
                    end
                end
            end
        end
        for _, group in pairs(groups) do
            if #group.effects > 0 then
                group.displayName = group.label .. " [" .. tostring(#group.effects) .. " FX]"
                table.insert(standAuraSources, group)
            end
        end
    end

    table.sort(standAuraSources, function(a, b)
        local an, bn = string.lower(a.label), string.lower(b.label)
        if an == bn then return #a.effects > #b.effects end
        return an < bn
    end)

    if #standAuraSources == 0 then
        table.insert(standAuraNames, "No Stand effects found")
        standAuraIndex = 1
        if standAuraCycle then standAuraCycle.set(1) end
        if standAuraScanStatus then
            if not standsFolder then
                standAuraScanStatus.Text = "ReplicatedStorage.Stands wasn't found; no compatible loaded effects were found either."
            else
                standAuraScanStatus.Text = "No compatible visual FX found under ReplicatedStorage.Stands or in loaded game effects."
            end
        end
        warn("[TrueSight] No compatible Stand FX found under ReplicatedStorage.Stands or in loaded game effects.")
        return 0
    end

    for _, source in ipairs(standAuraSources) do
        table.insert(standAuraNames, source.displayName)
    end
    standAuraIndex = math.clamp(standAuraIndex, 1, #standAuraNames)
    if standAuraCycle then standAuraCycle.set(standAuraIndex) end
    if standAuraScanStatus then
        local origin = standAuraSources[1].origin or "Stand assets"
        standAuraScanStatus.Text = "Found " .. tostring(#standAuraSources) .. " sources. First source: " .. tostring(origin) .. ". Choose a source, then enable Stand Aura."
    end
    print("[TrueSight] Found " .. tostring(#standAuraSources) .. " Stand/skin FX sources.")
    return #standAuraSources
end

-- Jump circles: a ring + splash where you land
local jumpConn
local airStart
local jumpLast = 0
local jumpSize = 1

local function groundCFrame(pos, normal)
    if normal.Y > 0.99 then
        return CFrame.new(pos)
    end
    -- Point the ring at the ground surface.
    return CFrame.lookAt(pos, pos + normal) * CFrame.Angles(-math.pi / 2, 0, 0)
end

local function spawnRing(cf, finalSize, withSplash, strength)
    local part = Instance.new("Part")
    part.Name = "LocalJumpCircle"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Transparency = 1
    part.Size = Vector3.new(1, 0.05, 1)
    part.CFrame = cf

    local sg = Instance.new("SurfaceGui")
    sg.Face = Enum.NormalId.Top
    sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
    sg.CanvasSize = Vector2.new(256, 256)
    sg.LightInfluence = 0
    sg.Adornee = part
    sg.Parent = part

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(1, 1)
    fill.BackgroundColor3 = accent
    fill.BackgroundTransparency = 0.8
    fill.BorderSizePixel = 0
    fill.Parent = sg

    local round = Instance.new("UICorner")
    round.CornerRadius = UDim.new(0.5, 0)
    round.Parent = fill

    local stroke = Instance.new("UIStroke")
    stroke.Color = accent
    stroke.Thickness = 10
    stroke.Parent = fill

    part.Parent = workspace

    if withSplash then
        local e = Instance.new("ParticleEmitter")
        e.Name = "LocalSplash"
        e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        e.Rate = 0
        e.Lifetime = NumberRange.new(0.35, 0.6)
        e.Speed = NumberRange.new(6, 12)
        e.SpreadAngle = Vector2.new(70, 70)
        e.EmissionDirection = Enum.NormalId.Top
        e.Acceleration = Vector3.new(0, -35, 0)
        e.LightEmission = 1
        e.LightInfluence = 0
        e.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.5),
            NumberSequenceKeypoint.new(1, 0),
        })
        e.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        })
        e.Color = ColorSequence.new(accent, accent:Lerp(Color3.new(1, 1, 1), 0.6))
        e.Parent = part
        e:Emit(math.floor(14 * strength))
    end

    local grow = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fade = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(part, grow, {Size = Vector3.new(finalSize, 0.05, finalSize)}):Play()
    TweenService:Create(stroke, fade, {Transparency = 1}):Play()
    TweenService:Create(fill, fade, {BackgroundTransparency = 1}):Play()
    Debris:AddItem(part, 0.9)
end

local function spawnJumpCircle(character, strength)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local hit = workspace:Raycast(root.Position, Vector3.new(0, -10, 0), params)
    if not hit then return end

    local cf = groundCFrame(hit.Position + hit.Normal * 0.06, hit.Normal)
    local size = 8 * jumpSize * strength
    spawnRing(cf, size, true, strength)
    task.delay(0.07, function()
        spawnRing(cf, size * 0.6, false, strength)
    end)
end

local function unhookJump()
    if jumpConn then
        jumpConn:Disconnect()
        jumpConn = nil
    end
    airStart = nil
end

local function hookJump(character)
    unhookJump()
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    jumpConn = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Freefall
            or new == Enum.HumanoidStateType.Jumping then
            if not airStart then airStart = os.clock() end
        elseif new == Enum.HumanoidStateType.Landed then
            local air = airStart and (os.clock() - airStart) or 0
            airStart = nil
            local now = os.clock()
            if air < 0.12 or now - jumpLast < 0.15 then return end
            jumpLast = now
            spawnJumpCircle(character, math.clamp(0.8 + air * 0.9, 0.8, 2))
        elseif new == Enum.HumanoidStateType.Running then
            airStart = nil
        end
    end)
end

