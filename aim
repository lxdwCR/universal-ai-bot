local ghostRenderSettings = {
    lastTick = 0,
    updateHz = 15,
    fillTransparency = 0.35,
    outlineTransparency = 0.08,
    -- Highlights use less overdraw; other modes show the clone's material.
    materialName = "Highlight",
}
