    -- Passive FPS/frame-time sampler. It records one number per rendered frame, uses a fixed ring
    -- buffer, and updates text at most once per second.
    note(perfPanel, "LIVE PERFORMANCE", 26)
    local live = note(perfPanel, "Measuring FPS…", 60)
    live.TextColor3 = TEXT

    -- Optional FPS cap requests. Only executors exposing setfpscap can change Roblox's native frame
    -- limit; this does NOT bypass game/client enforcement. Entirely event-driven: reuses the
    -- performance sampler's one-second update.
    local capState = {requested = nil, supported = false, setter = nil, getter = nil,
        previous = nil, applied = false, result = "Not changed", fps = 0}
    do
        local ok, env = pcall(function()
            return type(getgenv) == "function" and getgenv() or _G
        end)
        local candidate = type(setfpscap) == "function" and setfpscap or nil
        local getCandidate = type(getfpscap) == "function" and getfpscap or nil
        if ok and type(env) == "table" then
            if not candidate and type(rawget(env, "setfpscap")) == "function" then
                candidate = rawget(env, "setfpscap")
            end
            if not getCandidate and type(rawget(env, "getfpscap")) == "function" then
                getCandidate = rawget(env, "getfpscap")
            end
        end
        capState.setter = candidate
        capState.getter = getCandidate
        capState.supported = candidate ~= nil
        if getCandidate then
            local readOK, value = pcall(getCandidate)
            if readOK and type(value) == "number" and value >= 0 and value < 10000 then
                capState.previous = value
            end
        end
    end

    note(perfPanel, "FPS LIMIT  •  Requires executor support", 27)
    local capInfo = note(perfPanel, "Cap: unchanged", 47)
    local capPresets = {"Keep Current", "60", "120", "144", "165", "240", "360", "480", "500", "Unlimited (0)"}
    local capValues = {nil, 60, 120, 144, 165, 240, 360, 480, 500, 0}
    local function describeCap()
        local selected = capState.requested == nil and "unchanged"
            or (capState.requested == 0 and "unlimited" or (tostring(capState.requested) .. " FPS"))
        capInfo.Text = string.format("Cap: %s   •   Live: %.0f FPS\n%s", selected, capState.fps, capState.result)
    end
    local function applyCap(index)
        capState.requested = capValues[index]
        if capState.requested == nil then
            if capState.applied and capState.previous ~= nil and capState.setter then
                local restored = pcall(capState.setter, capState.previous)
                if restored then capState.applied = false end
            end
            capState.result = "Previous limit restored (if known)."
            describeCap()
            return
        end
        if not capState.supported then
            capState.result = "Unavailable: setfpscap not supported."
            describeCap()
            return
        end
