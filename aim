    local function getPreviewStandName()
        local stats = player:FindFirstChild("PlayerStats")
        local standObj = stats and stats:FindFirstChild("Stand")
        if not standObj then return "Unknown" end
        local ok, value = pcall(function() return standObj.Value end)
        if not ok then return "Unknown" end
        if typeof(value) == "Instance" then value = value.Name end
        return tostring(value or "Unknown")
    end

    local function normalizedStandName(value)
        return string.lower(tostring(value or "")):gsub("[^%w]", "")
    end

    local function isNoStandName(value)
        local n = string.lower(tostring(value or ""))
        return n == "" or n == "none" or n == "nil" or n == "0" or n == "unknown"
    end

    local function previewVisiblePartScore(model)
        if not model then return 0 end
        local score = 0
        local ok, descendants = pcall(function() return model:GetDescendants() end)
        if not ok then return 0 end
        for _, obj in ipairs(descendants) do
            if obj:IsA("BasePart") then
                local name = string.lower(obj.Name)
                local maxDimension = math.max(obj.Size.X, obj.Size.Y, obj.Size.Z)
                local minDimension = math.min(obj.Size.X, obj.Size.Y, obj.Size.Z)
                local big = maxDimension > 120
                local helperPart = string.find(name, "hitbox", 1, true)
                    or string.find(name, "collision", 1, true)
                    or string.find(name, "hurtbox", 1, true)
                    or name == "humanoidrootpart" or name == "rootpart"
                -- Ignore local transparency modifiers when scoring: they can hide
                -- legitimate Stand pieces in the live scene even though the preview clone can show them.
                local hidden = obj.Transparency >= 0.995 or maxDimension < 0.025
                if not hidden and not big and not helperPart and minDimension >= 0 then score += 1 end
            end
        end
        if score == 0 then return 0 end

        -- Stand FX contain lots of tiny strips and particles. Don't mistake a
        -- horizontal line of effect meshes for a whole Stand in the viewport.
        local boundsOk, _, bounds = pcall(function()
            local cf, size = model:GetBoundingBox()
            return cf, size
        end)
        if not boundsOk or not bounds then return 0 end
        local dimensionsGood = bounds.X >= 0.45 and bounds.Y >= 1.45 and bounds.Z >= 0.35
        local oneMeshStand = score == 1 and bounds.X >= 1.0 and bounds.Y >= 2.0 and bounds.Z >= 0.55
        if not dimensionsGood and not oneMeshStand then return 0 end
        return score + math.min(bounds.Y, 12) * 1.5 + math.min(bounds.X * bounds.Z, 8)
    end

    local function getStandModelWithin(container, targetName, allowContainerModel)
        if not container then return nil end
        -- Live YBA characters commonly keep the current skin under StandMorph.
        local morph = container:FindFirstChild("StandMorph", true)
        if morph and morph:IsA("Model") and previewVisiblePartScore(morph) > 0 then return morph end

        local wanted = normalizedStandName(targetName)
        local exact
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("Model") then
                if wanted ~= "" and normalizedStandName(obj.Name) == wanted then
                    exact = obj
                    break
                end
            end
        end
        if exact and previewVisiblePartScore(exact) > 0 then
            local nestedMorph = exact:FindFirstChild("StandMorph", true)
            if nestedMorph and nestedMorph:IsA("Model") and previewVisiblePartScore(nestedMorph) > 0 then return nestedMorph end
            return exact
        end
        if allowContainerModel and container:IsA("Model") and previewVisiblePartScore(container) > 0 then return container end

        -- Asset layouts vary. Rank every nested model and choose the model with
        -- the most convincing full-Stand geometry, rather than the first little
        -- VFX strip/part that happens to be inside the asset folder.
        local best, bestScore = nil, 0
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("Model") then
                local score = previewVisiblePartScore(obj)
                if score > bestScore then best, bestScore = obj, score end
            end
        end
        return best
    end

    local function findStandPreviewSource(standName)
        local living = workspace:FindFirstChild("Living")
        local liveCharacter = living and living:FindFirstChild(player.Name)
        if liveCharacter then
            local liveMorph = liveCharacter:FindFirstChild("StandMorph", true)
            if liveMorph and liveMorph:IsA("Model") and previewVisiblePartScore(liveMorph) > 0 then return liveMorph end
        end
        local character = player.Character
        if character then
            local characterMorph = character:FindFirstChild("StandMorph", true)
            if characterMorph and characterMorph:IsA("Model") and previewVisiblePartScore(characterMorph) > 0 then return characterMorph end
        end

        local standsFolder = ReplicatedStorage:FindFirstChild("Stands")
        if not standsFolder then return nil end
        local wanted = normalizedStandName(standName)
        if wanted == "" then return nil end

        -- Prefer an exact child-name match; normalized names ignore spaces/punctuation.
        for _, child in ipairs(standsFolder:GetChildren()) do
            if normalizedStandName(child.Name) == wanted then
                local model = getStandModelWithin(child, standName, true)
                if model then return model end
            end
        end
        -- Some builds put the StandMorph deeper inside the named asset folder.
        for _, child in ipairs(standsFolder:GetChildren()) do
            if string.find(normalizedStandName(child.Name), wanted, 1, true)
                or string.find(wanted, normalizedStandName(child.Name), 1, true) then
                local model = getStandModelWithin(child, standName, true)
                if model then return model end
            end
        end
        -- Last attempt: a model itself may be named after the Stand even when
        -- the root folder has a generic name.
        for _, obj in ipairs(standsFolder:GetDescendants()) do
            if obj:IsA("Model") and normalizedStandName(obj.Name) == wanted then
                local nestedMorph = obj:FindFirstChild("StandMorph", true)
                if nestedMorph and nestedMorph:IsA("Model") and previewVisiblePartScore(nestedMorph) > 0 then return nestedMorph end
                if previewVisiblePartScore(obj) > 0 then return obj end
            end
        end
        return nil
    end

