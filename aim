        modules.renderState.rays.Enabled = modules.renderState.raysOriginal.Enabled
        modules.renderState.rays.Intensity = modules.renderState.raysOriginal.Intensity
        modules.renderState.rays.Spread = modules.renderState.raysOriginal.Spread
    end
    if modules._restoreFrameCap then pcall(modules._restoreFrameCap) end
    if modules._cleanupProjectilePrediction then pcall(modules._cleanupProjectilePrediction) end
    if modules._cleanupYBATeleportFilter then pcall(modules._cleanupYBATeleportFilter) end
    if modules._cleanupSpawnMarker then pcall(modules._cleanupSpawnMarker) end
