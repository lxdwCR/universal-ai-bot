                                        local n = string.lower(obj.Name)
                                        if not string.find(n, "effect", 1, true)
                                            and not string.find(n, "hitbox", 1, true)
                                            and not string.find(n, "dummy", 1, true)
                                            and not string.find(n, "rig", 1, true)
                                            and not string.find(n, "vfx", 1, true) then
                                            local candidate = normalizeStandCandidate(obj.Name:gsub("[Ss]tand", ""))
                                            if not candidate then candidate = normalizeStandCandidate(obj.Name) end
                                            if candidate then standName = candidate break end
                                        end
                                    end
                                end
                            end
                            standName = standName or "Unknown"
