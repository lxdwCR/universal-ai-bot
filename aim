-- Unload
------------------------------------------------------------------
local function cleanup()
    for i = #modules, 1, -1 do
        local m = modules[i]
        if m.enabled then pcall(m.set, false) end
    end
    for _, c in ipairs(connections) do c:Disconnect() end
    table.clear(connections)
    pcall(function() RunService:UnbindFromRenderStep("VisualClientFOV") end)

    removeHat()
    removeTrail()
    removeWings()
    correction:Destroy()
    blur:Destroy()
    gui:Destroy()
end

