    pageSearch.Visible = searchVisible
    pageHeading.Size = UDim2.new(1, searchVisible and -295 or -85, 0, 25)
    pageSummary.Size = UDim2.new(1, searchVisible and -300 or -95, 0, 15)
    for title, panel in pairs(panelRegistry) do
        if panel and panel.Parent then
            -- Crucial: keep each feature page inside the workspace, not on the original root canvas where
            -- it previously appeared off to the right.
            if panel.Parent ~= navShell then panel.Parent = navShell end
            panel:SetAttribute("TrueSightNavPage", true)
            panel.AnchorPoint = Vector2.new(0, 0)
            panel.Position = UDim2.fromOffset(navContentLeft + 1, 71)
            panel.Size = UDim2.fromOffset(width - navContentLeft - 1, height - 71)
            panel.BackgroundTransparency = (bgState.mode == 3 and bgState.enabled and bgState.asset ~= "") and 0.24 or 0.04
            panel.Visible = (title == activeNavPage)
            panel.ZIndex = 3
            local originalHeader = panel:FindFirstChildWhichIsA("TextButton")
            if originalHeader and originalHeader:GetAttribute("TrueSightRole") == "header" then
                originalHeader.Visible = false
            end
            local content = panel:FindFirstChild("PanelContent")
            if content then
                content.LayoutOrder = 0
                content.Size = UDim2.new(1, 0, 1, 0)
            end
            local stroke = panel:FindFirstChild("TrueSightPanelStroke")
            if stroke then stroke.Transparency = 1 end
        end
    end
