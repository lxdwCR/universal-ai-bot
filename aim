local order = 0
local function button(label, callback)
    order += 1
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 36)
    b.BackgroundColor3 = Color3.fromRGB(39, 44, 55)
    b.BorderSizePixel = 0
    b.TextColor3 = Color3.fromRGB(230, 235, 245)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 13
    b.Text = label
    b.LayoutOrder = order
    b.Parent = list
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(callback)
    return b
end

local function module(name, callback)
    enabled[name] = false
    local b
    b = button("[ OFF ]  " .. name, function()
        enabled[name] = not enabled[name]
        b.Text = (enabled[name] and "[ ON ]   " or "[ OFF ]  ") .. name
        b.BackgroundColor3 = enabled[name]
            and Color3.fromRGB(35, 100, 155)
            or Color3.fromRGB(39, 44, 55)
        callback(enabled[name])
    end)
    table.insert(resetFns, function()
        if enabled[name] then
            enabled[name] = false
            callback(false)
        end
    end)
    return b
end

-- Menu toggle key (rebindable)
local menuKey = Enum.KeyCode.RightShift
local binding = false
local keyButton

local function updateKeyButton()
    if not keyButton then return end
    if binding then
        keyButton.Text = "Menu Key:  press a key... (Esc cancels)"
    else
        keyButton.Text = "Menu Key:  " .. menuKey.Name .. "  (click to rebind)"
    end
end

keyButton = button("", function()
    binding = true
    updateKeyButton()
end)
updateKeyButton()

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if binding then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Escape then
                menuKey = input.KeyCode
            end
            binding = false
            updateKeyButton()
        end
        return
    end

    if processed then return end
    if input.KeyCode == menuKey then
        main.Visible = not main.Visible
    end
end))

-- China hat: glowing cone built from adornments (no physics, no shadows).
local hatPresets = {
    {name = "Cyan",   color = Color3.fromRGB(0, 220, 255)},
    {name = "Purple", color = Color3.fromRGB(170, 70, 255)},
    {name = "Pink",   color = Color3.fromRGB(255, 70, 170)},
    {name = "Green",  color = Color3.fromRGB(70, 255, 140)},
    {name = "Gold",   color = Color3.fromRGB(255, 200, 70)},
}
local hatIndex = 1
local hatCones = {}   -- {adornment, ...}
local hatLight

local function applyHatColor()
    local c = hatPresets[hatIndex].color
    for _, cone in ipairs(hatCones) do
        cone.Color3 = c
    end
    if hatLight then hatLight.Color = c end
end

local function removeHat()
    for _, obj in ipairs(cosmetics) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(cosmetics)
    table.clear(hatCones)
    hatLight = nil
end

local function addHat(character)
    removeHat()
    local head = character:FindFirstChild("Head")
    if not head then return end

    -- cone tip points up: rotate +90 degrees about X
    local function cone(radius, height, transparency, yOffset)
        local c = Instance.new("ConeHandleAdornment")
        c.Name = "LocalChinaHat"
        c.Adornee = head
        c.Radius = radius
        c.Height = height
        c.Transparency = transparency
        c.CFrame = CFrame.new(0, yOffset, 0) * CFrame.Angles(math.rad(90), 0, 0)
        c.ZIndex = 1
        c.AlwaysOnTop = false
        c.Parent = head
        table.insert(cosmetics, c)
        table.insert(hatCones, c)
    end

    cone(1.35, 1.15, 0.05, 0.45)   -- solid core
    cone(1.55, 1.35, 0.65, 0.40)   -- soft outer glow layer

    hatLight = Instance.new("PointLight")
    hatLight.Name = "LocalChinaHatLight"
    hatLight.Brightness = 1.5
    hatLight.Range = 10
    hatLight.Shadows = false
    hatLight.Parent = head
    table.insert(cosmetics, hatLight)

    applyHatColor()
end

module("China Hat", function(on)
    if on then
        if player.Character then addHat(player.Character) end
    else
        removeHat()
    end
end)

local hatColorButton
hatColorButton = button("Hat Color:  Cyan", function()
    hatIndex = hatIndex % #hatPresets + 1
    hatColorButton.Text = "Hat Color:  " .. hatPresets[hatIndex].name
    applyHatColor()
end)

-- Trail cosmetics
local function removeTrail()
    for _, obj in ipairs(trailObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(trailObjects)
end

local function addTrail(character)
    removeTrail()
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local a0 = Instance.new("Attachment")
    a0.Position = Vector3.new(-0.65, 0, 0)
    a0.Parent = root

    local a1 = Instance.new("Attachment")
    a1.Position = Vector3.new(0.65, 0, 0)
    a1.Parent = root

    local trail = Instance.new("Trail")
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Lifetime = 0.65
    trail.MinLength = 0.1
    trail.FaceCamera = true
    trail.LightEmission = 0.8
    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 200, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 60, 255))
    })
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.15),
        NumberSequenceKeypoint.new(1, 1)
    })
    trail.Parent = root

    table.insert(trailObjects, a0)
    table.insert(trailObjects, a1)
    table.insert(trailObjects, trail)
end

module("Player Trails", function(on)
    if on then
        if player.Character then addTrail(player.Character) end
    else
        removeTrail()
    end
end)

