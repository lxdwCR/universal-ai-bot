local stunStartedAt
-- Fallback estimate when YBA only exposes a boolean/flag rather than a remaining timer.
-- The estimate improves from measured stun lengths observed on this client during this session.
local learnedStunDuration = 2.0
local predictedStunDuration

local function truthyStunValue(value)
    if value == true then return true end
    if type(value) == "number" then return value > 0 end
    if type(value) == "string" then
        local v = string.lower(value)
        return v == "true" or v == "stunned" or v == "stun" or v == "hitstun"
    end
    return false
end

-- Look for game-provided timing fields. A plain Stunned=true flag tells us only
-- whether stun is active, not how much time remains, so we separately look for
-- names that specifically indicate a remaining countdown or end timestamp.
local function getStunTimingSignals()
    local character = player.Character
    if not character then return nil, nil end
    local remaining, duration
    local function consider(name, value)
        local key = string.lower(tostring(name)):gsub("[^%w]", "")
        local number = tonumber(value)
        if not number or number <= 0 or number > 120 then return end
        if not string.find(key, "stun", 1, true) and not string.find(key, "hitstun", 1, true) then return end

        local explicitRemaining = string.find(key, "remaining", 1, true)
            or string.find(key, "timeleft", 1, true)
            or string.find(key, "durationleft", 1, true)
            or string.find(key, "countdown", 1, true)
            or string.find(key, "timerleft", 1, true)
        if explicitRemaining and number <= 60 then
            remaining = remaining and math.min(remaining, number) or number
            return
        end

        if string.find(key, "endtime", 1, true) or string.find(key, "until", 1, true)
            or string.find(key, "endsat", 1, true) then
            -- Different games use either server-clock or local-clock timestamps.
            local ok, serverNow = pcall(function() return workspace:GetServerTimeNow() end)
            local candidates = {}
            if ok and type(serverNow) == "number" then table.insert(candidates, number - serverNow) end
            table.insert(candidates, number - os.clock())
            for _, left in ipairs(candidates) do
                if left > 0 and left <= 60 then
                    remaining = remaining and math.min(remaining, left) or left
                end
            end
            return
        end

        -- Total-duration fields are useful to seed the fallback countdown, but
        -- are not mistaken for remaining time.
        if string.find(key, "duration", 1, true) and number <= 15 then
            duration = duration and math.min(duration, number) or number
        end
    end

    local function inspect(instance)
        local ok, attributes = pcall(function() return instance:GetAttributes() end)
        if ok then
            for key, value in pairs(attributes) do consider(key, value) end
        end
    end

    inspect(player)
    inspect(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then inspect(humanoid) end
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") or obj:IsA("StringValue") then
            consider(obj.Name, obj.Value)
        end
        inspect(obj)
    end
    return remaining, duration
end

local function isActiveStunKey(name)
    local key = string.lower(tostring(name)):gsub("[^%w]", "")
    if not string.find(key, "stun", 1, true) then return false end
    -- Duration/end-time metadata isn't proof that a stun is currently active.
    if string.find(key, "duration", 1, true)
        or string.find(key, "endtime", 1, true)
        or string.find(key, "endsat", 1, true)
        or string.find(key, "until", 1, true) then
        return false
    end
    return true
end

local function isLocallyStunned()
    local character = player.Character
    if not character then return false, "no character" end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local keys = {"Stunned", "Stun", "IsStunned", "HitStun", "Hitstun", "InStun", "stunned", "stun"}
    local function checkAttributes(instance)
        for _, key in ipairs(keys) do
            local ok, value = pcall(function() return instance:GetAttribute(key) end)
            if ok and truthyStunValue(value) then return true end
        end
        local ok, attributes = pcall(function() return instance:GetAttributes() end)
        if ok then
            for key, value in pairs(attributes) do
                if isActiveStunKey(key) and truthyStunValue(value) then
                    return true
                end
            end
        end
        return false
    end
    if checkAttributes(character) or checkAttributes(player) or (humanoid and checkAttributes(humanoid)) then
        return true, "stun flag"
    end
    for _, obj in ipairs(character:GetDescendants()) do
        local lower = string.lower(obj.Name)
        if (obj:IsA("BoolValue") or obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("StringValue")) then
            if isActiveStunKey(obj.Name) and truthyStunValue(obj.Value) then
                return true, "stun value"
            end
        end
        if obj:IsA("Folder") or obj:IsA("Model") then
            if (lower == "stun" or lower == "stunned" or lower == "hitstun") and #obj:GetChildren() > 0 then
                return true, "stun container"
            end
        end
    end
    -- Movement-lock fallback can help detect some stuns, but may also trigger
    -- during moves. Prefer an explicit YBA state whenever one is available.
    if humanoid and humanoid.Health > 0 then
        local jumpDisabled = humanoid.UseJumpPower and humanoid.JumpPower <= 1 or (not humanoid.UseJumpPower and humanoid.JumpHeight <= 0.1)
        if humanoid.WalkSpeed <= 1 and jumpDisabled then
            return true, "movement lock"
        end
    end
    return false, "not detected"
end

