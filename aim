local function normalizeBackgroundAsset(value)
    value = tostring(value or "")
    value = value:gsub("%s+", "")
    if value == "" then return "" end
    if value:match("^rbxassetid://") or value:match("^https?://") then return value end
    local digits = value:match("^(%d+)$")
    return digits and ("rbxassetid://" .. digits) or value
end

local function refreshWorkspaceBackground()
    local accentDark = BG:Lerp(accent, 0.12)
    local accentSoft = BG:Lerp(accent, 0.05)
    bgRoot.Visible = bgState.enabled and bgState.mode ~= 1
    bgGradientFrame.Visible = bgState.enabled and bgState.mode == 2
    bgImage.Visible = bgState.enabled and bgState.mode == 3 and bgState.asset ~= ""
    bgImage.Image = bgState.asset
    bgImage.ImageTransparency = bgState.imageTransparency
    bgImage.ScaleType = bgFitModes[bgState.fit] or Enum.ScaleType.Crop
    bgOverlay.BackgroundTransparency = bgState.overlayTransparency
    bgGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 11, 17)),
        ColorSequenceKeypoint.new(0.35, accentSoft),
        ColorSequenceKeypoint.new(1, accentDark)
    })
    local showArt = bgState.enabled and bgState.mode == 3 and bgState.asset ~= ""
    for _, panel in pairs(panelRegistry) do
        if panel and panel.Parent and panel:GetAttribute("TrueSightNavPage") then
            panel.BackgroundTransparency = showArt and 0.24 or 0.04
        end
    end
end
