                    return HttpService:JSONEncode(snapshotData)
                end)
                if snapshotJsonOk then
                    pcall(writeVerified, STARTUP_CONFIG_PATH, snapshotJson)
                end
            end
            return true
        end
    end
    return false
end

local function applyConfig(data)
    if type(data) ~= "table" then return false end
    configLoading = true
    local applied = true

    local ok, err = pcall(function()
        if type(data.accent) == "number" and presets[data.accent] then
            pcall(setAccentIndex, data.accent)
        end

        -- Restore setting values before enabling modules, so each module starts using the saved
        -- configuration rather than its default settings.
        if type(data.values) == "table" then
            for key, value in pairs(data.values) do
                local entry = configEntries[key]
                if not entry and type(key) == "string" then
                    -- Keep v26-v41 settings when the stand-skin label loses Experimental.
                    local previousPrefix = "Avatar Stand Skin (Experimental)/"
                    if string.sub(key, 1, #previousPrefix) == previousPrefix then
                        entry = configEntries["Skin Changer/" .. string.sub(key, #previousPrefix + 1)]
                    end
                    local legacyPrefix = "Avatar Stand Skin/"
                    if not entry and string.sub(key, 1, #legacyPrefix) == legacyPrefix then
                        local oldLabel = string.sub(key, #legacyPrefix + 1)
                        if oldLabel == "Username" or oldLabel == "Stand Skin Username" then oldLabel = "Avatar Username" end
                        if oldLabel == "SPOHAura" or oldLabel == "SPOH Stand Aura" then oldLabel = "SPOH Golden Aura" end
                        if oldLabel == "SPOHBarrageFX" then oldLabel = "SPOH Barrage FX" end
                        entry = configEntries["Skin Changer/" .. oldLabel]
                        if key == "Avatar Stand Skin/Skin Source" and tonumber(value) == 3 then
                            value = 2
                        end
                    end
                end
                if entry then
                    local setOk, setErr = pcall(entry.set, value)
                    if not setOk then
                        warn("[TrueSight] Could not apply setting " .. tostring(key) .. ": " .. tostring(setErr))
                    end
                end
            end
        end

        if modules._finalizeBackdropConfig then
            pcall(modules._finalizeBackdropConfig, data.values)
        end

        if type(data.menuKey) == "string" then
            local keyOk, kc = pcall(function() return Enum.KeyCode[data.menuKey] end)
            if keyOk and kc then
                keyUiState.menuKey = kc
                pcall(keyUiState.updateKeyUi)
            end
        end

        if type(data.panelSizes) == "table" then
            for title, size in pairs(data.panelSizes) do
                local panel = panelRegistry[title]
                if panel and not panel:GetAttribute("TrueSightNavPage")
                    and type(size) == "table" and type(size.w) == "number" and type(size.h) == "number" then
                    pcall(function()
                        local viewport = (cam() and cam().ViewportSize) or Vector2.new(1280, 720)
                        panel.Size = UDim2.fromOffset(
                            math.clamp(size.w, 132, math.max(132, viewport.X - 16)),
                            math.clamp(size.h, 250, math.max(250, viewport.Y - 24)))
                    end)
                end
            end
        end
        if type(data.panels) == "table" then
            for title, pos in pairs(data.panels) do
                local panel = panelRegistry[title]
                if title ~= "Config" and panel and not panel:GetAttribute("TrueSightNavPage")
                    and type(pos) == "table"
                    and type(pos.x) == "number" and type(pos.y) == "number" then
                    pcall(function() panel.Position = UDim2.fromOffset(pos.x, pos.y) end)
                end
            end
        end
        uiInteraction.clampAll()
        task.defer(uiInteraction.clampAll)

        if type(data.statsPosition) == "table"
            and type(data.statsPosition.x) == "number"
            and type(data.statsPosition.y) == "number" then
            pcall(function()
                statsFrame.Position = UDim2.fromOffset(data.statsPosition.x, data.statsPosition.y)
            end)
        end

        if type(data.modules) == "table" then
            for _, module in ipairs(modules) do
                local want = data.modules[module.name]
                if want == nil and module.name == "Skin Changer" then
                    want = data.modules["Avatar Stand Skin"]
                    if want == nil then want = data.modules["Avatar Stand Skin (Experimental)"] end
                end
                if want == nil and module.name == "Desync Box" then
                    want = data.modules["Own Position Estimate"]
                    if want == nil then want = data.modules["Desync Tracker"] end
                end
                if type(want) == "boolean" then
                    local setOk, setErr = pcall(module.set, want)
                    if not setOk then
                        warn("[TrueSight] Could not apply module " .. tostring(module.name) .. ": " .. tostring(setErr))
                    end
                end
            end
        end
    end)

    configLoading = false
    if not ok then
        applied = false
        warn("[TrueSight] Config application failed: " .. tostring(err))
    end
    return applied
end

