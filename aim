modules._unloadCleanup = function()
    if chatConfigConnection then
        pcall(function() chatConfigConnection:Disconnect() end)
        chatConfigConnection = nil
    end
    -- save the current state first, then stop auto-saving while modules switch off
    if saveConfig then saveConfig() end
    configLoading = true
    for i = #modules, 1, -1 do
        local m = modules[i]
        if m.enabled then pcall(m.set, false) end
    end
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    if sprintConn then
        pcall(function() sprintConn:Disconnect() end)
        sprintConn = nil
    end
    pcall(function() RunService:UnbindFromRenderStep("TrueSightFOV") end)

    removeHat()
    removeTrail()
    removeWings()
    removeAura()
    removeStandAura()
    verity.remove()
    unhookJump()
    removeGhost()
    if visualModules.removeHalo then pcall(visualModules.removeHalo) end
    if visualModules.removeOrbs then pcall(visualModules.removeOrbs) end
    if visualModules.stopFootstepSparks then pcall(visualModules.stopFootstepSparks) end
    if visualModules.removeBodyGlow then pcall(visualModules.removeBodyGlow) end
    if visualModules.stopBlackFlash then pcall(visualModules.stopBlackFlash) end
    if nameTagLoop then nameTagLoop:Disconnect() nameTagLoop = nil end
    for plr in pairs(nameTagObjects) do removeNameTag(plr) end
    if modules.cleanupWorldMood then pcall(modules.cleanupWorldMood) end
    if renderState.correction then renderState.correction:Destroy() end
    if renderState.blur then renderState.blur:Destroy() end
    if renderState.bloomCreated then
        renderState.bloom:Destroy()
    elseif renderState.bloomOriginal and renderState.bloom.Parent then
        renderState.bloom.Enabled = renderState.bloomOriginal.Enabled
        renderState.bloom.Intensity = renderState.bloomOriginal.Intensity
        renderState.bloom.Size = renderState.bloomOriginal.Size
        renderState.bloom.Threshold = renderState.bloomOriginal.Threshold
    end
    if renderState.raysCreated then
        renderState.rays:Destroy()
    elseif renderState.raysOriginal and renderState.rays.Parent then
        renderState.rays.Enabled = renderState.raysOriginal.Enabled
        renderState.rays.Intensity = renderState.raysOriginal.Intensity
        renderState.rays.Spread = renderState.raysOriginal.Spread
    end
    fxGui:Destroy()
    gui:Destroy()
end

------------------------------------------------------------------
-- Config saving (needs an executor with writefile / readfile)
------------------------------------------------------------------
;(function()
local CONFIG_PATH = canFolder and "TrueSight/config.json" or "TrueSightConfig.json"
local currentProfile = "default"

local function normalizeProfileName(value)
    local safe = string.gsub(tostring(value or ""), "[^%w_-]", "")
    return string.sub(safe, 1, 24)
end

-- Prefer flat files as the canonical paths. They do not depend on the
-- executor correctly supporting folders across separate script executions.
local function profilePath(profile)
    if profile == "default" then return "TrueSightConfig.json" end
    return "TrueSight_" .. profile .. ".json"
end

local function readConfig(profileName)
    local profile = normalizeProfileName(profileName or currentProfile)
    if profile == "" or not canFile then return nil end

    -- Try both folder and flat-file layouts. Some executor environments expose
    -- makefolder/isfolder differently between sessions, so relying on one path
    -- can make a valid selected profile look like it was never saved.
    local paths = {}
    local seen = {}
    local function addPath(path)
        if path and not seen[path] then
            seen[path] = true
            table.insert(paths, path)
        end
    end
    addPath(profilePath(profile))
    if profile == "default" then
        addPath("TrueSight/config.json")
        addPath("TrueSightConfig.json")
        addPath("VisualClient/config.json")
        addPath("VisualClientConfig.json")
    else
        addPath("TrueSight/" .. profile .. ".json")
        addPath("TrueSight_" .. profile .. ".json")
    end

    for _, path in ipairs(paths) do
        -- Do not gate readfile behind isfile(): some executors report false for
        -- valid paths or implement isfile inconsistently. A protected read is
        -- a more reliable existence check.
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)
        if ok and type(data) == "table" then return data end
    end
    return nil
end

-- Canonical auto-load marker and self-contained snapshot are flat files so
-- executors can reuse them across separate executions.
local AUTOLOAD_PATH = "TrueSightAutoLoad.txt"
local STARTUP_CONFIG_PATH = "TrueSightStartupConfig.json"
local AUTOLOAD_MARKER_PATHS = {AUTOLOAD_PATH, "TrueSight/autoload.txt"}

local function timestampMillis()
    local ok, value = pcall(function()
        return DateTime.now().UnixTimestampMillis
    end)
    if ok and type(value) == "number" then return value end
    return os.time() * 1000
end

local function parseAutoLoadMarker(value)
    if type(value) ~= "string" then return nil, 0 end
    -- New format is "profile|timestamp"; plain profile names from older script
    -- versions remain supported and are treated as older than timestamped data.
    local rawProfile, rawStamp = string.match(value, "^(.-)|(%d+)$")
    if not rawProfile then rawProfile = value end
    local profile = normalizeProfileName(rawProfile)
    if profile == "" then return nil, 0 end
    return profile, tonumber(rawStamp) or 0
end

-- Read every marker and select the most recently written one. This also allows
-- an alternate path to work if a particular executor blocks one file location.
local function readAutoLoadMarker()
    if not canFile then return nil, 0 end
    local bestProfile, bestStamp = nil, -1
    for _, path in ipairs(AUTOLOAD_MARKER_PATHS) do
        local ok, value = pcall(readfile, path)
        if ok and type(value) == "string" then
            local profile, stamp = parseAutoLoadMarker(value)
            if profile and stamp > bestStamp then
                bestProfile, bestStamp = profile, stamp
            end
        end
    end
    return bestProfile, bestStamp >= 0 and bestStamp or 0
end

local function readStartupSnapshot()
    if not canFile then return nil, nil, 0 end
    local ok, contents = pcall(readfile, STARTUP_CONFIG_PATH)
    if not ok or type(contents) ~= "string" then return nil, nil, 0 end
    local decodeOk, data = pcall(function()
        return HttpService:JSONDecode(contents)
    end)
    if not decodeOk or type(data) ~= "table" then return nil, nil, 0 end
    local profile = normalizeProfileName(data.profile)
    if profile == "" then profile = nil end
    local stamp = tonumber(data.selectionTimestamp) or 0
    return data, profile, stamp
end

local function getAutoLoadSelection()
    if not canFile then return "default", 0, "default" end
    local markerProfile, markerStamp = readAutoLoadMarker()
    local _, snapshotProfile, snapshotStamp = readStartupSnapshot()

    -- Timestamp comparison prevents a stale marker or stale snapshot from
    -- undoing a newer selection. On ties, prefer the marker (legacy scripts).
    if snapshotProfile and snapshotStamp > markerStamp then
        return snapshotProfile, snapshotStamp, "snapshot"
    end
    if markerProfile then return markerProfile, markerStamp, "marker" end
    if snapshotProfile then return snapshotProfile, snapshotStamp, "snapshot" end
    return "default", 0, "default"
end

local function getAutoLoadProfile()
    local profile = getAutoLoadSelection()
    return profile
end

local function writeVerified(path, contents)
    local writeOk = pcall(function() writefile(path, contents) end)
    if not writeOk then return false end
    local verifyOk, verifyValue = pcall(readfile, path)
    return verifyOk and verifyValue == contents
end

local function setAutoLoadProfile(profileName)
    if not canFile then return false end
    local profile = normalizeProfileName(profileName or "default")
    if profile == "" then return false end

    -- Validate the named profile before making it the startup selection.
    local data = readConfig(profile)
    if type(data) ~= "table" then return false end

    local _, previousStamp = getAutoLoadSelection()
    local selectedAt = math.max(timestampMillis(), (previousStamp or 0) + 1)
    data.profile = profile
    data.selectionTimestamp = selectedAt
    local encodedOk, snapshotJson = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if not encodedOk then return false end

    -- Write the same timestamped selection to both files. At next startup the
    -- newest successful write wins, even if one path failed and contains an
    -- older profile name.
    local markerValue = profile .. "|" .. tostring(selectedAt)
    local markerOk = false
    for _, path in ipairs(AUTOLOAD_MARKER_PATHS) do
        local ok, result = pcall(function()
            if string.sub(path, 1, 10) == "TrueSight/" and canFolder then
                local folderExists = false
                pcall(function() folderExists = isfolder("TrueSight") end)
                if not folderExists then pcall(makefolder, "TrueSight") end
            end
            return writeVerified(path, markerValue)
        end)
        if ok and result then markerOk = true end
    end
    local snapshotOk = writeVerified(STARTUP_CONFIG_PATH, snapshotJson)
    return markerOk or snapshotOk
end

saveConfig = function(profileName)
    if not canFile then return false end
    local profile = normalizeProfileName(profileName or currentProfile)
    if profile == "" then return false end
    currentProfile = profile

    local data = {
        version = 1,
        accent = accentIndex,
        menuKey = keyUiState.menuKey.Name,
        modules = {},
        values = {},
        panels = {},
        panelSizes = {},
        statsPosition = {
            x = statsFrame.Position.X.Offset,
            y = statsFrame.Position.Y.Offset,
        },
    }
    for _, m in ipairs(modules) do
        data.modules[m.name] = m.enabled
    end
    for key, e in pairs(configEntries) do
        local ok, v = pcall(e.get)
        if ok then data.values[key] = v end
    end
    for title, panel in pairs(panelRegistry) do
        -- Keep Config aligned to the current screen edge instead of restoring
        -- a stale pixel coordinate from another screen resolution.
        if title ~= "Config" then
            data.panels[title] = {
                x = panel.Position.X.Offset,
                y = panel.Position.Y.Offset,
            }
        end
        data.panelSizes[title] = {
            w = panel.Size.X.Offset,
            h = panel.Size.Y.Offset,
        }
    end

    local encodedOk, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if not encodedOk then return false end

    local paths = {}
    local seen = {}
    local function addPath(path)
        if path and not seen[path] then
            seen[path] = true
            table.insert(paths, path)
        end
    end
    addPath(profilePath(profile))
    if profile == "default" then
        addPath("TrueSight/config.json")
        addPath("TrueSightConfig.json")
    else
        addPath("TrueSight/" .. profile .. ".json")
        addPath("TrueSight_" .. profile .. ".json")
    end

    for _, path in ipairs(paths) do
        local writeOk = pcall(function()
            if string.sub(path, 1, 10) == "TrueSight/" and canFolder then
                local folderExists = false
                pcall(function() folderExists = isfolder("TrueSight") end)
                if not folderExists then pcall(makefolder, "TrueSight") end
            end
            writefile(path, encoded)
        end)
        if writeOk then
            local verifyOk, contents = pcall(readfile, path)
            if verifyOk and contents == encoded then
                -- Keep the self-contained startup copy in sync whenever the
                -- currently selected auto-load profile is saved/auto-saved.
                local selectedOk, selectedProfile, selectedStamp = pcall(function()
                    return getAutoLoadSelection()
                end)
                if selectedOk and selectedProfile == profile then
                    local snapshotData = data
                    snapshotData.profile = profile
                    snapshotData.selectionTimestamp = selectedStamp or 0
                    local snapshotJsonOk, snapshotJson = pcall(function()
                        return HttpService:JSONEncode(snapshotData)
                    end)
                    if snapshotJsonOk then
                        pcall(writeVerified, STARTUP_CONFIG_PATH, snapshotJson)
                    end
                end
                return true
            end
        end
    end
    return false
end

local function applyConfig(data)
    if type(data) ~= "table" then return false end
    configLoading = true
    local applied = true

    local ok, err = pcall(function()
        if type(data.accent) == "number" and presets[data.accent] then
            pcall(setAccentIndex, data.accent)
        end

        -- Restore setting values before enabling modules, so each module starts
        -- using the saved configuration rather than its default settings.
        if type(data.values) == "table" then
            for key, value in pairs(data.values) do
                local entry = configEntries[key]
                if entry then
                    local setOk, setErr = pcall(entry.set, value)
                    if not setOk then
                        warn("[TrueSight] Could not apply setting " .. tostring(key) .. ": " .. tostring(setErr))
                    end
                end
            end
        end

        if type(data.menuKey) == "string" then
            local keyOk, kc = pcall(function() return Enum.KeyCode[data.menuKey] end)
            if keyOk and kc then
                keyUiState.menuKey = kc
                pcall(keyUiState.updateKeyUi)
            end
        end

        if type(data.panelSizes) == "table" then
            for title, size in pairs(data.panelSizes) do
                local panel = panelRegistry[title]
                if panel and type(size) == "table" and type(size.w) == "number" and type(size.h) == "number" then
                    pcall(function()
                        local viewport = (cam() and cam().ViewportSize) or Vector2.new(1280, 720)
                        panel.Size = UDim2.fromOffset(
                            math.clamp(size.w, 132, math.max(132, viewport.X - 16)),
                            math.clamp(size.h, 250, math.max(250, viewport.Y - 24)))
                    end)
                end
            end
        end
        if type(data.panels) == "table" then
            for title, pos in pairs(data.panels) do
                local panel = panelRegistry[title]
                if title ~= "Config" and panel and type(pos) == "table"
                    and type(pos.x) == "number" and type(pos.y) == "number" then
                    pcall(function() panel.Position = UDim2.fromOffset(pos.x, pos.y) end)
                end
            end
        end
        uiInteraction.clampAll()
        task.defer(uiInteraction.clampAll)

        if type(data.statsPosition) == "table"
            and type(data.statsPosition.x) == "number"
            and type(data.statsPosition.y) == "number" then
            pcall(function()
                statsFrame.Position = UDim2.fromOffset(data.statsPosition.x, data.statsPosition.y)
            end)
        end

        if type(data.modules) == "table" then
            for _, module in ipairs(modules) do
                local want = data.modules[module.name]
                if want == nil and module.name == "Desync Box" then
                    want = data.modules["Own Position Estimate"]
                    if want == nil then want = data.modules["Desync Tracker"] end
                end
                if type(want) == "boolean" then
                    local setOk, setErr = pcall(module.set, want)
                    if not setOk then
                        warn("[TrueSight] Could not apply module " .. tostring(module.name) .. ": " .. tostring(setErr))
                    end
                end
            end
        end
    end)

    configLoading = false
    if not ok then
        applied = false
        warn("[TrueSight] Config application failed: " .. tostring(err))
    end
    return applied
end

-- Persistent on-screen feedback for config commands and saves.
local configNotice
local configNoticeToken = 0

notifyConfig = function(message, isError)
    if not gui or not gui.Parent then
        if isError then warn("[TrueSight] " .. message) else print("[TrueSight] " .. message) end
        return
    end

    if not configNotice or not configNotice.Parent then
        configNotice = Instance.new("TextLabel")
        configNotice.Name = "ConfigNotice"
        configNotice.AnchorPoint = Vector2.new(0.5, 0)
        configNotice.Position = UDim2.new(0.5, 0, 0, 12)
        configNotice.Size = UDim2.fromOffset(340, 34)
        configNotice.BackgroundColor3 = BG
        configNotice.BackgroundTransparency = 0.04
        configNotice:SetAttribute("TrueSightRole", "panel")
        configNotice.BorderSizePixel = 0
        configNotice.Font = FONTB
        configNotice.TextSize = 13
        configNotice.TextColor3 = TEXT
        configNotice.TextWrapped = true
        configNotice.ZIndex = 100
        configNotice.Parent = gui
        corner(configNotice, 9)
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1
        stroke.Parent = configNotice
        stroke:SetAttribute("TrueSightRole", "accent-stroke")
        onAccent(function(c) if stroke.Parent then stroke.Color = c end end)
    end

    configNoticeToken += 1
    local token = configNoticeToken
    configNotice.Text = "  " .. message .. "  "
    configNotice.TextColor3 = isError and BAD or GOOD
    configNotice.Visible = true
    task.delay(2.5, function()
        if configNotice and configNotice.Parent and configNoticeToken == token then
            configNotice.Visible = false
        end
    end)
end

local function flash(btn, text, base)
    btn.Text = "   " .. text
    task.delay(1.5, function()
        if btn.Parent then btn.Text = "   " .. base end
    end)
end

-- A separate Config panel keeps save/load controls visible regardless of the
-- number of Client options or whether the Client panel is obscured/off-screen.
local viewportWidth = (cam() and cam().ViewportSize.X) or clickGui.AbsoluteSize.X
local configPanel = makePanel("Config", math.max(8, viewportWidth - 197))

local saveBtn
saveBtn = addAction(configPanel, "Save Config", function()
    if not canFile then
        flash(saveBtn, "No file access here", "Save Config")
    elseif saveConfig() then
        flash(saveBtn, "Saved!", "Save Config")
        notifyConfig("Config saved", false)
    else
        flash(saveBtn, "Save failed", "Save Config")
    end
end)
saveBtn.LayoutOrder = 1

local loadBtn
loadBtn = addAction(configPanel, "Load Config", function()
    local data = readConfig()
    if data then
        applyConfig(data)
        flash(loadBtn, "Loaded!", "Load Config")
        notifyConfig("Config loaded", false)
    else
        flash(loadBtn, canFile and "No saved config" or "No file access here", "Load Config")
    end
end)
loadBtn.LayoutOrder = 2

local profileInput
profileInput = addTextInput(configPanel, "Config Profile",
    "Profile name (letters, numbers, _ or -)...", "default", function(value)
        local safe = normalizeProfileName(value)
        if safe ~= "" then
            profileInput.Text = safe
            currentProfile = safe
        end
    end)
profileInput.LayoutOrder = 3
-- Save Profile button removed: Save Config writes the currently selected profile.
local loadProfileBtn
loadProfileBtn = addAction(configPanel, "Load Profile", function()
    local profile = normalizeProfileName(profileInput.Text)
    local data = profile ~= "" and readConfig(profile) or nil
    if data then
        currentProfile = profile
        applyConfig(data)
        flash(loadProfileBtn, "Loaded " .. profile, "Load Profile")
        notifyConfig("Config loaded (" .. profile .. ")", false)
    else
        flash(loadProfileBtn, "Profile not found", "Load Profile")
    end
end)
loadProfileBtn.LayoutOrder = 5
local autoLoadBtn
local function refreshAutoLoadButton()
    if autoLoadBtn then autoLoadBtn.Text = "   Auto-Load: " .. getAutoLoadProfile() end
end
autoLoadBtn = addAction(configPanel, "Set Auto-Load Profile", function()
    local profile = normalizeProfileName(profileInput.Text)
    if profile == "" then profile = "default" end
    if not canFile then
        flash(autoLoadBtn, "No file access", "Set Auto-Load Profile")
    elseif not readConfig(profile) then
        flash(autoLoadBtn, "Profile not found", "Set Auto-Load Profile")
    elseif setAutoLoadProfile(profile) then
        currentProfile = profile
        profileInput.Text = profile
        refreshAutoLoadButton()
        flash(autoLoadBtn, "Set: " .. profile, "Auto-Load: " .. profile)
        notifyConfig("Startup profile set to " .. profile, false)
    else
        flash(autoLoadBtn, "Could not save", "Set Auto-Load Profile")
    end
end)
autoLoadBtn.LayoutOrder = 6
refreshAutoLoadButton()

-- Chat shortcuts: /config save, /config load, /config save <profile>,
-- /config load <profile>. Chat messages are handled locally by this script.
pcall(function()
    chatConfigConnection = player.Chatted:Connect(function(message)
        local command, profile = string.match(message, "^%s*/config%s+(%S+)%s*(.-)%s*$")
        if not command then return end
        command = string.lower(command)
        profile = normalizeProfileName(profile)
        if command == "save" then
            local ok = saveConfig(profile ~= "" and profile or nil)
            if ok then
                notifyConfig("Config saved" .. (profile ~= "" and (" (" .. profile .. ")") or ""), false)
            else
                notifyConfig("Config save failed — check executor file access", true)
            end
        elseif command == "load" then
            local data = readConfig(profile ~= "" and profile or nil)
            if data then
                currentProfile = profile ~= "" and profile or "default"
                applyConfig(data)
                notifyConfig("Config loaded" .. (profile ~= "" and (" (" .. profile .. ")") or ""), false)
            else
                notifyConfig("No saved config found" .. (profile ~= "" and (" for " .. profile) or ""), true)
            end
        end
    end)
end)

addAction(clientPanel, "Unload Client", modules._unloadCleanup)

-- Auto-load after the UI and module callbacks have finished initializing. The
-- dedicated snapshot is authoritative when present; the selected profile file
-- is the fallback if the snapshot cannot be decoded.
if canFile then
    task.defer(function()
        -- Allow the GUI, module rows and setting registration to finish first.
        task.wait(0.8)

        -- A saved marker takes precedence over the cached snapshot. Only use
        -- the snapshot when it belongs to the selected profile, or when there
        -- is no marker and the snapshot is the only saved startup selection.
        local startupProfile, selectedStamp, selectionSource = getAutoLoadSelection()
        local snapshot, snapshotProfile, snapshotStamp = readStartupSnapshot()
        local data = nil
        local loadedFromSnapshot = false

        -- If the snapshot is the newest surviving selection, it is the chosen
        -- config itself. Otherwise prefer the selected profile file, falling
        -- back to a matching snapshot only if that profile file is unavailable.
        if selectionSource == "snapshot" and snapshot and snapshotProfile == startupProfile then
            data = snapshot
            loadedFromSnapshot = true
        else
            data = readConfig(startupProfile)
            if not data and snapshot and snapshotProfile == startupProfile then
                data = snapshot
                loadedFromSnapshot = true
            end
        end

        if data then
            currentProfile = startupProfile
            if profileInput then profileInput.Text = startupProfile end

            local applyOk = applyConfig(data)
            -- A few visual modules depend on Character/PlayerGui finishing their
            -- startup. Retry twice after short settling windows.
            task.wait(0.35)
            local secondApplyOk = applyConfig(data)
            task.wait(0.5)
            local thirdApplyOk = applyConfig(data)

            if applyOk and secondApplyOk and thirdApplyOk then
                notifyConfig("Config auto-loaded: " .. startupProfile .. (loadedFromSnapshot and " (snapshot)" or ""), false)
                print("[TrueSight] Startup config applied: " .. startupProfile
                    .. " (source=" .. tostring(loadedFromSnapshot and "snapshot" or "profile file")
                    .. ", selection=" .. tostring(selectionSource) .. ", timestamp=" .. tostring(selectedStamp) .. ")")
            else
                notifyConfig("Config found but application failed; see console", true)
                warn("[TrueSight] Startup config application failed for profile: " .. startupProfile)
            end
        else
            notifyConfig("Auto-load profile not found: " .. startupProfile, true)
            warn("[TrueSight] Could not read auto-load profile: " .. startupProfile)
        end
    end)
end
end)()

