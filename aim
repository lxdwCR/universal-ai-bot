                spawnState.x, spawnState.y, spawnState.z = pad.Position.X, pad.Position.Y, pad.Position.Z
                spawnState.target = pad
                spawnState.label = spawnState.aliases[key] or autoName
                spawnState.spawnToken += 1
                updateSelected()
                requestSave()
                task.defer(function()
                    if not modules._unloaded and refreshSpawnList then refreshSpawnList() end
                end)
            end)
            button.Parent = choicesHost
            button.LayoutOrder = i
            button.TextColor3 = selected and accent or TEXT
            spawnState.rows[#spawnState.rows+1] = button
