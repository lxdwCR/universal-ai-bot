    local function refitPreviewCamera()
        if not previewModel or not previewModel.Parent then return end
        local boundsOk, _, bounds = pcall(function()
            local cf, size = previewModel:GetBoundingBox()
            return cf, size
        end)
        if not boundsOk or not bounds then return end
        local width = math.max(1, previewViewport.AbsoluteSize.X)
        local height = math.max(1, previewViewport.AbsoluteSize.Y)
        local aspect = width / height
        local vfov = math.rad(previewCamera.FieldOfView)
        local hfov = 2 * math.atan(math.tan(vfov / 2) * aspect)
        local distanceV = math.max(bounds.Y, 0.65) / (2 * math.tan(vfov / 2))
        local distanceH = math.max(bounds.X, bounds.Z, 0.65) / (2 * math.tan(hfov / 2))
        local distance = math.max(distanceV, distanceH, bounds.Z * 0.72, 2.6) * 1.30
        local lookY = math.clamp(bounds.Y * 0.04, -0.6, 0.6)
        previewCamera.CFrame = CFrame.lookAt(Vector3.new(distance * 0.30, lookY, distance), Vector3.new(0, lookY, 0))
        previewCamera.Focus = CFrame.new(0, 0, 0)
    end

