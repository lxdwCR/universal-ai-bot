modules._unloadCleanup = function()
    if modules._unloaded then return end
    modules._unloaded = true
    if modules._sessionEnv and modules._sessionHandle
        and rawget(modules._sessionEnv, "__TrueSightActiveSessionV7") == modules._sessionHandle then
        rawset(modules._sessionEnv, "__TrueSightActiveSessionV7", nil)
    end
    if chatConfigConnection then
        pcall(function() chatConfigConnection:Disconnect() end)
        chatConfigConnection = nil
    end
    -- save the current state first, then stop auto-saving while modules switch off
    if saveConfig then saveConfig() end
    configLoading = true
    for i = #modules, 1, -1 do
        local m = modules[i]
        if m.enabled then pcall(m.set, false) end
    end
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    if sprintConn then
        pcall(function() sprintConn:Disconnect() end)
        sprintConn = nil
    end
    pcall(function() RunService:UnbindFromRenderStep("TrueSightFOV") end)
    pcall(function() RunService:UnbindFromRenderStep("TrueSightFreelook") end)
    pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
    pcall(function() UserInputService.MouseIconEnabled = true end)

    removeHat()
    removeTrail()
    removeWings()
    removeAura()
    removeStandAura()
    verity.remove()
    unhookJump()
    removeGhost()
    if visualModules.removeHalo then pcall(visualModules.removeHalo) end
    if visualModules.removeOrbs then pcall(visualModules.removeOrbs) end
    if visualModules.stopFootstepSparks then pcall(visualModules.stopFootstepSparks) end
    if visualModules.removeBodyGlow then pcall(visualModules.removeBodyGlow) end
    if visualModules.clearShowcaseChams then pcall(visualModules.clearShowcaseChams) end
    if modules._cleanupEmoteWheel then pcall(modules._cleanupEmoteWheel) end
    if modules._cleanupMoid then pcall(modules._cleanupMoid) end
    if modules._cleanupSkinSync then pcall(modules._cleanupSkinSync) end
    if modules._cleanupStandSkin then pcall(modules._cleanupStandSkin) end
    if visualModules.stopBlackFlash then pcall(visualModules.stopBlackFlash) end
    if nameTagLoop then nameTagLoop:Disconnect() nameTagLoop = nil end
    for plr in pairs(nameTagObjects) do removeNameTag(plr) end
    if modules.cleanupWorldMood then pcall(modules.cleanupWorldMood) end
    if modules.renderState.correction then modules.renderState.correction:Destroy() end
