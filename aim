    local function getCharacterSkillRemote()
        -- Use the player's current Character RemoteFunction first. This is the
        -- path used by commonly published YBA LearnSkill examples. The model in
        -- workspace.Living is only a fallback, since its instance can be stale
        -- during/just after a Rokakaka reset.
        local character = player.Character
        if character then
            local remote = character:FindFirstChild("RemoteFunction")
            if not (remote and remote:IsA("RemoteFunction")) then
                remote = character:WaitForChild("RemoteFunction", 5)
            end
            if remote and remote:IsA("RemoteFunction") then
                return remote, "LocalPlayer.Character.RemoteFunction"
            end
        end

        local living = workspace:FindFirstChild("Living")
        local livingCharacter = living and living:FindFirstChild(player.Name)
        local livingRemote = livingCharacter and livingCharacter:FindFirstChild("RemoteFunction")
        if livingRemote and livingRemote:IsA("RemoteFunction") then
            return livingRemote, "workspace.Living." .. player.Name .. ".RemoteFunction (fallback)"
        end
        return nil, "Could not find a direct RemoteFunction on the current Character or its Living fallback"
    end

    local requestWorthiness
    requestWorthiness = function(reason)
        if not worthinessMod or not worthinessMod.enabled then return end
        if worthinessRequestBusy then
            worthinessQueuedReason = reason or "reset"
            return
        end

        worthinessRequestBusy = true
        local token = worthinessRunToken
        task.spawn(function()
            -- A Rokakaka updates Stand/PlayerStats before every skill-tree state
            -- has necessarily finished resetting on the server. Give that reset
            -- time to settle before sending LearnSkill. Startup still uses a short wait.
            local reasonText = string.lower(tostring(reason or ""))
            local afterReset = string.find(reasonText, "reset", 1, true) ~= nil
            task.wait(afterReset and 1.35 or 0.18)

            local remote, remotePathOrError = getCharacterSkillRemote()
            local resultLines = {}
            -- Current YBA uses a single "Worthiness" node (not Worthiness I/II).
            -- Unlock the three Stamina prerequisites in order, then request Worthiness once.
            local sequence = {
                "Stamina I",
                "Stamina II",
                "Stamina III",
                "Worthiness",
            }

            if not remote then
                table.insert(resultLines, "REMOTE ERROR: " .. tostring(remotePathOrError))
            else
                for _, skillName in ipairs(sequence) do
                    if token ~= worthinessRunToken or not worthinessMod.enabled then break end

                    local callOk, response = pcall(function()
                        return remote:InvokeServer("LearnSkill", {
                            Skill = skillName,
                            SkillTreeType = "Character",
                        })
                    end)

                    local result
                    if not callOk then
                        result = "ERROR: " .. tostring(response)
                    elseif response == false then
                        result = "returned false (may be already owned, locked, or out of points)"
                    elseif response == nil then
                        -- YBA's LearnSkill RemoteFunction can perform the action
                        -- without returning a value; nil is inconclusive, not an error.
                        result = "no return value (normal/inconclusive; verify in Skill Tree)"
                    else
                        result = tostring(response)
                    end
                    table.insert(resultLines, skillName .. " => " .. result)

                    -- Leave time for each prerequisite to replicate before the next
                    -- node is requested. This is only four calls, so reliability is
                    -- more useful than shaving a few tenths of a second here.
                    task.wait(0.30)
                end
            end

            if token == worthinessRunToken and worthinessMod.enabled then
                local resultText = table.concat(resultLines, " | ")
                if remote then
                    print("[TrueSight] Skill-tree requests finished via " .. tostring(remotePathOrError) .. ": " .. resultText)
                else
                    warn("[TrueSight] Skill-tree request setup failed: " .. resultText)
                end
                if not remote then
                    worthinessNotice("Worthiness helper could not find the live skill remote. See executor output.", true)
                else
                    worthinessNotice(
                        "Skill-tree requests attempted. Reopen Character Skill Tree to verify; remote replies alone do not confirm upgrades.",
                        false
                    )
                end
            end

            worthinessRequestBusy = false
            local queuedReason = worthinessQueuedReason
            worthinessQueuedReason = nil
            if queuedReason and worthinessMod and worthinessMod.enabled then
                task.delay(0.30, function()
                    requestWorthiness(queuedReason)
                end)
            end
        end)
    end

    worthinessMod = addModule(clientPanel, "Worthiness Helper", function(on)
        worthinessRunToken += 1
        worthinessQueuedReason = nil
        if worthinessStandConn then
            worthinessStandConn:Disconnect()
            worthinessStandConn = nil
        end
        if worthinessCharacterConn then
            worthinessCharacterConn:Disconnect()
            worthinessCharacterConn = nil
        end
        if not on then
            previewFrame.Visible = false
            previewLoadToken += 1
            removePreviewModel()
            previewStatus.Text = "Preview paused while helper is off"
            return
        end

        previewFrame.Visible = true
        refreshStandPreview()

        local token = worthinessRunToken
        task.spawn(function()
            local stats = player:WaitForChild("PlayerStats", 15)
            if token ~= worthinessRunToken or not worthinessMod.enabled then return end
            if not stats then
                worthinessNotice("Could not find PlayerStats; automatic Rokakaka-reset detection is unavailable.", true)
                return
            end
            local standValue = stats:WaitForChild("Stand", 10)
            if token ~= worthinessRunToken or not worthinessMod.enabled then return end
            if not standValue then
                worthinessNotice("Could not find PlayerStats.Stand; automatic Rokakaka-reset detection is unavailable.", true)
                return
            end

            worthinessStandConn = standValue:GetPropertyChangedSignal("Value"):Connect(function()
                if token ~= worthinessRunToken or not worthinessMod.enabled then return end
                task.delay(0.2, function()
                    if token == worthinessRunToken and worthinessMod.enabled then
                        refreshStandPreview()
                    end
                end)
                if string.lower(tostring(standValue.Value)) == "none" then
                    task.delay(1.0, function()
                        if token == worthinessRunToken and worthinessMod.enabled then
                            requestWorthiness("Rokakaka/Stand reset")
                        end
                    end)
                end
            end)

            worthinessCharacterConn = player.CharacterAdded:Connect(function()
                task.delay(0.9, function()
                    if token ~= worthinessRunToken or not worthinessMod.enabled then return end
                    refreshStandPreview()
                    if string.lower(tostring(standValue.Value)) == "none" then
                        requestWorthiness("post-reset character respawn")
                    end
                end)
            end)
        end)

        requestWorthiness("startup/enable")
    end)
    -- Enabled by default; saved TrueSight configs can still turn it off.
    worthinessMod.set(true)
end)()
