    local spawnCache
    refreshSpawnList = function(force)
        for _, row in ipairs(spawnState.rows) do
            if row.Parent then row:Destroy() end
        end
        table.clear(spawnState.rows)
        if not spawnCache or force then
            local found, npcs = {}, {}
            local sum = Vector3.new(0, 0, 0)
            for _, inst in ipairs(workspace:GetDescendants()) do
                if inst:IsA("SpawnLocation") then
                    found[#found+1] = inst
                    sum += inst.Position
                elseif #npcs < 250 and inst:IsA("Model") and isMeaningfulName(inst.Name)
                    and inst:FindFirstChildOfClass("Humanoid")
