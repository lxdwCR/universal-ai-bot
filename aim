-- Wings: welded neon feathers; only the pivots animate.
local wingParts = {}
local wingPivots = {}
local wingConn
local wingSpeed = 3

local feathers = {
    {len = 3.0, y = 0.85,  tilt = 22,  h = 0.45},
    {len = 2.8, y = 0.45,  tilt = 10,  h = 0.45},
    {len = 2.4, y = 0.05,  tilt = -2,  h = 0.42},
    {len = 1.9, y = -0.35, tilt = -14, h = 0.40},
    {len = 1.3, y = -0.75, tilt = -26, h = 0.36},
}

local function pivotCFrame(side, flap)
    return CFrame.new(side * 0.35, 0.35, 0.45)
        * CFrame.Angles(0, -side * math.rad(28), side * flap)
end

local function removeWings()
    if wingConn then
        wingConn:Disconnect()
        wingConn = nil
    end
    for _, p in ipairs(wingParts) do
        if p and p.Parent then p:Destroy() end
    end
    table.clear(wingParts)
    table.clear(wingPivots)
end

local function newWingPart(size, transparency)
    local p = Instance.new("Part")
    p.Name = "LocalWing"
    p.Size = size
    p.Material = Enum.Material.Neon
    p.Color = accent
    p.Transparency = transparency
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Massless = true
    p.Anchored = false
    return p
end

local function addWings(character)
    removeWings()
    local torso = getTorso(character)
    if not torso then return end

    for _, side in ipairs({-1, 1}) do
        local pivot = newWingPart(Vector3.new(0.2, 0.2, 0.2), 1)
        local pw = Instance.new("Weld")
        pw.Part0 = torso
        pw.Part1 = pivot
        pw.C0 = pivotCFrame(side, 0)
        pw.Parent = pivot
        pivot.Parent = character
        table.insert(wingParts, pivot)
        table.insert(wingPivots, {weld = pw, side = side})

        for _, f in ipairs(feathers) do
            local fp = newWingPart(Vector3.new(f.len, f.h, 0.08), 0.1)
            local fw = Instance.new("Weld")
            fw.Part0 = pivot
            fw.Part1 = fp
            fw.C0 = CFrame.new(0, f.y, 0)
                * CFrame.Angles(0, 0, side * math.rad(f.tilt))
                * CFrame.new(side * f.len / 2, 0, 0)
            fw.Parent = fp
            fp.Parent = character
            table.insert(wingParts, fp)
        end
    end

    wingConn = RunService.Heartbeat:Connect(function()
        local flap = math.sin(os.clock() * wingSpeed) * math.rad(14)
        for _, w in ipairs(wingPivots) do
            w.weld.C0 = pivotCFrame(w.side, flap)
        end
    end)
end

onAccent(function(c)
    for _, p in ipairs(wingParts) do p.Color = c end
end)

