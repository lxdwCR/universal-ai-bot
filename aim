                        tag.Enabled = visible
                        if visible then
                            local standName = nil
                            local standKeys = {"StandName", "Stand", "CurrentStand", "StandType"}
                            for _, key in ipairs(standKeys) do
                                local ok, value = pcall(function() return plr:GetAttribute(key) end)
                                if ok then standName = normalizeStandCandidate(value) end
                                if not standName then
                                    ok, value = pcall(function() return character:GetAttribute(key) end)
                                    if ok then standName = normalizeStandCandidate(value) end
                                end
                                if standName then break end
                            end
                            if not standName then
                                for _, container in ipairs({plr, character}) do
                                    for _, obj in ipairs(container:GetDescendants()) do
                                        if (obj:IsA("StringValue") or obj:IsA("ObjectValue")) then
                                            local n = string.lower(obj.Name)
                                            if string.find(n, "stand", 1, true) then
                                                local candidate = normalizeStandCandidate(obj.Value)
                                                if candidate then standName = candidate break end
                                            end
                                        end
                                    end
                                    if standName then break end
                                end
                            end
                            if not standName then
