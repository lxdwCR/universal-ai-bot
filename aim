                        if not entry.weld then
                            root.Anchored = true
                            root.CFrame = desired
                            local weld = Instance.new("Weld")
                            weld.Part0, weld.Part1 = sr, root
                            entry.rootOffset = sr.CFrame:ToObjectSpace(root.CFrame)
                            weld.C0, weld.C1 = entry.rootOffset, CFrame.identity
                            weld.Parent = root
                            root.Anchored = false
                            entry.weld = weld
                        end
                        local localExpected = sr.CFrame:ToObjectSpace(desired)
                        local want = Vector3.new(localExpected.LookVector.X, 0, localExpected.LookVector.Z)
                        local have = Vector3.new(entry.weld.C0.LookVector.X, 0, entry.weld.C0.LookVector.Z)
                        if want.Magnitude > 0.08 and have.Magnitude > 0.08 then
                            local desiredYaw = CFrame.lookAt(Vector3.zero, want.Unit)
