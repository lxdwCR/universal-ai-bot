    frame.Name = title .. "Stat"
    frame.LayoutOrder = order
    frame.Size = UDim2.new(1, 0, 0, 0)
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.BackgroundColor3 = BG
    frame.BackgroundTransparency = 0.25
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.Parent = statsFrame
    corner(frame, 4)
    vlist(frame)

    local label = Instance.new("TextLabel")
    label.LayoutOrder = 0
    label.Size = UDim2.new(1, 0, 0, 22)
    label.BackgroundTransparency = 1
    label.RichText = true
    label.Font = FONTB
    label.TextSize = 14
    label.TextColor3 = TEXT
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local graph = Instance.new("Frame")
    graph.LayoutOrder = 1
    graph.Size = UDim2.new(1, 0, 0, 28)
    graph.BackgroundTransparency = 1
    graph.Parent = frame

    local gp = Instance.new("UIPadding")
    gp.PaddingLeft = UDim.new(0, 6)
    gp.PaddingRight = UDim.new(0, 6)
    gp.PaddingBottom = UDim.new(0, 4)
    gp.Parent = graph

    local bars = {}
    for i = 1, HISTORY do
        local b = Instance.new("Frame")
        b.AnchorPoint = Vector2.new(0, 1)
        b.Position = UDim2.new((i - 1) / HISTORY, 0, 1, 0)
        b.Size = UDim2.new(1 / HISTORY, -1, 0, 0)
        b.BorderSizePixel = 0
        b.Visible = false
        b.Parent = graph
        bars[i] = b
    end

    local function redraw()
        local n = #values
        if n == 0 then
            label.Text = string.format('  <font color="#%s">%s</font>  ...', accent:ToHex(), title)
            return
        end

        local last = values[n]
        label.Text = string.format(
            '  <font color="#%s">%s</font>  <font color="#%s">%s</font>  <font color="#%s">%s</font>',
            accent:ToHex(), title,
            colorFn(last):ToHex(), formatFn(last),
            DIM:ToHex(), extraFn(values))

        if graphOn then
            local peak = floorValue
            for _, v in ipairs(values) do
                if v > peak then peak = v end
            end
            for i, bar in ipairs(bars) do
                local v = values[n - (HISTORY - i)]
                if v then
                    bar.Visible = true
                    bar.Size = UDim2.new(1 / HISTORY, -1, math.clamp(v / peak, 0.04, 1), 0)
                    bar.BackgroundColor3 = colorFn(v)
                else
                    bar.Visible = false
                end
            end
        end
    end

    onAccent(function() redraw() end)

    return {
        frame = frame,
        push = function(v)
            table.insert(values, v)
            if #values > HISTORY then table.remove(values, 1) end
            redraw()
        end,
        reset = function()
            table.clear(values)
            redraw()
        end,
        setGraph = function(on)
            graphOn = on
            graph.Visible = on
            if on then redraw() end
        end,
    }
end

