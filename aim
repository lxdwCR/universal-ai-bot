local function responsivePanelWidth(viewportWidth)
    -- Reserve a separate right-hand lane for the Stand preview. At wide resolutions the module
    -- panels retain their full width and the extra space becomes breathing room.
    local minimum = viewportWidth >= 1120 and 132 or 108
    return math.floor(math.clamp((viewportWidth - 36 - 40 - 8 - 286) / 6, minimum, 204))
end

