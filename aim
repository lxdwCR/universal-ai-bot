------------------------------------------------------------------
-- China hat: glowing cone (adornments, no physics, no shadows)
------------------------------------------------------------------
local hatObjects = {}
local hatCones = {}
local hatLight
local hatScale = 1

local function removeHat()
    for _, o in ipairs(hatObjects) do
        if o and o.Parent then o:Destroy() end
    end
    table.clear(hatObjects)
    table.clear(hatCones)
    hatLight = nil
end

local function applyHatScale()
    for _, c in ipairs(hatCones) do
        c.obj.Radius = c.r * hatScale
        c.obj.Height = c.h * hatScale
    end
end

local function addHat(character)
    removeHat()
    local head = character:FindFirstChild("Head")
    if not head then return end

    local function cone(radius, height, transparency, yOffset)
        local c = Instance.new("ConeHandleAdornment")
        c.Name = "LocalChinaHat"
        c.Adornee = head
        c.Radius = radius * hatScale
        c.Height = height * hatScale
        c.Transparency = transparency
        c.Color3 = accent
        c.CFrame = CFrame.new(0, yOffset, 0) * CFrame.Angles(math.rad(90), 0, 0)
        c.ZIndex = 1
        c.AlwaysOnTop = false
        c.Parent = head
        table.insert(hatObjects, c)
        table.insert(hatCones, {obj = c, r = radius, h = height})
    end

    cone(1.35, 1.15, 0.05, 0.45) -- solid core
    cone(1.55, 1.35, 0.65, 0.40) -- soft outer glow layer

    hatLight = Instance.new("PointLight")
    hatLight.Name = "LocalChinaHatLight"
    hatLight.Brightness = 1.5
    hatLight.Range = 10
    hatLight.Shadows = false
    hatLight.Color = accent
    hatLight.Parent = head
    table.insert(hatObjects, hatLight)
end

onAccent(function(c)
    for _, cc in ipairs(hatCones) do cc.obj.Color3 = c end
    if hatLight then hatLight.Color = c end
end)

------------------------------------------------------------------
-- Player trail (follows the accent color)
------------------------------------------------------------------
local trailObjects = {}
local activeTrail
local trailLifetime = 0.65

local function trailColor(c)
    return ColorSequence.new(c, c:Lerp(Color3.new(1, 1, 1), 0.55))
end

local function removeTrail()
    for _, obj in ipairs(trailObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(trailObjects)
    activeTrail = nil
end

local function addTrail(character)
    removeTrail()
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local a0 = Instance.new("Attachment")
    a0.Position = Vector3.new(-0.65, 0, 0)
    a0.Parent = root

    local a1 = Instance.new("Attachment")
    a1.Position = Vector3.new(0.65, 0, 0)
    a1.Parent = root

    local trail = Instance.new("Trail")
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Lifetime = trailLifetime
    trail.MinLength = 0.1
    trail.FaceCamera = true
    trail.LightEmission = 0.8
    trail.Color = trailColor(accent)
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.15),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.Parent = root

    table.insert(trailObjects, a0)
    table.insert(trailObjects, a1)
    table.insert(trailObjects, trail)
    activeTrail = trail
end

onAccent(function(c)
    if activeTrail then activeTrail.Color = trailColor(c) end
end)

------------------------------------------------------------------
-- Wings: 2 invisible pivots + 10 thin neon feathers, welded (no physics).
-- Only the 2 pivot welds are updated per frame to flap.
------------------------------------------------------------------
local wingParts = {}
local wingPivots = {}
local wingConn
local wingSpeed = 3

local feathers = {
    {len = 3.0, y = 0.85,  tilt = 22,  h = 0.45},
    {len = 2.8, y = 0.45,  tilt = 10,  h = 0.45},
    {len = 2.4, y = 0.05,  tilt = -2,  h = 0.42},
    {len = 1.9, y = -0.35, tilt = -14, h = 0.40},
    {len = 1.3, y = -0.75, tilt = -26, h = 0.36},
}

local function pivotCFrame(side, flap)
    return CFrame.new(side * 0.35, 0.35, 0.45)
        * CFrame.Angles(0, -side * math.rad(28), side * flap)
end

local function removeWings()
    if wingConn then
        wingConn:Disconnect()
        wingConn = nil
    end
    for _, p in ipairs(wingParts) do
        if p and p.Parent then p:Destroy() end
    end
    table.clear(wingParts)
    table.clear(wingPivots)
end

local function newWingPart(size, transparency)
    local p = Instance.new("Part")
    p.Name = "LocalWing"
    p.Size = size
    p.Material = Enum.Material.Neon
    p.Color = accent
    p.Transparency = transparency
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Massless = true
    p.Anchored = false
    return p
end

local function addWings(character)
    removeWings()
    local torso = getTorso(character)
    if not torso then return end

    for _, side in ipairs({-1, 1}) do
        local pivot = newWingPart(Vector3.new(0.2, 0.2, 0.2), 1)
        local pw = Instance.new("Weld")
        pw.Part0 = torso
        pw.Part1 = pivot
        pw.C0 = pivotCFrame(side, 0)
        pw.Parent = pivot
        pivot.Parent = character
        table.insert(wingParts, pivot)
        table.insert(wingPivots, {weld = pw, side = side})

        for _, f in ipairs(feathers) do
            local fp = newWingPart(Vector3.new(f.len, f.h, 0.08), 0.1)
            local fw = Instance.new("Weld")
            fw.Part0 = pivot
            fw.Part1 = fp
            fw.C0 = CFrame.new(0, f.y, 0)
                * CFrame.Angles(0, 0, side * math.rad(f.tilt))
                * CFrame.new(side * f.len / 2, 0, 0)
            fw.Parent = fp
            fp.Parent = character
            table.insert(wingParts, fp)
        end
    end

    wingConn = RunService.Heartbeat:Connect(function()
        local flap = math.sin(os.clock() * wingSpeed) * math.rad(14)
        for _, w in ipairs(wingPivots) do
            w.weld.C0 = pivotCFrame(w.side, flap)
        end
    end)
end

onAccent(function(c)
    for _, p in ipairs(wingParts) do p.Color = c end
end)

------------------------------------------------------------------
-- Fog removal (classic fog + Atmosphere)
------------------------------------------------------------------
local savedAtmos = {}
local fogConn

local function clearFog()
    Lighting.FogStart = 1e6
    Lighting.FogEnd = 1e6
    for _, obj in ipairs(Lighting:GetDescendants()) do
        if obj:IsA("Atmosphere") then
            if not savedAtmos[obj] then
                savedAtmos[obj] = {Density = obj.Density, Haze = obj.Haze}
            end
            obj.Density = 0
            obj.Haze = 0
        end
    end
end

local function setFog(on)
    if fogConn then
        fogConn:Disconnect()
        fogConn = nil
    end
    if on then
        clearFog()
        local last = 0
        fogConn = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            if now - last < 0.5 then return end
            last = now
            clearFog()
        end)
    else
        Lighting.FogStart = oldLighting.FogStart
        Lighting.FogEnd = oldLighting.FogEnd
        for obj, vals in pairs(savedAtmos) do
            if obj and obj.Parent then
                obj.Density = vals.Density
                obj.Haze = vals.Haze
            end
        end
        table.clear(savedAtmos)
    end
end

------------------------------------------------------------------
-- Weather removal
-- Disables particle emitters and sounds whose name (or a parent's name)
-- looks like weather, plus terrain clouds. Name-based, so a game that
-- names its weather something unusual may not be caught.
------------------------------------------------------------------
local weatherWords = {
    "rain", "snow", "storm", "weather", "blizzard",
    "hail", "sleet", "thunder", "drizzle",
}
local weatherEmitters = {}
local weatherSounds = {}
local weatherConn
local weatherLoop
local weatherToken = 0
local cloudsInst
local cloudsWas

local function looksLikeWeather(inst)
    local node = inst
    for _ = 1, 4 do
        if not node or node == workspace or node == game then break end
        local n = string.lower(node.Name)
        for _, w in ipairs(weatherWords) do
            if string.find(n, w, 1, true) then return true end
        end
        node = node.Parent
    end
    return false
end

local function killWeather(inst)
    if inst:IsA("ParticleEmitter") then
        if weatherEmitters[inst] == nil and looksLikeWeather(inst) then
            weatherEmitters[inst] = inst.Enabled
            inst.Enabled = false
        end
    elseif inst:IsA("Sound") then
        if weatherSounds[inst] == nil and looksLikeWeather(inst) then
            weatherSounds[inst] = inst.Volume
            inst.Volume = 0
        end
    end
end

local function weatherTick()
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    local cl = terrain and terrain:FindFirstChildOfClass("Clouds")
    if cl then
        if cloudsInst ~= cl then
            cloudsInst = cl
            cloudsWas = cl.Enabled
        end
        cl.Enabled = false
    end
    for inst in pairs(weatherEmitters) do
        if not inst.Parent then
            weatherEmitters[inst] = nil
        elseif inst.Enabled then
            inst.Enabled = false
        end
    end
    for inst in pairs(weatherSounds) do
        if not inst.Parent then
            weatherSounds[inst] = nil
        elseif inst.Volume ~= 0 then
            inst.Volume = 0
        end
    end
end

local function setWeather(on)
    weatherToken += 1
    if weatherConn then weatherConn:Disconnect() weatherConn = nil end
    if weatherLoop then weatherLoop:Disconnect() weatherLoop = nil end

    if on then
        local token = weatherToken
        weatherConn = workspace.DescendantAdded:Connect(killWeather)

        -- one-time scan, spread over several frames so it doesn't hitch
        task.spawn(function()
            local n = 0
            for _, d in ipairs(workspace:GetDescendants()) do
                if token ~= weatherToken then return end
                killWeather(d)
                n += 1
                if n % 1500 == 0 then task.wait() end
            end
        end)

        weatherTick()
        local last = os.clock()
        weatherLoop = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            if now - last < 1 then return end
            last = now
            weatherTick()
        end)
    else
        for inst, was in pairs(weatherEmitters) do
            if inst.Parent then inst.Enabled = was end
        end
        table.clear(weatherEmitters)
        for inst, vol in pairs(weatherSounds) do
            if inst.Parent then inst.Volume = vol end
        end
        table.clear(weatherSounds)
        if cloudsInst and cloudsInst.Parent then
            cloudsInst.Enabled = cloudsWas
        end
        cloudsInst = nil
    end
end

