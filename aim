-- Resolve both the usual {frame = Frame, n = number} wrapper and a raw Frame.
-- Some executor/build combinations produced a nil panel argument during UI setup;
-- fall back to an existing utility panel rather than aborting the entire script.
local function resolvePanelState(panel)
    if type(panel) == "table" and panel.frame then
        return panel
    end
    if typeof(panel) == "Instance" then
        return panelStatesByFrame[panel]
    end

    local preferred = panelRegistry["Client"] or panelRegistry["Config"]
    if preferred and panelStatesByFrame[preferred] then
        warn("[TrueSight] UI helper received a nil panel; using " .. preferred.Name .. " panel as fallback")
        return panelStatesByFrame[preferred]
    end
    for _, frame in pairs(panelRegistry) do
        local state = panelStatesByFrame[frame]
        if state then
            warn("[TrueSight] UI helper received a nil panel; using " .. frame.Name .. " panel as fallback")
            return state
        end
    end
    return nil
end

local function nextOrder(panel)
    local state = resolvePanelState(panel)
    if not state then
        fallbackOrder += 1
        warn("[TrueSight] Could not resolve panel for LayoutOrder; using fallback order " .. tostring(fallbackOrder))
        return 100000 + fallbackOrder
    end
    state.n = (tonumber(state.n) or 0) + 1
    return state.n
end

-- Dropdown widget: choices open in a top-layer popup, so scroll clipping cannot hide them.
local function addCycle(parent, label, options, start, onChange, key)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 38)
    styleButton(b)
    b.BackgroundColor3 = ROW
    b.TextColor3 = TEXT
    b:SetAttribute("TrueSightRole", "row")
    b.TextSize = 11
    b.TextWrapped = true
    b.TextYAlignment = Enum.TextYAlignment.Center
    b.TextTruncate = Enum.TextTruncate.AtEnd
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 9)
    padding.PaddingRight = UDim.new(0, 7)
    padding.Parent = b
    local idx = math.clamp(tonumber(start) or 1, 1, math.max(1, #options))
    local function refresh()
        b.Text = label .. "   ▾\n" .. tostring(options[idx])
    end
    refresh()
    local function choose(i)
        if not options[i] then return end
        idx = i
        refresh()
        onChange(idx)
        requestSave()
    end
    b.MouseButton1Click:Connect(function()
        if uiInteraction.resizeState and uiInteraction.resizeState.dropdownPopup and uiInteraction.resizeState.dropdownOwner == b then
            uiInteraction.closeDropdown()
        else
            uiInteraction.openDropdown(b, label, options, idx, choose)
        end
    end)
    if key then
        registerConfig(key, function() return idx end, function(i)
            if type(i) == "number" and options[i] then
                idx = i
                refresh()
                onChange(i)
            end
        end)
    end
    b.Parent = parent
    return {
        button = b,
        set = function(i)
            if type(i) == "number" and options[i] then idx = i; refresh() end
        end,
    }
end

-- Slider widget
local function addSlider(parent, label, minV, maxV, value, step, onChange, key)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 34)
    f.BackgroundColor3 = ROW
    f.BorderSizePixel = 0
    f:SetAttribute("TrueSightRole", "row")
    corner(f, 6)
    local fStroke = Instance.new("UIStroke")
    fStroke.Color = accent
    fStroke.Transparency = 0.82
    fStroke.Parent = f
    fStroke:SetAttribute("TrueSightRole", "accent-stroke")
    onAccent(function(c) if fStroke.Parent then fStroke.Color = c end end)

    local t = Instance.new("TextLabel")
    t.Position = UDim2.fromOffset(18, 3)
    t.Size = UDim2.new(1, -24, 0, 16)
    t.BackgroundTransparency = 1
    t.Font = FONT
    t.TextSize = 12
    t.TextColor3 = DIM
    t.TextXAlignment = Enum.TextXAlignment.Left
    t:SetAttribute("TrueSightRole", "muted")
    t.Parent = f

    local track = Instance.new("Frame")
    track.Position = UDim2.fromOffset(18, 24)
    track.Size = UDim2.new(1, -36, 0, 4)
    track.BackgroundColor3 = Color3.fromRGB(38, 44, 57)
    track.BorderSizePixel = 0
    track.Parent = f
    corner(track, 2)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 2)
    onAccent(function(c) fill.BackgroundColor3 = c end)

    local cur = value
    local function show(v)
        cur = v
        local pct = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        t.Text = label .. ": " .. string.format("%g", v)
    end
    show(value)

    local function setFromX(x)
        local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = minV + pct * (maxV - minV)
        v = math.floor(v / step + 0.5) * step
        v = math.clamp(v, minV, maxV)
        show(v)
        onChange(v)
        requestSave()
    end

    f.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = setFromX
            setFromX(input.Position.X)
        end
    end)

    if key then
        registerConfig(key, function() return cur end, function(v)
            if type(v) == "number" then
                v = math.clamp(v, minV, maxV)
                show(v)
                onChange(v)
            end
        end)
    end

    f.Parent = parent
    return f
end

-- Module row (left-click toggle, right-click settings)
local function addModule(panel, name, onToggle)
    local mod = {name = name, enabled = false, keybind = nil}

    local holder = Instance.new("Frame")
    holder.LayoutOrder = nextOrder(panel)
    holder.Size = UDim2.new(1, 0, 0, 0)
