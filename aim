    box.ClearTextOnFocus = false
    box.Font = FONT
    box.TextSize = 11
    box.TextColor3 = TEXT
    box.PlaceholderColor3 = DIM
    box.PlaceholderText = placeholder
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.Text = initialValue or ""
    box.Parent = state.frame
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 8)
    padding.PaddingRight = UDim.new(0, 8)
    padding.Parent = box
    box.FocusLost:Connect(function()
        onCommit(box.Text)
        requestSave()
    end)
    if key then
        registerConfig(key, function() return box.Text end, function(value)
            if type(value) == "string" then
                box.Text = value
                onCommit(value)
            end
        end)
    end
    box:SetAttribute("Title", title)
    return box
end

