-- Slider widget
local function addSlider(parent, label, minV, maxV, value, step, onChange, key)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 48)
    f.BackgroundColor3 = ROW
    f.BorderSizePixel = 0
    f:SetAttribute("TrueSightRole", "row")
    corner(f, 6)
    local fStroke = Instance.new("UIStroke")
    fStroke.Color = accent
    fStroke.Transparency = 0.82
    fStroke.Parent = f
    fStroke:SetAttribute("TrueSightRole", "accent-stroke")
    onAccent(function(c) if fStroke.Parent then fStroke.Color = c end end)

    local t = Instance.new("TextLabel")
    t.Position = UDim2.fromOffset(16, 7)
    t.Size = UDim2.new(1, -32, 0, 18)
    t.BackgroundTransparency = 1
    t.Font = FONT
    t.TextSize = 11
    t.TextColor3 = DIM
    t.TextXAlignment = Enum.TextXAlignment.Left
    t:SetAttribute("TrueSightRole", "muted")
    t.Parent = f

    local track = Instance.new("Frame")
    track.Position = UDim2.fromOffset(16, 34)
    track.Size = UDim2.new(1, -32, 0, 5)
    track.BackgroundColor3 = Color3.fromRGB(38, 44, 57)
    track.BorderSizePixel = 0
    track.Parent = f
    corner(track, 2)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 2)
    onAccent(function(c) fill.BackgroundColor3 = c end)

    local cur = value
    local function show(v)
        cur = v
        local pct = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        t.Text = label .. ": " .. string.format("%g", v)
    end
    show(value)

    local function setFromX(x)
        local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = minV + pct * (maxV - minV)
        v = math.floor(v / step + 0.5) * step
        v = math.clamp(v, minV, maxV)
        show(v)
        onChange(v)
        requestSave()
    end

    f.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = setFromX
            setFromX(input.Position.X)
        end
    end)

    if key then
        registerConfig(key, function() return cur end, function(v)
            if type(v) == "number" then
                v = math.clamp(v, minV, maxV)
                show(v)
                onChange(v)
            end
        end)
    end

    f.Parent = parent
    return f
end

-- Module row (left-click toggle, right-click settings)
local function addModule(panel, name, onToggle)
    local mod = {name = name, enabled = false, keybind = nil, favourite = false}

    local holder = Instance.new("Frame")
    holder.LayoutOrder = nextOrder(panel)
    holder.Size = UDim2.new(1, 0, 0, 0)
    holder.AutomaticSize = Enum.AutomaticSize.Y
    holder.BackgroundTransparency = 1
    holder.Parent = panel.frame
    local holderPadding = Instance.new("UIPadding")
    holderPadding.PaddingLeft = UDim.new(0, 0)
    holderPadding.PaddingRight = UDim.new(0, 0)
    holderPadding.PaddingTop = UDim.new(0, 2)
    holderPadding.PaddingBottom = UDim.new(0, 8)
    holderPadding.Parent = holder
    mod.holder = holder
    mod.panel = panel.panel or panel.frame
    local holderLayout = vlist(holder)
    holderLayout.Padding = UDim.new(0, 8)

    local btn = Instance.new("TextButton")
    btn.LayoutOrder = 0
    btn.Size = UDim2.new(1, 0, 0, 42)
    styleButton(btn)
    btn.Text = "   " .. name
    btn.Parent = holder
    btn.TextSize = 12
    btn:SetAttribute("TrueSightRole", "row")

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, -12)
    bar.Position = UDim2.fromOffset(0, 6)
    bar.BorderSizePixel = 0
    bar.Visible = false
    bar.Parent = btn
    corner(bar, 2)

    local statusPill = Instance.new("TextLabel")
    statusPill.Name = "State"
    statusPill.AnchorPoint = Vector2.new(1, 0.5)
    statusPill.Position = UDim2.new(1, -35, 0.5, 0)
    statusPill.Size = UDim2.fromOffset(42, 20)
    statusPill.BackgroundColor3 = Color3.fromRGB(28, 35, 46)
    statusPill.BorderSizePixel = 0
    statusPill.Font = FONTB
    statusPill.TextSize = 9
    statusPill.TextColor3 = DIM
    statusPill.Text = "OFF"
    statusPill.Active = false
    statusPill.Parent = btn
    corner(statusPill, 6)

    local settings = Instance.new("Frame")
    settings.LayoutOrder = 1
    settings.Size = UDim2.new(1, 0, 0, 0)
    settings.AutomaticSize = Enum.AutomaticSize.Y
    settings.BackgroundColor3 = SUB
    settings.BorderSizePixel = 0
    settings.Visible = false
    settings.Parent = holder
    -- Allow related controls to live inside the module's existing expandable settings.
    mod.settingsFrame = settings
    settings:SetAttribute("TrueSightRole", "sub")
    corner(settings, 6)
    local settingsPadding = Instance.new("UIPadding")
    settingsPadding.PaddingLeft = UDim.new(0, 14)
    settingsPadding.PaddingRight = UDim.new(0, 14)
    settingsPadding.PaddingTop = UDim.new(0, 12)
    settingsPadding.PaddingBottom = UDim.new(0, 12)
    settingsPadding.Parent = settings
    local settingsList = vlist(settings)
    settingsList.Padding = UDim.new(0, 9)

    local arrow
    local function markSettings()
        if mod.hasSettings then return end
        mod.hasSettings = true
        arrow = Instance.new("TextLabel")
        arrow.Name = "SettingsToggle"
        arrow.AnchorPoint = Vector2.new(1, 0)
        arrow.Position = UDim2.new(1, -3, 0, 0)
        arrow.Size = UDim2.fromOffset(34, 42)
        arrow.BackgroundTransparency = 1
        arrow.Active = false
        arrow.Font = FONTB
        arrow.TextSize = 14
        arrow.TextColor3 = DIM
        arrow.Text = "+"
        arrow.ZIndex = btn.ZIndex + 2
        arrow.Parent = btn
        arrow:SetAttribute("TrueSightRole", "muted")
    end

    local function refresh()
        btn.TextColor3 = mod.enabled and accent or DIM
        btn:SetAttribute("TrueSightModuleEnabled", mod.enabled)
        btn.BackgroundColor3 = mod.enabled and ROW:Lerp(accent, 0.10) or ROW
        bar.Visible = mod.enabled
        bar.BackgroundColor3 = accent
        statusPill.Text = mod.enabled and "ON" or "OFF"
        statusPill.TextColor3 = mod.enabled and TEXT or DIM
        statusPill.BackgroundColor3 = mod.enabled and BG:Lerp(accent, 0.35) or Color3.fromRGB(28, 35, 46)
    end

    function mod.set(on)
        if mod.enabled == on then return end
        mod.enabled = on
        refresh()
        local ok, err = pcall(onToggle, on)
        if not ok then
            warn("[TrueSight] " .. name .. ": " .. tostring(err))
        end
        refreshArray()
        requestSave()
        if not configLoading and modules._onModuleToggled then pcall(modules._onModuleToggled, mod) end
        if modules._refreshFavouriteUI and mod.favourite then pcall(modules._refreshFavouriteUI) end
    end

    local settingOrder = 0
    function mod.cycle(label, options, start, onChange)
        markSettings()
        local widget = addCycle(settings, label, options, start, onChange, name .. "/" .. label)
        widget.button.LayoutOrder = settingOrder
        settingOrder += 1
        return widget
    end

    function mod.slider(label, minV, maxV, value, step, onChange)
        markSettings()
        local widget = addSlider(settings, label, minV, maxV, value, step, onChange, name .. "/" .. label)
        widget.LayoutOrder = settingOrder
        settingOrder += 1
        return widget
    end

    -- per-feature free-form keyboard binding; Esc cancels, Backspace clears. Uses the same central
    -- capture path as existing module/menu binds.
    function mod.keySetting(label, defaultKey, onChange)
        markSettings()
        local selected = defaultKey
        local btn = Instance.new("TextButton")
        btn.LayoutOrder = settingOrder
        settingOrder += 1
        btn.Size = UDim2.new(1, 0, 0, 32)
        styleButton(btn)
        btn.TextSize = 11
        btn.Parent = settings
        btn:SetAttribute("TrueSightRole", "sub")
        local function setKey(key)
            selected = key
            btn.Text = "  " .. label .. ":  " .. (key and key.Name or "None") .. "    [Edit]"
            if onChange then onChange(key) end
        end
        btn.MouseButton1Click:Connect(function()
            keyUiState.capture = {
                label = label,
                callback = function(key) setKey(key); requestSave() end,
                refresh = function() setKey(selected) end,
            }
            btn.Text = "  " .. label .. ": press any key   [Esc cancels]"
        end)
        registerConfig(name .. "/" .. label, function()
            return selected and selected.Name or ""
        end, function(value)
            if type(value) ~= "string" then return end
            if value == "" then setKey(nil); return end
            local ok, key = pcall(function() return Enum.KeyCode[value] end)
            if ok and key and key ~= Enum.KeyCode.Unknown then setKey(key) end
        end)
        setKey(defaultKey)
        return {button = btn, set = setKey, get = function() return selected end}
    end

    local bindButton = Instance.new("TextButton")
    bindButton.LayoutOrder = 9999
    bindButton.Size = UDim2.new(1, 0, 0, 32)
    styleButton(bindButton)
    bindButton.BackgroundColor3 = SUB
    bindButton:SetAttribute("TrueSightRole", "sub")
    bindButton.TextSize = 12
    bindButton.Parent = settings
    local function refreshBindButton()
        bindButton.Text = "      Keybind:  "
            .. (mod.keybind and mod.keybind.Name or "None")
            .. (keyUiState.bindingModule == mod and "  (press a key)" or "")
    end
    mod.refreshBindButton = refreshBindButton
    bindButton.MouseButton1Click:Connect(function()
        keyUiState.binding = true
        keyUiState.bindingModule = mod
        refreshBindButton()
        hint.Text = "Press a key to bind " .. name .. "  |  Esc cancels"
    end)
    markSettings()
    registerConfig(name .. "/Keybind", function()
        return mod.keybind and mod.keybind.Name or ""
    end, function(value)
        if type(value) == "string" and value ~= "" then
            local ok, key = pcall(function() return Enum.KeyCode[value] end)
            mod.keybind = ok and key or nil
        else
            mod.keybind = nil
        end
        refreshBindButton()
    end)
    refreshBindButton()

    -- Star a module once and it appears in Quick Access. Favourite state is saved under a unique
    -- config key without moving any original module UI.
    local favouriteButton = Instance.new("TextButton")
    favouriteButton.LayoutOrder = 9998
    favouriteButton.Size = UDim2.new(1, 0, 0, 32)
    styleButton(favouriteButton)
    favouriteButton.Parent = settings
    local function refreshFavourite()
        favouriteButton.Text = mod.favourite and "   ★  Remove from Quick Access" or "   ☆  Add to Quick Access"
    end
    mod.refreshFavourite = refreshFavourite
    registerConfig("Favourites/" .. name, function() return mod.favourite end, function(value)
        mod.favourite = (value == true)
        refreshFavourite()
        if modules._refreshFavouriteUI then pcall(modules._refreshFavouriteUI) end
    end)
    favouriteButton.MouseButton1Click:Connect(function()
        mod.favourite = not mod.favourite
        refreshFavourite()
        if modules._refreshFavouriteUI then pcall(modules._refreshFavouriteUI) end
        requestSave()
    end)
    refreshFavourite()

    local function closeSettings()
        settings.Visible = false
        if arrow then arrow.Text = "+" end
        if uiInteraction and uiInteraction.resizeState and uiInteraction.resizeState.openSettingsModule == mod then
            uiInteraction.resizeState.openSettingsModule = nil
        end
    end
    mod.closeSettings = closeSettings

    local function toggleSettings()
        if not mod.hasSettings then return end
        if settings.Visible then
            closeSettings()
        else
            local interactionState = uiInteraction and uiInteraction.resizeState
            local other = interactionState and interactionState.openSettingsModule
            if other and other ~= mod and other.closeSettings then other.closeSettings() end
            settings.Visible = true
            if interactionState then interactionState.openSettingsModule = mod end
            if arrow then arrow.Text = "−" end
            hint.Text = "Settings: " .. name .. "  |  use dropdowns or sliders"
        end
    end
    btn.MouseButton1Click:Connect(function()
        local mouse = UserInputService:GetMouseLocation()
        local onSettingsToggle = mod.hasSettings and mouse.X >= (btn.AbsolutePosition.X + btn.AbsoluteSize.X - 34)
        if onSettingsToggle then
            toggleSettings()
        else
            mod.set(not mod.enabled)
        end
    end)
    btn.MouseButton2Click:Connect(toggleSettings)
    mod.toggleSettings = toggleSettings

    onAccent(function() refresh() end)
    table.insert(modules, mod)
    return mod
end

