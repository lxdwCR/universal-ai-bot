-- Fog removal (handles both classic fog and Atmosphere objects)
local savedAtmos = {}
local fogConn

local function clearFog()
    Lighting.FogStart = 1e6
    Lighting.FogEnd = 1e6
    for _, obj in ipairs(Lighting:GetDescendants()) do
        if obj:IsA("Atmosphere") then
            if not savedAtmos[obj] then
                savedAtmos[obj] = {Density = obj.Density, Haze = obj.Haze}
            end
            obj.Density = 0
            obj.Haze = 0
        end
    end
end

module("Remove Fog", function(on)
    if fogConn then
        fogConn:Disconnect()
        fogConn = nil
    end

    if on then
        clearFog()
        -- some games keep resetting fog, so re-apply periodically
        local last = 0
        fogConn = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            if now - last < 0.5 then return end
            last = now
            clearFog()
        end)
    else
        Lighting.FogStart = oldLighting.FogStart
        Lighting.FogEnd = oldLighting.FogEnd
        for obj, vals in pairs(savedAtmos) do
            if obj and obj.Parent then
                obj.Density = vals.Density
                obj.Haze = vals.Haze
            end
        end
        table.clear(savedAtmos)
    end
end)

-- FPS-friendly effects toggle
module("FPS Boost", function(on)
    if on then
        table.clear(originalEffects)
        for _, obj in ipairs(Lighting:GetDescendants()) do
            if obj:IsA("PostEffect") then
                originalEffects[obj] = obj.Enabled
                obj.Enabled = false
            end
        end
    else
        for obj, wasEnabled in pairs(originalEffects) do
            if obj and obj.Parent then
                obj.Enabled = wasEnabled
            end
        end
        table.clear(originalEffects)
    end
end)

