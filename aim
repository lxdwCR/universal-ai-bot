local uiThemeController = (function()
    local names = {"Midnight", "Deep Ocean", "Graphite", "Violet Dusk", "Ice Terminal"}
    local palettes = {
        {bg = Color3.fromRGB(13, 16, 23), header = Color3.fromRGB(8, 11, 17), row = Color3.fromRGB(22, 27, 37), sub = Color3.fromRGB(16, 21, 31), text = Color3.fromRGB(232, 238, 248), dim = Color3.fromRGB(145, 155, 174)},
