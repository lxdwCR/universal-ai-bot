    }
    local fontNames = {"Gotham", "Source Sans", "Code", "Arial"}
    local fontPairs = {
        {regular = Enum.Font.GothamMedium, bold = Enum.Font.GothamBold},
        {regular = Enum.Font.SourceSans, bold = Enum.Font.SourceSansBold},
        {regular = Enum.Font.Code, bold = Enum.Font.Code},
        {regular = Enum.Font.Arial, bold = Enum.Font.ArialBold},
    }
    local fontIndex = 1
    local index = 1
    local function apply(i)
        if type(i) == "number" and palettes[i] then index = i end
        local p = palettes[index]
        BG, HEADER, ROW, SUB, TEXT, DIM = p.bg, p.header, p.row, p.sub, p.text, p.dim
        local colors = {panel = BG, header = HEADER, row = ROW, sub = SUB, text = TEXT, muted = DIM,
            backdrop = BG}
        for _, obj in ipairs(gui:GetDescendants()) do
            local role = obj:GetAttribute("TrueSightRole")
            if role and colors[role] then
                if obj:IsA("GuiObject") then
                    local baseColor = colors[role]
                    if role == "row" and obj:GetAttribute("TrueSightModuleEnabled") == true then
                        baseColor = ROW:Lerp(accent, 0.12)
                    end
                    obj.BackgroundColor3 = baseColor
                end
                if role == "text" and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                    obj.TextColor3 = TEXT
                elseif role == "muted" and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                    obj.TextColor3 = DIM
                end
            elseif role == "accent-stroke" and obj:IsA("UIStroke") then
                obj.Color = accent
            elseif role == "header-gradient" and obj:IsA("UIGradient") then
                obj.Color = ColorSequence.new(HEADER, BG:Lerp(accent, 0.07))
            elseif role == "backdrop-gradient" and obj:IsA("UIGradient") then
                obj.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, BG:Lerp(accent, 0.10)),
                    ColorSequenceKeypoint.new(0.55, HEADER:Lerp(accent, 0.05)),
                    ColorSequenceKeypoint.new(1, HEADER),
                })
            end
        end
    end
    local function setFont(i)
        if type(i) == "number" and fontPairs[i] then fontIndex = i end
        local pair = fontPairs[fontIndex]
        FONT = pair.regular
        FONTB = pair.bold
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local weight = obj:GetAttribute("TrueSightFontWeight")
                local useBold = weight == "bold"
                if weight == nil then
                    useBold = (obj:IsA("TextLabel") and obj.TextSize >= 14)
                        or (obj:IsA("TextButton") and obj.TextSize >= 15)
                end
                obj.Font = useBold and pair.bold or pair.regular
            end
        end
    end
    return {
        names = names,
        apply = apply,
        getIndex = function() return index end,
        fontNames = fontNames,
        setFont = setFont,
        getFontIndex = function() return fontIndex end,
    }
end)()

