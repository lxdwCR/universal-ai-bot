    end

    local function clampObject(object)
        if not object or not object.Parent then return end
        local viewport = (cam() and cam().ViewportSize) or Vector2.new(1280, 720)
        local size = object.AbsoluteSize
        local screenX = math.clamp(object.AbsolutePosition.X, 8, math.max(8, viewport.X - size.X - 8))
        local screenY = math.clamp(object.AbsolutePosition.Y, 28, math.max(28, viewport.Y - size.Y - 8))
        -- Position is relative to the parent's origin, not the screen. Subtract
        -- the parent's absolute position before writing the clamped coordinates.
        local parentOrigin = Vector2.new(0, 0)
        local parentSize = viewport
        if object.Parent:IsA("GuiObject") then
            parentOrigin = object.Parent.AbsolutePosition
            parentSize = object.Parent.AbsoluteSize
        end
        local scaleX = object.Position.X.Scale
        local scaleY = object.Position.Y.Scale
        object.Position = UDim2.new(
            scaleX, screenX - parentOrigin.X + object.AnchorPoint.X * size.X - scaleX * parentSize.X,
            scaleY, screenY - parentOrigin.Y + object.AnchorPoint.Y * size.Y - scaleY * parentSize.Y
        )
    end

    local function clampAll()
        local viewport = (cam() and cam().ViewportSize) or Vector2.new(1280, 720)
        for _, panel in pairs(panelRegistry) do
            if panel and panel.Parent then
                panel.Size = UDim2.fromOffset(math.min(panel.Size.X.Offset, viewport.X - 16), math.min(panel.Size.Y.Offset, viewport.Y - 24))
                clampObject(panel)
            end
        end
        if state.layoutRefs.StandPreview and state.layoutRefs.StandPreview.Parent then
            local preview = state.layoutRefs.StandPreview
            preview.Size = UDim2.fromOffset(math.min(preview.Size.X.Offset, viewport.X - 16), math.min(preview.Size.Y.Offset, viewport.Y - 16))
            clampObject(preview)
        end
    end

    local function resetLayout()
        local viewport = (cam() and cam().ViewportSize) or Vector2.new(1280, 720)
        local width = responsivePanelWidth(viewport.X)
        local height = math.max(220, math.min(690, viewport.Y - 92))
        for title, panel in pairs(panelRegistry) do
            local col = panelColumns[title] or 1
            panel.AnchorPoint = Vector2.new(0, 0)
            panel.Size = UDim2.fromOffset(width, height)
