-- Optional projectile lead marker; estimate only, never a hitbox.
do
local predictorOK, predictorError = xpcall(function()
    local settings = {speed = 130, maxTime = 1.35, maxRange = 220, maxTargets = 4,
        style = 1, opacity = 0.3, latency = 0.05, enabled = false,
        records = {}, accumulator = 0, rescanClock = 0, list = {}, ping = 0}
    local stale = workspace:FindFirstChild("TrueSightProjectilePredictionLocal")
    if stale then stale:Destroy() end
    local folder = Instance.new("Folder")
    folder.Name = "TrueSightProjectilePredictionLocal"
    folder.Parent = workspace
    local heartbeat

    local function clearRecord(other)
        local record = settings.records[other]
        if record then
            if record.proxy then record.proxy:Destroy() end
            settings.records[other] = nil
        end
    end
    local function clearAll()
        for other in pairs(settings.records) do clearRecord(other) end
        table.clear(settings.list)
    end
    local function visuals(other)
        local existing = settings.records[other]
        if existing then return existing end
        local proxy = Instance.new("Part")
        proxy.Name = "Lead_" .. tostring(other.UserId)
        proxy.Size = Vector3.new(4, 6, 3)
        proxy.Anchored = true
        proxy.Transparency = 1
        proxy.CanCollide = false
        proxy.CanTouch = false
        proxy.CanQuery = false
        proxy.CastShadow = false
        proxy.Parent = folder
        local outline = Instance.new("SelectionBox")
        outline.Name = "LeadOutline"
        outline.Adornee = proxy
        outline.Color3 = accent
        outline.SurfaceTransparency = 1
        outline.LineThickness = 0.05
        outline.Visible = settings.style == 1
        outline.Parent = proxy
        local tint = Instance.new("BoxHandleAdornment")
        tint.Name = "LeadBox"
        tint.Adornee = proxy
        tint.Size = proxy.Size
        tint.Transparency = 1 - settings.opacity
        tint.Color3 = accent
        tint.AlwaysOnTop = false
        tint.Visible = settings.style == 2
        tint.Parent = proxy
        local record = {proxy=proxy, outline=outline, tint=tint, smooth=Vector3.zero}
        settings.records[other] = record
        return record
    end
    local function refreshStyle()
        for _, rec in pairs(settings.records) do
            rec.outline.Visible = settings.style == 1
            rec.tint.Visible = settings.style == 2
            rec.tint.Transparency = 1 - settings.opacity
        end
    end
    onAccent(function(color)
        for _, rec in pairs(settings.records) do
            if rec.outline.Parent then rec.outline.Color3 = color end
            if rec.tint.Parent then rec.tint.Color3 = color end
        end
    end)
    local function recomputeTargets(localRoot)
        local candidates = {}
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player then
                local char = other.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 and root:IsA("BasePart") then
                    local gap = (root.Position - localRoot.Position).Magnitude
                    if gap <= settings.maxRange then
                        table.insert(candidates, {p=other, d=gap})
                    end
                end
            end
        end
        table.sort(candidates, function(a,b) return a.d < b.d end)
        table.clear(settings.list)
        local chosen = {}
        for i = 1, math.min(settings.maxTargets, #candidates) do
            local other = candidates[i].p
            table.insert(settings.list, other)
            chosen[other] = true
        end
        for other in pairs(settings.records) do
            if not chosen[other] then clearRecord(other) end
        end
    end
    local function update(dt)
        if modules._unloaded or not settings.enabled then return end
        settings.accumulator += dt
        if settings.accumulator < 0.05 then return end -- 20 updates/sec max
        local elapsed = math.min(settings.accumulator, 0.25)
        settings.accumulator = 0
        local selfChar = player.Character
        local localRoot = selfChar and selfChar:FindFirstChild("HumanoidRootPart")
        if not localRoot then clearAll(); return end
        settings.rescanClock += elapsed
        if settings.rescanClock >= 0.2 then
            settings.rescanClock = 0
            recomputeTargets(localRoot)
            local ok, pingValue = pcall(function() return player:GetNetworkPing() end)
            if ok and type(pingValue) == "number" then settings.ping = math.clamp(pingValue,0,0.25) end
        end
        for _, other in ipairs(settings.list) do
            local char = other.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local rec = visuals(other)
                local raw = root.AssemblyLinearVelocity
                if raw.Magnitude > 65 then raw = raw.Unit * 65 end
                -- Low-pass velocity to reduce jitter, retain XZ direction only.
                local desired = Vector3.new(raw.X, 0, raw.Z)
                rec.smooth = rec.smooth:Lerp(desired, math.clamp(elapsed * 10, 0, 1))
                local dist = (root.Position - localRoot.Position).Magnitude
                local t = math.clamp(dist / math.max(1, settings.speed) + settings.latency + settings.ping * 0.5,
                    0, settings.maxTime)
                local predicted = root.Position + rec.smooth * t
                local face = root.CFrame - root.Position
                rec.proxy.CFrame = CFrame.new(predicted) * face
                local h = math.clamp(4.8 + (hum.HipHeight or 2) * 0.55, 5, 7)
                local boxSize = Vector3.new(3.8, h, 3.2)
                rec.proxy.Size = boxSize
                rec.tint.Size = boxSize
            else
                clearRecord(other)
            end
        end
    end
    local function setEnabled(value)
        settings.enabled = value
        if heartbeat then heartbeat:Disconnect(); heartbeat = nil end
        if not value then
            clearAll()
            return
        end
        settings.accumulator = 0
        settings.rescanClock = 1
        heartbeat = RunService.Heartbeat:Connect(update)
    end
    local predictor = addModule(modules._predictionPanel, "Projectile Prediction Hitboxes", setEnabled)
    predictor.slider("Projectile Speed (studs/sec)", 30, 400, 130, 10, function(value)
        settings.speed = value
    end)
    predictor.slider("Prediction Limit (seconds)", 0.2, 2, 1.35, 0.05, function(value)
        settings.maxTime = value
    end)
    predictor.slider("Max Display Range", 40, 400, 220, 10, function(value)
        settings.maxRange = value
        settings.rescanClock = 1
    end)
    predictor.slider("Players to Show", 1, 8, 4, 1, function(value)
        settings.maxTargets = value
        settings.rescanClock = 1
    end)
    predictor.cycle("Hitbox Style", {"Outline", "Tinted Box"}, 1, function(index)
        settings.style = index
        refreshStyle()
    end)
    predictor.slider("Box Opacity", 0.1, 0.85, 0.3, 0.05, function(value)
        settings.opacity = value
        refreshStyle()
    end)
    predictor.slider("Extra Latency (seconds)", 0, 0.25, 0.05, 0.01, function(value)
        settings.latency = value
    end)
    modules._cleanupProjectilePrediction = function()
        setEnabled(false)
        if folder.Parent then folder:Destroy() end
    end
end, function(e) return tostring(e) end)
if not predictorOK then
    warn("[TrueSight] Projectile prediction setup failed (menu will still load): " .. tostring(predictorError))
    if modules._predictionIntro then
        modules._predictionIntro.Text = "Prediction failed to initialize. Check the executor console: " .. tostring(predictorError)
    end
end
end

