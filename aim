-- Fog removal (classic fog + Atmosphere)
------------------------------------------------------------------
local savedAtmos = {}
local fogConn

local function clearFog()
    Lighting.FogStart = 1e6
    Lighting.FogEnd = 1e6
    for _, obj in ipairs(Lighting:GetDescendants()) do
        if obj:IsA("Atmosphere") then
            if not savedAtmos[obj] then
                savedAtmos[obj] = {Density = obj.Density, Haze = obj.Haze}
            end
            obj.Density = 0
            obj.Haze = 0
        end
    end
end

local function setFog(on)
    if fogConn then
        fogConn:Disconnect()
        fogConn = nil
    end
    if on then
        clearFog()
        local last = 0
        fogConn = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            if now - last < 0.5 then return end
            last = now
            clearFog()
        end)
    else
        Lighting.FogStart = oldLighting.FogStart
        Lighting.FogEnd = oldLighting.FogEnd
        for obj, vals in pairs(savedAtmos) do
            if obj and obj.Parent then
                obj.Density = vals.Density
                obj.Haze = vals.Haze
            end
        end
        table.clear(savedAtmos)
    end
end

------------------------------------------------------------------
-- Weather removal
-- Smart mode: silences emitters/sounds that look like weather (by name, or by
--   behaviour: heavy emitters that spray downward) plus terrain clouds.
-- Aggressive mode: silences EVERY particle emitter that isn't on a player.
-- "Silenced" = disabled, zero rate, zero lifetime and invisible, so scripts
-- that call :Emit() by hand can't bring the particles back either.
------------------------------------------------------------------
local weatherWords = {
    "rain", "snow", "storm", "weather", "blizzard", "hail", "sleet",
    "thunder", "drizzle", "precip", "flurr", "downpour",
}
local weatherMode = 1 -- 1 = Smart, 2 = Aggressive
local weatherOn = false
local weatherEmitters = {}
local weatherSounds = {}
local weatherConn
local weatherLoop
local weatherToken = 0
local cloudsInst
local cloudsWas

local function inCharacter(inst)
    for _, p in ipairs(Players:GetPlayers()) do
        local ch = p.Character
        if ch and inst:IsDescendantOf(ch) then return true end
    end
    return false
end

local function looksLikeWeather(inst)
    local node = inst
    for _ = 1, 4 do
        if not node or node == workspace or node == game then break end
        local n = string.lower(node.Name)
        for _, w in ipairs(weatherWords) do
            if string.find(n, w, 1, true) then return true end
        end
        node = node.Parent
    end
    return false
end

local function behavesLikeWeather(e)
    local falling = e.EmissionDirection == Enum.NormalId.Bottom
        or e.Acceleration.Y <= -5
    return falling and e.Rate >= 20
end

local function silence(e)
    e.Enabled = false
    e.Rate = 0
    e.Lifetime = NumberRange.new(0)
    e.Transparency = NumberSequence.new(1)
    e:Clear()
end

local function killWeather(inst)
    if not weatherOn or not inst.Parent then return end
    if inst:IsA("ParticleEmitter") then
        if weatherEmitters[inst] ~= nil then return end
        if inCharacter(inst) then return end
        if string.sub(inst.Name, 1, 5) == "Local" then return end
        if weatherMode == 2 or looksLikeWeather(inst) or behavesLikeWeather(inst) then
            weatherEmitters[inst] = {
                Enabled = inst.Enabled,
                Rate = inst.Rate,
                Lifetime = inst.Lifetime,
                Transparency = inst.Transparency,
            }
            silence(inst)
        end
    elseif inst:IsA("Sound") then
        if weatherSounds[inst] == nil and looksLikeWeather(inst) then
            weatherSounds[inst] = inst.Volume
            inst.Volume = 0
        end
    end
end

local function weatherTick()
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    local cl = terrain and terrain:FindFirstChildOfClass("Clouds")
    if cl then
        if cloudsInst ~= cl then
            cloudsInst = cl
            cloudsWas = cl.Enabled
        end
        cl.Enabled = false
    end
    for inst in pairs(weatherEmitters) do
        if not inst.Parent then
            weatherEmitters[inst] = nil
        elseif inst.Enabled or inst.Rate ~= 0 then
            silence(inst)
        end
    end
    for inst in pairs(weatherSounds) do
        if not inst.Parent then
            weatherSounds[inst] = nil
        elseif inst.Volume ~= 0 then
            inst.Volume = 0
        end
    end
end

local function setWeather(on)
    weatherToken += 1
    weatherOn = on
    if weatherConn then weatherConn:Disconnect() weatherConn = nil end
    if weatherLoop then weatherLoop:Disconnect() weatherLoop = nil end

    if on then
        local token = weatherToken

        -- new objects (small delay so scripts can finish setting properties)
        weatherConn = workspace.DescendantAdded:Connect(function(inst)
            if inst:IsA("ParticleEmitter") or inst:IsA("Sound") then
                task.delay(0.1, killWeather, inst)
            end
        end)

        -- one-time scan, spread over several frames so it doesn't hitch
        task.spawn(function()
            local n = 0
            for _, d in ipairs(workspace:GetDescendants()) do
                if token ~= weatherToken then return end
                killWeather(d)
                n += 1
                if n % 1500 == 0 then task.wait() end
            end
        end)

        weatherTick()
        local last = os.clock()
        weatherLoop = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            if now - last < 0.5 then return end
            last = now
            weatherTick()
        end)
    else
        for inst, saved in pairs(weatherEmitters) do
            if inst.Parent then
                inst.Lifetime = saved.Lifetime
                inst.Transparency = saved.Transparency
                inst.Rate = saved.Rate
                inst.Enabled = saved.Enabled
            end
        end
        table.clear(weatherEmitters)
        for inst, vol in pairs(weatherSounds) do
            if inst.Parent then inst.Volume = vol end
        end
        table.clear(weatherSounds)
        if cloudsInst and cloudsInst.Parent then
            cloudsInst.Enabled = cloudsWas
        end
        cloudsInst = nil
    end
end

