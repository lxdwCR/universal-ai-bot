------------------------------------------------------------------
-- Smooth neon backdrop. One capped-rate animation loop drives every pattern.
-- Patterns are designed as subtle ambient glows rather than busy particles.
------------------------------------------------------------------
local menuFxController = (function()
    local styleNames = {"Soft Glow", "Flowing Lines", "Glowing Hexagons", "Neon Dust", "Electric Veil", "Off"}
    local styleIndex = 1
    local enabled = true
    local opacity = 0.58
    local motionSpeed = 0.48
    local density = 18
    local softness = 0.82
    local cursorStrength = 0.68
    local lastFrame = 0
    local pieces = {}
    local cursorGlowParts = nil
    local smoothMouse = Vector2.new(0.5, 0.5)

    local layer = Instance.new("Frame")
    layer.Name = "MenuBackdrop"
    layer.Size = UDim2.fromScale(1, 1)
    layer.BackgroundColor3 = Color3.fromRGB(7, 10, 17)
    layer.BackgroundTransparency = 0.56
    layer.BorderSizePixel = 0
    layer.Active = false
    layer.ZIndex = 1
    layer.Parent = clickGui
    layer:SetAttribute("TrueSightRole", "backdrop")

    local backdropGradient = Instance.new("UIGradient")
    backdropGradient.Rotation = 18
    backdropGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 14, 26)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(12, 14, 25)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(6, 8, 14)),
    })
    backdropGradient.Parent = layer
    backdropGradient:SetAttribute("TrueSightRole", "backdrop-gradient")

    local canvas = Instance.new("Frame")
    canvas.Name = "EffectCanvas"
    canvas.Size = UDim2.fromScale(1, 1)
    canvas.BackgroundTransparency = 1
    canvas.BorderSizePixel = 0
    canvas.Active = false
    canvas.ZIndex = 1
    canvas.Parent = layer

    local function clearPieces()
        for _, child in ipairs(canvas:GetChildren()) do child:Destroy() end
        table.clear(pieces)
        cursorGlowParts = nil
    end

    local function addCursorGlow()
        local group = {}
        for _, spec in ipairs({
            {size = 184, fill = 0.982, stroke = 0.87, thickness = 2},
            {size = 126, fill = 0.988, stroke = 0.79, thickness = 1.5},
            {size = 70, fill = 0.991, stroke = 0.70, thickness = 1},
        }) do
            local ring = Instance.new("Frame")
            ring.Name = "CursorGlowLayer"
            ring.AnchorPoint = Vector2.new(0.5, 0.5)
            ring.Position = UDim2.fromScale(smoothMouse.X, smoothMouse.Y)
            ring.Size = UDim2.fromOffset(spec.size, spec.size)
            ring.BackgroundColor3 = accent
            ring.BackgroundTransparency = spec.fill
            ring.BorderSizePixel = 0
            ring.Active = false
            ring.ZIndex = 2
            ring.Parent = canvas
            corner(ring, spec.size)
            local line = Instance.new("UIStroke")
            line.Color = accent
            line.Thickness = spec.thickness
            line.Transparency = spec.stroke
            line.Parent = ring
            table.insert(group, {frame = ring, stroke = line, size = spec.size, fill = spec.fill, baseStroke = spec.stroke})
        end
        cursorGlowParts = group
    end

    local function addLine(x, y, width, height, rotation, phase, alpha, drift)
        local obj = Instance.new("Frame")
        obj.Name = "SoftNeonRibbon"
        obj.AnchorPoint = Vector2.new(0.5, 0.5)
        obj.Position = UDim2.fromScale(x, y)
        obj.Size = UDim2.new(width, 0, 0, height)
        obj.Rotation = rotation
        obj.BackgroundColor3 = accent
        obj.BackgroundTransparency = 0.68
        obj.BorderSizePixel = 0
        obj.Active = false
        obj.Parent = canvas
        corner(obj, math.max(10, math.floor(height / 2)))

        local grad = Instance.new("UIGradient")
        grad.Rotation = 0
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, accent:Lerp(Color3.fromRGB(105, 120, 255), 0.18)),
            ColorSequenceKeypoint.new(0.5, accent),
            ColorSequenceKeypoint.new(1, accent:Lerp(Color3.fromRGB(115, 95, 255), 0.24)),
        })
        grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.18, 0.82),
            NumberSequenceKeypoint.new(0.5, 0.26),
            NumberSequenceKeypoint.new(0.82, 0.82),
            NumberSequenceKeypoint.new(1, 1),
        })
        grad.Parent = obj
        obj:SetAttribute("TrueSightRole", "accent-fx")
        table.insert(pieces, {obj = obj, gradient = grad, kind = "line", x = x, y = y,
            phase = phase, alpha = alpha or 0.5, baseRotation = rotation, drift = drift or 0.025})
    end

    local function addDot(x, y, size, phase, vx, vy)
        local obj = Instance.new("Frame")
        obj.Name = "NeonDustDot"
        obj.AnchorPoint = Vector2.new(0.5, 0.5)
        obj.Position = UDim2.fromScale(x, y)
        obj.Size = UDim2.fromOffset(size, size)
        obj.BackgroundColor3 = accent
        obj.BackgroundTransparency = 0.5
        obj.BorderSizePixel = 0
        obj.Active = false
        obj.Parent = canvas
        corner(obj, size)
        local stroke = Instance.new("UIStroke")
        stroke.Color = accent
        stroke.Thickness = 1
        stroke.Transparency = 0.48
        stroke.Parent = obj
        table.insert(pieces, {obj = obj, stroke = stroke, kind = "dot", x = x, y = y, size = size,
            phase = phase, vx = vx, vy = vy, alpha = 0.55})
    end

    local function addHex(x, y, size, phase, vx, vy)
        -- Build the outline from six actual line segments instead of a Unicode
        -- glyph. Font fallback can turn the glyph into a box/rectangle on some clients.
        local obj = Instance.new("Frame")
        obj.Name = "NeonHexagonOutline"
        obj.AnchorPoint = Vector2.new(0.5, 0.5)
        obj.Position = UDim2.fromScale(x, y)
        obj.Size = UDim2.fromOffset(size, size)
        obj.BackgroundTransparency = 1
        obj.BorderSizePixel = 0
        obj.Active = false
        obj.Parent = canvas
        local edges = {}
        local radius = size * 0.43
        local points = {}
        for i = 1, 6 do
            local angle = math.rad(-30 + (i - 1) * 60)
            points[i] = Vector2.new(math.cos(angle) * radius, math.sin(angle) * radius)
        end
        for i = 1, 6 do
            local a = points[i]
            local b = points[(i % 6) + 1]
            local delta = b - a
            local edge = Instance.new("Frame")
            edge.Name = "HexEdge"
            edge.AnchorPoint = Vector2.new(0.5, 0.5)
            edge.Position = UDim2.new(0.5, (a.X + b.X) * 0.5, 0.5, (a.Y + b.Y) * 0.5)
            edge.Size = UDim2.fromOffset(delta.Magnitude + 1.5, 1.7)
            edge.Rotation = math.deg(math.atan2(delta.Y, delta.X))
            edge.BackgroundColor3 = accent
            edge.BackgroundTransparency = 0.48
            edge.BorderSizePixel = 0
            edge.Active = false
            edge.Parent = obj
            table.insert(edges, edge)
        end
        table.insert(pieces, {obj = obj, edges = edges, kind = "hex", x = x, y = y, size = size,
            phase = phase, vx = vx, vy = vy, alpha = 0.5})
    end

    local function addGlowRing(x, y, size, phase)
        -- Separate outer bloom and crisp inner ring: avoids stacking multiple
        -- UIStroke instances on one GuiObject, which varies across UI runtimes.
        local bloom = Instance.new("Frame")
        bloom.Name = "SoftGlowBloom"
        bloom.AnchorPoint = Vector2.new(0.5, 0.5)
        bloom.Position = UDim2.fromScale(x, y)
        bloom.Size = UDim2.fromOffset(size + 10, size + 10)
        bloom.BackgroundTransparency = 1
        bloom.BorderSizePixel = 0
        bloom.Active = false
        bloom.Parent = canvas
        corner(bloom, size + 10)
        local bloomStroke = Instance.new("UIStroke")
        bloomStroke.Name = "GlowBloom"
        bloomStroke.Color = accent
        bloomStroke.Thickness = 4
        bloomStroke.Transparency = 0.93
        bloomStroke.Parent = bloom

        local obj = Instance.new("Frame")
        obj.Name = "SoftGlowRing"
        obj.AnchorPoint = Vector2.new(0.5, 0.5)
        obj.Position = UDim2.fromScale(x, y)
        obj.Size = UDim2.fromOffset(size, size)
        obj.BackgroundTransparency = 1
        obj.BorderSizePixel = 0
        obj.Active = false
        obj.Parent = canvas
        corner(obj, size)
        local stroke = Instance.new("UIStroke")
        stroke.Name = "GlowOutline"
        stroke.Color = accent
        stroke.Thickness = 1.25
        stroke.Transparency = 0.67
        stroke.Parent = obj
        table.insert(pieces, {obj = obj, stroke = stroke, bloom = bloom, bloomStroke = bloomStroke,
            kind = "ring", x = x, y = y, size = size, phase = phase, alpha = 0.55})
    end

    local function applySoftness()
        local centerTransparency = math.clamp(0.25 + (1 - softness) * 0.42, 0.25, 0.62)
        for _, p in ipairs(pieces) do
            if p.gradient and p.gradient.Parent then
                p.gradient.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(0.18, math.min(0.98, centerTransparency + 0.18)),
                    NumberSequenceKeypoint.new(0.5, centerTransparency),
                    NumberSequenceKeypoint.new(0.82, math.min(0.98, centerTransparency + 0.18)),
                    NumberSequenceKeypoint.new(1, 1),
                })
            end
        end
    end

    local function rebuild()
        clearPieces()
        local style = styleNames[styleIndex]
        canvas.Visible = enabled and style ~= "Off"
        layer.Visible = enabled and style ~= "Off"
        if not canvas.Visible then return end

        if style == "Soft Glow" then
            for i = 1, 6 do
                local x = 0.16 + (i - 1) * 0.145
                local y = 0.22 + (i % 3) * 0.22
                addLine(x, y, 0.50 + (i % 3) * 0.12, 38 + (i % 3) * 18,
                    -18 + i * 7, i * 0.83, 0.45, 0.018)
            end
            for i = 1, 6 do
                addGlowRing(0.14 + ((i * 0.173) % 0.75), 0.2 + ((i * 0.267) % 0.62),
                    76 + (i % 3) * 54, i * 1.27)
            end
        elseif style == "Flowing Lines" then
            for i = 1, math.max(7, math.floor(density * 0.55)) do
                local x = ((i * 0.6180339) + 0.05) % 1
                local y = 0.12 + ((i * 0.2360679) % 0.78)
                addLine(x, y, 0.46 + (i % 4) * 0.13, 22 + (i % 3) * 12,
                    -22 + (i % 7) * 7, i * 0.71, 0.42, 0.022)
            end
        elseif style == "Glowing Hexagons" then
            local rows = math.max(2, math.floor(math.sqrt(density * 0.65)))
            local cols = math.max(4, math.floor(density / rows))
            for row = 1, rows do
                for col = 1, cols do
                    local x = (col - 0.45 + (row % 2) * 0.34) / (cols + 0.25)
                    local y = 0.13 + (row - 1) * (0.73 / math.max(1, rows - 1))
                    local size = 32 + ((row + col) % 4) * 12
                    addHex(x, y, size, row * 0.9 + col * 0.61,
                        ((col % 3) - 1) * 0.0018, ((row % 3) - 1) * 0.0015)
                end
            end
        elseif style == "Neon Dust" then
            for i = 1, density do
                local x = ((i * 0.6180339) + 0.07) % 1
                local y = ((i * 0.3819660) + 0.13) % 1
                addDot(x, y, 2 + (i % 4), i * 0.77,
                    (((i % 5) - 2) * 0.0035), (((i % 7) - 3) * 0.003))
            end
        elseif style == "Electric Veil" then
            -- Smooth, wide ribbons with low-amplitude motion instead of sharp lightning bolts.
            for i = 1, math.max(7, math.floor(density * 0.48)) do
                local x = ((i * 0.754877) + 0.08) % 1
                local y = 0.12 + ((i * 0.569840) % 0.76)
                addLine(x, y, 0.32 + (i % 4) * 0.13, 4 + (i % 2) * 3,
                    -34 + (i % 6) * 13, i * 1.4, 0.62, 0.012)
            end
        end
        addCursorGlow()
        applySoftness()
    end

    local function setStyle(i)
        if type(i) == "number" and styleNames[i] then styleIndex = i end
        rebuild()
    end
    local function setEnabled(value)
        enabled = value == true
        rebuild()
    end
    local function setOpacity(value)
        opacity = math.clamp(tonumber(value) or opacity, 0.1, 0.9)
    end
    local function setSpeed(value)
        motionSpeed = math.clamp(tonumber(value) or motionSpeed, 0.1, 1.8)
    end
    local function setDensity(value)
        density = math.clamp(math.floor((tonumber(value) or density) + 0.5), 8, 36)
        rebuild()
    end
    local function setSoftness(value)
        softness = math.clamp(tonumber(value) or softness, 0.15, 1)
        applySoftness()
    end
    local function setCursorStrength(value)
        cursorStrength = math.clamp(tonumber(value) or cursorStrength, 0, 1.25)
    end
    local function setPanelTransparency(value)
        value = math.clamp(tonumber(value) or 0.06, 0.02, 0.36)
        for _, panel in pairs(panelRegistry) do
            if panel and panel.Parent then panel.BackgroundTransparency = value end
        end
    end
    local function setCornerRadius(value)
        value = math.clamp(math.floor((tonumber(value) or 8) + 0.5), 2, 18)
        for _, inst in ipairs(gui:GetDescendants()) do
            if inst:IsA("UICorner") then inst.CornerRadius = UDim.new(0, value) end
        end
    end

    onAccent(function(color)
        backdropGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 12, 22):Lerp(color, 0.12)),
            ColorSequenceKeypoint.new(0.55, Color3.fromRGB(12, 14, 25):Lerp(color, 0.08)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(6, 8, 14)),
        })
        for _, p in ipairs(pieces) do
            if p.obj and p.obj.Parent then
                if p.kind == "hex" and p.edges then
                    for _, edge in ipairs(p.edges) do
                        if edge and edge.Parent then edge.BackgroundColor3 = color end
                    end
                elseif p.obj:IsA("TextLabel") then
                    p.obj.TextColor3 = color
                    p.obj.TextStrokeColor3 = color
                elseif p.obj:IsA("GuiObject") then
                    p.obj.BackgroundColor3 = color
                end
                if p.stroke and p.stroke.Parent then p.stroke.Color = color end
                if p.bloomStroke and p.bloomStroke.Parent then p.bloomStroke.Color = color end
                if p.gradient and p.gradient.Parent then
                    p.gradient.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, color:Lerp(Color3.fromRGB(100, 120, 255), 0.18)),
                        ColorSequenceKeypoint.new(0.5, color),
                        ColorSequenceKeypoint.new(1, color:Lerp(Color3.fromRGB(125, 95, 255), 0.24)),
                    })
                end
            end
        end
    end)

    rebuild()
    table.insert(connections, RunService.RenderStepped:Connect(function(dt)
        if not enabled or not layer.Visible or not clickGui.Visible then return end
        local now = os.clock()
        local viewport = (cam() and cam().ViewportSize) or Vector2.new(1280, 720)
        local mouse = UserInputService:GetMouseLocation()
        local targetMouse = Vector2.new(
            math.clamp(mouse.X / math.max(1, viewport.X), 0, 1),
            math.clamp(mouse.Y / math.max(1, viewport.Y), 0, 1)
        )
        -- Exponential easing keeps the glow responsive without jittering.
        smoothMouse = smoothMouse:Lerp(targetMouse, math.clamp(dt * 5.5, 0, 1))
        if cursorGlowParts then
            for _, glow in ipairs(cursorGlowParts) do
                if glow.frame and glow.frame.Parent then
                    glow.frame.Position = UDim2.fromScale(smoothMouse.X, smoothMouse.Y)
                    glow.frame.BackgroundColor3 = accent
                    glow.stroke.Color = accent
                    glow.frame.Visible = cursorStrength > 0.01
                    glow.stroke.Transparency = math.clamp(glow.baseStroke + (1 - cursorStrength) * 0.10, 0.65, 0.99)
                end
            end
        end
        backdropGradient.Rotation = 18 + (smoothMouse.X - 0.5) * cursorStrength * 8
        if now - lastFrame < 1 / 30 then return end
        local step = math.min(dt, 0.08) * motionSpeed
        lastFrame = now
        local parallaxX = (smoothMouse.X - 0.5) * cursorStrength * 0.035
        local parallaxY = (smoothMouse.Y - 0.5) * cursorStrength * 0.035
        for _, p in ipairs(pieces) do
            local obj = p.obj
            if obj and obj.Parent then
                local pulse = 0.5 + 0.5 * math.sin(now * (0.52 + motionSpeed * 0.32) + p.phase)
                if p.kind == "dot" or p.kind == "hex" then
                    p.x += (p.vx or 0) * step
                    p.y += (p.vy or 0) * step
                    if p.x < 0.025 or p.x > 0.975 then p.vx = -(p.vx or 0); p.x = math.clamp(p.x, 0.025, 0.975) end
                    if p.y < 0.04 or p.y > 0.96 then p.vy = -(p.vy or 0); p.y = math.clamp(p.y, 0.04, 0.96) end
                    obj.Position = UDim2.fromScale(p.x + parallaxX, p.y + parallaxY)
                    if p.kind == "hex" and p.edges then
                        local edgeTransparency = math.clamp(1 - opacity * p.alpha * (0.62 + pulse * 0.30) + (1 - softness) * 0.12, 0.12, 0.94)
                        for _, edge in ipairs(p.edges) do
                            if edge and edge.Parent then
                                edge.BackgroundTransparency = edgeTransparency
                            end
                        end
                        obj.BackgroundTransparency = 1
                    elseif obj:IsA("TextLabel") then
                        obj.TextTransparency = 1 - opacity * p.alpha * (0.5 + 0.38 * pulse)
                        obj.TextStrokeTransparency = math.clamp(0.92 - opacity * softness * (0.42 + pulse * 0.14), 0.48, 0.94)
                    else
                        obj.BackgroundTransparency = 1 - opacity * p.alpha * (0.32 + pulse * 0.58)
                        if p.stroke then p.stroke.Transparency = math.clamp(0.94 - opacity * (0.32 + pulse * 0.2), 0.55, 0.96) end
                    end
                elseif p.kind == "line" then
                    obj.Position = UDim2.fromScale(p.x + math.sin(now * 0.16 + p.phase) * p.drift + parallaxX,
                        p.y + math.sin(now * 0.21 + p.phase) * p.drift * 0.8 + parallaxY)
                    obj.Rotation = p.baseRotation + math.sin(now * 0.18 + p.phase) * 4
                    obj.BackgroundTransparency = math.clamp(0.87 - opacity * p.alpha * (0.16 + 0.17 * pulse), 0.61, 0.94)
                elseif p.kind == "ring" then
                    local swell = 1 + pulse * 0.055 * softness
                    obj.Position = UDim2.fromScale(p.x + math.sin(now * 0.12 + p.phase) * 0.012 + parallaxX,
                        p.y + math.cos(now * 0.16 + p.phase) * 0.016 + parallaxY)
                    obj.Size = UDim2.fromOffset(p.size * swell, p.size * swell)
                    if p.stroke then p.stroke.Transparency = math.clamp(0.96 - opacity * (0.36 + pulse * 0.14), 0.61, 0.97) end
                    if p.bloom then
                        p.bloom.Position = obj.Position
                        p.bloom.Size = UDim2.fromOffset((p.size + 10) * swell, (p.size + 10) * swell)
                    end
                    if p.bloomStroke then p.bloomStroke.Transparency = math.clamp(0.99 - opacity * softness * (0.16 + pulse * 0.09), 0.82, 0.99) end
                end
            end
        end
    end))

    return {
        styleNames = styleNames,
        getStyle = function() return styleIndex end,
        setStyle = setStyle,
        setEnabled = setEnabled,
        setOpacity = setOpacity,
        setSpeed = setSpeed,
        setDensity = setDensity,
        setSoftness = setSoftness,
        setCursorStrength = setCursorStrength,
        setPanelTransparency = setPanelTransparency,
        setCornerRadius = setCornerRadius,
    }
end)()

-- Live palette controller for the UI chrome (world lighting and the shared accent are independent).
local uiThemeController = (function()
    local names = {"Midnight", "Deep Ocean", "Graphite", "Violet Dusk", "Ice Terminal"}
    local palettes = {
