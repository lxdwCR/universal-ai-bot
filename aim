table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if keyUiState.bindingModule then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Escape then
                if input.KeyCode == Enum.KeyCode.Backspace then
                    keyUiState.bindingModule.keybind = nil
                else
                    keyUiState.bindingModule.keybind = input.KeyCode
                end
            end
            local wasBinding = keyUiState.bindingModule
            keyUiState.bindingModule = nil
            keyUiState.binding = false
            wasBinding.refreshBindButton()
            keyUiState.updateKeyUi()
            requestSave()
        end
        return
    elseif keyUiState.binding then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Escape then
                keyUiState.menuKey = input.KeyCode
            end
            keyUiState.binding = false
            keyUiState.updateKeyUi()
            requestSave()
        end
        return
    end

    if processed then return end
    if input.KeyCode == keyUiState.menuKey then
        clickGui.Visible = not clickGui.Visible
        if uiInteraction then uiInteraction.closeDropdown() end
        return
    end
    for _, m in ipairs(modules) do
        if m.keybind and input.KeyCode == m.keybind then
            m.set(not m.enabled)
            break
        end
    end
end))

table.insert(connections, UserInputService.InputChanged:Connect(function(input)
    local moving = input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    if not moving then return end

    local interactionState = uiInteraction and uiInteraction.resizeState
    local resize = interactionState and interactionState.resizeState
    if resize and resize.target and resize.target.Parent then
        local delta = input.Position - resize.startMouse
        local w = math.clamp(resize.startSize.X.Offset + delta.X, resize.minW, resize.maxW)
        local h = math.clamp(resize.startSize.Y.Offset + delta.Y, resize.minH, resize.maxH)
        resize.target.Size = UDim2.fromOffset(w, h)
    elseif dragTarget then
        local delta = input.Position - dragStartMouse
        -- Preserve the element's original Scale components and add deltas only
        -- to its Offset components. This keeps dragging in parent-local space and
        -- prevents the release snap/clamp jump caused by using screen coordinates.
        local startPosition = dragStartPos and dragStartPos.position or dragTarget.Position
        dragTarget.Position = UDim2.new(
            startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
        )
    elseif activeSlider then
        activeSlider(input.Position.X)
    end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        if dragTarget or (uiInteraction and uiInteraction.resizeState and uiInteraction.resizeState.resizeState) then requestSave() end
        if dragTarget and dragTarget.Parent then pcall(uiInteraction.clampObject, dragTarget) end
        local interactionState = uiInteraction and uiInteraction.resizeState
        if interactionState and interactionState.resizeState then
            pcall(uiInteraction.clampObject, interactionState.resizeState.target)
            interactionState.resizeState = nil
        end
        dragTarget = nil
        activeSlider = nil
    end
end))

