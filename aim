    -- Only use meaningful NPC/place names. YBA often calls every NPC "Human", so generic NPC names
    -- must never be used as landmarks.
    local genericNames = {
        human = true, humanoid = true, npc = true, model = true, dummy = true,
        man = true, woman = true, boy = true, girl = true, player = true,
        character = true, rig = true, guard = true, citizen = true,
        enemy = true, mob = true, thug = true, gangster = true,
        part = true, meshpart = true, folder = true, workspace = true,
        map = true, spawn = true, spawnpoint = true, spawnlocation = true,
        startercharacter = true, humanoidrootpart = true, head = true,
        torso = true, npcs = true, humans = true, characters = true,
    }
    local function isMeaningfulName(name)
        if type(name) ~= "string" or #name < 3 or #name > 42 then return false end
        local clean = string.lower((name:gsub("^%s+", ""):gsub("%s+$", "")))
        if genericNames[clean] or string.find(clean, "spawn", 1, true) then return false end
        if string.match(clean, "^human[%s%d_-]*$") or string.match(clean, "^npc[%s%d_-]*$") then return false end
        if string.match(clean, "^%d+$") or string.match(clean, "^model[%s%d_-]*$") then return false end
        return true
    end
    local function automaticName(part, index, center, npcs)
        if isMeaningfulName(part.Name) then return part.Name end
        local parent = part.Parent
        if parent and parent ~= workspace and isMeaningfulName(parent.Name) then
            return parent.Name
        end
        local nearest, distance = nil, 90
        for _, npc in ipairs(npcs) do
            local d = (part.Position - npc.position).Magnitude
            if d < distance then nearest, distance = npc.name, d end
        end
        if nearest then return "Near " .. nearest end
        local dx, dz = part.Position.X - center.X, part.Position.Z - center.Z
        local direction = "Central"
        if math.max(math.abs(dx), math.abs(dz)) > 90 then
            if math.abs(dx) > math.abs(dz) * 1.35 then
                direction = dx > 0 and "East" or "West"
            elseif math.abs(dz) > math.abs(dx) * 1.35 then
                direction = dz > 0 and "South" or "North"
            else
                direction = (dz > 0 and "South" or "North") .. (dx > 0 and "east" or "west")
            end
        end
        return string.format("%s Spawn %02d", direction, index)
    end
    local locationTitle = note(spawnPanel, "LOCATIONS", 27)
    locationTitle.TextColor3 = TEXT
    local choicesHost = Instance.new("Frame")
    choicesHost.Name = "SpawnChoices"
    choicesHost.BackgroundTransparency = 1
