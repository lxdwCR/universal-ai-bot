-- Auto Sprint taps the run key when movement resumes at walking speed.
local sprintKeyOptions = {"Left Ctrl", "Left Shift", "Right Ctrl", "Right Shift", "V", "C"}
local sprintKeyData = {
    ["Left Ctrl"]  = {keyCode = Enum.KeyCode.LeftControl,  virtualKey = 0x11},
    ["Right Ctrl"] = {keyCode = Enum.KeyCode.RightControl, virtualKey = 0x11},
    ["Left Shift"] = {keyCode = Enum.KeyCode.LeftShift,    virtualKey = 0x10},
    ["Right Shift"]= {keyCode = Enum.KeyCode.RightShift,   virtualKey = 0x10},
    ["V"] = {keyCode = Enum.KeyCode.V, virtualKey = 0x56},
    ["C"] = {keyCode = Enum.KeyCode.C, virtualKey = 0x43},
}
local sprintKeyIndex = 1
local sprintKeyName = sprintKeyOptions[sprintKeyIndex]
local sprintConn
local sprintInputWarned = false
local sprintTapToken = 0

-- Always attempt key-up, even if the press/wait path errors. Some executors can leave a
-- synthetic key held if the release call is skipped or fails.
local function tapSprintKey(keyName)
    if type(keyName) ~= "string" or keyName == "" then return false end
    local keyInfo = sprintKeyData[keyName]
    if not keyInfo then
        local kc = Enum.KeyCode[keyName]
        if not kc or kc == Enum.KeyCode.Unknown then return false end
        local vk
        if keyName:match("^[A-Z]$") or keyName:match("^[0-9]$") then
            vk = string.byte(keyName)
        elseif keyName:match("^F%d+$") then
            local n = tonumber(keyName:match("%d+"))
            if n and n >= 1 and n <= 12 then vk = 0x6F + n end
        else
            local special = {
                Space = 0x20, Tab = 0x09, Return = 0x0D,
                LeftControl = 0x11, RightControl = 0x11,
                LeftShift = 0x10, RightShift = 0x10,
                LeftAlt = 0x12, RightAlt = 0x12,
                Up = 0x26, Down = 0x28, Left = 0x25, Right = 0x27,
                Backspace = 0x08,
            }
            vk = special[keyName]
        end
        keyInfo = {keyCode = kc, virtualKey = vk}
    end

    if keyInfo.virtualKey and type(keypress) == "function" and type(keyrelease) == "function" then
        local downOk = pcall(keypress, keyInfo.virtualKey)
        if downOk then
            task.wait(0.045)
            local upOk = pcall(keyrelease, keyInfo.virtualKey)
            if upOk then return true end
            -- Retry release once before falling back to another input route.
            task.wait()
            pcall(keyrelease, keyInfo.virtualKey)
        end
    end

    local serviceOk, virtualInput = pcall(function()
        return game:GetService("VirtualInputManager")
    end)
    if serviceOk and virtualInput then
        local downOk = pcall(function()
            virtualInput:SendKeyEvent(true, keyInfo.keyCode, false, game)
        end)
        task.wait(0.045)
        local upOk = pcall(function()
            virtualInput:SendKeyEvent(false, keyInfo.keyCode, false, game)
        end)
        -- A release is attempted even if the press call reports an error.
        if not upOk then
            pcall(function()
                virtualInput:SendKeyEvent(false, keyInfo.keyCode, false, game)
            end)
        end
        return downOk and upOk
    end
    return false
end

local autoSprintMod = addModule(clientPanel, "Auto Sprint", function(on)
    -- Invalidate any pending tap loop from a previous enable/disable cycle.
    sprintTapToken += 1
    local thisToken = sprintTapToken

    if sprintConn then
        sprintConn:Disconnect()
        sprintConn = nil
    end

    if not on then return end

    local elapsed = 0
    local lastAttempt = -math.huge
    local tapInProgress = false
    local wasRunning = false
    local walkSince = nil
    local retryDelay = 0.18

    sprintConn = RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.025 then return end
        elapsed = 0

        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            wasRunning = false
            walkSince = nil
            return
        end

        local focused = UserInputService:GetFocusedTextBox()
        local moving = humanoid.MoveDirection.Magnitude > 0.05
        local speed = humanoid.WalkSpeed

        -- Prefer explicit game-provided sprint flags when the experience exposes them. Attribute/value
        -- names vary between YBA builds, so check common names on the player, character and humanoid
        -- before using WalkSpeed.
        local function readSprintFlag(container)
            if not container then return nil end
            for _, name in ipairs({"IsSprinting", "Sprinting", "IsRunning", "Running", "SprintingEnabled"}) do
                local value = nil
                pcall(function() value = container:GetAttribute(name) end)
                if type(value) == "boolean" then return value end
                local child = container:FindFirstChild(name)
                if child and child:IsA("BoolValue") then return child.Value end
            end
            return nil
        end
        local gameSprintState
        -- Re-check in priority order so an explicit false is preserved.
        local explicitSprintState = readSprintFlag(character)
        if explicitSprintState == nil then explicitSprintState = readSprintFlag(player) end
        if explicitSprintState == nil then explicitSprintState = readSprintFlag(humanoid) end
        gameSprintState = explicitSprintState

        -- When a game flag exists, trust it even if WalkSpeed stays elevated during block recovery.
        -- Otherwise use the usual YBA speed threshold.
        local running
        if gameSprintState ~= nil then
            running = gameSprintState
        else
            running = speed >= 19
        end
        local walkingWhileMoving = moving and speed >= 5 and not running

        if running then
            wasRunning = true
            walkSince = nil
        elseif walkingWhileMoving then
            -- Start a fresh recovery window whenever sprint drops back to walk. Use a very short settle
            -- window so sprint resumes promptly after block recovery, while still avoiding input during
            -- low-speed locks.
            if wasRunning or walkSince == nil then
                walkSince = os.clock()
            end
            wasRunning = false
        else
            -- Not moving or movement is locked; wait for movement to recover.
            walkSince = nil
            if speed < 5 then wasRunning = false end
        end

        if focused or not walkingWhileMoving or tapInProgress or not walkSince then
            return
        end

        local now = os.clock()
        local elapsedWalking = now - walkSince
        local sinceAttempt = now - lastAttempt
