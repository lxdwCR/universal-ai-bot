local function selectNavPage(page)
    activeNavPage = page
    clickGui:SetAttribute("TrueSightActivePage", page)
    pageHeading.Text = page
    pageSummary.Text = pageDescriptions[page] or "TrueSight workspace"
    if pageSearch.Text ~= "" then pageSearch.Text = "" end
    applyPageSearch()
    if uiInteraction then uiInteraction.closeDropdown() end
    for title, panel in pairs(panelRegistry) do
        if panel and panel.Parent then panel.Visible = (title == page) end
    end
    for title, button in pairs(navButtons) do
        local selected = title == page
        button.BackgroundColor3 = selected and BG:Lerp(accent, 0.16) or Color3.fromRGB(13, 17, 25)
        button.TextColor3 = selected and TEXT or DIM
        local marker = button:FindFirstChild("SelectedMarker")
        if marker then marker.Visible = selected end
    end
end

