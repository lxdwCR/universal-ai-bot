-- Visible-only player labels. YBA's stand state is not a public Roblox API,
-- so stand detection checks common attributes/values and stand model names.
local nameTagObjects = {}
local nameTagLoop
local nameTagsMod

-- Avoid treating keybinds (for example Q or Tab) as stand names. YBA may
-- expose control/keybind values alongside other character/player values.
local invalidStandTokens = {
    q=true, w=true, e=true, r=true, t=true, y=true, u=true, i=true, o=true, p=true,
    a=true, s=true, d=true, f=true, g=true, h=true, j=true, k=true, l=true,
    z=true, x=true, c=true, v=true, b=true, n=true, m=true,
    tab=true, shift=true, leftshift=true, rightshift=true,
    ctrl=true, control=true, leftcontrol=true, rightcontrol=true,
    alt=true, leftalt=true, rightalt=true, space=true, escape=true, esc=true,
    enter=true, ["return"]=true, backspace=true, capslock=true,
    mousebutton1=true, mousebutton2=true, mousebutton3=true,
    unknown=true, none=true, ["nil"]=true, na=true, notavailable=true,
    stand=true, standname=true, currentstand=true, standtype=true,
    default=true, summon=true, desummon=true,
}

local function normalizeStandCandidate(value)
    if typeof(value) == "Instance" then
        value = value.Name
    end
    if type(value) ~= "string" then return nil end
    value = value:gsub("^%s+", ""):gsub("%s+$", "")
    if value == "" or #value > 48 then return nil end

    local compact = string.lower(value)
    compact = compact:gsub("^enum%.keycode%.", ""):gsub("^keycode%.", "")
    compact = compact:gsub("[%s_%-%.]", "")
    if invalidStandTokens[compact] or string.match(compact, "^%d+$") then
        return nil
    end
    -- Single-letter labels are almost always keybinds, not YBA stand names.
    if #compact == 1 and string.match(compact, "^[%a]$") then return nil end
    return value
end
local function removeNameTag(plr)
    local guiObject = nameTagObjects[plr]
    if guiObject then
        if guiObject.Parent then guiObject:Destroy() end
        nameTagObjects[plr] = nil
    end
end
local function createNameTag(plr)
    if plr == player then return end
    local character = plr.Character
    local head = character and character:FindFirstChild("Head")
    local existing = nameTagObjects[plr]
    -- Keep the same GUI instance, but retarget it whenever this player respawns.
    if existing and existing.Parent then
        if head and existing.Adornee ~= head then
            existing.Adornee = head
        end
        return existing
    end
    if not head then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TrueSightNameTag"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(220, 48)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = false
    billboard.Enabled = false
    billboard.Parent = gui
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = FONTB
    label.TextSize = 12
    label.TextColor3 = TEXT
    label.TextStrokeTransparency = 0.35
    label.RichText = true
    label.Parent = billboard
    nameTagObjects[plr] = billboard
end
local function setNameTags(on)
    if nameTagLoop then nameTagLoop:Disconnect() nameTagLoop = nil end
    if not on then
        for plr in pairs(nameTagObjects) do removeNameTag(plr) end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do createNameTag(plr) end
    nameTagLoop = RunService.Heartbeat:Connect(function()
        local camera = cam()
        if not camera then return end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {player.Character}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local character = plr.Character
                local head = character and character:FindFirstChild("Head")
                local hum = character and character:FindFirstChildOfClass("Humanoid")
                local tag = nameTagObjects[plr]
                -- Resolve a missing tag and retarget it to the new character's Head
                -- before checking health. Dead characters hide the tag temporarily;
                -- a respawn reuses the GUI and attaches it to the replacement Head.
                if head then
                    if not tag or not tag.Parent then
                        createNameTag(plr)
                        tag = nameTagObjects[plr]
                    elseif tag.Adornee ~= head then
                        tag.Adornee = head
                    end
                end
                if head and hum and hum.Health > 0 then
                    if tag then
                        local point, onScreen = camera:WorldToViewportPoint(head.Position)
                        local visible = onScreen and point.Z > 0
                        if visible then
                            local direction = head.Position - camera.CFrame.Position
                            local hit = workspace:Raycast(camera.CFrame.Position, direction, params)
                            visible = (not hit) or hit.Instance:IsDescendantOf(character)
                        end
                        tag.Enabled = visible
                        if visible then
                            local standName = nil
                            local standKeys = {"StandName", "Stand", "CurrentStand", "StandType"}
                            for _, key in ipairs(standKeys) do
                                local ok, value = pcall(function() return plr:GetAttribute(key) end)
                                if ok then standName = normalizeStandCandidate(value) end
                                if not standName then
                                    ok, value = pcall(function() return character:GetAttribute(key) end)
                                    if ok then standName = normalizeStandCandidate(value) end
                                end
                                if standName then break end
                            end
                            if not standName then
                                for _, container in ipairs({plr, character}) do
                                    for _, obj in ipairs(container:GetDescendants()) do
                                        if (obj:IsA("StringValue") or obj:IsA("ObjectValue")) then
                                            local n = string.lower(obj.Name)
                                            if string.find(n, "stand", 1, true) then
                                                local candidate = normalizeStandCandidate(obj.Value)
                                                if candidate then standName = candidate break end
                                            end
                                        end
                                    end
                                    if standName then break end
                                end
                            end
                            if not standName then
                                -- Some builds parent the summoned Stand model directly to
                                -- the character. Ignore control/key names and utility models.
                                for _, obj in ipairs(character:GetChildren()) do
                                    if obj:IsA("Model") and obj.Name ~= "" then
                                        local n = string.lower(obj.Name)
                                        if not string.find(n, "effect", 1, true)
                                            and not string.find(n, "hitbox", 1, true)
                                            and not string.find(n, "dummy", 1, true)
                                            and not string.find(n, "rig", 1, true)
                                            and not string.find(n, "vfx", 1, true) then
                                            local candidate = normalizeStandCandidate(obj.Name:gsub("[Ss]tand", ""))
                                            if not candidate then candidate = normalizeStandCandidate(obj.Name) end
                                            if candidate then standName = candidate break end
                                        end
                                    end
                                end
                            end
                            standName = standName or "Unknown"
                            tag.Label.TextColor3 = accent
                            tag.Label.Text = string.format(
                                '<font color="#%s">%s</font>  <font color="#FFFFFF">HP %d/%d</font>\n<font color="#B8C8D8">Stand: %s</font>',
                                accent:ToHex(), plr.DisplayName,
                                math.floor(hum.Health + 0.5), math.floor(hum.MaxHealth + 0.5),
                                tostring(standName):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
                        end
                    end
                elseif tag then
                    tag.Enabled = false
                end
            end
        end
    end)
end
