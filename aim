------------------------------------------------------------------
-- China hat: glowing cone (adornments, no physics, no shadows)
------------------------------------------------------------------
local hatObjects = {}
local hatCones = {}
local hatLight
local hatScale = 1

local function removeHat()
    for _, o in ipairs(hatObjects) do
        if o and o.Parent then o:Destroy() end
    end
    table.clear(hatObjects)
    table.clear(hatCones)
    hatLight = nil
end

local function applyHatScale()
    for _, c in ipairs(hatCones) do
        c.obj.Radius = c.r * hatScale
        c.obj.Height = c.h * hatScale
    end
end

local function addHat(character)
    removeHat()
    local head = character:FindFirstChild("Head")
    if not head then return end

    local function cone(radius, height, transparency, yOffset)
        local c = Instance.new("ConeHandleAdornment")
        c.Name = "LocalChinaHat"
        c.Adornee = head
        c.Radius = radius * hatScale
        c.Height = height * hatScale
        c.Transparency = transparency
        c.Color3 = accent
        c.CFrame = CFrame.new(0, yOffset, 0) * CFrame.Angles(math.rad(90), 0, 0)
        c.ZIndex = 1
        c.AlwaysOnTop = false
        c.Parent = head
        table.insert(hatObjects, c)
        table.insert(hatCones, {obj = c, r = radius, h = height})
    end

    cone(1.35, 1.15, 0.05, 0.45) -- solid core
    cone(1.55, 1.35, 0.65, 0.40) -- soft outer glow layer

    hatLight = Instance.new("PointLight")
    hatLight.Name = "LocalChinaHatLight"
    hatLight.Brightness = 1.5
    hatLight.Range = 10
    hatLight.Shadows = false
    hatLight.Color = accent
    hatLight.Parent = head
    table.insert(hatObjects, hatLight)
end

onAccent(function(c)
    for _, cc in ipairs(hatCones) do cc.obj.Color3 = c end
    if hatLight then hatLight.Color = c end
end)

