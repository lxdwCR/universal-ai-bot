    local function guardSharedCosmeticPhysics(entry,skin)
        local watched=setmetatable({}, {__mode="k"})
        local function onPart(obj)
            if not obj:IsA("BasePart") or watched[obj] then return end
            watched[obj]=true
            local function enforce()
                if entry.skin~=skin or not obj.Parent then return end
                if obj.CanCollide then obj.CanCollide=false end
                if obj.CanTouch then obj.CanTouch=false end
                if obj.CanQuery then obj.CanQuery=false end
                if not obj.Massless then obj.Massless=true end
            end
            enforce()
            table.insert(entry.connections,obj:GetPropertyChangedSignal("CanCollide"):Connect(enforce))
            table.insert(entry.connections,obj:GetPropertyChangedSignal("CanTouch"):Connect(enforce))
            table.insert(entry.connections,obj:GetPropertyChangedSignal("CanQuery"):Connect(enforce))
        end
        for _,obj in ipairs(skin:GetDescendants()) do onPart(obj) end
        table.insert(entry.connections,skin.DescendantAdded:Connect(onPart))
