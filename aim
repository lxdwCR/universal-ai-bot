;(function()
    local visualPanel = visualModules.panel
    if not visualPanel then return end

    ------------------------------------------------------------------
    -- ReplicatedStorage YBA cosmetics / accessory picker
    ------------------------------------------------------------------
    local cosmeticCandidates = {}
    local cosmeticNames = {"None"}
    local selectedCosmeticIndex = 1
    local activeCosmetic
    local cosmeticStatus
    local cosmeticHatMod
    local cosmeticOffsetX, cosmeticOffsetY, cosmeticOffsetZ = 0, 0, 0
    local cosmeticRotationY = 0
    local blackFlashAssets = {}
    local blackFlashNames = {"Auto-detect"}
    local blackFlashCycle
    local blackFlashSelectedIndex = 1
    local blackFlashStatus
    local blackFlashMod
    local blackFlashAnimationConnection
    local blackFlashRespawnConnection
    local blackFlashActiveObjects = {_state = {recentAttackAt = 0, durationFactor = 1.6, effectScale = 0.58}}
    local blackFlashChance = 100
    local blackFlashVolume = 0.8
    local blackFlashCooldown = 1.2
    local blackFlashLastTrigger = 0
    local blackFlashParticleCount = 42

    local function lower(value)
        return string.lower(tostring(value or ""))
    end

    local function hasHatWord(name)
        local n = lower(name)
        return string.find(n, "hat", 1, true) ~= nil
            or string.find(n, "helmet", 1, true) ~= nil
            or string.find(n, "headwear", 1, true) ~= nil
            or string.find(n, "accessory", 1, true) ~= nil
            or string.find(n, "cosmetic", 1, true) ~= nil
            or string.find(n, "mask", 1, true) ~= nil
            or string.find(n, "glasses", 1, true) ~= nil
            or string.find(n, "crown", 1, true) ~= nil
    end

    local function pathHasCosmeticFolder(inst)
        local node = inst.Parent
        while node and node ~= ReplicatedStorage do
            local n = lower(node.Name)
            if string.find(n, "cosmetic", 1, true)
                or string.find(n, "accessor", 1, true)
                or string.find(n, "headwear", 1, true)
                or string.find(n, "hats", 1, true) then
                return true
            end
            node = node.Parent
        end
        return false
    end

    local function hasBasePart(root)
        if root:IsA("BasePart") then return true end
        for _, child in ipairs(root:GetDescendants()) do
            if child:IsA("BasePart") then return true end
        end
        return false
    end

    local function hasNestedAccessory(model)
        -- A direct-child check avoids repeatedly scanning large nested cosmetic trees.
        for _, child in ipairs(model:GetChildren()) do
            if child:IsA("Accessory") then return true end
        end
        return false
    end

    local function getInstancePath(inst)
        local parts = {}
        local node = inst
        while node and node ~= ReplicatedStorage do
            table.insert(parts, 1, tostring(node.Name))
            node = node.Parent
        end
        return table.concat(parts, "/")
    end

    local function scanReplicatedCosmetics()
        table.clear(cosmeticCandidates)
        table.clear(cosmeticNames)
        table.clear(blackFlashAssets)
        table.clear(blackFlashNames)
        table.insert(cosmeticNames, "None")
        table.insert(blackFlashNames, "Auto-detect")
        local ok, descendants = pcall(function() return ReplicatedStorage:GetDescendants() end)
        if not ok or type(descendants) ~= "table" then
            if cosmeticStatus then cosmeticStatus.Text = "Could not discover assets in ReplicatedStorage during startup." end
            return 0
        end

        local seen = {}
        local blackFlashSeen = {}
        for scanIndex, inst in ipairs(descendants) do
            -- Yield periodically so large asset folders can't hitch menu startup.
            if scanIndex % 450 == 0 then task.wait() end

            -- Detect Black Flash source folders/effects during the same pass as
            -- the cosmetic scan, avoiding a second expensive full-tree traversal.
            local norm = lower(inst.Name):gsub("[^%w]", "")
            if string.find(norm, "blackflash", 1, true) then
                local root = inst
                local ancestor = inst.Parent
                while ancestor and ancestor ~= ReplicatedStorage do
                    local ancestorName = lower(ancestor.Name):gsub("[^%w]", "")
                    if string.find(ancestorName, "blackflash", 1, true) then root = ancestor end
                    ancestor = ancestor.Parent
                end
                if root and not blackFlashSeen[root] then
                    blackFlashSeen[root] = true
                    local path = getInstancePath(root)
                    local label = tostring(root.Name) .. "  •  " .. path
                    if #label > 64 then label = string.sub(label, 1, 61) .. "..." end
                    table.insert(blackFlashAssets, {source = root, path = path, label = label})
                end
            end

            local candidate = false
            if inst:IsA("Accessory") then
                -- Accessory instances are exact wearables and are preferred.
                candidate = hasBasePart(inst)
            elseif inst:IsA("Model") then
                -- Filter by name/path before traversing descendants. Scanning every
                -- model's full subtree made ReplicatedStorage scans unnecessarily expensive.
                local n = lower(inst.Name)
                local containerName = n == "cosmetic" or n == "cosmetics" or n == "hat"
                    or n == "hats" or n == "accessory" or n == "accessories"
                    or n == "headwear" or n == "cosmeticassets"
                candidate = not containerName and (hasHatWord(inst.Name) or pathHasCosmeticFolder(inst))
                if candidate then
                    local childModel = false
                    for _, child in ipairs(inst:GetChildren()) do
                        if child:IsA("Model") or child:IsA("Accessory") then childModel = true break end
                    end
                    if childModel and not hasHatWord(inst.Name) then candidate = false end
                    if candidate then candidate = hasBasePart(inst) and not hasNestedAccessory(inst) end
                end
            end
            if candidate and not seen[inst] and #cosmeticCandidates < 120 then
                seen[inst] = true
                local path = getInstancePath(inst)
                local label = inst.Name
                if #label > 32 then label = string.sub(label, 1, 29) .. "..." end
                table.insert(cosmeticCandidates, {source = inst, path = path, label = label})
            end
        end
        table.sort(cosmeticCandidates, function(a, b)
            local an, bn = lower(a.label), lower(b.label)
            if an == bn then return a.path < b.path end
            return an < bn
        end)
        for _, item in ipairs(cosmeticCandidates) do
            local display = item.label
            if cosmeticNames[1] == display then display = display .. " " end
            table.insert(cosmeticNames, display)
        end
        table.sort(blackFlashAssets, function(a, b)
            local an, bn = lower(a.label), lower(b.label)
            if an == bn then return a.path < b.path end
            return an < bn
        end)
        for _, item in ipairs(blackFlashAssets) do table.insert(blackFlashNames, item.label) end
        -- Preload a bounded set of Black Flash sounds in the background so impact audio
        -- starts closer to the visual burst instead of waiting for first-use asset streaming.
        task.spawn(function()
            local preloadItems, seenSounds = {}, {}
            for _, item in ipairs(blackFlashAssets) do
                local okSounds, soundDescendants = pcall(function() return item.source:GetDescendants() end)
                if okSounds then
                    for _, soundObj in ipairs(soundDescendants) do
                        if soundObj:IsA("Sound") and soundObj.SoundId ~= "" and not seenSounds[soundObj] then
                            seenSounds[soundObj] = true
                            table.insert(preloadItems, soundObj)
                            if #preloadItems >= 60 then break end
                        end
                    end
                end
                if #preloadItems >= 60 then break end
            end
            if #preloadItems > 0 then
                pcall(function() game:GetService("ContentProvider"):PreloadAsync(preloadItems) end)
            end
        end)
        if blackFlashCycle then blackFlashCycle.set(1); blackFlashSelectedIndex = 1 end
        if blackFlashStatus then
            blackFlashStatus.Text = string.format("Found %d named Black Flash asset group(s) in ReplicatedStorage.", #blackFlashAssets)
        end
        if cosmeticStatus then
            cosmeticStatus.Text = string.format("Found %d possible YBA cosmetics and %d Black Flash source(s) under ReplicatedStorage. Changes are local-only.", #cosmeticCandidates, #blackFlashAssets)
        end
        return #cosmeticCandidates
    end

    local function removeActiveCosmetic()
        if activeCosmetic then
            pcall(function() activeCosmetic:Destroy() end)
        end
        activeCosmetic = nil
    end

    local function cloneArchivable(source)
        local all = {source}
        local ok, desc = pcall(function() return source:GetDescendants() end)
        if ok then
            for _, child in ipairs(desc) do table.insert(all, child) end
        end
        local old = {}
        for _, obj in ipairs(all) do
            old[obj] = obj.Archivable
            pcall(function() obj.Archivable = true end)
        end
        local cloneOk, clone = pcall(function() return source:Clone() end)
        for obj, value in pairs(old) do pcall(function() obj.Archivable = value end) end
        if cloneOk then return clone end
        return nil
    end

    local function buildCosmeticOffset()
        return CFrame.new(cosmeticOffsetX, cosmeticOffsetY, cosmeticOffsetZ)
            * CFrame.Angles(0, math.rad(cosmeticRotationY), 0)
    end

    local function cosmeticPlacementCFrame(clone, head, label)
        local lowerLabel = lower(label)
        local boundsCF, boundsSize
        if clone:IsA("Model") then
            local ok, cf, size = pcall(function() local c, sz = clone:GetBoundingBox(); return c, sz end)
            if ok then boundsCF, boundsSize = cf, size end
        elseif clone:IsA("BasePart") then
            boundsCF, boundsSize = clone.CFrame, clone.Size
        else
            local handle = clone:FindFirstChild("Handle")
            local firstPart = (handle and handle:IsA("BasePart")) and handle or clone:FindFirstChildWhichIsA("BasePart", true)
            if firstPart then boundsCF, boundsSize = firstPart.CFrame, firstPart.Size end
        end
        boundsCF = boundsCF or CFrame.new()
        boundsSize = boundsSize or Vector3.new(0.8, 0.5, 0.3)

        local localTarget
        if string.find(lowerLabel, "glass", 1, true) or string.find(lowerLabel, "spectacle", 1, true)
            or string.find(lowerLabel, "mask", 1, true) or string.find(lowerLabel, "visor", 1, true)
            or string.find(lowerLabel, "face", 1, true) then
            -- Roblox faces forward along the head's local -Z axis.
            localTarget = CFrame.new(0, 0.05, -(head.Size.Z * 0.5 + boundsSize.Z * 0.5 - 0.03))
        elseif string.find(lowerLabel, "hat", 1, true) or string.find(lowerLabel, "crown", 1, true)
            or string.find(lowerLabel, "helmet", 1, true) or string.find(lowerLabel, "headwear", 1, true) then
            localTarget = CFrame.new(0, head.Size.Y * 0.5 + boundsSize.Y * 0.5 - 0.06, 0)
        else
            -- Unknown YBA names default to the top/centre of the head, not the
            -- previous fixed +0.6 offset which placed many cosmetics too high.
            localTarget = CFrame.new(0, head.Size.Y * 0.5 + boundsSize.Y * 0.35, 0)
        end
        local desiredGeometryCF = head.CFrame * localTarget * buildCosmeticOffset()
        local delta = desiredGeometryCF * boundsCF:Inverse()
        return delta
    end

    local function applyModelCosmetic(clone, character, label)
        local head = character:FindFirstChild("Head")
        if not head then clone:Destroy(); return false, "Character head not found" end
        local parts = {}
        for _, obj in ipairs(clone:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Anchored = true
                obj.CanCollide = false
                obj.CanTouch = false
                obj.CanQuery = false
                obj.Massless = true
                obj.CastShadow = false
                table.insert(parts, obj)
            elseif obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript")
                or obj:IsA("Constraint") or obj:IsA("JointInstance") then
                pcall(function() obj:Destroy() end)
            end
        end
        if clone:IsA("BasePart") then table.insert(parts, clone) end
        if #parts == 0 then clone:Destroy(); return false, "Cosmetic has no 3D parts" end

        -- Compute a transform from the asset's actual bounding-box centre to a
        -- head/face/top anchor, then apply the user's manual fine-alignment offsets.
        local delta = cosmeticPlacementCFrame(clone, head, label or clone.Name)
        if clone:IsA("Model") then
            pcall(function() clone:PivotTo(delta * clone:GetPivot()) end)
        else
            -- Accessory/Folder-like containers don't expose PivotTo or CFrame.
            for _, part in ipairs(parts) do
                if part and part.Parent then part.CFrame = delta * part.CFrame end
            end
        end
        clone.Parent = character
        for _, part in ipairs(parts) do
            local weld = Instance.new("WeldConstraint")
            weld.Name = "TrueSightCosmeticWeld"
            weld.Part0 = head
            weld.Part1 = part
            weld.Parent = part
        end
        for _, part in ipairs(parts) do if part and part.Parent then part.Anchored = false end end
        return true
    end

    local function findMatchingCosmeticAttachment(character, handle)
        if not handle then return nil, nil end
        local handleAttachments = {}
        for _, obj in ipairs(handle:GetDescendants()) do
            if obj:IsA("Attachment") then table.insert(handleAttachments, obj) end
        end
        local head = character:FindFirstChild("Head")
        for _, handleAttachment in ipairs(handleAttachments) do
            if head then
                local headAttachment = head:FindFirstChild(handleAttachment.Name)
                if headAttachment and headAttachment:IsA("Attachment") then
                    return headAttachment, handleAttachment
                end
            end
            for _, host in ipairs(character:GetDescendants()) do
                if host:IsA("Attachment") and host.Name == handleAttachment.Name
                    and host.Parent and host.Parent:IsA("BasePart") then
                    return host, handleAttachment
                end
            end
        end
        return nil, nil
    end

    local function applySelectedCosmetic(character)
        removeActiveCosmetic()
        if not cosmeticHatMod or not cosmeticHatMod.enabled then return end
        character = character or player.Character
        if not character then
            if cosmeticStatus then cosmeticStatus.Text = "Waiting for your character..." end
            return
        end
        if selectedCosmeticIndex <= 1 then
            if cosmeticStatus then cosmeticStatus.Text = "No cosmetic selected." end
            return
        end
        local record = cosmeticCandidates[selectedCosmeticIndex - 1]
        if not record or not record.source or not record.source.Parent then
            if cosmeticStatus then cosmeticStatus.Text = "Selected asset is no longer available. Restart TrueSight to refresh assets." end
            return
        end
        local clone = cloneArchivable(record.source)
        if not clone then
            if cosmeticStatus then cosmeticStatus.Text = "Could not clone the selected asset." end
            return
        end
        local ok, err
        if clone:IsA("Accessory") then
            local handle = clone:FindFirstChild("Handle")
            local hostAttachment, handleAttachment = findMatchingCosmeticAttachment(character, handle)
            if handle and handle:IsA("BasePart") and hostAttachment and handleAttachment then
                -- Match the wearable's authored attachment (HatAttachment,
                -- FaceFrontAttachment, etc.) instead of guessing a fixed height.
                for _, obj in ipairs(clone:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        obj.Anchored = false
                        obj.CanCollide = false
                        obj.CanTouch = false
                        obj.CanQuery = false
                        obj.Massless = true
                        obj.CastShadow = false
                    elseif obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                        pcall(function() obj:Destroy() end)
                    end
                end
                clone.Parent = character
                local weld = Instance.new("Weld")
                weld.Name = "TrueSightCosmeticAttachmentWeld"
                weld.Part0 = hostAttachment.Parent
                weld.Part1 = handle
                weld.C0 = hostAttachment.CFrame * buildCosmeticOffset()
                weld.C1 = handleAttachment.CFrame
                weld.Parent = handle
                ok = true
            else
                -- Some YBA assets are custom Models disguised as Accessory instances
                -- and have no standard Attachment pair. Use a name-aware head/face fit.
                ok, err = applyModelCosmetic(clone, character, record.label)
            end
        else
            ok, err = applyModelCosmetic(clone, character, record.label)
        end
        if ok then
            activeCosmetic = clone
            if cosmeticStatus then cosmeticStatus.Text = "Equipped locally: " .. record.path end
        else
            if cosmeticStatus then cosmeticStatus.Text = tostring(err or "Could not attach cosmetic") end
        end
    end

