        or input.UserInputType == Enum.UserInputType.Touch
    if not moving then return end

    local interactionState = uiInteraction and uiInteraction.resizeState
    local resize = interactionState and interactionState.resizeState
    if resize and resize.target and resize.target.Parent then
        local delta = input.Position - resize.startMouse
        local w = math.clamp(resize.startSize.X.Offset + delta.X, resize.minW, resize.maxW)
        local h = math.clamp(resize.startSize.Y.Offset + delta.Y, resize.minH, resize.maxH)
        resize.target.Size = UDim2.fromOffset(w, h)
    elseif dragTarget then
        local delta = input.Position - dragStartMouse
        -- Preserve the element's original Scale components and add deltas only to its Offset
        -- components. This keeps dragging in parent-local space and prevents the release snap/clamp
        -- jump caused by using screen coordinates.
        local startPosition = dragStartPos and dragStartPos.position or dragTarget.Position
        dragTarget.Position = UDim2.new(
            startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
        )
    elseif activeSlider then
        activeSlider(input.Position.X)
    end
end))

