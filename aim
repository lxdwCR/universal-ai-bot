            entry.morph, entry.standTorso, entry.standRoot = morph, standTorso, standRoot
            entry.articulated = articulated
            entry.rootOffset = standRoot.CFrame:ToObjectSpace(root.CFrame)
            entry.torsoOffset = standRoot.CFrame:ToObjectSpace(standTorso.CFrame)
