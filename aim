    local teleportHeader = note(spawnPanel, "TELEPORT", 25)
    teleportHeader.TextColor3 = TEXT
    local methodLabel = note(spawnPanel, "Root CFrame + YBA Filter", 29)
    methodLabel.TextColor3 = DIM
    local testButton = addAction(spawnPanel, "Teleport Now", function()
