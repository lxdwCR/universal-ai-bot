-- Wait for YBA to finish loading before starting TrueSight.
-- Skip startup if the game never becomes ready.
do
    local env
    pcall(function()
        env = type(getgenv) == "function" and getgenv() or _G
    end)

    local earlyPlayers = game:GetService("Players")
    local earlyPlayer = earlyPlayers.LocalPlayer
    local earlyGui = earlyPlayer and earlyPlayer:FindFirstChild("PlayerGui")
    local alreadyRunning = earlyGui and earlyGui:FindFirstChild("TrueSight") ~= nil

    if not alreadyRunning then
        local bootKey = "__TrueSightAutoExecV22Booting"
        if type(env) == "table" and rawget(env, bootKey) then
            warn("[TrueSight] Ignoring overlapping auto-execute startup")
            return
        end
        if type(env) == "table" then rawset(env, bootKey, true) end

        local started = os.clock()
        local timeout = 90
        local readySince = nil
        local ready = false
        local waitingFor = "game loading"

        while os.clock() - started < timeout do
            local plr = earlyPlayers.LocalPlayer
            local char = plr and plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local playerGui = plr and plr:FindFirstChild("PlayerGui")
            local playerScripts = plr and plr:FindFirstChild("PlayerScripts")
            local playerModule = playerScripts and playerScripts:FindFirstChild("PlayerModule")
            local currentCamera = workspace.CurrentCamera
            local camSubject = currentCamera and currentCamera.CameraSubject
            local cameraOnCharacter = camSubject and char and
                (camSubject == hum or camSubject:IsDescendantOf(char))

            local fullyReady = game:IsLoaded() and playerGui and playerModule
                and hum and hum.Health > 0 and root and not root.Anchored
                and currentCamera and currentCamera.CameraType ~= Enum.CameraType.Scriptable
                and cameraOnCharacter

            if fullyReady then
                -- Make sure the character and camera stay ready before continuing.
                readySince = readySince or os.clock()
                if os.clock() - readySince >= 4 then
                    ready = true
                    break
                end
            else
                readySince = nil
                if not game:IsLoaded() then waitingFor = "game loading"
                elseif not plr then waitingFor = "LocalPlayer"
                elseif not playerGui then waitingFor = "PlayerGui"
                elseif not playerModule then waitingFor = "Roblox PlayerModule controls"
                elseif not hum or not root then waitingFor = "playable character"
                elseif hum.Health <= 0 or root.Anchored then waitingFor = "character spawn/unfreeze"
                else waitingFor = "player camera" end
            end
            task.wait(0.2)
        end
        if type(env) == "table" then rawset(env, bootKey, nil) end
        if not ready then
            warn("[TrueSight] Auto-execute was skipped (90s timeout waiting for "
                .. waitingFor .. "). Roblox/YBA has not reached a stable playable state. "
                .. "You can execute TrueSight manually after joining.")
            return
        end
        -- Give YBA a moment to settle before opening the UI.
        task.wait(1.5)
        print("[TrueSight] Auto-execute startup ready; initializing modules safely")
    end
end

-- Clean up the previous run so old UI and loops don't linger.
do
    local ok, env = pcall(function()
        if type(getgenv) == "function" then return getgenv() end
        return _G
    end)
    if ok and type(env) == "table" then
        local previous = rawget(env, "__TrueSightActiveSessionV7")
        if type(previous) == "table" and type(previous.unload) == "function" then
            local unloaded, err = pcall(previous.unload)
            if not unloaded then warn("[TrueSight] Previous unload returned: " .. tostring(err)) end
        end
        rawset(env, "__TrueSightActiveSessionV7", nil)
    end
end

