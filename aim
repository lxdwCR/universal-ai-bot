------------------------------------------------------------------
-- Jump circles: a ring + splash where you land
------------------------------------------------------------------
local jumpConn
local airStart
local jumpLast = 0
local jumpSize = 1

local function groundCFrame(pos, normal)
    if normal.Y > 0.99 then
        return CFrame.new(pos)
    end
    -- make the part's top face point along the surface normal
    return CFrame.lookAt(pos, pos + normal) * CFrame.Angles(-math.pi / 2, 0, 0)
end

local function spawnRing(cf, finalSize, withSplash, strength)
    local part = Instance.new("Part")
    part.Name = "LocalJumpCircle"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Transparency = 1
    part.Size = Vector3.new(1, 0.05, 1)
    part.CFrame = cf

    local sg = Instance.new("SurfaceGui")
    sg.Face = Enum.NormalId.Top
    sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
    sg.CanvasSize = Vector2.new(256, 256)
    sg.LightInfluence = 0
    sg.Adornee = part
    sg.Parent = part

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(1, 1)
    fill.BackgroundColor3 = accent
    fill.BackgroundTransparency = 0.8
    fill.BorderSizePixel = 0
    fill.Parent = sg

    local round = Instance.new("UICorner")
    round.CornerRadius = UDim.new(0.5, 0)
    round.Parent = fill

    local stroke = Instance.new("UIStroke")
    stroke.Color = accent
    stroke.Thickness = 10
    stroke.Parent = fill

    part.Parent = workspace

    if withSplash then
        local e = Instance.new("ParticleEmitter")
        e.Name = "LocalSplash"
        e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        e.Rate = 0
        e.Lifetime = NumberRange.new(0.35, 0.6)
        e.Speed = NumberRange.new(6, 12)
        e.SpreadAngle = Vector2.new(70, 70)
        e.EmissionDirection = Enum.NormalId.Top
        e.Acceleration = Vector3.new(0, -35, 0)
        e.LightEmission = 1
        e.LightInfluence = 0
        e.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.5),
            NumberSequenceKeypoint.new(1, 0),
        })
        e.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        })
        e.Color = ColorSequence.new(accent, accent:Lerp(Color3.new(1, 1, 1), 0.6))
        e.Parent = part
        e:Emit(math.floor(14 * strength))
    end

    local grow = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fade = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(part, grow, {Size = Vector3.new(finalSize, 0.05, finalSize)}):Play()
    TweenService:Create(stroke, fade, {Transparency = 1}):Play()
    TweenService:Create(fill, fade, {BackgroundTransparency = 1}):Play()
    Debris:AddItem(part, 0.9)
end

local function spawnJumpCircle(character, strength)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local hit = workspace:Raycast(root.Position, Vector3.new(0, -10, 0), params)
    if not hit then return end

    local cf = groundCFrame(hit.Position + hit.Normal * 0.06, hit.Normal)
    local size = 8 * jumpSize * strength
    spawnRing(cf, size, true, strength)
    task.delay(0.07, function()
        spawnRing(cf, size * 0.6, false, strength)
    end)
end

local function unhookJump()
    if jumpConn then
        jumpConn:Disconnect()
        jumpConn = nil
    end
    airStart = nil
end

local function hookJump(character)
    unhookJump()
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    jumpConn = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Freefall
            or new == Enum.HumanoidStateType.Jumping then
            if not airStart then airStart = os.clock() end
        elseif new == Enum.HumanoidStateType.Landed then
            local air = airStart and (os.clock() - airStart) or 0
            airStart = nil
            local now = os.clock()
            if air < 0.12 or now - jumpLast < 0.15 then return end
            jumpLast = now
            spawnJumpCircle(character, math.clamp(0.8 + air * 0.9, 0.8, 2))
        elseif new == Enum.HumanoidStateType.Running then
            airStart = nil
        end
    end)
end

