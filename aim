table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if keyUiState.bindingModule then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Escape then
                if input.KeyCode == Enum.KeyCode.Backspace then
                    keyUiState.bindingModule.keybind = nil
                else
                    keyUiState.bindingModule.keybind = input.KeyCode
                end
            end
            local wasBinding = keyUiState.bindingModule
            keyUiState.bindingModule = nil
            keyUiState.binding = false
            wasBinding.refreshBindButton()
            keyUiState.updateKeyUi()
            requestSave()
        end
        return
    elseif keyUiState.binding then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Escape then
                keyUiState.menuKey = input.KeyCode
            end
            keyUiState.binding = false
            keyUiState.updateKeyUi()
            requestSave()
        end
        return
    end

    if processed then return end
    if input.KeyCode == keyUiState.menuKey then
        clickGui.Visible = not clickGui.Visible
        return
    end
    for _, m in ipairs(modules) do
        if m.keybind and input.KeyCode == m.keybind then
            m.set(not m.enabled)
            break
        end
    end
end))

table.insert(connections, UserInputService.InputChanged:Connect(function(input)
    local moving = input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    if not moving then return end

    if dragTarget then
        local delta = input.Position - dragStartMouse
        dragTarget.Position = UDim2.fromOffset(
            dragStartPos.X.Offset + delta.X,
            dragStartPos.Y.Offset + delta.Y
        )
    elseif activeSlider then
        activeSlider(input.Position.X)
    end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        if dragTarget then requestSave() end
        dragTarget = nil
        activeSlider = nil
    end
end))

