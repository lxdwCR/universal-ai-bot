    local autoCycle = addCycle(spawnPanel.frame, "On Respawn", {"Off", "On"}, 1,
        function(i)
            spawnState.auto = i == 2
            spawnState.spawnToken += 1
            if spawnState.auto then
                local ok, err = enableTeleportFilter()
                status.Text = ok and "Auto respawn enabled." or
                    ("Auto respawn unavailable: " .. tostring(err))
                if not ok then spawnState.auto = false end
            else
                status.Text = "Auto respawn disabled."
            end
