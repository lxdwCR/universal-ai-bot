            if not root and owner then root=owner:FindFirstChild("HumanoidRootPart",true) end
            if root and root:IsA("BasePart") then
                local d=(sourcePart.Position-root.Position).Magnitude
                if d<bestDist then
                    runnerUp=bestDist
                    bestDist=d
                    bestEntry=activeEntries[other.UserId]
                elseif d<runnerUp then runnerUp=d end
            end
        end
        if bestDist>5 or runnerUp-bestDist<1.25
            or not bestEntry or bestEntry.avatarId~=SPOH_SYNC_AVATAR_ID
            or not bestEntry.skin or not bestEntry.fx then return end
