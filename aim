    local function buildStandPreview(source, standName)
        if not source or not source:IsA("Model") then return false, "No model source" end

        local originals = {source}
        local okDesc, sourceDescendants = pcall(function() return source:GetDescendants() end)
        if okDesc then for _, obj in ipairs(sourceDescendants) do table.insert(originals, obj) end end
        local previousArchivable = {}
        for _, obj in ipairs(originals) do
            previousArchivable[obj] = obj.Archivable
            pcall(function() obj.Archivable = true end)
        end
        local cloneOk, clone = pcall(function() return source:Clone() end)
        for obj, was in pairs(previousArchivable) do pcall(function() obj.Archivable = was end) end
        if not cloneOk or not clone or not clone:IsA("Model") then
            if clone and clone.Destroy then pcall(function() clone:Destroy() end) end
            return false, "Could not clone the Stand model"
        end

        clone.Name = "TrueSightStandPreviewModel"
        local parts = {}
        local sourcePrimaryName = source.PrimaryPart and source.PrimaryPart.Name
        for _, obj in ipairs(clone:GetDescendants()) do
            if obj:IsA("BasePart") then
                local name = string.lower(obj.Name)
                local maxDimension = math.max(obj.Size.X, obj.Size.Y, obj.Size.Z)
                local protectedRoot = name == "humanoidrootpart" or name == "rootpart" or name == "standroot" or name == "root"
                local helperPart = not protectedRoot and (
                    string.find(name, "hitbox", 1, true)
                    or string.find(name, "collision", 1, true)
                    or string.find(name, "hurtbox", 1, true))
                local tooLarge = maxDimension > 120
                if helperPart or tooLarge then
                    pcall(function() obj:Destroy() end)
                else
                    -- Keep every mesh/part (even if locally hidden in the live scene),
                    -- and stabilise it before entering WorldModel so Motor6Ds cannot
                    -- snap visible pieces out of the captured Stand pose.
                    -- Preview must show the actual Stand opaque even when its live
                    -- game copy uses LocalTransparencyModifier/Transparency for fade
                    -- transitions. Keep only technical root parts hidden.
                    obj.Transparency = protectedRoot and 1 or 0
                    if not protectedRoot and (obj.Material == Enum.Material.ForceField or obj.Material == Enum.Material.Glass) then
                        obj.Material = Enum.Material.SmoothPlastic
                    end
                    obj.CanCollide = false
                    obj.CanTouch = false
                    obj.CanQuery = false
                    obj.CastShadow = false
                    obj.Massless = true
                    obj.Anchored = true
                    pcall(function() obj.LocalTransparencyModifier = 0 end)
                    table.insert(parts, obj)
                end
            elseif obj:IsA("Humanoid") or obj:IsA("Animator") or obj:IsA("AnimationController")
                or obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript")
                or obj:IsA("Constraint") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")
                or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")
                or obj:IsA("Sound") or obj:IsA("BillboardGui") or obj:IsA("Highlight") then
                pcall(function() obj:Destroy() end)
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 0
            end
        end
        if #parts == 0 then
            clone:Destroy()
            return false, "Stand model has no visible parts after filtering hidden helper geometry"
        end

        local rootPart
        if sourcePrimaryName then
            local candidate = clone:FindFirstChild(sourcePrimaryName, true)
            if candidate and candidate:IsA("BasePart") then rootPart = candidate end
        end
        if not rootPart then
            for _, part in ipairs(parts) do
                local n = string.lower(part.Name)
                if n == "humanoidrootpart" or n == "rootpart" or n == "standroot" or n == "root" then
                    rootPart = part
                    break
                end
            end
        end
        rootPart = rootPart or parts[1]

        -- Set PrimaryPart and anchors while the clone is still outside the WorldModel.
        -- All parts are static in a viewport; preserving their cloned CFrames is more
        -- reliable than letting game rigs re-solve joints in a no-physics preview.
        pcall(function() clone.PrimaryPart = rootPart end)
        for _, part in ipairs(parts) do part.Anchored = true end
        clone.Parent = previewWorld

        -- Centre only after anchoring the model, so a first physics step cannot split it.
        RunService.Heartbeat:Wait()
        local boxOk, boxCF, bounds = pcall(function()
            local cf, size = clone:GetBoundingBox()
            return cf, size
        end)
        if not boxOk or not bounds then
            clone:Destroy()
            return false, "Could not measure the Stand model"
        end
        pcall(function() clone:PivotTo(CFrame.new(-boxCF.Position) * clone:GetPivot()) end)
        RunService.Heartbeat:Wait()
        local recenterOk, recenterCF = pcall(function()
            local cf = clone:GetBoundingBox()
            return cf
        end)
        if recenterOk and recenterCF and recenterCF.Position.Magnitude > 0.1 then
            pcall(function() clone:PivotTo(CFrame.new(-recenterCF.Position) * clone:GetPivot()) end)
        end

        removePreviewModel()
        previewModel = clone
        previewBasePivot = clone:GetPivot()
        refitPreviewCamera()
        previewYaw = 0
        previewName.Text = "Stand: " .. tostring(standName)
        previewStatus.Text = "Drag the model to rotate • " .. tostring(#parts) .. " visible parts"

        previewRotationConn = RunService.Heartbeat:Connect(function(dt)
            if not previewFrame.Visible or not previewModel or not previewModel.Parent or not previewBasePivot then return end
            if previewManualDrag then
                previewAccumulator = 0
                return
            end
            previewAccumulator += dt
            if previewAccumulator < (1 / 20) then return end
            local rotateDt = previewAccumulator
            previewAccumulator = 0
            previewYaw += math.rad(14) * rotateDt
            pcall(function()
                previewModel:PivotTo(CFrame.Angles(0, previewYaw, 0) * previewBasePivot)
            end)
        end)
        return true
    end

    local function refreshStandPreview()
        if not worthinessMod or not worthinessMod.enabled then return end
        previewLoadToken += 1
        local token = previewLoadToken
        local standName = getPreviewStandName()
        previewName.Text = "Stand: " .. tostring(standName)
        removePreviewModel()

        if isNoStandName(standName) then
            previewStatus.Text = "No Stand equipped yet"
            return
        end
        previewStatus.Text = "Finding 3D model..."
        task.spawn(function()
            local lastError = "Stand model not found"
            for attempt = 1, 3 do
                if token ~= previewLoadToken or not previewFrame.Visible then return end
                local sourceOk, source = pcall(findStandPreviewSource, standName)
                if sourceOk and source then
                    local built, err = buildStandPreview(source, standName)
                    if token ~= previewLoadToken or not previewFrame.Visible then
                        if previewModel and previewModel.Parent then previewModel:Destroy() end
                        previewModel = nil
                        return
                    end
                    if built then return end
                    lastError = tostring(err or lastError)
                end
                if attempt < 3 then task.wait(0.40) end
            end
            if token == previewLoadToken and previewFrame.Visible then
                previewStatus.Text = "No 3D model found in loaded Stand assets"
                warn("[TrueSight] Stand preview: " .. lastError)
            end
        end)
    end

