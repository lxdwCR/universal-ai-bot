local function buildGhostAvatar(character)
    -- Remove the old ghost when your character respawns.
    if ghostAvatar.clone and ghostAvatar.clone.Parent then
        ghostAvatar.clone:Destroy()
    end
    ghostAvatar.clone = nil
    ghostAvatar.highlight = nil
    table.clear(ghostAvatar.parts)
    local extents = character:GetExtentsSize()
    ghostAvatar.size = Vector3.new(
        math.clamp(extents.X * 0.75, 1.2, 2.1),
        math.clamp(extents.Y * 0.85, 3.2, 4.7),
        math.clamp(extents.Z * 0.75, 0.8, 1.4)
    )
    local wasArchivable = character.Archivable
    local ok, clone = pcall(function()
        character.Archivable = true
        return character:Clone()
    end)
    character.Archivable = wasArchivable
    if not ok or not clone then
        ghostAvatar.source = character
        warn("[TrueSight] Could not clone your character for Desync Box.")
        return
    end

    clone.Name = "TrueSightDesyncChams"
    table.clear(ghostAvatar.parts)

    -- Hide hats and accessories on the ghost only; leave your real avatar alone.
    for _, item in ipairs(clone:GetDescendants()) do
        if item:IsA("Accessory") then
            item:Destroy()
        end
    end

    -- Match ghost parts by path, not child order.
    local function relativePath(root, inst)
        local names = {}
        local node = inst
        while node and node ~= root do
            table.insert(names, 1, node.Name)
            node = node.Parent
        end
        return table.concat(names, "/")
    end

    local ghostByPath = {}
    local mappedGhostParts = {}
    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("BasePart") then
            ghostByPath[relativePath(clone, obj)] = obj
        end
    end

    for _, sourcePart in ipairs(character:GetDescendants()) do
        -- Don't let excluded accessories return to the ghost.
        if sourcePart:IsA("BasePart")
            and not sourcePart:FindFirstAncestorWhichIsA("Accessory") then
            local ghostPart = ghostByPath[relativePath(character, sourcePart)]
            if ghostPart and ghostPart:IsA("BasePart") then
                mappedGhostParts[ghostPart] = true
                ghostPart.Anchored = true
                ghostPart.CanCollide = false
                ghostPart.CanTouch = false
                ghostPart.CanQuery = false
                ghostPart.CastShadow = false
                ghostPart.LocalTransparencyModifier = 0
                ghostPart.Material = Enum.Material[ghostRenderSettings.materialName] or Enum.Material.Plastic
                ghostPart.Color = accent
                -- Show either the highlight or material chams, not both.
                ghostPart.Transparency = 0.90
                table.insert(ghostAvatar.parts, {
                    source = sourcePart,
                    ghost = ghostPart,
                })
            end
        end
    end

    -- Keep only the body visuals; remove duplicate clone effects.
    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("BasePart") then
            if not mappedGhostParts[obj] then
                obj:Destroy()
            else
                obj.Anchored = true
                obj.CanCollide = false
                obj.CanTouch = false
                obj.CanQuery = false
                obj.Massless = true
                obj.CastShadow = false
                obj.Material = Enum.Material.SmoothPlastic
                obj.Color = accent
                obj.Transparency = 0.90
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture")
            or obj:IsA("SurfaceAppearance") or obj:IsA("Highlight")
            or obj:IsA("SelectionBox") or obj:IsA("ParticleEmitter")
            or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Light") or obj:IsA("BillboardGui")
            or obj:IsA("SurfaceGui") or obj:IsA("Sound") then
            obj:Destroy()
        elseif obj:IsA("JointInstance") or obj:IsA("Constraint")
            or obj:IsA("BodyMover") or obj:IsA("Humanoid") or obj:IsA("Animator")
            or obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            obj:Destroy()
        end
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "TrueSightDesyncHighlight"
    highlight.Adornee = clone
    highlight.FillColor = accent
    highlight.OutlineColor = accent
    -- Highlight mode uses fill. Material mode uses actual clone parts.
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = ghostRenderSettings.outlineTransparency
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Enabled = ghostAvatar.style ~= 2
    highlight.Parent = clone

    ghostAvatar.source = character
    ghostAvatar.clone = clone
    ghostAvatar.highlight = highlight
    clone.Parent = workspace
    ghostRenderSettings.applyVisuals()
end

local function addGhost()
    removeGhost()
    for _, oldObject in ipairs(workspace:GetChildren()) do
        if oldObject.Name == "TrueSightDesyncChams"
            or oldObject.Name == "LocalServerGhost" then
            oldObject:Destroy()
        end
    end

    local part = Instance.new("Part")
    part.Name = "LocalServerGhost"
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Transparency = 1
    part.Size = Vector3.new(1, 1, 1)
    part.Parent = workspace

    local box = Instance.new("SelectionBox")
    box.Adornee = part
    box.LineThickness = 0.04
    box.Color3 = accent
    box.SurfaceColor3 = accent
    box.SurfaceTransparency = 1
    box.Visible = false
    box.Parent = part

    local bb = Instance.new("BillboardGui")
    bb.Adornee = part
    bb.Size = UDim2.fromOffset(200, 24)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = false
    bb.Enabled = ghostLabelOn
    bb.Parent = part

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.RichText = true
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = Color3.fromRGB(235, 238, 245)
    label.TextStrokeTransparency = 0.5
    label.Text = ""
    label.Parent = bb

    ghostPart, ghostGui, ghostLabel, ghostBox = part, bb, label, box
    ghostPing = getPing()
    ghostRenderSettings.lastTick = 0
    if player.Character then buildGhostAvatar(player.Character) end

    ghostConn = RunService.Heartbeat:Connect(function()
        local now = os.clock()
        local interval = 1 / math.clamp(ghostRenderSettings.updateHz, 5, 60)
        if now - ghostRenderSettings.lastTick < interval then return end
        ghostRenderSettings.lastTick = now
        local ch = player.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if not root then
            box.Visible = false
            return
        end
        if ghostAvatar.source ~= ch or (ghostAvatar.clone and not ghostAvatar.clone.Parent) then
            buildGhostAvatar(ch)
        end
        part.Size = ghostAvatar.size

        -- Keep roughly three seconds of movement history.
        table.insert(ghostTimes, now)
        table.insert(ghostPos, root.CFrame)
        while #ghostTimes > 1 and ghostTimes[1] < now - 3 do
            table.remove(ghostTimes, 1)
            table.remove(ghostPos, 1)
        end

        -- Show the position from about half a ping ago.
        local target = now - ghostPing / 2000
        local est = root.CFrame
        for i = #ghostTimes, 1, -1 do
            if ghostTimes[i] <= target then
                local j = ghostTimes[i + 1] and i + 1 or i
                local t0, t1 = ghostTimes[i], ghostTimes[j]
                local a = t1 > t0 and (target - t0) / (t1 - t0) or 0
                est = ghostPos[i]:Lerp(ghostPos[j], a)
                break
            end
        end

        part.CFrame = est * CFrame.new(0, -0.35, 0)
        -- Style: 1 chams, 2 box, 3 both.
        box.Visible = (ghostAvatar.style == 2 or ghostAvatar.style == 3)
        if ghostAvatar.highlight then
            ghostAvatar.highlight.Enabled = (ghostAvatar.style ~= 2)
        end
        -- Refresh the look when settings change, not every frame.
        local offset = est * root.CFrame:Inverse()
        for _, pair in ipairs(ghostAvatar.parts) do
            if pair.source.Parent and pair.ghost.Parent then
                pair.ghost.CFrame = offset * pair.source.CFrame
            end
        end
        local dist = (est.Position - root.Position).Magnitude

        if now - ghostLastUi > 0.25 then
            ghostLastUi = now
            ghostPing = getPing()
            label.Text = string.format(
                '<font color="#%s">DESYNC ESTIMATE</font>  %d ms  |  %.1f studs',
                accent:ToHex(), math.floor(ghostPing + 0.5), dist)
        end
    end)
end

