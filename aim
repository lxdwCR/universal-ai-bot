    -- Reuse the installed YBA-specific filter from the last session, if present. Hook wrappers
    -- cannot reliably be uninstalled within the same game session; keep a single wrapper and switch
    -- off interception on TrueSight unload.
    local teleportFilterState
    do
        local ok, env = pcall(function()
            return type(getgenv) == "function" and getgenv() or _G
        end)
        if ok and type(env) == "table" then
            local key = "__TrueSightYBAReturnerFilterV1"
            local existing = rawget(env, key)
            if type(existing) == "table" and existing.signature == "TrueSightYBAReturnerFilterV1" then
                teleportFilterState = existing
            else
                teleportFilterState = { signature = "TrueSightYBAReturnerFilterV1",
                    installed = false, enabled = false, intercepted = 0, previous = nil }
                rawset(env, key, teleportFilterState)
            end
        end
    end
    if teleportFilterState then teleportFilterState.enabled = false end
    local function enableTeleportFilter()
        if not teleportFilterState then return false, "Executor environment unavailable" end
        if teleportFilterState.installed then
            if type(teleportFilterState.previous) ~= "function" then
                return false, "Previous hook missing"
            end
            teleportFilterState.enabled = true
            return true
        end
        if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function"
            or type(checkcaller) ~= "function" then
            return false, "Missing executor hook functions"
        end
        local state = teleportFilterState
        local function wrappedNamecall(self, ...)
            if state.enabled then
                local ok, executorCaller = pcall(checkcaller)
                if ok and not executorCaller then
                    local methodOK, method = pcall(getnamecallmethod)
                    if methodOK and (method == "InvokeServer" or method == "FireServer") then
                        if select(1, ...) == "idklolbrah2de" and tostring(self) == "Returner" then
                            state.intercepted = (state.intercepted or 0) + 1
                            return "  ___XP DE KEY"
                        end
                    end
                end
            end
            return state.previous(self, ...)
        end
        local callback = wrappedNamecall
        if type(newcclosure) == "function" then
            local ok, converted = pcall(newcclosure, wrappedNamecall)
            if ok and type(converted) == "function" then callback = converted end
        end
        local ok, previous = pcall(hookmetamethod, game, "__namecall", callback)
        if not ok or type(previous) ~= "function" then
            state.enabled = false
            return false, ok and "Unable to capture original hook" or tostring(previous)
        end
        state.previous = previous
        state.installed = true
        state.enabled = true
        return true
    end
    modules._cleanupYBATeleportFilter = function()
        if teleportFilterState then teleportFilterState.enabled = false end
    end

    -- Use exactly the successful v19 combination: filter + root CFrame.
    local function teleportOnce(character, afterRespawn)
        if modules._unloaded or not character or character ~= player.Character then return end
        local point = spawnPosition()
        if not point then status.Text = "Select a spawn first."; return end
        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then
            status.Text = "Character not ready."
            return
        end
        local enabled, reason = enableTeleportFilter()
        if not enabled then
            status.Text = "Teleport unavailable: " .. string.sub(tostring(reason), 1, 90)
            return
        end
        local exactPad = spawnState.target and spawnState.target.Parent
            and spawnState.target:IsA("SpawnLocation") and spawnState.target or nil
        local extra = exactPad and (exactPad.Size.Y * 0.5 + 3) or
            (spawnState.id == "Custom position" and 0 or 3.5)
        local dest = point + Vector3.new(0, extra, 0)
        local start = root.Position
        local previousHits = teleportFilterState.intercepted or 0
        spawnState.testToken += 1
        local token = spawnState.testToken
        local ok, err = pcall(function()
            root.CFrame = CFrame.new(dest) * root.CFrame.Rotation
        end)
        if not ok then
            status.Text = "Teleport failed: " .. string.sub(tostring(err), 1, 90)
            return
        end
        status.Text = (afterRespawn and "Respawn" or "Teleport") .. ": checking position…"
        task.delay(3, function()
            if modules._unloaded or spawnState.testToken ~= token or player.Character ~= character
                or not root.Parent then return end
            local remaining = (root.Position - dest).Magnitude
            local fromStart = (root.Position - start).Magnitude
            local hits = math.max(0, (teleportFilterState.intercepted or 0) - previousHits)
            if remaining < 12 then
                status.Text = string.format("Teleport stable  •  3s  •  Filter hits %d", hits)
            elseif fromStart < 18 then
                status.Text = "Snapback detected."
            else
                status.Text = string.format("Moved %.0f studs from target.", remaining)
            end
        end)
    end
    local function scheduleRespawn(character)
        if modules._unloaded or not spawnState.auto or not spawnPosition() then return end
        spawnState.spawnToken += 1
        local token = spawnState.spawnToken
        task.spawn(function()
            local elapsed = 0
            while elapsed < 4 and not modules._unloaded and token == spawnState.spawnToken
                and player.Character == character and not (character:FindFirstChild("HumanoidRootPart")
                and character:FindFirstChildOfClass("Humanoid")) do
                task.wait(0.1)
                elapsed += 0.1
            end
            if modules._unloaded or token ~= spawnState.spawnToken or player.Character ~= character then return end
            task.wait(spawnState.waitSeconds)
            if modules._unloaded or token ~= spawnState.spawnToken or not spawnState.auto
                or player.Character ~= character then return end
            teleportOnce(character, true)
        end)
    end

