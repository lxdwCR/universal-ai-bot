    -- Retain the v20 config key, translating v20's mode 3 into "On".
    registerConfig("Preferred Spawn/Respawn Behaviour", function()
        return spawnState.auto and 3 or 2
    end, function(value)
        spawnState.auto = value == 3
        autoCycle.set(spawnState.auto and 2 or 1)
