local skyboxId = ""
local skyboxTarget
local skyboxCreated = false
local skyboxOriginal = {}
local function normalizeSkyboxId(value)
    value = string.gsub(value, "^%s*(.-)%s*$", "%1")
    if value == "" then return "" end
    if string.match(value, "^%d+$") then return "rbxassetid://" .. value end
    return value
end
local function applySkybox()
    local assets = {}
    for value in string.gmatch(skyboxId, "[^,]+") do
        local asset = normalizeSkyboxId(value)
        if asset ~= "" then table.insert(assets, asset) end
    end
    if #assets ~= 1 and #assets ~= 6 then return end
    if not skyboxTarget or not skyboxTarget.Parent then
        skyboxTarget = Lighting:FindFirstChildOfClass("Sky")
        if skyboxTarget then
            for _, face in ipairs(skyboxFaces) do
                skyboxOriginal[face] = skyboxTarget[face]
            end
        else
            skyboxTarget = Instance.new("Sky")
            skyboxTarget.Name = "TrueSightSky"
            skyboxCreated = true
            skyboxTarget.Parent = Lighting
        end
    end
    for i, face in ipairs(skyboxFaces) do
        skyboxTarget[face] = assets[#assets == 1 and 1 or i]
    end
end
local function restoreSkybox()
    if not skyboxTarget then return end
    if skyboxCreated then
        if skyboxTarget.Parent then skyboxTarget:Destroy() end
    elseif skyboxTarget.Parent then
        for _, face in ipairs(skyboxFaces) do
            if skyboxOriginal[face] then skyboxTarget[face] = skyboxOriginal[face] end
        end
    end
    skyboxTarget = nil
    skyboxCreated = false
    table.clear(skyboxOriginal)
end
