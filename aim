-- Visible-only player labels. YBA's stand state is not a public Roblox API, so stand detection
-- checks common attributes/values and stand model names.
local nameTagObjects = {}
local nameTagLoop
local nameTagsMod

-- Avoid treating keybinds (for example Q or Tab) as stand names. YBA may expose control/keybind
-- values alongside other character/player values.
local invalidStandTokens = {
    q=true, w=true, e=true, r=true, t=true, y=true, u=true, i=true, o=true, p=true,
    a=true, s=true, d=true, f=true, g=true, h=true, j=true, k=true, l=true,
    z=true, x=true, c=true, v=true, b=true, n=true, m=true,
    tab=true, shift=true, leftshift=true, rightshift=true,
    ctrl=true, control=true, leftcontrol=true, rightcontrol=true,
    alt=true, leftalt=true, rightalt=true, space=true, escape=true, esc=true,
    enter=true, ["return"]=true, backspace=true, capslock=true,
    mousebutton1=true, mousebutton2=true, mousebutton3=true,
    unknown=true, none=true, ["nil"]=true, na=true, notavailable=true,
    stand=true, standname=true, currentstand=true, standtype=true,
    default=true, summon=true, desummon=true,
}

local function normalizeStandCandidate(value)
    if typeof(value) == "Instance" then
        value = value.Name
    end
    if type(value) ~= "string" then return nil end
    value = value:gsub("^%s+", ""):gsub("%s+$", "")
    if value == "" or #value > 48 then return nil end

    local compact = string.lower(value)
    compact = compact:gsub("^enum%.keycode%.", ""):gsub("^keycode%.", "")
    compact = compact:gsub("[%s_%-%.]", "")
    if invalidStandTokens[compact] or string.match(compact, "^%d+$") then
        return nil
    end
    -- Single-letter labels are almost always keybinds, not YBA stand names.
    if #compact == 1 and string.match(compact, "^[%a]$") then return nil end
    return value
end
