    local function tickSharedSPOHFX(entry,now)
        local fx = entry.fx
        if not fx or not entry.skin or not entry.skin.Parent then return end
        local beamActive = now >= fx.fingerStart and now < fx.fingerEnd
            and fx.fingerEnd > 0
        fx.inner.Enabled,fx.outer.Enabled = beamActive,beamActive
        if beamActive and fx.origin.Parent and fx.target.Parent then
            local length = math.clamp((now-fx.fingerStart-0.01)/0.13,0.03,1)
            if fx.fingerEnd-now < 0.12 then
                length *= math.clamp((fx.fingerEnd-now)/0.12,0.03,1)
            end
            local body = entry.skin:FindFirstChild("HumanoidRootPart")
                or entry.skin:FindFirstChild("UpperTorso")
            local from = fx.origin.WorldPosition
            local forward = body and body.CFrame.LookVector or fx.origin.WorldCFrame.LookVector
            fx.target.CFrame = CFrame.new(from+forward*(9.5*length))
        end
        if now - fx.lastPoll > 0.16 then
            fx.lastPoll = now
            fx.actionTrack = false
            if fx.sourceAnimator and fx.sourceAnimator.Parent then
                pcall(function()
                    for _, track in ipairs(fx.sourceAnimator:GetPlayingAnimationTracks()) do
                        fx.onTrack(track)
                        if track.Priority.Value >= Enum.AnimationPriority.Action.Value then
                            fx.actionTrack = true
                        end
                    end
                end)
            end
            -- Only show remote kick FX when both legs move during a real animation.
            if now-fx.lastMotion > 0.16 then
                fx.lastMotion = now
                local moved = 0
                for joint,last in pairs(fx.legRest) do
                    if joint.Parent then
                        local delta = last:ToObjectSpace(joint.Transform)
                        local _,angle = delta:ToAxisAngle()
                        if math.abs(angle)>0.42 then moved+=1 end
                        fx.legRest[joint]=joint.Transform
                    end
                end
                if moved>=3 then
                    fx.legMotion += 1
                else
                    fx.legMotion = math.max(0,fx.legMotion-1)
                end
                if fx.legMotion>=2 and fx.actionTrack and fx.barrageEnd<=now then
                    fx.kickEnd = math.max(fx.kickEnd,now+0.25)
                end
            end
        end
        if fx.barrageEnd>now and now-fx.lastBarragePulse>0.12 then
            fx.lastBarragePulse = now
            if fx.leftSparks then fx.leftSparks:Emit(1) end
            if fx.rightSparks then fx.rightSparks:Emit(1) end
        end
        local kicking = fx.kickEnd>now
        for _,trail in ipairs(fx.kickTrails or {}) do
            if trail.Parent then trail.Enabled = kicking end
        end
        if kicking and now-fx.lastKickPulse>0.2 then
            fx.lastKickPulse=now
            for _,emitter in ipairs(fx.kickSparks) do
                if emitter.Parent then emitter:Emit(1) end
            end
        end
    end
