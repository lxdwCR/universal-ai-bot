            local sourceAnimator = morph:FindFirstChildWhichIsA("Animator", true)
            local targetAnimator = humanoid:FindFirstChildWhichIsA("Animator")
            if not targetAnimator then
                targetAnimator = Instance.new("Animator")
                targetAnimator.Parent = humanoid
            end
            if sourceAnimator and (not isSpoh or #entry.mirrors < 10) then
                local function playCopy(source)
                    if not entry.skin or entry.tracks[source] then return end
                    local count = 0
                    for _ in pairs(entry.tracks) do count += 1 end
                    if count >= 4 then return end
