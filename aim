    b.Parent = parent
    return {
        button = b,
        set = function(i)
            idx = i
            refresh()
        end,
    }
end

-- Slider widget
local function addSlider(parent, label, minV, maxV, value, step, onChange, key)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 34)
    f.BackgroundColor3 = SUB
    f.BorderSizePixel = 0

    local t = Instance.new("TextLabel")
    t.Position = UDim2.fromOffset(18, 3)
    t.Size = UDim2.new(1, -24, 0, 16)
    t.BackgroundTransparency = 1
    t.Font = FONT
    t.TextSize = 12
    t.TextColor3 = DIM
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = f

    local track = Instance.new("Frame")
    track.Position = UDim2.fromOffset(18, 24)
    track.Size = UDim2.new(1, -36, 0, 4)
    track.BackgroundColor3 = Color3.fromRGB(45, 48, 58)
    track.BorderSizePixel = 0
    track.Parent = f
    corner(track, 2)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 2)
    onAccent(function(c) fill.BackgroundColor3 = c end)

    local cur = value
    local function show(v)
        cur = v
        local pct = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        t.Text = label .. ": " .. string.format("%g", v)
    end
    show(value)

    local function setFromX(x)
        local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = minV + pct * (maxV - minV)
        v = math.floor(v / step + 0.5) * step
        v = math.clamp(v, minV, maxV)
        show(v)
        onChange(v)
        requestSave()
    end

    f.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = setFromX
            setFromX(input.Position.X)
        end
    end)

    if key then
        registerConfig(key, function() return cur end, function(v)
            if type(v) == "number" then
                v = math.clamp(v, minV, maxV)
                show(v)
                onChange(v)
            end
        end)
    end

    f.Parent = parent
    return f
end

-- Module row (left-click toggle, right-click settings)
local function addModule(panel, name, onToggle)
    local mod = {name = name, enabled = false, keybind = nil}

    local holder = Instance.new("Frame")
    holder.LayoutOrder = nextOrder(panel)
    holder.Size = UDim2.new(1, 0, 0, 0)
    holder.AutomaticSize = Enum.AutomaticSize.Y
    holder.BackgroundTransparency = 1
    holder.Parent = panel.frame
    mod.holder = holder
    mod.panel = panel.frame
    vlist(holder)

    local btn = Instance.new("TextButton")
    btn.LayoutOrder = 0
    btn.Size = UDim2.new(1, 0, 0, 28)
    styleButton(btn)
    btn.Text = "   " .. name
    btn.Parent = holder

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, 0)
    bar.BorderSizePixel = 0
    bar.Visible = false
    bar.Parent = btn

    local settings = Instance.new("Frame")
    settings.LayoutOrder = 1
    settings.Size = UDim2.new(1, 0, 0, 0)
    settings.AutomaticSize = Enum.AutomaticSize.Y
    settings.BackgroundColor3 = SUB
    settings.BorderSizePixel = 0
    settings.Visible = false
    settings.Parent = holder
    vlist(settings)

    local arrow
    local function markSettings()
        if mod.hasSettings then return end
        mod.hasSettings = true
        arrow = Instance.new("TextLabel")
        arrow.AnchorPoint = Vector2.new(1, 0)
        arrow.Position = UDim2.new(1, -6, 0, 0)
        arrow.Size = UDim2.fromOffset(20, 28)
        arrow.BackgroundTransparency = 1
        arrow.Font = FONTB
        arrow.TextSize = 14
        arrow.TextColor3 = DIM
        arrow.Text = "+"
        arrow.Parent = btn
    end

    local function refresh()
        btn.TextColor3 = mod.enabled and accent or DIM
        bar.Visible = mod.enabled
        bar.BackgroundColor3 = accent
    end

    function mod.set(on)
        if mod.enabled == on then return end
        mod.enabled = on
        refresh()
        local ok, err = pcall(onToggle, on)
        if not ok then
            warn("[TrueSight] " .. name .. ": " .. tostring(err))
        end
        refreshArray()
        requestSave()
    end

    function mod.cycle(label, options, start, onChange)
        markSettings()
        return addCycle(settings, label, options, start, onChange, name .. "/" .. label)
    end

    function mod.slider(label, minV, maxV, value, step, onChange)
        markSettings()
        return addSlider(settings, label, minV, maxV, value, step, onChange, name .. "/" .. label)
    end

    local bindButton = Instance.new("TextButton")
    bindButton.LayoutOrder = 99
    bindButton.Size = UDim2.new(1, 0, 0, 25)
    styleButton(bindButton)
    bindButton.BackgroundColor3 = SUB
    bindButton.TextSize = 12
    bindButton.Parent = settings
    local function refreshBindButton()
        bindButton.Text = "      Keybind:  "
            .. (mod.keybind and mod.keybind.Name or "None")
            .. (keyUiState.bindingModule == mod and "  (press a key)" or "")
    end
    mod.refreshBindButton = refreshBindButton
    bindButton.MouseButton1Click:Connect(function()
        keyUiState.binding = true
        keyUiState.bindingModule = mod
        refreshBindButton()
        hint.Text = "Press a key to bind " .. name .. "  |  Esc cancels"
    end)
    markSettings()
    registerConfig(name .. "/Keybind", function()
        return mod.keybind and mod.keybind.Name or ""
    end, function(value)
        if type(value) == "string" and value ~= "" then
            local ok, key = pcall(function() return Enum.KeyCode[value] end)
            mod.keybind = ok and key or nil
        else
            mod.keybind = nil
        end
        refreshBindButton()
    end)
    refreshBindButton()

    btn.MouseButton1Click:Connect(function() mod.set(not mod.enabled) end)
    btn.MouseButton2Click:Connect(function()
        if mod.hasSettings then
            settings.Visible = not settings.Visible
            arrow.Text = settings.Visible and "-" or "+"
        end
    end)

    onAccent(function() refresh() end)
    table.insert(modules, mod)
    return mod
end

