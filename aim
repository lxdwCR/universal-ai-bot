            if not spohBarrageEnabled or settings.barrage.enabled == false then return end
            local focused = UserInputService:GetFocusedTextBox()
            local down = focused == nil and UserInputService:IsKeyDown(Enum.KeyCode.E)
            if now - lastTrackCheck > 0.16 then
                lastTrackCheck = now
                barrageTrack = false
                kickState.tracked = false
                if sourceAnimator and sourceAnimator.Parent then
                    pcall(function()
                        for _, track in ipairs(sourceAnimator:GetPlayingAnimationTracks()) do
                            local name = tostring(track.Name or ""):lower()
                            local animName = track.Animation and tostring(track.Animation.Name or ""):lower() or ""
                            local full = name .. " " .. animName
                            if trackKind(track) == "kick" then
                                kickState.tracked = true
                                kickState.untilTime = now + 0.28
                            elseif full:find("barrage", 1, true) then
                                barrageTrack = true
                            end
                        end
                    end)
                end
            end
            if down or barrageTrack then barrageUntil = now + 0.3 end
            if (down or barrageTrack) and now - lastPulse >= math.clamp(
                tonumber(settings.barrage.pulse_interval) or 0.085, 0.11, 0.22) then
                lastPulse = now
                for _, emitter in ipairs(emitters) do
                    if emitter.Parent then emitter:Emit(1) end
                end
            end
            if (kickState.tracked or kickState.untilTime > now)
                and now - kickState.pulse > 0.18 then
                kickState.pulse = now
                for _, emitter in ipairs(kickEmitters) do
                    if emitter.Parent then emitter:Emit(1) end
                end
            end
        end)
    end
    local function status(message)
        if notifyConfig then notifyConfig("Skin Changer: " .. message, false) end
    end
    local function disconnectAll()
        for _, conn in ipairs(watchers) do pcall(function() conn:Disconnect() end) end
        table.clear(watchers)
    end
    local function restoreSkin()
        spohClearFX()
        spohRestoreOtherAura()
        -- Disconnect animation and render callbacks before removing the skin.
        if visualFollowBound then
            pcall(function() RunService:UnbindFromRenderStep(visualFollowStepName) end)
            visualFollowBound = false
        end
        if visualPoseConnection then
            pcall(function() visualPoseConnection:Disconnect() end)
            visualPoseConnection = nil
        end
        -- Remove our weld without touching YBA's own joints.
        if visualStandWeld then
            pcall(function() visualStandWeld:Destroy() end)
            visualStandWeld = nil
        end
        for _, connection in ipairs(standCollisionConnections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(standCollisionConnections)
        for _, connection in ipairs(skinCollisionConnections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(skinCollisionConnections)
        -- Restore the stand's collision settings on disable.
        -- Leave hitbox touch/query settings alone.
        for part, originallyCollidable in pairs(savedStandCollisions) do
            if part and part.Parent then
                pcall(function() part.CanCollide = originallyCollidable end)
            end
            savedStandCollisions[part] = nil
        end
        for _, connection in ipairs(standAnimationConnections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(standAnimationConnections)
        for sourceTrack, destinationTrack in pairs(activeStandTracks) do
            pcall(function() destinationTrack:Stop(0) end)
            pcall(function() destinationTrack:Destroy() end)
            activeStandTracks[sourceTrack] = nil
        end
        -- Stop hiding the original stand before restoring its properties.
        for _, connection in ipairs(originalVisualConnections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(originalVisualConnections)
        if visualRoot then visualRoot:Destroy(); visualRoot = nil end
        for obj, original in pairs(savedVisibility) do
            if obj and obj.Parent then
                pcall(function()
                    if original.kind == "part" then
                        obj.Transparency = original.transparency
                        obj.LocalTransparencyModifier = original.modifier
                    elseif original.kind == "texture" then
                        obj.Transparency = original.transparency
                    elseif original.kind == "effect" then
                        obj.Enabled = original.enabled
                    end
                end)
            end
            savedVisibility[obj] = nil
        end
        currentMorph = nil
    end
    local function findMorph()
        local living = workspace:FindFirstChild("Living")
        local owner = living and living:FindFirstChild(player.Name)
        local ch = player.Character
        -- Use the live summoned StandMorph, not the storage template.
        local containers = {}
        if owner then table.insert(containers, owner) end
        if ch and ch ~= owner then table.insert(containers, ch) end
        for _, container in ipairs(containers) do
            if container then
                local stand = container:FindFirstChild("StandMorph", true)
                if stand and stand:IsA("Model") and stand:IsDescendantOf(workspace) then
                    return stand
                end
            end
        end
        return nil
    end
    -- YBA sometimes puts arm and head meshes inside folders, not parts.
    local function normalizedPartName(value)
        local clean = string.lower(tostring(value or "")):gsub("[^%w]", "")
        return clean
    end
    local bodyAliases = {
        head = "head", torso = "torso", uppertorso = "uppertorso", lowertorso = "lowertorso",
        leftarm = "leftarm", leftupperarm = "leftupperarm", leftlowerarm = "leftlowerarm", lefthand = "lefthand",
        rightarm = "rightarm", rightupperarm = "rightupperarm", rightlowerarm = "rightlowerarm", righthand = "righthand",
        leftleg = "leftleg", leftupperleg = "leftupperleg", leftlowerleg = "leftlowerleg", leftfoot = "leftfoot",
        rightleg = "rightleg", rightupperleg = "rightupperleg", rightlowerleg = "rightlowerleg", rightfoot = "rightfoot",
    }
    local sourceAlternates = {
        UpperTorso = {"uppertorso", "torso"}, LowerTorso = {"lowertorso", "torso", "uppertorso"},
        LeftUpperArm = {"leftupperarm", "leftarm"}, LeftLowerArm = {"leftlowerarm", "leftarm", "leftupperarm"},
        LeftHand = {"lefthand", "leftarm", "leftlowerarm", "leftupperarm"},
        RightUpperArm = {"rightupperarm", "rightarm"}, RightLowerArm = {"rightlowerarm", "rightarm", "rightupperarm"},
        RightHand = {"righthand", "rightarm", "rightlowerarm", "rightupperarm"},
        LeftUpperLeg = {"leftupperleg", "leftleg"}, LeftLowerLeg = {"leftlowerleg", "leftleg", "leftupperleg"},
        LeftFoot = {"leftfoot", "leftleg", "leftlowerleg", "leftupperleg"},
        RightUpperLeg = {"rightupperleg", "rightleg"}, RightLowerLeg = {"rightlowerleg", "rightleg", "rightupperleg"},
        RightFoot = {"rightfoot", "rightleg", "rightlowerleg", "rightupperleg"},
        ["Left Arm"] = {"leftarm", "leftupperarm"}, ["Right Arm"] = {"rightarm", "rightupperarm"},
        ["Left Leg"] = {"leftleg", "leftupperleg"}, ["Right Leg"] = {"rightleg", "rightupperleg"},
        Torso = {"torso", "uppertorso", "lowertorso"}, Head = {"head"},
    }
    local function anatomicalGroup(name)
        return bodyAliases[normalizedPartName(name)]
    end
    local function visibleStandPart(part)
        if not part:IsA("BasePart") or part.Transparency >= 0.995 then return false end
        local n = normalizedPartName(part.Name)
        if n == "humanoidrootpart" or n == "rootpart" or n == "primarypart"
            or n:find("hitbox", 1, true) or n:find("hurtbox", 1, true)
            or n:find("collision", 1, true) or n:find("effect", 1, true)
            or n:find("projectile", 1, true) then return false end
        local size = part.Size
        return size.X >= 0.04 and size.Y >= 0.04 and size.Z >= 0.04
            and size.Magnitude < 80
    end
    local function standBodyData(morph)
        local visible = {}
        local buckets = {}
        for _, part in ipairs(morph:GetDescendants()) do
            if visibleStandPart(part) and not (visualRoot and part:IsDescendantOf(visualRoot)) then
                table.insert(visible, part)
                -- Look inside named limb folders for the real part.
                local node = part
                while node and node ~= morph do
                    local group = anatomicalGroup(node.Name)
                    if group then
                        buckets[group] = buckets[group] or {}
                        table.insert(buckets[group], part)
                        break
                    end
                    node = node.Parent
                end
            end
        end
        local chosen, centres = {}, {}
        for group, parts in pairs(buckets) do
            local best, bestScore
            local total, weighted = 0, Vector3.zero
            for _, part in ipairs(parts) do
                local sz = part.Size
                local volume = sz.X * sz.Y * sz.Z
                -- Ignore tiny decorations when choosing limb anchors.
                local weight = math.clamp(math.sqrt(volume), 0.03, 2)
                total += weight
                weighted += part.Position * weight
                local score = volume
                if part:IsA("Part") then score *= 1.2 end
                if not bestScore or score > bestScore then
                    best, bestScore = part, score
                end
            end
            chosen[group] = best
            if best and total > 0 then
                -- Calculate the offset once and follow the moving limb.
                local localOffset = best.CFrame:PointToObjectSpace(weighted / total)
                if localOffset.Magnitude > 2.5 then localOffset = localOffset.Unit * 2.5 end
                centres[group] = localOffset
            end
        end
        return visible, chosen, centres, buckets
    end
    local function selectBone(chosen, sourceName)
        local keys = sourceAlternates[sourceName]
            or {normalizedPartName(sourceName)}
        for _, key in ipairs(keys) do
            local part = chosen[key]
            if part and part.Parent then return part, key end
        end
        return nil, nil
    end
    local function fallbackGroup(name)
        local lower = normalizedPartName(name)
        if lower == "head" then return "head" end
        if lower:find("torso", 1, true) then return "torso" end
        if lower:find("left", 1, true) and (lower:find("arm", 1, true) or lower:find("hand", 1, true)) then return "leftarm" end
        if lower:find("right", 1, true) and (lower:find("arm", 1, true) or lower:find("hand", 1, true)) then return "rightarm" end
        if lower:find("left", 1, true) and (lower:find("leg", 1, true) or lower:find("foot", 1, true)) then return "leftleg" end
        if lower:find("right", 1, true) and (lower:find("leg", 1, true) or lower:find("foot", 1, true)) then return "rightleg" end
        return nil
    end
    local function fallbackAnatomy(parts)
        -- Only transfer poses when the stand has enough separate limbs.
        if #parts < 5 then return {} end
        local cf
        local largest = -1
        for _, part in ipairs(parts) do
            local sz = part.Size
            local v = sz.X * sz.Y * sz.Z
            if v > largest then largest = v; cf = part.CFrame end
        end
        if not cf then return {} end
        local minX, minY, minZ = math.huge, math.huge, math.huge
        local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
        local positions = {}
        for _, part in ipairs(parts) do
            local pt = cf:PointToObjectSpace(part.Position)
            positions[part] = pt
            minX, minY, minZ = math.min(minX, pt.X), math.min(minY, pt.Y), math.min(minZ, pt.Z)
            maxX, maxY, maxZ = math.max(maxX, pt.X), math.max(maxY, pt.Y), math.max(maxZ, pt.Z)
        end
        local centre = Vector3.new((minX + maxX) * 0.5, (minY + maxY) * 0.5, (minZ + maxZ) * 0.5)
        local w, h, d = math.max(maxX - minX, 0.5), math.max(maxY - minY, 0.5), math.max(maxZ - minZ, 0.5)
        local targets = {
            head = Vector3.new(0, 0.43, 0), torso = Vector3.new(0, 0.09, 0),
            leftarm = Vector3.new(-0.32, 0.11, 0), rightarm = Vector3.new(0.32, 0.11, 0),
            leftleg = Vector3.new(-0.15, -0.32, 0), rightleg = Vector3.new(0.15, -0.32, 0),
        }
        local used, result = {}, {}
        for _, name in ipairs({"head", "torso", "leftarm", "rightarm", "leftleg", "rightleg"}) do
            local best, score
            for _, part in ipairs(parts) do
                if not used[part] then
                    local pt = positions[part] - centre
                    local unit = Vector3.new(pt.X / w, pt.Y / h, pt.Z / d)
                    local distance = (unit - targets[name]).Magnitude
                    -- Don't use one large mesh as the anchor for every limb.
                    if not score or distance < score then best, score = part, distance end
                end
            end
            if best and score < 0.55 then result[name] = best; used[best] = true end
        end
        return result
    end
    local function sourceAnchor(avatar, source, group)
        local preferred = {
            head = "Head", torso = "UpperTorso", leftarm = "LeftUpperArm",
            rightarm = "RightUpperArm", leftleg = "LeftUpperLeg", rightleg = "RightUpperLeg",
        }
        local anchor = avatar:FindFirstChild(preferred[group] or "")
        if not (anchor and anchor:IsA("BasePart")) then
            local r6 = {torso="Torso", leftarm="Left Arm", rightarm="Right Arm", leftleg="Left Leg", rightleg="Right Leg"}
            anchor = avatar:FindFirstChild(r6[group] or "")
        end
        if anchor and anchor:IsA("BasePart") and anchor ~= source then
            return anchor.CFrame:ToObjectSpace(source.CFrame)
        end
        return nil
    end
    -- Clone visuals only. Leave the game's stand rig in charge.
    local function linkVisual(source, bone, parent, relative, sizeFactor)
        if not source or not bone or not bone.Parent then return nil end
        local cloned = source:Clone()
        cloned.Name = "TrueSightAvatar_" .. source.Name
        for _, descendant in ipairs(cloned:GetDescendants()) do
            if descendant:IsA("JointInstance") or descendant:IsA("WeldConstraint")
                or descendant:IsA("Script") or descendant:IsA("LocalScript")
                or descendant:IsA("ModuleScript") then
                descendant:Destroy()
            end
        end
        local factor = sizeFactor or scale
        cloned.Anchored = false
        cloned.CanCollide = false
        cloned.CanTouch = false
        cloned.CanQuery = false
        cloned.Massless = true
        cloned.CastShadow = false
        cloned.Size = source.Size * factor
        -- Scale mesh details and attachments along with the part.
        for _, desc in ipairs(cloned:GetDescendants()) do
            if desc:IsA("Attachment") then
                desc.Position *= factor
            elseif desc:IsA("SpecialMesh") then
                desc.Scale *= factor
                desc.Offset *= factor
            end
        end
        cloned.CFrame = bone.CFrame * (relative or CFrame.identity)
        cloned.Parent = parent
        local weld = Instance.new("WeldConstraint")
        weld.Name = "TrueSightSkinWeld"
        weld.Part0 = bone
        weld.Part1 = cloned
        weld.Parent = cloned
        return cloned
    end

    local function getStandOrientation(morph, chosen)
        local root = morph:FindFirstChild("HumanoidRootPart", true)
        if not (root and root:IsA("BasePart")) then
            local ch = player.Character
            root = ch and ch:FindFirstChild("HumanoidRootPart")
        end
        if root and root:IsA("BasePart") then return root.CFrame.Rotation end
        local torso = chosen.torso or chosen.uppertorso
        return (torso and torso.CFrame.Rotation) or morph:GetPivot().Rotation
    end

    local function getFittedScale(avatar, chosen)
        if fitMode == "Compact" then return 0.7 * scale end
        if fitMode == "Original Size" then return scale end
        local aHead = avatar:FindFirstChild("Head")
        local aTorso = avatar:FindFirstChild("UpperTorso") or avatar:FindFirstChild("Torso")
        local sHead, sTorso = chosen.head, chosen.uppertorso or chosen.torso
        -- Use distances between limb centres, not armour sizes.
        if aHead and aTorso and sHead and sTorso then
            local aDistance = (aHead.Position - aTorso.Position).Magnitude
            local sDistance = (sHead.Position - sTorso.Position).Magnitude
            if aDistance > 0.3 and sDistance > 0.3 then
                return math.clamp(sDistance / aDistance, 0.62, 0.92) * scale
            end
        end
        return 0.82 * scale
    end

    local function renderAccessories(avatar, accessoryAvatar, bodyClones, root, fittedScale)
        if not wantAccessories then return 0, 0 end
        -- Use the R15 avatar description to fill in missing accessories.
        accessoryAvatar = accessoryAvatar or avatar
        local byName = {}
        local attachmentTargets = {}
        for original, cloned in pairs(bodyClones) do
            byName[original.Name] = cloned
            for _, node in ipairs(cloned:GetDescendants()) do
                if node:IsA("Attachment") and not attachmentTargets[node.Name] then
                    attachmentTargets[node.Name] = {part = cloned, node = node}
                end
            end
        end
        local rendered, discovered = 0, 0
        for _, obj in ipairs(accessoryAvatar:GetChildren()) do
            if obj:IsA("Accessory") then
                discovered += 1
                if rendered < 16 then
                    local handle = obj:FindFirstChild("Handle")
                    if handle and handle:IsA("BasePart") then
                        local anchor, intended
                        for _, att in ipairs(handle:GetChildren()) do
                            if att:IsA("Attachment") then
                                local target = attachmentTargets[att.Name]
                                if target then
                                    anchor = target.part
                                    -- Attachments are already scaled; adjust the accessory offset here.
                                    local scaledHandleAttach = CFrame.new(att.Position * fittedScale) * att.CFrame.Rotation
                                    intended = target.node.CFrame * scaledHandleAttach:Inverse()
                                    break
                                end
                            end
                        end
                        if not anchor then
                            -- Place older hats relative to the head when attachments are missing.
                            local kind = tostring(obj.AccessoryType)
                            local upper = kind:find("Back") or kind:find("Front")
                                or kind:find("Waist") or kind:find("Shoulder")
                            local preferred = upper and (byName.UpperTorso or byName.Torso) or byName.Head
                            anchor = preferred
                            local partName = upper and (accessoryAvatar:FindFirstChild("UpperTorso")
                                and "UpperTorso" or "Torso") or "Head"
                            local originalPart = accessoryAvatar:FindFirstChild(partName)
                            if anchor and originalPart and originalPart:IsA("BasePart") then
                                local oldWeld = handle:FindFirstChild("AccessoryWeld")
                                if oldWeld and oldWeld:IsA("Weld") and oldWeld.Part1 == originalPart then
                                    intended = oldWeld.C1 * oldWeld.C0:Inverse()
                                else
                                    local rel = originalPart.CFrame:ToObjectSpace(handle.CFrame)
                                    intended = CFrame.new(rel.Position * fittedScale) * rel.Rotation
                                end
                            end
                        end
                        if anchor and intended then
                            local ok, cloned = pcall(linkVisual, handle, anchor, root, intended, fittedScale)
                            if ok and cloned then rendered += 1 end
                        end
                    end
                end
            end
        end
        return rendered, discovered
    end
    -- Hide the original stand's look, but keep its rig and gameplay parts.
    local function skipOriginalVisual(obj)
        if not currentMorph or not obj:IsDescendantOf(currentMorph) then return true end
        if visualRoot and obj:IsDescendantOf(visualRoot) then return true end
        local node = obj
        while node and node ~= currentMorph do
            local n = normalizedPartName(node.Name)
            -- Hide the old root aura, not the root or hitboxes.
            local cosmetic = obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke")
                or obj:IsA("Sparkles") or obj:IsA("Highlight")
            local rootCosmetic = cosmetic and standSkinSource ~= "Roblox Avatar"
            if ((n == "humanoidrootpart" or n == "rootpart" or n == "primarypart")
                    and not rootCosmetic)
                or n:find("hitbox", 1, true) or n:find("hurtbox", 1, true)
                or n:find("projectile", 1, true)
                or (n:find("effect", 1, true) and standSkinSource == "Roblox Avatar")
                or n:find("collision", 1, true) or n:find("attack", 1, true)
                or n:find("truesight", 1, true) then
                return true
            end
            node = node.Parent
        end
        return false
    end
    local function enforceOriginalHidden(obj)
        if not replaceOriginalStand or not currentMorph or not visualRoot
            or not visualRoot.Parent or not obj.Parent then return end
        if skipOriginalVisual(obj) then return end
        local snapshot = savedVisibility[obj]
        if not snapshot then return end
        pcall(function()
            if snapshot.kind == "part" then
                -- Handle both transparency values; YBA may reset one.
                if obj.Transparency ~= 1 then obj.Transparency = 1 end
                if obj.LocalTransparencyModifier ~= 1 then obj.LocalTransparencyModifier = 1 end
            elseif snapshot.kind == "texture" then
                if obj.Transparency ~= 1 then obj.Transparency = 1 end
            elseif snapshot.kind == "effect" then
                if obj.Enabled then obj.Enabled = false end
            end
        end)
    end
    local function hideOriginalVisual(obj)
        if not replaceOriginalStand or not currentMorph or not visualRoot
            or not visualRoot.Parent or not obj.Parent then return end
        if skipOriginalVisual(obj) then return end
        if savedVisibility[obj] then
            enforceOriginalHidden(obj)
            return
        end
        local original
        if obj:IsA("BasePart") then
            original = {kind = "part", transparency = obj.Transparency,
                modifier = obj.LocalTransparencyModifier}
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            original = {kind = "texture", transparency = obj.Transparency}
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")
            or obj:IsA("Highlight") then
            -- Leave TrueSight and combat effects alone.
            original = {kind = "effect", enabled = obj.Enabled}
        else
            return
        end
        savedVisibility[obj] = original
        if original.kind == "part" then
            table.insert(originalVisualConnections,
                obj:GetPropertyChangedSignal("Transparency"):Connect(function()
                    enforceOriginalHidden(obj)
                end))
            table.insert(originalVisualConnections,
                obj:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
                    enforceOriginalHidden(obj)
                end))
        elseif original.kind == "texture" then
            table.insert(originalVisualConnections,
                obj:GetPropertyChangedSignal("Transparency"):Connect(function()
                    enforceOriginalHidden(obj)
                end))
        else
            table.insert(originalVisualConnections,
                obj:GetPropertyChangedSignal("Enabled"):Connect(function()
                    enforceOriginalHidden(obj)
                end))
        end
        enforceOriginalHidden(obj)
    end
    -- Both the hidden stand and visual avatar must be non-collidable.
    -- Restore the original stand's collision state when disabled.
    local function suppressOriginalStandCollisions(morph)
        local function handlePart(obj)
            if not obj:IsA("BasePart") or (visualRoot and obj:IsDescendantOf(visualRoot))
                or savedStandCollisions[obj] ~= nil then return end
            savedStandCollisions[obj] = obj.CanCollide
            local function enforce()
                if currentMorph == morph and obj.Parent and obj.CanCollide then
                    obj.CanCollide = false
                end
            end
            table.insert(standCollisionConnections,
                obj:GetPropertyChangedSignal("CanCollide"):Connect(enforce))
            enforce()
        end
        -- Watch for parts YBA adds later during summoning.
        table.insert(standCollisionConnections,
            morph.DescendantAdded:Connect(handlePart))
        for _, obj in ipairs(morph:GetDescendants()) do handlePart(obj) end
    end

    local function suppressSkinCollisions(skin)
        -- Accessories may appear later, so keep all cosmetic handles collision-free.
        local watched = setmetatable({}, {__mode = "k"})
        local function handlePart(obj)
            if not obj:IsA("BasePart") or watched[obj] then return end
            watched[obj] = true
            local function enforce()
                if visualRoot ~= skin or not obj.Parent then return end
                if obj.CanCollide then obj.CanCollide = false end
                if obj.CanTouch then obj.CanTouch = false end
                if obj.CanQuery then obj.CanQuery = false end
                if not obj.Massless then obj.Massless = true end
            end
            enforce()
            table.insert(skinCollisionConnections,
                obj:GetPropertyChangedSignal("CanCollide"):Connect(enforce))
            table.insert(skinCollisionConnections,
                obj:GetPropertyChangedSignal("CanTouch"):Connect(enforce))
            table.insert(skinCollisionConnections,
                obj:GetPropertyChangedSignal("CanQuery"):Connect(enforce))
        end
        table.insert(skinCollisionConnections, skin.DescendantAdded:Connect(handlePart))
        for _, obj in ipairs(skin:GetDescendants()) do handlePart(obj) end
    end

    local function hideOriginalStand(morph)
        if not replaceOriginalStand then return 0 end
        -- Listen first: accessories/meshes can appear after StandMorph creation.
        table.insert(originalVisualConnections,
            morph.DescendantAdded:Connect(function(obj)
                if currentMorph == morph then hideOriginalVisual(obj) end
            end))
        for _, obj in ipairs(morph:GetDescendants()) do
            hideOriginalVisual(obj)
        end
        local hiddenCount = 0
        for _ in pairs(savedVisibility) do hiddenCount += 1 end
        return hiddenCount
    end

    -- Only animated, properly jointed R15 limbs are used for the replacement. Sticky Fingers and
    -- other YBA stands may put their visible pieces at odd angles. Fitting R15 limbs to those
    -- independent meshes tears the rig apart.
    local function usableStandAnchor(morph, chosen, torso)
        if anchorMode == "Follow Torso" then return torso end
        local root = morph:FindFirstChild("HumanoidRootPart", true)
        if not (root and root:IsA("BasePart")) then
            root = morph.PrimaryPart
        end
        if root and root:IsA("BasePart")
            and (root.Position - torso.Position).Magnitude <= 12 then
            return root
        end
        return torso
    end

    local function replayCompatibleStandTracks(sourceAnimator, targetAnimator)
        if motionMode ~= "Copy Compatible Animations" or not sourceAnimator or not targetAnimator then
            return
        end
        local function attemptTrack(sourceTrack)
            if not visualRoot or not visualRoot.Parent or activeStandTracks[sourceTrack] then return end
            local count = 0
            for _ in pairs(activeStandTracks) do count += 1 end
            if count >= 4 then return end
            -- Only shared R15-compatible pose channels can move the skin. A YBA-only animation won't match
            -- R15 joints and is simply ignored.
            local sourceAnimation = sourceTrack.Animation
            if not (sourceAnimation and sourceAnimation:IsA("Animation")) then return end
            local asset = sourceAnimation.AnimationId
            if not asset or asset == "" then return end
            local ok, played = pcall(function()
                local loaded = targetAnimator:LoadAnimation(sourceAnimation)
                loaded.Looped = sourceTrack.Looped
                loaded.Priority = sourceTrack.Priority
                loaded:Play(0.05, 1, math.clamp(sourceTrack.Speed, 0.1, 4))
                pcall(function() loaded.TimePosition = sourceTrack.TimePosition end)
                return loaded
            end)
            if not ok or not played then return end
            activeStandTracks[sourceTrack] = played
            -- Using an event avoids any per-frame or per-character polling.
            table.insert(standAnimationConnections, sourceTrack.Stopped:Connect(function()
                if activeStandTracks[sourceTrack] == played then
                    activeStandTracks[sourceTrack] = nil
                end
                pcall(function() played:Stop(0.12) end)
                pcall(function() played:Destroy() end)
            end))
        end
        table.insert(standAnimationConnections, sourceAnimator.AnimationPlayed:Connect(attemptTrack))
        for _, playing in ipairs(sourceAnimator:GetPlayingAnimationTracks()) do
            attemptTrack(playing)
        end
    end

    local function applySkin(morph)
        if not standSkinModule.enabled or not builtAvatar or not morph or not morph.Parent then
            return false
        end
        if standSkinSource ~= "Roblox Avatar" and not isStarPlatinumStand(player, morph) then
            restoreSkin()
            status("SPOH is only available for Star Platinum; original stand unchanged.")
            return false
        end
        if morph == currentMorph and visualRoot and visualRoot.Parent then return true end
        restoreSkin()

        -- Stand animations remain alive on the game's ORIGINAL (hidden) rig. Do not accidentally pick
        -- an Animator from our cloned R15 rig.
        local sourceAnimator = morph:FindFirstChildWhichIsA("Animator", true)
        local parts, chosen, centres, buckets = standBodyData(morph)
        -- Use the real R15 torso joint, not an armour folder, to track facing.
        local articulatedTorso
        for _, node in ipairs(morph:GetDescendants()) do
            if node:IsA("Motor6D") and node.Name == "Waist"
                and node.Part0 and node.Part1
                and node.Part0.Name == "LowerTorso"
                and node.Part1.Name == "UpperTorso"
                and node.Part0:IsDescendantOf(morph)
                and node.Part1:IsDescendantOf(morph) then
                articulatedTorso = node.Part1
                break
            end
        end
        local standTorso = articulatedTorso
            or chosen.uppertorso or chosen.torso or chosen.lowertorso
        if not standTorso then
            local bestScore = -1
            for _, candidate in ipairs(parts) do
                local size = candidate.Size
                local volume = size.X * size.Y * size.Z
                if volume > bestScore then
                    bestScore, standTorso = volume, candidate
                end
            end
        end
        if not (standTorso and standTorso:IsA("BasePart")) then
            status("No stable stand body part found; original stand kept visible.")
            return false
        end

        local okClone, skin = pcall(function() return builtAvatar:Clone() end)
        if not okClone or not skin then
            status("Couldn't clone the full R15 avatar.")
            return false
        end
        skin.Name = "TrueSightAvatarStandSkin"
        local avatarRoot = skin:FindFirstChild("HumanoidRootPart")
        local avatarTorso = skin:FindFirstChild("UpperTorso")
        local humanoid = skin:FindFirstChildOfClass("Humanoid")
        if not (avatarRoot and avatarRoot:IsA("BasePart")
            and avatarTorso and avatarTorso:IsA("BasePart")
            and humanoid and humanoid.RigType == Enum.HumanoidRigType.R15) then
            skin:Destroy()
            status("The chosen avatar didn't generate a complete R15 skeleton.")
            return false
        end

        -- Preserve and move the complete rig as one model. ScaleTo adjusts *joint offsets, attachment
        -- points, body parts and accessories*.
        local fitting = standSkinSource ~= "Roblox Avatar" and 1.0
            or math.clamp(getFittedScale(builtAvatar, chosen), 0.6, 1.35)
        if standSkinSource == "Roblox Avatar" and fitMode == "Auto" then
            fitting = math.clamp(0.82 * scale, 0.6, 1.3)
        end
        local okScale, scaleError = pcall(function() skin:ScaleTo(fitting) end)
        if not okScale then
            skin:Destroy()
            status("R15 rig scale failed: " .. tostring(scaleError))
            return false
        end

        local accessories = 0
        for _, obj in ipairs(skin:GetChildren()) do
            if obj:IsA("Accessory") then
                accessories += 1
                if not wantAccessories or accessories > 16 then obj:Destroy() end
            end
        end
        for _, obj in ipairs(skin:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.Anchored = false
                obj.CanCollide = false
                obj.CanTouch = false
                obj.CanQuery = false
                obj.Massless = true
                obj.CastShadow = false
            end
        end
        -- A passive humanoid keeps normal avatar rendering, including layered clothes, but will not
        -- apply movement or physics forces to the stand.
        pcall(function() humanoid.EvaluateStateMachine = false end)
        humanoid.AutoRotate = false
        humanoid.BreakJointsOnDeath = false
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        humanoid.NameDisplayDistance = 0
        avatarRoot.Transparency = 1
        avatarRoot.LocalTransparencyModifier = 1
        -- Initially anchor the cloned root for placement. During ordinary movement it becomes
        -- unanchored and welded to the genuine stand root. All body parts remain noncollidable,
        -- massless and non-touching.
        avatarRoot.Anchored = true
        avatarRoot.RootPriority = -127
        skin.PrimaryPart = avatarRoot

        -- Pick stable limb anchors once when the stand appears.
        local torsoGroup = (standTorso == chosen.uppertorso and "uppertorso")
            or (standTorso == chosen.torso and "torso")
            or (standTorso == chosen.lowertorso and "lowertorso")
        local samples = {}
        local torsoBucket = torsoGroup and buckets[torsoGroup]
        if torsoBucket then
            local candidates = {}
            for _, bodyPart in ipairs(torsoBucket) do
                if bodyPart.Parent and (bodyPart.Position - standTorso.Position).Magnitude < 5.5 then
                    local sz = bodyPart.Size
                    local volume = sz.X * sz.Y * sz.Z
                    local weight = math.clamp(math.sqrt(math.max(volume, 0.0001)), 0.06, 1.6)
                    table.insert(candidates, {part = bodyPart, weight = weight})
                end
            end
            table.sort(candidates, function(a,b) return a.weight > b.weight end)
            for i = 1, math.min(#candidates, 10) do
                table.insert(samples, candidates[i])
            end
        end
        if #samples == 0 then
            samples[1] = {part = standTorso, weight = 1}
        end

        -- The original stand's actual visible torso is the reference point. Do not use player's
        -- HumanoidRootPart or cached stand-root offsets: beatdowns often animate the stand away from
        -- both.
        local fallbackOffset = torsoGroup and centres[torsoGroup] or Vector3.zero
        if fallbackOffset.Magnitude > 1.3 then
            fallbackOffset = fallbackOffset.Unit * 1.3
        end
        local facingRoot = morph:FindFirstChild("HumanoidRootPart", true)
        if not (facingRoot and facingRoot:IsA("BasePart")) then
            facingRoot = morph.PrimaryPart
        end
        if not (facingRoot and facingRoot:IsA("BasePart")) then facingRoot = nil end

        local function horizontalFrame(cf)
            if not cf then return nil end
            local vector = cf.LookVector
            local flat = Vector3.new(vector.X, 0, vector.Z)
            if flat.Magnitude < 0.08 then return nil end
            return CFrame.lookAt(Vector3.zero, flat.Unit)
        end
        local spawnTorsoYaw = horizontalFrame(standTorso.CFrame)
        local spawnRootYaw = facingRoot and horizontalFrame(facingRoot.CFrame)
        -- Some stand roots face backward. Calibrate on summon, not every frame.
        local rootFacingCorrection = CFrame.identity
        if not articulatedTorso and facingRoot and facingRoot.Parent then
            local characterRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local playerYaw = characterRoot and horizontalFrame(characterRoot.CFrame)
            if playerYaw and spawnRootYaw
                and (characterRoot.Position - facingRoot.Position).Magnitude < 22
                and playerYaw.LookVector:Dot(spawnRootYaw.LookVector) < -0.6 then
                rootFacingCorrection = CFrame.Angles(0, math.pi, 0)
            end
        end
        -- Calibrate a model's custom mesh rotation only once, not on every running frame. Many stand
        -- torso meshes face 90 degrees sideways.
        local torsoToStandYaw = (spawnTorsoYaw and spawnRootYaw)
            and spawnTorsoYaw:ToObjectSpace(spawnRootYaw) or CFrame.identity
        local previousYaw = spawnRootYaw or spawnTorsoYaw or CFrame.identity
        local normalRootDistance = facingRoot and
            (facingRoot.Position - standTorso.Position).Magnitude or 0
        local detachDistance = math.clamp(normalRootDistance + 4, 8, 15)

        local function liveStandCentre()
            local total, centre = 0, Vector3.zero
            for _, entry in ipairs(samples) do
                local part = entry.part
                if part and part.Parent and part:IsDescendantOf(morph) then
                    total += entry.weight
                    centre += part.Position * entry.weight
                end
            end
            if total > 0 then return centre / total end
            return standTorso.CFrame:PointToWorldSpace(fallbackOffset)
        end

        local function liveStandYaw()
            local rootYaw = facingRoot and facingRoot.Parent
                and horizontalFrame(facingRoot.CFrame)
            local torsoYaw = horizontalFrame(standTorso.CFrame)
            local detached = facingRoot and facingRoot.Parent
                and (facingRoot.Position - standTorso.Position).Magnitude > detachDistance
            -- Follow the stable root in normal play and the animated torso in beatdowns.
            if detached and torsoYaw then
                previousYaw = torsoYaw * torsoToStandYaw
            elseif rootYaw then
                previousYaw = rootYaw
            elseif torsoYaw then
                previousYaw = torsoYaw * torsoToStandYaw
            end
            return previousYaw * rootFacingCorrection
        end

        local function targetRootFrame()
            if articulatedTorso and articulatedTorso.Parent
                and articulatedTorso:IsDescendantOf(morph) then
                -- Match real R15 torso transforms directly.
                local localTorso = avatarRoot.CFrame:ToObjectSpace(avatarTorso.CFrame)
                return articulatedTorso.CFrame * localTorso:Inverse()
            end
            local desiredBodyYaw = liveStandYaw()
            local avatarTorsoLocal = avatarRoot.CFrame:ToObjectSpace(avatarTorso.CFrame)
            -- Copying a stand track can rotate the R15 torso relative to its HumanoidRootPart. Subtract
            -- that local rotation so the rendered body, not merely the invisible root, faces the correct
            -- way.
            local localTorsoYaw = horizontalFrame(avatarTorsoLocal)
            local correctedRootYaw = localTorsoYaw
                and (desiredBodyYaw * localTorsoYaw:Inverse()) or desiredBodyYaw
            local targetRootPosition = liveStandCentre()
                - correctedRootYaw:VectorToWorldSpace(avatarTorsoLocal.Position)
            return CFrame.new(targetRootPosition) * correctedRootYaw
        end

        -- Only copy poses between matching R15 joints, never decorative meshes.
        local poseMirrors = {}
        local sourceJoints = {}
        local ambiguousJoints = {}
        local safeJointNames = {
            Root = true, Waist = true, Neck = true,
            LeftShoulder = true, LeftElbow = true, LeftWrist = true,
            RightShoulder = true, RightElbow = true, RightWrist = true,
            LeftHip = true, LeftKnee = true, LeftAnkle = true,
            RightHip = true, RightKnee = true, RightAnkle = true,
        }
        local function rigJointKey(joint)
            if not (joint:IsA("Motor6D") and joint.Part0 and joint.Part1) then return nil end
            return joint.Name .. ":" .. joint.Part0.Name .. ":" .. joint.Part1.Name
        end
        -- Insist on the SAME joint and the SAME two limb names on both rigs. There is deliberately no
        -- LeftArm -> LeftUpperArm fallback.
        for _, obj in ipairs(morph:GetDescendants()) do
            local key = rigJointKey(obj)
            if key and safeJointNames[obj.Name] then
                if sourceJoints[key] then ambiguousJoints[key] = true end
                sourceJoints[key] = obj
            end
        end
        for _, obj in ipairs(skin:GetDescendants()) do
            local key = rigJointKey(obj)
            if key and safeJointNames[obj.Name] and not ambiguousJoints[key]
                and obj.Part0:IsDescendantOf(skin)
                and obj.Part1:IsDescendantOf(skin) then
                local source = sourceJoints[key]
                if source and source.Part0:IsDescendantOf(morph)
                    and source.Part1:IsDescendantOf(morph) then
                    -- Even equal limb names can use different joint axes. Only mirror rotation when BOTH rest-pose
                    -- frames align.
                    local _, offset0 = (source.C0.Rotation:ToObjectSpace(
                        obj.C0.Rotation)):ToAxisAngle()
                    local _, offset1 = (source.C1.Rotation:ToObjectSpace(
                        obj.C1.Rotation)):ToAxisAngle()
                    if offset0 <= math.rad(25) and offset1 <= math.rad(25) then
                        table.insert(poseMirrors, {
                            original = source,
                            avatar = obj,
                            -- Rest-relative orientation maps joint motion between different Roblox body packages without
                            -- mapping mesh world positions onto limbs.
                            restRotation = (source.C0 * source.C1:Inverse()).Rotation,
                        })
                    end
                end
            end
        end
        -- If joint matching fails, fall back to compatible animation tracks.
        local rootToPivot = avatarRoot.CFrame:ToObjectSpace(skin:GetPivot())
        skin:PivotTo(targetRootFrame() * rootToPivot)
        skin.Parent = workspace
        visualRoot = skin
        currentMorph = morph

        -- Calibrate after placing the rig; running should follow the stand root.
        local locomotionRootOffset
        local originalTorsoRootOffset
        if facingRoot and facingRoot.Parent and facingRoot:IsDescendantOf(morph) then
            locomotionRootOffset = facingRoot.CFrame:ToObjectSpace(avatarRoot.CFrame)
            originalTorsoRootOffset = facingRoot.CFrame:ToObjectSpace(standTorso.CFrame)
        end
        -- Don't calculate rest offsets from decorative meshes.
        suppressSkinCollisions(skin)
        suppressOriginalStandCollisions(morph)
        -- Copy joint transforms before physics for stable M1 and beatdown poses.
        local nextTrackSync = 0
        visualPoseConnection = RunService.PreSimulation:Connect(function()
            if visualRoot ~= skin or currentMorph ~= morph then return end
            if not skin.Parent or not morph:IsDescendantOf(workspace) or not standTorso.Parent then
                task.defer(restoreSkin)
                return
            end
            -- Copy the effective joint pose, including C0/C1 changes, before physics.
            -- Leave root following to the later render step.
            for _, pair in ipairs(poseMirrors) do
                local source, target = pair.original, pair.avatar
                if source.Parent and target.Parent and source.Part0 and source.Part1 then
                    local okPose, liveSourceRotation = pcall(function()
                        return (source.C0 * source.Transform * source.C1:Inverse()).Rotation
                    end)
                    if okPose and liveSourceRotation then
                        local delta = pair.restRotation:Inverse() * liveSourceRotation
                        local _, angle = delta:ToAxisAngle()
                        if angle == angle and math.abs(angle) < math.rad(170) then
                            local targetBasis = target.C1.Rotation
                            local targetPose = targetBasis:Inverse() * delta * targetBasis
                            pcall(function() target.Transform = targetPose end)
                        end
                    end
                end
            end
            local now = os.clock()
            if now >= nextTrackSync then
                nextTrackSync = now + 0.25
                for sourceTrack, avatarTrack in pairs(activeStandTracks) do
                    pcall(function()
                        if sourceTrack.IsPlaying and avatarTrack.IsPlaying
                            and math.abs(sourceTrack.TimePosition - avatarTrack.TimePosition) > 0.12 then
                            avatarTrack.TimePosition = sourceTrack.TimePosition
                        end
                    end)
                end
            end
        end)

        -- Keep the root welded to the stand; only adjust its facing.
        -- Use the real torso facing to avoid jitter and backward poses.
        local detachedMode = false
        local function releaseVisualWeld()
            if visualStandWeld then
                pcall(function() visualStandWeld:Destroy() end)
                visualStandWeld = nil
            end
        end
        local function validAttachmentRoot()
            return facingRoot and facingRoot.Parent
                and facingRoot:IsDescendantOf(morph)
                and locomotionRootOffset and originalTorsoRootOffset
        end
        -- Use the torso's facing correction without changing root position.
        local function desiredWeldYaw()
            if not validAttachmentRoot() then return nil end
            local standRootYaw = horizontalFrame(facingRoot.CFrame)
            local visibleBodyYaw = horizontalFrame(targetRootFrame())
            if standRootYaw and visibleBodyYaw then
                return standRootYaw:ToObjectSpace(visibleBodyYaw)
            end
            return nil
        end
        -- Keep the weld position fixed; adjust only its angle when needed.
        local function alignVisualWeldYaw(dt)
            local weld = visualStandWeld
            if not (weld and weld.Parent and weld.Part0 == facingRoot
                and weld.Part1 == avatarRoot) then return end
            local desiredYaw = desiredWeldYaw()
            if not desiredYaw then return end
            local currentYaw = horizontalFrame(weld.C0)
            if not currentYaw then return end
            local dot = math.clamp(currentYaw.LookVector:Dot(desiredYaw.LookVector), -1, 1)
            local difference = math.acos(dot)
            if difference < math.rad(2.5) then return end
            -- Keep movement weld-driven; ease small turns and snap large ones.
            local alpha = (difference > math.rad(65)) and 1
                or math.clamp(1 - math.exp(-16 * math.clamp(dt or 0.016, 0, 0.1)), 0.08, 1)
            local alignedYaw = currentYaw:Lerp(desiredYaw, alpha)
            weld.C0 = CFrame.new(locomotionRootOffset.Position) * alignedYaw
        end
        local function weldVisualToStandRoot()
            if not validAttachmentRoot() then return false end
            if visualStandWeld and visualStandWeld.Parent
                and visualStandWeld.Part0 == facingRoot
                and visualStandWeld.Part1 == avatarRoot then
                return true
            end
            releaseVisualWeld()
            -- Position the clone before welding so the original stand doesn't move.
            local faceYaw = desiredWeldYaw()
            local weldOffset = faceYaw
                and (CFrame.new(locomotionRootOffset.Position) * faceYaw)
                or locomotionRootOffset
            avatarRoot.Anchored = true
            avatarRoot.CFrame = facingRoot.CFrame * weldOffset
            avatarRoot.Anchored = false
            local weld = Instance.new("Weld")
            weld.Name = "TrueSightVisualStandRootWeld"
            weld.Part0 = facingRoot
            weld.Part1 = avatarRoot
            weld.C0 = weldOffset
            weld.C1 = CFrame.identity
            weld.Parent = avatarRoot
            visualStandWeld = weld
            return true
        end
        -- Only watch for detached beatdowns; normal movement uses the weld.
        RunService:BindToRenderStep(visualFollowStepName,
            Enum.RenderPriority.Last.Value + 5, function(dt)
                if visualRoot ~= skin or currentMorph ~= morph then return end
                if not skin.Parent or not morph:IsDescendantOf(workspace)
                    or not standTorso.Parent then
                    task.defer(restoreSkin)
                    return
                end
                local attached = validAttachmentRoot()
                if attached then
                    local sourceRootFrame = facingRoot.CFrame
                    local expectedTorsoPosition =
                        (sourceRootFrame * originalTorsoRootOffset).Position
                    local torsoDeviation =
                        (standTorso.Position - expectedTorsoPosition).Magnitude
                    -- Keep the weld for normal moves; switch tracking for large beatdowns.
                    if detachedMode then
                        if torsoDeviation < 1.35 then detachedMode = false end
                    elseif torsoDeviation > 3.25 then
                        detachedMode = true
                    end
                    if (facingRoot.Position - standTorso.Position).Magnitude > detachDistance then
                        detachedMode = true
                    end
                else
                    detachedMode = true
                end

                if not detachedMode and attached then
                    -- Follow position with the weld and correct facing separately.
                    if weldVisualToStandRoot() then
                        alignVisualWeldYaw(dt)
                    end
                else
                    -- Detach before anchoring to avoid anchoring the real stand.
                    releaseVisualWeld()
                    avatarRoot.Anchored = true
                    avatarRoot.CFrame = targetRootFrame()
                end
            end)
        visualFollowBound = true
        -- Attach right away so the skin doesn't lag a frame behind.
        if validAttachmentRoot() then weldVisualToStandRoot() end

        local targetAnimator = humanoid:FindFirstChildOfClass("Animator")
        if not targetAnimator then
            targetAnimator = Instance.new("Animator")
            targetAnimator.Parent = humanoid
        end
        if standSkinSource == "Roblox Avatar" or #poseMirrors < 10 then
            -- Don't replay animations when joint mirroring already handles them.
            replayCompatibleStandTracks(sourceAnimator, targetAnimator)
        end
        spohFxOnSkin(skin, morph, sourceAnimator)
        local hiddenCount = hideOriginalStand(morph)
        local synced = #poseMirrors
        if synced == 0 then
            warn("[TrueSight] Stand rig has no compatible R15 Motor6D pairs; "
                .. "using track-replay fallback (custom YBA animation poses may differ).")
        end
        status((standSkinSource ~= "Roblox Avatar" and "SPOH model" or "Full R15 rig")
            .. " welded (" .. tostring(math.min(accessories, wantAccessories and 16 or 0))
            .. " accessories, " .. tostring(synced) .. " pose-sync joints, no collision; "
            .. (replaceOriginalStand and (hiddenCount .. " original visuals hidden") or "overlay") .. ").")
        return true
    end

    local function refreshStand()
        if not standSkinModule.enabled or not builtAvatar then return end
        if queued then return end
        queued = true
        local token = activeGeneration
        task.delay(0.65, function()
            queued = false
            if token ~= activeGeneration or not standSkinModule.enabled then return end
            local morph = findMorph()
            if morph and morph ~= currentMorph then
                if morph ~= lastRetryMorph then
                    lastRetryMorph = morph
                    retryCount = 0
                end
                local ok, applied = pcall(applySkin, morph)
                if not ok then warn("[TrueSight] Avatar stand overlay failed: " .. tostring(applied)) end
                if (not ok or not applied) and retryCount < 10 then
                    retryCount += 1
                    task.delay(0.65, function()
                        if token == activeGeneration and standSkinModule.enabled then refreshStand() end
                    end)
                end
            end
        end)
    end
    local function watchContainer(container)
        if not container then return end
        table.insert(watchers, container.DescendantAdded:Connect(function(obj)
            if obj.Name == "StandMorph" and obj:IsA("Model") then refreshStand() end
        end))
        table.insert(watchers, container.DescendantRemoving:Connect(function(obj)
            if obj == currentMorph then task.defer(restoreSkin) end
        end))
    end
    local function setupWatchers()
        disconnectAll()
        watchContainer(player.Character)
        local living = workspace:FindFirstChild("Living")
        if living then
            local mine = living:FindFirstChild(player.Name)
            if mine and mine ~= player.Character then watchContainer(mine) end
            table.insert(watchers, living.ChildAdded:Connect(function(obj)
                if obj.Name == player.Name then watchContainer(obj); refreshStand() end
            end))
        end
        table.insert(watchers, player.CharacterAdded:Connect(function(ch)
            watchContainer(ch)
            task.delay(0.8, refreshStand)
        end))
        -- The Living folder may change after respawn or teleport.
        table.insert(watchers, workspace.ChildAdded:Connect(function(obj)
            if obj.Name == "Living" then
                local mine = obj:FindFirstChild(player.Name)
                if mine then watchContainer(mine) end
                table.insert(watchers, obj.ChildAdded:Connect(function(ch)
                    if ch.Name == player.Name then watchContainer(ch); refreshStand() end
                end))
                refreshStand()
            end
        end))
    end
    local function updateAvatarTemplate()
        activeGeneration += 1
        local token = activeGeneration
        restoreSkin()
        lastRetryMorph, retryCount = nil, 0
        if builtAvatar then builtAvatar:Destroy(); builtAvatar = nil end
        if builtAvatarR6 then builtAvatarR6:Destroy(); builtAvatarR6 = nil end
        task.spawn(function()
            if standSkinSource ~= "Roblox Avatar" then
                -- Load the original SPOH R15 model from the GitHub file cache.
                -- Potassium can deserialize it with getcustomasset and GetObjects.
                local filePath = customModelCachePath
                if not spohValidModel(spohFileBytes(filePath)) then
                    -- The first download may still be running.
                    local startWait = os.clock()
                    while cacheSyncBusy and os.clock() - startWait < 8
                        and token == activeGeneration and standSkinModule.enabled do
                        task.wait(0.15)
                    end
                end
                if not spohValidModel(spohFileBytes(filePath)) then
                    status("SPOH unavailable. Check GitHub / skins/spoh/spohr15.rbxm.")
                    return
                end
                if type(getcustomasset) ~= "function" then
                    status("Executor has no getcustomasset(path) function.")
                    return
                end
                local assetOK, asset = pcall(getcustomasset, filePath)
                if not assetOK or type(asset) ~= "string" then
                    status("Potassium couldn't register the SPOH file.")
                    warn("[TrueSight] getcustomasset failed:", asset)
                    return
                end
                local loaded, result = pcall(function()
                    return game:GetObjects(asset)
                end)
                if token ~= activeGeneration or not standSkinModule.enabled then
                    if loaded and type(result) == "table" then
                        for _, instance in ipairs(result) do pcall(function() instance:Destroy() end) end
                    end
                    return
                end
                if not loaded or type(result) ~= "table" or #result == 0 then
                    status("Unable to deserialize SPOH .rbxm in Potassium.")
                    warn("[TrueSight] SPOH model load failed:", result)
                    return
                end
                local template
                local function usable(model)
                    if not model:IsA("Model") then return false end
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    local rootPart = model:FindFirstChild("HumanoidRootPart")
                    local torso = model:FindFirstChild("UpperTorso")
                    if not (hum and hum.RigType == Enum.HumanoidRigType.R15
                        and rootPart and rootPart:IsA("BasePart")
